private foreign handler _gpx_start() returns CInt binds to "c:gamepadxt>gpx_start!cdecl"
private foreign handler _gpx_stop() returns nothing binds to "c:gamepadxt>gpx_stop!cdecl"
private foreign handler _gpx_is_started() returns CInt binds to "c:gamepadxt>gpx_is_started!cdecl"

