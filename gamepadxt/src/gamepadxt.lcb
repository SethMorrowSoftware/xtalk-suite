private foreign handler _gpx_button_names() returns Pointer binds to "c:gamepadxt>gpx_button_names!cdecl"
private foreign handler _gpx_axis_names() returns Pointer binds to "c:gamepadxt>gpx_axis_names!cdecl"
private foreign handler _gpx_pad_button(in pPad as CInt, in pButton as ZStringUTF8) returns CInt binds to "c:gamepadxt>gpx_pad_button!cdecl"
