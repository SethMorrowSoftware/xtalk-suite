-- src/gamepad_shim.c; tools/check-lcb-signatures.py holds every line to the
-- C definition it binds (name, return type, each parameter type).
-- =====================================================================

private foreign handler _gpx_text_length(in pText as Pointer) returns CInt binds to "c:gamepadxt>gpx_text_length!cdecl"

-- ---- the library
private foreign handler _gpx_abi_version() returns CInt binds to "c:gamepadxt>gpx_abi_version!cdecl"
private foreign handler _gpx_library_version() returns Pointer binds to "c:gamepadxt>gpx_library_version!cdecl"
private foreign handler _gpx_last_error() returns Pointer binds to "c:gamepadxt>gpx_last_error!cdecl"
private foreign handler _gpx_assert_count() returns CInt binds to "c:gamepadxt>gpx_assert_count!cdecl"

