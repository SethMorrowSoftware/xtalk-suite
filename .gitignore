# Suite-level ignores. Each member also carries its own .gitignore; this root
# file guarantees that the heavy CMake build trees (which are per-member and can
# reach into the gigabytes for the WebRTC/torrent members) never get committed,
# no matter which member you built in.
build/
build-*/
*/build/
*/build-*/
cmake-build-*/

# Python tooling
__pycache__/
*.pyc
.pytest_cache/

# Editor / OS cruft
.DS_Store
*.swp
*~
.idea/
.vscode/

# (tools/check-engine-lint.py used to write its wrapper and manifest here under
# fixed names. It now uses a private tempfile.mkdtemp per run, because two
# overlapping runs raced each other's cleanup within a day of the first version
# being written - so there is nothing left in the tree to ignore.)
