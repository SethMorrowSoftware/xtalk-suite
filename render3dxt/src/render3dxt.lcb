   end unsafe
end handler

/**
Summary: Returns the texture of a material.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: The texture handle, or 0 if it has none.
*/
public handler r3MaterialTexture(in pMaterial as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _material_texture(pMaterial) into tR
   end unsafe
   return tR
end handler

/**
Summary: Sets how shiny a material is.

pMaterial: A material handle from <r3MaterialCreate>.

pStrength: How bright the highlight is, 0 (none) to 1.

pShininess: How tight it is, 1 (broad) to 1000 (a pinpoint).

Description: A highlight appears where a light reflects towards the camera. A
new material has none.
*/
public handler r3MaterialSetSpecular(in pMaterial as Integer, in pStrength as Number, in pShininess as Number) returns nothing
   unsafe
      _material_set_specular(pMaterial, pStrength, pShininess)
   end unsafe
end handler

/**
Summary: Returns how shiny a material is.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: Two numbers as text, "strength,shininess".
*/
public handler r3MaterialSpecular(in pMaterial as Integer) returns String
   variable tR as Pointer
   unsafe
      put _material_specular(pMaterial) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Sets the light a material gives off by itself.

pMaterial: A material handle from <r3MaterialCreate>.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.

Description: Added to the surface whatever the lights do: a lamp, a screen, a
glowing sign.
*/
public handler r3MaterialSetEmissive(in pMaterial as Integer, in pR as Number, in pG as Number, in pB as Number) returns nothing
   unsafe
      _material_set_emissive(pMaterial, pR, pG, pB)
   end unsafe
end handler

/**
Summary: Draws a material at its full colour, ignoring the lights.

pMaterial: A material handle from <r3MaterialCreate>.

pFlag: True to turn it on, false to turn it off.

Description: For a sky, a sign, or a flat drawing style.
*/
public handler r3MaterialSetUnlit(in pMaterial as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _material_set_unlit(pMaterial, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether a material ignores the lights.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: True if it does.
*/
public handler r3MaterialIsUnlit(in pMaterial as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _material_is_unlit(pMaterial) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Draws both faces of a material's triangles.

pMaterial: A material handle from <r3MaterialCreate>.

pFlag: True to turn it on, false to turn it off.

Description: Normally a triangle seen from behind is skipped, which is right
for a closed object. Turn this on for a sheet seen from both sides: a leaf, a
flag, a single wall.
*/
public handler r3MaterialSetDoubleSided(in pMaterial as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _material_set_double_sided(pMaterial, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether both faces are drawn.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: True if they are.
*/
public handler r3MaterialIsDoubleSided(in pMaterial as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _material_is_double_sided(pMaterial) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Lights each triangle as one flat facet.

pMaterial: A material handle from <r3MaterialCreate>.

pFlag: True to turn it on, false to turn it off.

Description: Normally light is blended across a triangle so a sphere looks
round. Flat shows the facets: the low-polygon look.
*/
public handler r3MaterialSetFlat(in pMaterial as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _material_set_flat(pMaterial, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether a material is lit in flat facets.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: True if it is.
*/
public handler r3MaterialIsFlat(in pMaterial as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _material_is_flat(pMaterial) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Leaves holes where a material's texture is transparent.

pMaterial: A material handle from <r3MaterialCreate>.

pFlag: True to turn it on, false to turn it off.

Description: A pixel of the texture that is more than half transparent is not
drawn at all: fences, leaves, a grating.
*/
public handler r3MaterialSetCutout(in pMaterial as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _material_set_cutout(pMaterial, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether transparent texture pixels are left out.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: True if they are.
*/
public handler r3MaterialIsCutout(in pMaterial as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _material_is_cutout(pMaterial) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Frees a mesh.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

Description: A node that used it draws nothing from then on. A mesh loaded
from a model file takes the materials and textures the file made with it.
*/
public handler r3MeshDestroy(in pMesh as Integer) returns nothing
   unsafe
      _mesh_destroy(pMesh)
   end unsafe
end handler

/**
Summary: Reports whether a mesh handle is alive.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

Returns: True if it is.
*/
public handler r3MeshIsValid(in pMesh as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _mesh_is_valid(pMesh) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Returns how many vertices a mesh has.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

Returns: The count.
*/
public handler r3MeshVertexCount(in pMesh as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _mesh_vertex_count(pMesh) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how many triangles a mesh has.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

Returns: The count.
*/
public handler r3MeshTriangleCount(in pMesh as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _mesh_triangle_count(pMesh) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the box that just holds a mesh.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

Returns: Six numbers as text, "minX,minY,minZ,maxX,maxY,maxZ", in the mesh's
