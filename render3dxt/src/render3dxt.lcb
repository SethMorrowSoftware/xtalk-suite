   end unsafe
   return tR is not 0
end handler

/**
Summary: Sets the colour of a material.

pMaterial: A material handle from <r3MaterialCreate>.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.

Description: With a texture, the colour tints it; white shows the texture as
it is.
*/
public handler r3MaterialSetColor(in pMaterial as Integer, in pR as Number, in pG as Number, in pB as Number) returns nothing
   unsafe
      _material_set_color(pMaterial, pR, pG, pB)
   end unsafe
end handler

/**
Summary: Returns the colour of a material.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: Three numbers as text, "r,g,b", each 0 to 255.
*/
public handler r3MaterialColor(in pMaterial as Integer) returns String
   variable tR as Pointer
   unsafe
      put _material_color(pMaterial) into tR
   end unsafe
