   unsafe
      put _material_create(pR, pG, pB) into tR
   end unsafe
   return tR
end handler

/**
Summary: Frees a material.

pMaterial: A material handle from <r3MaterialCreate>.

Description: Whatever used it is drawn plain white from then on.
*/
public handler r3MaterialDestroy(in pMaterial as Integer) returns nothing
   unsafe
      _material_destroy(pMaterial)
   end unsafe
end handler

/**
Summary: Reports whether a material handle is alive.

pMaterial: A material handle from <r3MaterialCreate>.

Returns: True if it is.
*/
public handler r3MaterialIsValid(in pMaterial as Integer) returns Boolean
   variable tR as Integer
