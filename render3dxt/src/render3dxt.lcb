public handler r3NodeSetRotation(in pNode as Integer, in pQx as Number, in pQy as Number, in pQz as Number, in pQw as Number) returns nothing
   unsafe
      _node_set_rotation(pNode, pQx, pQy, pQz, pQw)
   end unsafe
end handler

/**
Summary: Moves and turns a node at once.

pNode: A node handle from <r3NodeCreate>.

pX: The x coordinate, in metres.

pY: The y coordinate, in metres (y is up).

pZ: The z coordinate, in metres.

pQx: The quaternion's x.

pQy: The quaternion's y.

pQz: The quaternion's z.

pQw: The quaternion's w.
*/
public handler r3NodeSetTransform(in pNode as Integer, in pX as Number, in pY as Number, in pZ as Number, in pQx as Number, in pQy as Number, in pQz as Number, in pQw as Number) returns nothing
   unsafe
      _node_set_transform(pNode, pX, pY, pZ, pQx, pQy, pQz, pQw)
   end unsafe
end handler

/**
Summary: Moves and turns a node from one text.

pNode: A node handle from <r3NodeCreate>.

pText: Seven numbers, "x,y,z,qx,qy,qz,qw".

Example:
r3NodeSetTransformText tNode, b3BodyTransform(tBody)

Description: Takes what box3dxt's b3BodyTransform returns, so a body's node
follows it in one line.
*/
public handler r3NodeSetTransformText(in pNode as Integer, in pText as String) returns nothing
   unsafe
      _node_set_transform_text(pNode, pText)
   end unsafe
end handler

/**
Summary: Sets the size of a node.

pNode: A node handle from <r3NodeCreate>.

pSx: The scale along the mesh's x.

pSy: The scale along its y.

pSz: The scale along its z.

Description: 1 is the mesh's own size. A negative number mirrors the mesh.
*/
public handler r3NodeSetScale(in pNode as Integer, in pSx as Number, in pSy as Number, in pSz as Number) returns nothing
   unsafe
      _node_set_scale(pNode, pSx, pSy, pSz)
   end unsafe
end handler

/**
Summary: Returns where a node is.

pNode: A node handle from <r3NodeCreate>.

Returns: Three numbers as text, "x,y,z".
*/
public handler r3NodePosition(in pNode as Integer) returns String
   variable tR as Pointer
   unsafe
      put _node_position(pNode) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Returns the rotation of a node.

pNode: A node handle from <r3NodeCreate>.

Returns: Four numbers as text, "qx,qy,qz,qw".
*/
public handler r3NodeRotation(in pNode as Integer) returns String
   variable tR as Pointer
   unsafe
      put _node_rotation(pNode) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Returns the size of a node.

pNode: A node handle from <r3NodeCreate>.

Returns: Three numbers as text, "sx,sy,sz".
*/
public handler r3NodeScale(in pNode as Integer) returns String
   variable tR as Pointer
   unsafe
      put _node_scale(pNode) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Returns the position and rotation of a node.

pNode: A node handle from <r3NodeCreate>.

Returns: Seven numbers as text, "x,y,z,qx,qy,qz,qw".
*/
public handler r3NodeTransform(in pNode as Integer) returns String
   variable tR as Pointer
   unsafe
      put _node_transform(pNode) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Shows or hides a node.

pNode: A node handle from <r3NodeCreate>.

pFlag: True to show it, false to hide it.

Description: A hidden node is not drawn and not found by <r3ScenePick>.
*/
public handler r3NodeSetVisible(in pNode as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _node_set_visible(pNode, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether a node is shown.

pNode: A node handle from <r3NodeCreate>.

Returns: True if it is.
*/
public handler r3NodeIsVisible(in pNode as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _node_is_visible(pNode) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Gives a node a number of your choosing.

pNode: A node handle from <r3NodeCreate>.

pTag: A whole number; 0 means no tag.

Example:
r3NodeSetTag tNode, tBody

Description: Normally the box3dxt body the node draws: <r3SceneApplyMoves>
moves the nodes whose tag is a body that moved.
*/
public handler r3NodeSetTag(in pNode as Integer, in pTag as Integer) returns nothing
   unsafe
      _node_set_tag(pNode, pTag)
   end unsafe
end handler

/**
Summary: Returns the tag of a node.

pNode: A node handle from <r3NodeCreate>.

Returns: The number, or 0.
*/
public handler r3NodeTag(in pNode as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _node_tag(pNode) into tR
   end unsafe
   return tR
end handler

/**
Summary: Finds the node with a tag.

pScene: A scene handle from <r3SceneCreate>.

pTag: The number given to <r3NodeSetTag>.

Returns: The first such node's handle, or 0.
*/
public handler r3SceneNodeByTag(in pScene as Integer, in pTag as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _scene_node_by_tag(pScene, pTag) into tR
   end unsafe
   return tR
end handler

/**
Summary: Moves every node whose body moved, from box3dxt's move list.

pScene: A scene handle from <r3SceneCreate>.

pText: What b3MovesText() returns: one line per body,
"body,x,y,z,qx,qy,qz,qw,fellAsleep".

Returns: How many nodes were moved.

Example:
b3WorldStep sWorld, 1/60, 4
get b3WorldUpdateMoves(sWorld)
get r3SceneApplyMoves(sScene, b3MovesText())
set the imageData of image "View" to r3SceneRender(sScene, 640, 480)

Description: One call a frame carries a whole physics step to the picture:
each line of the text moves the nodes tagged with that body (<r3NodeSetTag>).
Bodies with no node are skipped.
*/
public handler r3SceneApplyMoves(in pScene as Integer, in pText as String) returns Integer
   variable tR as Integer
   unsafe
      put _scene_apply_moves(pScene, pText) into tR
   end unsafe
   return tR
end handler

/**
Summary: Sets how many processor threads draw a picture.

pN: 1 to 16.

Description: The picture is the same whatever the number; more threads draw a
large picture faster. The default is the number of processor cores, up to 8.
*/
public handler r3SetThreadCount(in pN as Integer) returns nothing
   unsafe
      _set_thread_count(pN)
   end unsafe
end handler

/**
Summary: Returns how many threads draw a picture.

Returns: 1 to 16.
*/
public handler r3ThreadCount() returns Integer
   variable tR as Integer
   unsafe
      put _thread_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Draws a scene and returns the picture.

pScene: A scene handle from <r3SceneCreate>.

pW: The picture's width in pixels, 1 to 4096.

pH: The picture's height in pixels, 1 to 4096.

Returns: The picture as imageData, pW by pH pixels, or empty if the call was
refused.

Example:
set the imageData of image "View" to r3SceneRender(sScene, the width of image "View", the height of image "View")

Description: Set it as the imageData of an image of the same width and height.
The whole picture is drawn inside the library, so thousands of triangles cost
a few milliseconds.
*/
public handler r3SceneRender(in pScene as Integer, in pW as Integer, in pH as Integer) returns Data
   variable tPtr as Pointer
   variable tLen as Integer
   variable tData as Data
   variable tOk as CBool
   checkABI()
   put the empty data into tData
   unsafe
      put _scene_render(pScene, pW, pH) into tLen
      if tLen > 0 then
         put _scene_frame(pScene) into tPtr
         put MCDataCreateWithBytes(tPtr, tLen, tData) into tOk
      end if
   end unsafe
   return tData
end handler

/**
Summary: Begins drawing a scene and returns at once.

pScene: A scene handle from <r3SceneCreate>.

pW: The picture's width in pixels, 1 to 4096.

pH: The picture's height in pixels, 1 to 4096.

Returns: The picture's byte count, pW times pH times 4, or 0 if the call was
refused.

Example:
-- one frame of a game: show the picture begun last time, begin the next
on gameFrame
   set the imageData of image "View" to r3SceneFrame(sScene)
   get r3SceneApplyMoves(sScene, b3MovesText())
   get r3SceneRenderBegin(sScene, 640, 480)
   b3WorldStep sWorld, 1/60, 4
   get b3WorldUpdateMoves(sWorld)
   send "gameFrame" to me in 16 milliseconds
end gameFrame

Description: The engine runs script on one thread, so a picture drawn by
<r3SceneRender> is time in which nothing else happens. This call reads the
scene as it is now, leaves the drawing to the library's own threads, and comes
back at once: the physics step, the engine's own redraw and the wait for the
next frame all go on beside it. <r3SceneFrame> hands the picture over, waiting for
it if it is not finished, and <r3SceneIsRenderReady> asks without waiting.

What the script changes after this call belongs to the next picture. Any call
that names a scene, node, mesh, material, texture or light waits for the
picture first, so nothing can go wrong by calling one early: it only gives
the time back. One picture is drawn at a time. No message is sent when it is
finished. On the web, where there are no threads, the picture is drawn before
this returns.
*/
public handler r3SceneRenderBegin(in pScene as Integer, in pW as Integer, in pH as Integer) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _scene_render_begin(pScene, pW, pH) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns whether a picture begun with r3SceneRenderBegin is finished.

pScene: A scene handle from <r3SceneCreate>.

Returns: False while a picture of the scene is still being drawn; true when it
is finished, and when none was begun.

Description: It never waits. Use it to do something else while a large picture
is drawn; a frame loop that calls <r3SceneFrame> once a frame does not need it.
*/
public handler r3SceneIsRenderReady(in pScene as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _scene_is_render_ready(pScene) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Returns the last picture drawn of a scene.

pScene: A scene handle from <r3SceneCreate>.

Returns: The picture as imageData, or empty if none was drawn.

Description: After <r3SceneRenderBegin> this is how the picture is taken: if
it is still being drawn, the call waits for it.
*/
public handler r3SceneFrame(in pScene as Integer) returns Data
   variable tPtr as Pointer
   variable tLen as Integer
   variable tData as Data
   variable tOk as CBool
   put the empty data into tData
   unsafe
      put _scene_frame_length(pScene) into tLen
      if tLen > 0 then
         put _scene_frame(pScene) into tPtr
         put MCDataCreateWithBytes(tPtr, tLen, tData) into tOk
      end if
   end unsafe
   return tData
end handler

/**
Summary: Returns the size of the last picture drawn of a scene.

pScene: A scene handle from <r3SceneCreate>.

Returns: The byte count, width times height times 4, or 0.
*/
public handler r3SceneFrameLength(in pScene as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _scene_frame_length(pScene) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how much work the last picture was.

pScene: A scene handle from <r3SceneCreate>.

Returns: Three numbers as text, "triangles,pixels,milliseconds": triangles
drawn, pixels written, and the time taken.

Description: For tuning a scene: show item 3 in a field while you change it.
*/
public handler r3SceneStats(in pScene as Integer) returns String
   variable tR as Pointer
   unsafe
      put _scene_stats(pScene) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Finds the node under a point of the picture.

pScene: A scene handle from <r3SceneCreate>.

pW: The picture's width in pixels, 1 to 4096.

pH: The picture's height in pixels, 1 to 4096.

pPx: The picture x, in pixels from the left edge; a pixel's centre is at +0.5.

pPy: The picture y, in pixels from the top edge; a pixel's centre is at +0.5.

Returns: The node handle, or 0 if nothing is there.

Example:
on mouseDown
   put r3ScenePick(sScene, the width of me, the height of me, the mouseH - the left of me, the mouseV - the top of me) into tNode
end mouseDown

Description: For clicking on things. <r3HitText> then says where it was hit.
*/
public handler r3ScenePick(in pScene as Integer, in pW as Integer, in pH as Integer, in pPx as Number, in pPy as Number) returns Integer
   variable tR as Integer
   unsafe
      put _scene_pick(pScene, pW, pH, pPx, pPy) into tR
   end unsafe
   return tR
end handler

/**
Summary: Finds the first node a ray meets.

pScene: A scene handle from <r3SceneCreate>.

pOx: The x of the ray's start.

pOy: The y of the ray's start.

pOz: The z of the ray's start.

pDx: The x of the ray's direction.

pDy: The y of the ray's direction.

pDz: The z of the ray's direction.

Returns: The node handle, or 0.

Description: <r3HitText> then says where.
*/
public handler r3SceneRayCast(in pScene as Integer, in pOx as Number, in pOy as Number, in pOz as Number, in pDx as Number, in pDy as Number, in pDz as Number) returns Integer
   variable tR as Integer
   unsafe
      put _scene_ray_cast(pScene, pOx, pOy, pOz, pDx, pDy, pDz) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns where the last pick or ray cast hit.

Returns: Five numbers as text, "x,y,z,distance,triangle", or empty if it hit
nothing.
*/
public handler r3HitText() returns String
   variable tR as Pointer
   unsafe
      put _hit_text() into tR
   end unsafe
   return textOf(tR)
end handler

end library
