Description: Use it to place a camera so a loaded model fits the picture.
*/
public handler r3MeshBounds(in pMesh as Integer) returns String
   variable tR as Pointer
   unsafe
      put _mesh_bounds(pMesh) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Makes an empty mesh to fill from script.

Returns: A mesh handle.

Example:
put r3MeshCreate() into tMesh
get r3MeshAddVertex(tMesh, -1, 0, 0, 0, 0, 1, 0, 1)
get r3MeshAddVertex(tMesh, 1, 0, 0, 0, 0, 1, 1, 1)
get r3MeshAddVertex(tMesh, 0, 2, 0, 0, 0, 1, 0.5, 0)
get r3MeshAddTriangle(tMesh, 1, 2, 3, 1)

Description: Add corners with <r3MeshAddVertex> and faces with
<r3MeshAddTriangle>.
*/
public handler r3MeshCreate() returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_create() into tR
   end unsafe
   return tR
end handler

/**
Summary: Adds a corner to a mesh.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

pX: The x coordinate, in metres.

pY: The y coordinate, in metres (y is up).

pZ: The z coordinate, in metres.

pNx: The normal's x.

pNy: The normal's y.

pNz: The normal's z.

pU: The texture coordinate across, 0 at the left edge of the texture.

pV: The texture coordinate down, 0 at the top edge of the texture.

Returns: The new vertex's number, counted from 1, or 0 if refused.

Description: The normal is the direction the surface faces at this corner,
used for lighting; <r3MeshComputeNormals> can work them out. Texture
coordinate 0,0 is the top-left corner of the texture and 1,1 the bottom-right.
*/
public handler r3MeshAddVertex(in pMesh as Integer, in pX as Number, in pY as Number, in pZ as Number, in pNx as Number, in pNy as Number, in pNz as Number, in pU as Number, in pV as Number) returns Integer
   variable tR as Integer
   unsafe
      put _mesh_add_vertex(pMesh, pX, pY, pZ, pNx, pNy, pNz, pU, pV) into tR
   end unsafe
   return tR
end handler

/**
Summary: Adds a triangle to a mesh.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

pA: The first corner, a vertex number from <r3MeshAddVertex>.

pB: The second corner.

pC: The third corner.

pSlot: The material slot the triangle uses, 1 to 1024.

Returns: The mesh's triangle count, or 0 if refused.

Description: Name the corners counter-clockwise as seen from the side that
should be visible.
*/
public handler r3MeshAddTriangle(in pMesh as Integer, in pA as Integer, in pB as Integer, in pC as Integer, in pSlot as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _mesh_add_triangle(pMesh, pA, pB, pC, pSlot) into tR
   end unsafe
   return tR
end handler

/**
Summary: Works out smooth normals for a mesh from its triangles.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

Description: Each corner gets the average direction of the triangles that
share it. Call it after the last <r3MeshAddTriangle>.
*/
public handler r3MeshComputeNormals(in pMesh as Integer) returns nothing
   unsafe
      _mesh_compute_normals(pMesh)
   end unsafe
end handler

/**
Summary: Returns how many material slots a mesh has.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

Returns: The count; 1 for a simple mesh.

Description: A model file with several materials has one slot for each, in the
order of its material file.
*/
public handler r3MeshSlotCount(in pMesh as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _mesh_slot_count(pMesh) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the material of one slot of a mesh.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

pSlot: The material slot, counted from 1.

Returns: The material handle, or 0 if the slot has none.

Description: A model's own materials can be changed through this handle, for
example to give one a texture.
*/
public handler r3MeshSlotMaterial(in pMesh as Integer, in pSlot as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _mesh_slot_material(pMesh, pSlot) into tR
   end unsafe
   return tR
end handler

/**
Summary: Gives one slot of a mesh a material.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

pSlot: The material slot, counted from 1.

pMaterial: A material handle, or 0 for plain white.

Description: Every node that draws the mesh shows it, unless the node has a
material of its own.
*/
public handler r3MeshSetSlotMaterial(in pMesh as Integer, in pSlot as Integer, in pMaterial as Integer) returns nothing
   unsafe
      _mesh_set_slot_material(pMesh, pSlot, pMaterial)
   end unsafe
end handler

/**
Summary: Returns the name a model file gave a material slot.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

pSlot: The material slot, counted from 1.

Returns: The name, or empty.
*/
public handler r3MeshSlotName(in pMesh as Integer, in pSlot as Integer) returns String
   variable tR as Pointer
   unsafe
      put _mesh_slot_name(pMesh, pSlot) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Returns the picture file a model's material asked for.

pMesh: A mesh handle, from <r3MeshBox>, <r3MeshLoadObj> or another of the
r3Mesh makers.

pSlot: The material slot, counted from 1.

Returns: The file name as the material file wrote it, or empty.

Description: After <r3MeshParseObj>, which reads no files, this says which
picture to load for each slot.
*/
public handler r3MeshSlotTextureName(in pMesh as Integer, in pSlot as Integer) returns String
   variable tR as Pointer
   unsafe
      put _mesh_slot_texture_name(pMesh, pSlot) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Makes a box.

pHx: Half the width, in metres.

pHy: Half the height, in metres.

pHz: Half the depth, in metres.

Returns: A mesh handle, or 0 if a size was refused.

Example:
put r3MeshBox(0.5, 0.5, 0.5) into sCube

Description: Centred on its origin, like a box shape in box3dxt, so a node at
a body's transform covers the body. Each face shows the whole texture.
*/
public handler r3MeshBox(in pHx as Number, in pHy as Number, in pHz as Number) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_box(pHx, pHy, pHz) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a flat rectangle facing up.

pHx: Half the width, in metres.

pHz: Half the depth, in metres.

pURepeat: How many times the texture repeats across the width.

pVRepeat: How many times it repeats across the depth.

Returns: A mesh handle, or 0 if an argument was refused.

Example:
put r3MeshPlane(20, 20, 10, 10) into sFloor

Description: A floor. The texture repeats across it as many times as asked.
*/
public handler r3MeshPlane(in pHx as Number, in pHz as Number, in pURepeat as Number, in pVRepeat as Number) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_plane(pHx, pHz, pURepeat, pVRepeat) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a sphere.

pRadius: The radius, in metres.

pSlices: How many segments go round the y axis, 3 to 256.

pStacks: How many segments go from pole to pole, 2 to 256.

Returns: A mesh handle, or 0 if an argument was refused.

Example:
put r3MeshSphere(0.5, 24, 12) into sBall

Description: More slices and stacks make it rounder and slower to draw; 24 and
12 look round at most sizes.
*/
public handler r3MeshSphere(in pRadius as Number, in pSlices as Integer, in pStacks as Integer) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_sphere(pRadius, pSlices, pStacks) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a cylinder standing along the y axis.

pRadius: The radius, in metres.

pHalfHeight: Half the height, in metres.

pSlices: How many segments go round the y axis, 3 to 256.

Returns: A mesh handle, or 0 if an argument was refused.

Description: Closed at both ends.
*/
public handler r3MeshCylinder(in pRadius as Number, in pHalfHeight as Number, in pSlices as Integer) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_cylinder(pRadius, pHalfHeight, pSlices) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a capsule standing along the y axis.

pRadius: The radius, in metres.

pHalfHeight: Half the distance between the centres of the two end spheres, in
metres.

pSlices: How many segments go round the y axis, 3 to 256.

pStacks: How many segments each end has from its pole to its rim, 2 to 256.

Returns: A mesh handle, or 0 if an argument was refused.

Description: A cylinder with a half sphere on each end: box3dxt's capsule with
its two centres at plus and minus pHalfHeight on the y axis.
*/
public handler r3MeshCapsule(in pRadius as Number, in pHalfHeight as Number, in pSlices as Integer, in pStacks as Integer) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_capsule(pRadius, pHalfHeight, pSlices, pStacks) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a mesh from a list of triangles as text.

pText: One line per triangle, nine numbers: "x1,y1,z1,x2,y2,z2,x3,y3,z3",
counter-clockwise seen from outside.

Returns: A mesh handle, or 0 if a line was refused.

Description: The text box3dxt gives for a shape, so that what is drawn is
exactly what is simulated. Lighting is flat, and a texture repeats once a
metre.
*/
public handler r3MeshFromTrianglesText(in pText as String) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_from_triangles_text(pText) into tR
   end unsafe
   return tR
end handler

/**
Summary: Loads a model from a Wavefront OBJ file.

pPath: The file's full path.

Returns: A mesh handle, or 0 if the file could not be read.

Example:
put r3MeshLoadObj(specialFolderPath("resources") & "/teapot.obj") into sTeapot
put r3NodeCreate(sScene, sTeapot) into sTeapotNode

Description: The material file the model names (MTL) is read too, and the
pictures it names are loaded as textures, so a textured model arrives ready to
draw. Faces of any number of corners are accepted. Check <r3LastError> if it
returns 0.
*/
public handler r3MeshLoadObj(in pPath as String) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_load_obj(pPath) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a model from the text of an OBJ file.

pObjText: The contents of the OBJ file.

pMtlText: The contents of its material file, or empty.

Returns: A mesh handle, or 0 if the text is not a model.

Description: Nothing is read from disk, so this works where there are no
files, such as the web. Textures are not loaded: ask <r3MeshSlotTextureName>
which picture each slot wants and set it with <r3MeshSlotMaterial> and
<r3MaterialSetTexture>.
*/
public handler r3MeshParseObj(in pObjText as String, in pMtlText as String) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _mesh_parse_obj(pObjText, pMtlText) into tR
   end unsafe
   return tR
end handler

/**
Summary: Adds a light that shines from far away, like the sun.

pScene: A scene handle from <r3SceneCreate>.

pDx: The x of the direction the light travels.

pDy: The y of the direction the light travels (negative is downward).

pDz: The z of the direction the light travels.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.

pIntensity: The brightness, 0 to 100; 1 is full.

Returns: A light handle, or 0 if refused.

Example:
put r3LightCreateDirectional(sScene, -1, -2, -1, 255, 244, 230, 1) into sSun

Description: Every surface is lit from the same direction. A scene holds at
most 8 lights, and starts with one of these.
*/
public handler r3LightCreateDirectional(in pScene as Integer, in pDx as Number, in pDy as Number, in pDz as Number, in pR as Number, in pG as Number, in pB as Number, in pIntensity as Number) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _light_create_directional(pScene, pDx, pDy, pDz, pR, pG, pB, pIntensity) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a scene.

Returns: A scene handle.

Example:
put r3SceneCreate() into sScene

Description: A scene holds nodes (the things drawn), lights and a camera, and
draws itself with <r3SceneRender>. It starts with a dim ambient light, one
directional light and a camera at 0,2,8 looking at the origin. Free it with
<r3SceneDestroy>.
*/
public handler r3SceneCreate() returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _scene_create() into tR
   end unsafe
   return tR
end handler

/**
Summary: Frees a scene with its nodes and lights.

pScene: A scene handle from <r3SceneCreate>.

Description: Meshes, materials and textures are not the scene's and stay.
*/
public handler r3SceneDestroy(in pScene as Integer) returns nothing
   unsafe
      _scene_destroy(pScene)
   end unsafe
end handler

/**
Summary: Reports whether a scene handle is alive.

pScene: A scene handle from <r3SceneCreate>.

Returns: True if it is.
*/
public handler r3SceneIsValid(in pScene as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _scene_is_valid(pScene) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Sets the colour drawn where nothing is.

pScene: A scene handle from <r3SceneCreate>.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.
*/
public handler r3SceneSetBackground(in pScene as Integer, in pR as Number, in pG as Number, in pB as Number) returns nothing
   unsafe
      _scene_set_background(pScene, pR, pG, pB)
   end unsafe
end handler

/**
Summary: Returns the background colour.

pScene: A scene handle from <r3SceneCreate>.

Returns: Three numbers as text, "r,g,b".
*/
public handler r3SceneBackground(in pScene as Integer) returns String
   variable tR as Pointer
   unsafe
      put _scene_background(pScene) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Sets the light that reaches every surface from everywhere.

pScene: A scene handle from <r3SceneCreate>.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.

Description: It keeps the sides that face away from every light from going
black. The default is 64,64,64.
*/
public handler r3SceneSetAmbient(in pScene as Integer, in pR as Number, in pG as Number, in pB as Number) returns nothing
   unsafe
      _scene_set_ambient(pScene, pR, pG, pB)
   end unsafe
end handler

/**
Summary: Returns the ambient light.

pScene: A scene handle from <r3SceneCreate>.

Returns: Three numbers as text, "r,g,b".
*/
public handler r3SceneAmbient(in pScene as Integer) returns String
   variable tR as Pointer
   unsafe
      put _scene_ambient(pScene) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Fades distant things into a colour.

pScene: A scene handle from <r3SceneCreate>.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.

pFogNear: The distance in metres where fog starts.

pFogFar: The distance where everything is fog, or 0 for no fog.

Example:
r3SceneSetFog sScene, 31, 33, 41, 10, 40

Description: Usually the background colour, so the far edge of a floor melts
away. A pFogFar of 0 turns fog off.
*/
public handler r3SceneSetFog(in pScene as Integer, in pR as Number, in pG as Number, in pB as Number, in pFogNear as Number, in pFogFar as Number) returns nothing
   unsafe
      _scene_set_fog(pScene, pR, pG, pB, pFogNear, pFogFar)
   end unsafe
end handler

/**
Summary: Sets how smooth edges are drawn.

pScene: A scene handle from <r3SceneCreate>.

pN: 1 to 4.

Description: Each pixel becomes the average of pN by pN samples. 1 is fastest
and has jagged edges; 2 is a good balance; 4 is smoothest and sixteen times
the work.
*/
public handler r3SceneSetSupersample(in pScene as Integer, in pN as Integer) returns nothing
   unsafe
      _scene_set_supersample(pScene, pN)
   end unsafe
end handler

/**
Summary: Returns the supersampling of a scene.

pScene: A scene handle from <r3SceneCreate>.

Returns: 1 to 4.
*/
public handler r3SceneSupersample(in pScene as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _scene_supersample(pScene) into tR
   end unsafe
   return tR
end handler

/**
Summary: Places the camera.

pScene: A scene handle from <r3SceneCreate>.

pEx: The eye's x, in metres.

pEy: The eye's y.

pEz: The eye's z.

pTx: The x of the point looked at.

pTy: Its y.

pTz: Its z.

pFov: The vertical field of view in degrees, 5 to 150.

Example:
r3SceneSetCamera sScene, 0, 3, 10, 0, 1, 0, 50

Description: The same camera box3dxt's renderer has, so one set of numbers
serves both. Up is the world's y axis; looking straight down, the top of the
picture is the world's -z.
*/
public handler r3SceneSetCamera(in pScene as Integer, in pEx as Number, in pEy as Number, in pEz as Number, in pTx as Number, in pTy as Number, in pTz as Number, in pFov as Number) returns nothing
   unsafe
      _scene_set_camera(pScene, pEx, pEy, pEz, pTx, pTy, pTz, pFov)
   end unsafe
end handler

/**
Summary: Places the camera from one text.

pScene: A scene handle from <r3SceneCreate>.

pText: Seven numbers, "eyeX,eyeY,eyeZ,targetX,targetY,targetZ,fov".

Description: Takes what <r3SceneCamera> returns, or box3dxt's
b3RenderCamera().
*/
public handler r3SceneSetCameraText(in pScene as Integer, in pText as String) returns nothing
   unsafe
      _scene_set_camera_text(pScene, pText)
   end unsafe
end handler

/**
Summary: Returns the camera.

pScene: A scene handle from <r3SceneCreate>.

Returns: Seven numbers as text, "eyeX,eyeY,eyeZ,targetX,targetY,targetZ,fov".
*/
public handler r3SceneCamera(in pScene as Integer) returns String
   variable tR as Pointer
   unsafe
      put _scene_camera(pScene) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Sets the nearest and farthest distances drawn.

pScene: A scene handle from <r3SceneCreate>.

pNearZ: The near distance in metres, at least 0.001.

pFarZ: The far distance in metres, or 0 for none.

Description: Nothing nearer than the near distance is drawn (the default is
0.05). A far distance of 0, the default, draws everything.
*/
public handler r3SceneSetClip(in pScene as Integer, in pNearZ as Number, in pFarZ as Number) returns nothing
   unsafe
      _scene_set_clip(pScene, pNearZ, pFarZ)
   end unsafe
end handler

/**
Summary: Returns the nearest and farthest distances drawn.

pScene: A scene handle from <r3SceneCreate>.

Returns: Two numbers as text, "near,far".
*/
public handler r3SceneClip(in pScene as Integer) returns String
   variable tR as Pointer
   unsafe
      put _scene_clip(pScene) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Finds where a point in the world lands in the picture.

pScene: A scene handle from <r3SceneCreate>.

pW: The picture's width in pixels, 1 to 4096.

pH: The picture's height in pixels, 1 to 4096.

pX: The x coordinate, in metres.

pY: The y coordinate, in metres (y is up).

pZ: The z coordinate, in metres.

Returns: Three numbers as text, "px,py,depth", or empty if the point is behind
the camera. Depth is metres in front of the camera.

Example:
put r3SceneProject(sScene, 640, 480, 0, 1, 0) into tSpot
set the loc of field "Label" to (the left of image "View" + item 1 of tSpot), (the top of image "View" + item 2 of tSpot)

Description: For placing a label or a control over something in the scene.
*/
public handler r3SceneProject(in pScene as Integer, in pW as Integer, in pH as Integer, in pX as Number, in pY as Number, in pZ as Number) returns String
   variable tR as Pointer
   unsafe
      put _scene_project(pScene, pW, pH, pX, pY, pZ) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Returns the ray from the camera through a point of the picture.

pScene: A scene handle from <r3SceneCreate>.

pW: The picture's width in pixels, 1 to 4096.

pH: The picture's height in pixels, 1 to 4096.

pPx: The picture x, in pixels from the left edge; a pixel's centre is at +0.5.

pPy: The picture y, in pixels from the top edge; a pixel's centre is at +0.5.

Returns: Six numbers as text, "originX,originY,originZ,dirX,dirY,dirZ"; the
direction has length 1.

Description: The same ray box3dxt's b3RenderRay gives, for casting into a
physics world from a mouse click.
*/
public handler r3SceneRay(in pScene as Integer, in pW as Integer, in pH as Integer, in pPx as Number, in pPy as Number) returns String
   variable tR as Pointer
   unsafe
      put _scene_ray(pScene, pW, pH, pPx, pPy) into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Adds a light that shines from a point, like a lamp.

pScene: A scene handle from <r3SceneCreate>.

pX: The x coordinate, in metres.

pY: The y coordinate, in metres (y is up).

pZ: The z coordinate, in metres.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.

pIntensity: The brightness, 0 to 100; 1 is full.

pRange: The distance in metres where its light ends, or 0 for no end.

Returns: A light handle, or 0 if refused.

