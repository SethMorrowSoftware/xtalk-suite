-- =====================================================================
-- Helpers
-- =====================================================================

private handler asInt(in pFlag as Boolean) returns Integer
   if pFlag then
      return 1
   end if
   return 0
end handler

-- The binding and the native library must come from the same release: a
-- changed export list read through an old binding is a marshalling fault in
-- the host, not an error message. Asked once, by the calls that make things
-- (nothing can be drawn before something is made).
variable sABIChecked as Boolean

private handler checkABI()
   variable tV as Integer
   if sABIChecked is true then
      return
   end if
   unsafe
      put _abi_version() into tV
   end unsafe
   if tV is not 1 then
      throw "render3dxt: incompatible native library (this binding needs ABI 1) - update the render3dxt library beside the engine"
   end if
   put true into sABIChecked
end handler

-- A text result of the shim, copied into a String. The shim hands back a
-- pointer to a buffer IT owns, so the foreign handlers return Pointer and
-- never ZStringNative (box3dxt's rule 3). 4 is the engine's
-- MCStringEncoding value for UTF-8.
private handler textOf(in pText as Pointer) returns String
   variable tLength as Integer
   variable tResult as String
   variable tOk as CBool
   unsafe
      put _text_length(pText) into tLength
      put MCStringCreateWithBytes(pText, tLength, 4, false, tResult) into tOk
   end unsafe
   if not tOk then
      return ""
   end if
   return tResult
end handler

-- =====================================================================
-- The public handlers, in the shim's order
-- =====================================================================

/**
Summary: Returns the ABI number of the native library that is loaded.

Returns: The ABI number; this binding needs 1.
*/
public handler r3ABIVersion() returns Integer
   variable tR as Integer
   unsafe
      put _abi_version() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the version of the native library and of the file readers built into it.

Returns: A text such as "render3dxt 0.1.0 ABI 1; stb_image 2.34; fast_obj
1.3".

Example:
put r3LibraryVersion()

Description: The first call that reaches the native library. It throws if the
library beside the engine is from another release than this binding.
*/
public handler r3LibraryVersion() returns String
   variable tR as Pointer
   checkABI()
   unsafe
      put _library_version() into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Returns why the last call was refused.

Returns: A short text, or empty if the last call was not refused.

Description: A refused call returns 0 or empty and never throws, so a frame
loop cannot be stopped by a bad number. Ask this straight after the call you
are unsure of.
*/
public handler r3LastError() returns String
   variable tR as Pointer
   unsafe
      put _last_error() into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Returns how many objects of each kind are alive.

Returns: Six numbers as text, "scenes,nodes,meshes,materials,textures,lights".

Description: For finding a leak: the counts should return to where they were
once a stack has destroyed what it made.
*/
public handler r3LiveCounts() returns String
   variable tR as Pointer
   unsafe
      put _live_counts() into tR
   end unsafe
   return textOf(tR)
end handler

/**
Summary: Loads a picture file as a texture.

pPath: The file's full path.

Returns: A texture handle, or 0 if the file could not be read.

Example:
put r3TextureLoad(specialFolderPath("resources") & "/crate.png") into sCrate

Description: PNG, JPEG, BMP and TGA files are read, up to 8192 pixels each
way. A PNG's transparency is kept, for <r3MaterialSetCutout>. Free it with
<r3TextureDestroy>.
*/
public handler r3TextureLoad(in pPath as String) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _texture_load(pPath) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a texture from the bytes of a picture file.

pBytes: The whole contents of a PNG, JPEG, BMP or TGA file.

Returns: A texture handle, or 0 if the bytes are not a picture.

Example:
put r3TextureDecode(url ("binfile:" & tPath)) into sCrate

Description: For a picture that is not a file on disk: one kept in a custom
property, or fetched from a URL. The same formats as <r3TextureLoad>.
*/
public handler r3TextureDecode(in pBytes as Data) returns Integer
   variable tR as Integer
   variable tPtr as Pointer
   variable tLen as Integer
   checkABI()
   unsafe
      put MCDataGetBytePtr(pBytes) into tPtr
      put MCDataGetLength(pBytes) into tLen
      put _texture_decode(tPtr, tLen) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a texture from the imageData of an image.

pBytes: The imageData: four bytes a pixel.

pWidth: The image's width in pixels.

pHeight: The image's height in pixels.

Returns: A texture handle, or 0 if the data is too short.

Example:
put r3TextureFromImageData(the imageData of image "Crate", the width of image "Crate", the height of image "Crate") into sCrate

Description: Any image the engine can show can be a texture this way. The
texture is opaque: imageData carries no transparency.
*/
public handler r3TextureFromImageData(in pBytes as Data, in pWidth as Integer, in pHeight as Integer) returns Integer
   variable tR as Integer
   variable tPtr as Pointer
   variable tLen as Integer
   checkABI()
   unsafe
      put MCDataGetBytePtr(pBytes) into tPtr
      put MCDataGetLength(pBytes) into tLen
      put _texture_from_image_data(tPtr, tLen, pWidth, pHeight) into tR
   end unsafe
   return tR
end handler

/**
Summary: Makes a checkerboard texture.

pSize: The texture's width and height in pixels, 2 to 2048.

pCells: How many squares across, 1 to pSize.

pR1: The first colour's red, 0 to 255.

pG1: The first colour's green, 0 to 255.

pB1: The first colour's blue, 0 to 255.

pR2: The second colour's red, 0 to 255.

pG2: The second colour's green, 0 to 255.

pB2: The second colour's blue, 0 to 255.

Returns: A texture handle, or 0 if an argument was refused.

Example:
put r3TextureChecker(256, 8, 240, 240, 240, 60, 90, 160) into sFloorTexture

Description: A texture for a scene that has no picture files: a floor, or a
way to see an object turn.
*/
public handler r3TextureChecker(in pSize as Integer, in pCells as Integer, in pR1 as Number, in pG1 as Number, in pB1 as Number, in pR2 as Number, in pG2 as Number, in pB2 as Number) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _texture_checker(pSize, pCells, pR1, pG1, pB1, pR2, pG2, pB2) into tR
   end unsafe
   return tR
end handler

/**
Summary: Frees a texture.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

Description: A material that used it draws untextured from then on.
*/
public handler r3TextureDestroy(in pTexture as Integer) returns nothing
   unsafe
      _texture_destroy(pTexture)
   end unsafe
end handler

/**
Summary: Reports whether a texture handle is alive.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

Returns: True if it is.
*/
public handler r3TextureIsValid(in pTexture as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _texture_is_valid(pTexture) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Returns the width of a texture.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

Returns: The width in pixels, or 0.
*/
public handler r3TextureWidth(in pTexture as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _texture_width(pTexture) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the height of a texture.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

Returns: The height in pixels, or 0.
*/
public handler r3TextureHeight(in pTexture as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _texture_height(pTexture) into tR
   end unsafe
   return tR
end handler

/**
Summary: Chooses smooth or blocky drawing of a texture.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

pFlag: True for smooth, false for blocky.

Description: Smooth (the default) blends neighbouring pixels of the texture;
off shows each as a sharp square, the look pixel art wants.
*/
public handler r3TextureSetSmooth(in pTexture as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _texture_set_smooth(pTexture, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether a texture is drawn smooth.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

Returns: True if it is.
*/
public handler r3TextureIsSmooth(in pTexture as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _texture_is_smooth(pTexture) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Chooses whether a texture repeats beyond its edges.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

pFlag: True to repeat, false to stop at the edge.

Description: Repeating (the default) tiles the texture where texture
coordinates leave 0 to 1; off stretches its edge pixels instead.
*/
public handler r3TextureSetRepeat(in pTexture as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _texture_set_repeat(pTexture, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether a texture repeats.

pTexture: A texture handle, from <r3TextureLoad> or another of the r3Texture
makers.

Returns: True if it does.
*/
public handler r3TextureIsRepeat(in pTexture as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _texture_is_repeat(pTexture) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Makes a material of a colour.

pR: Red, 0 to 255.

pG: Green, 0 to 255.

pB: Blue, 0 to 255.

Returns: A material handle, or 0 if a number was refused.

Example:
put r3MaterialCreate(200, 60, 40) into sBrick

Description: A material says how a surface looks: its colour, its texture, how
shiny it is. Give it to a node with <r3NodeSetMaterial> or to a slot of a mesh
with <r3MeshSetSlotMaterial>.
*/
public handler r3MaterialCreate(in pR as Number, in pG as Number, in pB as Number) returns Integer
   variable tR as Integer
