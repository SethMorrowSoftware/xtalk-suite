public handler r3LightCreatePoint(in pScene as Integer, in pX as Number, in pY as Number, in pZ as Number, in pR as Number, in pG as Number, in pB as Number, in pIntensity as Number, in pRange as Number) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _light_create_point(pScene, pX, pY, pZ, pR, pG, pB, pIntensity, pRange) into tR
   end unsafe
