-- ABI 6: onion-service support primitives. The ed25519 seed-to-expanded-key
-- helper (for a reproducible Tor v3 .onion address from a master seed) and
-- HMAC-SHA256 (for the Tor control-port SAFECOOKIE challenge-response).
foreign handler _sxt_sign_expandedkeybytes() returns CInt binds to "c:sodiumxt>sxt_sign_expandedkeybytes"
foreign handler _sxt_sign_seed_to_expanded_key(in pOut as Pointer, in pCap as CInt, in pSeed as Pointer, in pSeedLen as CInt) returns CInt binds to "c:sodiumxt>sxt_sign_seed_to_expanded_key"
