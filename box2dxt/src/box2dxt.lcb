/**
Summary: Return how far along the cast a query row's hit was.

pIndex: The 1-based row index, from 1 to <b2QueryCount>.

Returns: A fraction from 0 to 1, or 0 when the index is out of range.

Example:
put b2QueryFraction(1) into tValue

Description:
Reads the rows of the last world query. Filled only by <b2RayCastAll>
and <b2ShapeCast>.

References: b2QueryCount (handler), b2RayCastAll (handler),
b2OverlapAABB (handler)
*/
public handler b2QueryFraction(in pIndex as Integer) returns Number
   variable tR as Number
   unsafe
      put _query_fraction(pIndex - 1) into tR
   end unsafe
   return tR
end handler

end library
