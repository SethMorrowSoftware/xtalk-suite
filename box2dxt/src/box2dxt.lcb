The same number <b2BodiesUpdate> returned.

References: b2BodiesUpdate (handler)
*/
public handler b2BodyMoveCount() returns Integer
   variable tR as Integer
   unsafe
      put _body_move_count() into tR
   end unsafe
   return tR
end handler

