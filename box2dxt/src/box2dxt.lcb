A default mask reads 2^64-1 (collide with everything). A stale or 0
handle returns 0.

References: b2SetShapeFilter (handler)
*/
public handler b2ShapeFilterMask(in pShape as Integer) returns Number
   variable tR as Number
   unsafe
      put _shape_filter_mask(pShape) into tR
   end unsafe
