*/
public handler b2ShapeSensorOverlapAt(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _shape_sensor_overlap_at(pIndex - 1) into tR
   end unsafe
   return tR
end handler

-- ---- chains ----
/**
Summary: Start a new point list for a chain.

Example:
b2ChainBegin
repeat with i = 0 to 20
   b2ChainAddPoint i, sin(i / 3)
end repeat
put b2CreateChain(tGround, false, 0.7, 0) into tTerrain

Description:
Clear the chain builder, add the points with <b2ChainAddPoint>, then
create the chain with <b2CreateChain>. The points stay until the next
<b2ChainBegin>.

References: b2ChainAddPoint (handler), b2CreateChain (handler)
*/
public handler b2ChainBegin()
   unsafe
      _chain_begin()
   end unsafe
end handler

/**
Summary: Add one point to the chain builder.

pX: The x of the point in the body's local frame, in metres.

pY: The y of the point in the body's local frame, in metres.

Example:
b2ChainAddPoint 3, 0.5

Description:
The builder holds up to 4096 points; extra points are ignored.

References: b2ChainBegin (handler), b2CreateChain (handler)
*/
public handler b2ChainAddPoint(in pX as Number, in pY as Number)
   unsafe
      _chain_add_point(pX, pY)
   end unsafe
end handler

/**
Summary: Create a chain of smooth, one-sided segments on a body.

pBody: The body handle, usually a static body.

pLoop: true to close the chain into a loop.

pFriction: The friction of every segment.

pRestitution: The restitution of every segment.

Returns: A chain handle, or 0 when the body is stale or fewer than 4
points were added.

Example:
b2ChainBegin
repeat with i = 0 to 20
   b2ChainAddPoint i, sin(i / 3)
end repeat
put b2CreateChain(tGround, false, 0.7, 0) into tTerrain

Description:
Chains are the primitive for terrain and one-sided platforms: bodies
slide across the joins without catching. A chain needs at least 4
points. In an open chain the first and last points are ghost vertices
that only shape the ends, so n points give n-3 collidable segments.

Of the pending shape-def options only the collision filter
(<b2ShapeDefFilter>) applies; all are cleared. Sensor events are on for
the segments, so sensors detect terrain.

References: b2ChainBegin (handler), b2DestroyChain (handler),
b2ChainSegmentCount (handler)
*/
public handler b2CreateChain(in pBody as Integer, in pLoop as Boolean, in pFriction as Number, in pRestitution as Number) returns Integer
   variable tR as Integer
   unsafe
      put _chain_create(pBody, bi(pLoop), pFriction, pRestitution) into tR
   end unsafe
   return tR
end handler

/**
Summary: Destroy a chain and its segments.

pChain: The chain handle.

Example:
b2DestroyChain tTerrain
put 0 into tTerrain

Description:
The segment shape handles become stale too. A stale or 0 handle is a
harmless no-op.

References: b2CreateChain (handler), b2ChainIsValid (handler)
*/
public handler b2DestroyChain(in pChain as Integer)
   unsafe
      _chain_destroy(pChain)
   end unsafe
end handler

/**
Summary: Report whether a chain handle is live.

pChain: The chain handle.

Returns: true if the chain exists.

Example:
if b2ChainIsValid(tTerrain) then b2DestroyChain tTerrain

Description:
false for a destroyed, stale or 0 handle.

References: b2DestroyChain (handler)
*/
public handler b2ChainIsValid(in pChain as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _chain_is_valid(pChain) into tR
   end unsafe
   return tR is 1
end handler

/**
Summary: Set the friction of every segment of a chain.

pChain: The chain handle.

pFriction: The friction coefficient.

Example:
b2SetChainFriction tTerrain, 0.2

Description:
A stale or 0 handle is a harmless no-op.

References: b2ChainFriction (handler)
*/
public handler b2SetChainFriction(in pChain as Integer, in pFriction as Number)
   unsafe
      _chain_set_friction(pChain, pFriction)
   end unsafe
end handler

/**
Summary: Return a chain's friction.

pChain: The chain handle.

Returns: The friction coefficient.

Example:
put b2ChainFriction(tTerrain) into tValue

Description:
A stale or 0 handle returns 0.

References: b2SetChainFriction (handler)
*/
public handler b2ChainFriction(in pChain as Integer) returns Number
   variable tR as Number
   unsafe
      put _chain_friction(pChain) into tR
   end unsafe
   return tR
end handler

/**
Summary: Set the restitution of every segment of a chain.

pChain: The chain handle.

pRestitution: The restitution (bounciness).

Example:
b2SetChainRestitution tTerrain, 0.3

Description:
A stale or 0 handle is a harmless no-op.

References: b2ChainRestitution (handler)
*/
public handler b2SetChainRestitution(in pChain as Integer, in pRestitution as Number)
   unsafe
      _chain_set_restitution(pChain, pRestitution)
   end unsafe
end handler

/**
Summary: Return a chain's restitution.

pChain: The chain handle.

Returns: The restitution.

Example:
put b2ChainRestitution(tTerrain) into tValue

Description:
A stale or 0 handle returns 0.

References: b2SetChainRestitution (handler)
*/
public handler b2ChainRestitution(in pChain as Integer) returns Number
   variable tR as Number
   unsafe
      put _chain_restitution(pChain) into tR
   end unsafe
   return tR
end handler

/**
Summary: Snapshot a chain's segment shapes and return how many there are.

pChain: The chain handle.

Returns: The number of segments; 0 for a stale chain.

Example:
repeat with i = 1 to b2ChainSegmentCount(tTerrain)
   put b2ChainSegmentAt(i) & cr after tSegments
end repeat

Description:
Read each one with <b2ChainSegmentAt>.

References: b2ChainSegmentAt (handler)
*/
public handler b2ChainSegmentCount(in pChain as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _chain_segment_count(pChain) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return one segment shape from the chain snapshot.

pIndex: The 1-based index, from 1 to the count <b2ChainSegmentCount>
returned.

Returns: A shape handle, or 0 when the index is out of range.

Example:
put b2ChainSegmentAt(1) into tSegment

Description:
Reads the snapshot taken by <b2ChainSegmentCount>.

References: b2ChainSegmentCount (handler)
*/
public handler b2ChainSegmentAt(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _chain_segment_at(pIndex - 1) into tR
   end unsafe
   return tR
end handler

