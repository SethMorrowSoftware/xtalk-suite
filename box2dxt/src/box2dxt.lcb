-- ---- native loader assist (Linux) ----------------------------------
-- The ONLY three bindings that do NOT target the box2dxt shim: they bind to
-- the platform's own loader/libc (dlopen/dlerror/realpath), resolved from the
-- host process's global symbol table. That is the whole point -- they must
-- be callable BEFORE box2dxt.so is loadable, so a script can preload the
-- shim by absolute path. On Linux the engine hands the bare name
-- "box2dxt.so" to dlopen and never searches the stack's folder; preloading
-- the exact file first puts it in the process, so the engine's later
-- bare-name load finds the already-resident copy (matched by soname --
-- build with -DBOX2DXT_BARE_SONAME=ON so that soname is "box2dxt.so").
-- Bindings resolve on first use, so these are harmless dead weight on
-- Windows/macOS as long as nothing calls them there (the engine already
-- finds the library next to the stack on those platforms).
-- If OXT cannot bind "c:>dlopen", swap the empty library token for your
-- libc: glibc >= 2.34 -> "c:libc.so.6>dlopen!cdecl"; older glibc or where
-- dlopen still lives in libdl -> "c:libdl.so.2>dlopen!cdecl".
private foreign handler _dlopen(in pPath as ZStringNative, in pFlags as CInt) returns optional Pointer binds to "c:>dlopen!cdecl"
private foreign handler _dlerror() returns optional ZStringNative binds to "c:>dlerror!cdecl"
-- realpath("/proc/self/exe", nil) -> the running engine's own executable path
-- on Linux; used by the b2LoadNativeLibHere helper below to locate the engine
-- folder. Returns nothing off Linux (no /proc). Only ever called on Linux.
private foreign handler _realpath(in pPath as ZStringNative, in pResolved as optional Pointer) returns optional ZStringNative binds to "c:>realpath!cdecl"

-- small bool -> int helper (no foreign call, so no unsafe needed)
private handler bi(in pB as Boolean) returns Integer
   if pB then
      return 1
   end if
   return 0
end handler

-- ---- engine-folder preload (Linux helper) --------------------------
-- Locate the running engine's OWN folder (realpath /proc/self/exe), strip to
-- its directory, and preload "<dir>/box2dxt.so" by absolute path -- so a user
-- can just drop the library beside the OXT engine (or bundle it in a
-- standalone) and a later bare-name bind resolves to it (no /usr/lib, no sudo,
-- no LD_LIBRARY_PATH). Returns 1 if a library was loaded, else 0.
--
-- LINUX ONLY, and deliberately NOT auto-fired: realpath/dlopen are POSIX, so
-- call this ONLY when the platform is Linux (e.g. the Kit gates it with
-- `the platform is "Linux"`). It is intentionally NOT invoked from
-- b2Version/checkABI -- those run on every platform, and touching the POSIX
-- bindings on Windows/macOS would error (those platforms already load the
-- library from beside the stack/app anyway). Requires the library's soname to
-- be "box2dxt.so" (-DBOX2DXT_BARE_SONAME) or the resident copy will not match
-- the engine's bare-name request.
/**
Summary: Preload box2dxt.so from the running engine's own folder (Linux only).

Returns: 1 if a library was loaded, else 0.

Example:
if the platform is "Linux" then
   get b2LoadNativeLibHere()
end if

Description:
Finds the engine's executable through /proc/self/exe and loads the file
box2dxt.so from that folder, so a later bare-name load of the library
finds the copy already in the process. Nothing calls it automatically.

It binds to the POSIX loader, so never call it on Windows or macOS. It
only helps for a library built with -DBOX2DXT_BARE_SONAME=ON (soname
box2dxt.so); the committed Linux libraries carry libbox2dxt.so and need
the Kit's revLibraryMapping route instead. The preload route has not
been confirmed on an engine.

References: b2LoadNativeLib (handler), b2LoadNativeLibError (handler)
*/
public handler b2LoadNativeLibHere() returns Integer
   variable tExe as optional String
   variable tPath as String
   variable tLen as Integer
   variable tCut as Integer
   variable tIdx as Integer
   variable tLib as String
   variable tHandle as optional Pointer
   unsafe
      put _realpath("/proc/self/exe", nothing) into tExe
   end unsafe
   if tExe is nothing then
      return 0
   end if
   put tExe into tPath
   put the number of chars in tPath into tLen
   put 0 into tCut
   repeat with tIdx from 1 up to tLen
      if char tIdx of tPath is "/" then
         put tIdx into tCut
      end if
   end repeat
   if tCut is 0 then
      return 0
   end if
   put char 1 to tCut of tPath into tLib
   put tLib & "box2dxt.so" into tLib
   unsafe
      put _dlopen(tLib, 258) into tHandle
   end unsafe
   if tHandle is nothing then
      return 0
   end if
   return 1
end handler

-- =====================================================================
-- Public API (callable from xTalk / OpenXTalk Script)
-- =====================================================================

/**
Summary: Return the native library's ABI version.

Returns: The shim's ABI version, currently 4.

Example:
if b2Version() is not 4 then answer "Wrong box2dxt library"

Description:
Call it once at startup as a load check: it proves the extension and the
native library are both present and in step. <b2NewWorld> and
<b2NewThreadedWorld> make the same check and throw "box2dxt:
incompatible native library (binding needs ABI 4)" when the loaded
library disagrees.

References: b2NewWorld (handler)
*/
public handler b2Version() returns Integer
   variable tR as Integer
   unsafe
      put _abi_version() into tR
   end unsafe
   return tR
end handler

-- This binding targets shim ABI 4. A mismatched libbox2dxt would otherwise
-- surface as an opaque crash on whichever call hits the skew first; checking
-- at world creation (the gateway every script goes through) turns it into a
-- clear, catchable error instead.
private handler checkABI()
   variable tV as Integer
   unsafe
      put _abi_version() into tV
   end unsafe
   if tV is not 4 then
      throw "box2dxt: incompatible native library (binding needs ABI 4) - update libbox2dxt / box2dxt.dll"
   end if
end handler

-- ---- native loader assist -------------------------------------------
-- Preload the native shim by ABSOLUTE path so the engine's later bare-name
-- load resolves to the already-resident copy. Lets a Linux script point at
-- box2dxt.so sitting next to the stack (no /usr/lib, no sudo, no
-- LD_LIBRARY_PATH). Returns 1 on success, 0 on failure (then call
-- b2LoadNativeLibError for the reason). The library MUST have been built
-- with a soname of "box2dxt.so" (see -DBOX2DXT_BARE_SONAME) or the match
-- fails silently. Flags 258 = RTLD_NOW (2) | RTLD_GLOBAL (256) on Linux:
-- resolve every symbol now and expose them globally so the bare-name
-- bindings bind to them. Intended for Linux; gate the call to Linux when
-- wiring it into the Kit (the dlopen binding will not resolve on Windows).
/**
Summary: Preload the native library by absolute path (Linux only).

pPath: The absolute path of the box2dxt.so file to load.

Returns: 1 on success, 0 on failure (see <b2LoadNativeLibError>).

Example:
if b2LoadNativeLib(tFolder & "/box2dxt.so") is 0 then
   answer b2LoadNativeLibError()
end if

Description:
Loads the file with dlopen (RTLD_NOW and RTLD_GLOBAL) so the engine's
later bare-name load finds the copy already in the process. The match is
by soname, so it only works for a library built with
-DBOX2DXT_BARE_SONAME=ON; the committed Linux libraries need the Kit's
revLibraryMapping route instead.

It binds to the POSIX loader: never call it on Windows or macOS. The
preload route has not been confirmed on an engine.

References: b2LoadNativeLibError (handler),
b2LoadNativeLibHere (handler)
*/
public handler b2LoadNativeLib(in pPath as String) returns Integer
   variable tHandle as optional Pointer
   unsafe
      put _dlopen(pPath, 258) into tHandle
   end unsafe
   if tHandle is nothing then
      return 0
   end if
   return 1
end handler

-- The last loader error string ("" if none) -- makes a failed
-- b2LoadNativeLib self-diagnosing (wrong path vs. could-not-load) instead
-- of a bare 0.
/**
Summary: Return the loader's last error message (Linux only).

Returns: The dlerror text, or empty if there is none.

Example:
put b2LoadNativeLibError() into tWhy

Description:
Tells you why <b2LoadNativeLib> returned 0: a wrong path, or a file that
could not be loaded. Linux only, like it.

References: b2LoadNativeLib (handler)
*/
public handler b2LoadNativeLibError() returns String
   variable tErr as optional String
   unsafe
      put _dlerror() into tErr
   end unsafe
   if tErr is nothing then
      return ""
   end if
   return tErr
end handler

-- ---- world ----------------------------------------------------------
/**
Summary: Create a single-threaded physics world.

pGravityX: The x component of gravity in m/s^2.

pGravityY: The y component of gravity in m/s^2; y points up, so -10
pulls down.

pAllowSleep: true to let resting bodies sleep, which saves time.

pContinuous: true to turn on continuous collision, which stops fast
bodies tunnelling through static ones.

Returns: A world handle, or 0 when gravity is not a finite number.

Example:
local tWorld
put b2NewWorld(0, -10, true, true) into tWorld

Description:
Everything else lives in a world: create one, add bodies, and advance it
with <b2Step>. Free it with <b2DestroyWorld>.

It first checks the native library's ABI and throws "box2dxt:
incompatible native library (binding needs ABI 4)" on a mismatch, so a
wrong library fails here with a clear error.

References: b2NewThreadedWorld (handler), b2Step (handler),
b2DestroyWorld (handler)
*/
public handler b2NewWorld(in pGravityX as Number, in pGravityY as Number, in pAllowSleep as Boolean, in pContinuous as Boolean) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _world_create(pGravityX, pGravityY, bi(pAllowSleep), bi(pContinuous)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Create a world whose step can use a pool of native worker threads.

pGravityX: The x component of gravity in m/s^2.

pGravityY: The y component of gravity in m/s^2; y points up.

pAllowSleep: true to let resting bodies sleep.

pContinuous: true to turn on continuous collision.

pWorkers: The number of Box2D worker threads to ask for.

Returns: A world handle, or 0 on failure.

Example:
put b2NewThreadedWorld(0, -10, true, true, 4) into tWorld
put b2WorldThreadCount(tWorld) into tThreads

Description:
Like <b2NewWorld>, but <b2Step> may spread its work over native threads.
Script stays single-threaded: the shim waits for the workers before
<b2Step> returns, and no callback ever reaches script. Where the
platform has no pool (Windows builds), the world runs serially;
<b2WorldThreadCount> says what you got. It makes the same ABI check as
<b2NewWorld>.

References: b2NewWorld (handler), b2WorldThreadCount (handler)
*/
public handler b2NewThreadedWorld(in pGravityX as Number, in pGravityY as Number, in pAllowSleep as Boolean, in pContinuous as Boolean, in pWorkers as Integer) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _world_create_threaded(pGravityX, pGravityY, bi(pAllowSleep), bi(pContinuous), pWorkers) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return how many native workers a world steps with.

pWorld: The world handle.

Returns: The active worker count; 1 means serial (or an unsupported
platform).

Example:
put b2WorldThreadCount(tWorld) into tThreads

Description:
Use it after <b2NewThreadedWorld> to see whether a pool was built. A
stale handle returns 1.

References: b2NewThreadedWorld (handler)
*/
public handler b2WorldThreadCount(in pWorld as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _world_thread_count(pWorld) into tR
   end unsafe
   return tR
end handler

/**
Summary: Destroy a world and everything in it.

pWorld: The world handle.

Example:
b2DestroyWorld tWorld
put 0 into tWorld

Description:
Every body, shape, joint and chain in the world goes with it, and their
handles become stale (harmless no-ops). A stale or 0 handle is a
harmless no-op.

References: b2NewWorld (handler)
*/
public handler b2DestroyWorld(in pWorld as Integer)
   unsafe
      _world_destroy(pWorld)
   end unsafe
end handler

/**
Summary: Change a world's gravity.

pWorld: The world handle.

pGx: The x component of gravity in m/s^2.

pGy: The y component of gravity in m/s^2.

Example:
b2SetGravity tWorld, 0, -10

Description:
Sleeping bodies do not wake on their own; wake them with <b2SetAwake> if
they should react at once. A non-finite value is ignored. A stale or 0
handle is a harmless no-op.

References: b2WorldGravityX (handler), b2WorldGravityY (handler)
*/
public handler b2SetGravity(in pWorld as Integer, in pGx as Number, in pGy as Number)
   unsafe
      _world_set_gravity(pWorld, pGx, pGy)
   end unsafe
end handler

/**
Summary: Turn sleeping on or off for a whole world.

pWorld: The world handle.

pFlag: true to let resting bodies sleep, false to keep every body awake.

Example:
b2EnableSleeping tWorld, false

Description:
A stale or 0 handle is a harmless no-op.

References: b2IsSleepingEnabled (handler), b2EnableSleep (handler)
*/
public handler b2EnableSleeping(in pWorld as Integer, in pFlag as Boolean)
   unsafe
      _world_enable_sleeping(pWorld, bi(pFlag))
   end unsafe
end handler

/**
Summary: Turn continuous collision on or off for a whole world.

pWorld: The world handle.

pFlag: true to stop fast bodies tunnelling through static geometry.

Example:
b2EnableContinuous tWorld, true

Description:
For a single fast dynamic body against other dynamic bodies, see
<b2SetBullet>. A stale or 0 handle is a harmless no-op.

References: b2IsContinuousEnabled (handler), b2SetBullet (handler)
*/
public handler b2EnableContinuous(in pWorld as Integer, in pFlag as Boolean)
   unsafe
      _world_enable_continuous(pWorld, bi(pFlag))
   end unsafe
end handler

-- pSubSteps is the Soft Step sub-step count (4 is a good default).
/**
Summary: Advance the simulation by one time step.

pWorld: The world handle.

pDt: The time step in seconds, for example 1/60.

pSubSteps: The solver sub-step count; 4 is a good default (clamped to 1
to 64).

Example:
b2Step tWorld, 1/60, 4

Description:
Drive it from a fixed time step: accumulate real elapsed time and step
in equal chunks. Variable steps make the solver jittery and
non-deterministic. A step of 0 or less is ignored.

After each step, read events with <b2ContactsUpdate>, <b2SensorsUpdate>
and <b2BodiesUpdate>.

References: b2ContactsUpdate (handler), b2BodiesUpdate (handler),
b2NewWorld (handler)
*/
public handler b2Step(in pWorld as Integer, in pDt as Number, in pSubSteps as Integer)
   unsafe
      _world_step(pWorld, pDt, pSubSteps)
   end unsafe
end handler

-- ---- bodies ----------------------------------------------------------
/**
Summary: Create a body with every option.

pWorld: The world handle.

pType: The body type: 0 static, 1 kinematic, 2 dynamic.

pX: The x position in metres.

pY: The y position in metres.

pAngle: The rotation in radians.

pBullet: true to treat it as a fast bullet (continuous collision against
dynamic bodies too).

pFixedRotation: true to stop the body rotating.

Returns: A body handle, or 0 when the world is stale, the type is not 0
to 2 or a number is not finite.

Example:
put b2NewBody(tWorld, 2, 0, 5, 0, false, false) into tBody

Description:
A body has no shape until you add one (<b2AddBox>, <b2AddCircle> and so
on); its mass comes from its shapes. Free it with <b2DestroyBody>.

References: b2NewDynamicBody (handler), b2AddBox (handler),
b2DestroyBody (handler)
*/
public handler b2NewBody(in pWorld as Integer, in pType as Integer, in pX as Number, in pY as Number, in pAngle as Number, in pBullet as Boolean, in pFixedRotation as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _body_create(pWorld, pType, pX, pY, pAngle, bi(pBullet), bi(pFixedRotation)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Create a static body at a position.

pWorld: The world handle.

pX: The x position in metres.

pY: The y position in metres.

Returns: A body handle, or 0 on failure.

Example:
put b2NewStaticBody(tWorld, 0, 5) into tBody
get b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0)

Description:
Shorthand for <b2NewBody> with type 0, angle 0 and no bullet or
fixed-rotation flag. A static body never moves; use it for ground and
walls.

References: b2NewBody (handler), b2AddBox (handler)
*/
public handler b2NewStaticBody(in pWorld as Integer, in pX as Number, in pY as Number) returns Integer
   return b2NewBody(pWorld, 0, pX, pY, 0, false, false)
end handler

/**
Summary: Create a kinematic body at a position.

pWorld: The world handle.

pX: The x position in metres.

pY: The y position in metres.

Returns: A body handle, or 0 on failure.

Example:
put b2NewKinematicBody(tWorld, 0, 5) into tBody
get b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0)

Description:
Shorthand for <b2NewBody> with type 1, angle 0 and no bullet or
fixed-rotation flag. A kinematic body moves only by the velocity you
give it and is not pushed by collisions.

References: b2NewBody (handler), b2AddBox (handler)
*/
public handler b2NewKinematicBody(in pWorld as Integer, in pX as Number, in pY as Number) returns Integer
   return b2NewBody(pWorld, 1, pX, pY, 0, false, false)
end handler

/**
Summary: Create a dynamic body at a position.

pWorld: The world handle.

pX: The x position in metres.

pY: The y position in metres.

Returns: A body handle, or 0 on failure.

Example:
put b2NewDynamicBody(tWorld, 0, 5) into tBody
get b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0)

Description:
Shorthand for <b2NewBody> with type 2, angle 0 and no bullet or
fixed-rotation flag. A dynamic body is moved by gravity, forces and
collisions.

References: b2NewBody (handler), b2AddBox (handler)
*/
public handler b2NewDynamicBody(in pWorld as Integer, in pX as Number, in pY as Number) returns Integer
   return b2NewBody(pWorld, 2, pX, pY, 0, false, false)
end handler

/**
Summary: Destroy a body, with its shapes and joints.

pBody: The body handle.

Example:
b2DestroyBody tBody
put 0 into tBody

Description:
The body's shapes and joints go too, and their handles become stale. A
stale or 0 handle is a harmless no-op.

References: b2NewBody (handler), b2DestroyShape (handler),
b2DestroyJoint (handler)
*/
public handler b2DestroyBody(in pBody as Integer)
   unsafe
      _body_destroy(pBody)
   end unsafe
end handler

/**
Summary: Return the x position of a body's origin.

pBody: The body handle.

Returns: The value in metres.

Example:
put b2BodyX(tBody) * 40 into tPixelX

Description:
Read it after <b2Step> to draw the body; multiply by your
pixels-per-metre scale (and flip y) at draw time. A stale or 0 handle
returns 0.

References: b2BodyY (handler), b2BodyAngle (handler),
b2BodiesUpdate (handler)
*/
public handler b2BodyX(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_x(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the y position of a body's origin.

pBody: The body handle.

Returns: The value in metres.

Example:
put -b2BodyY(tBody) * 40 into tPixelY

Description:
Read it after <b2Step>. The simulation's y points up while the screen's
points down, so flip it when drawing. A stale or 0 handle returns 0.

References: b2BodyX (handler), b2BodyAngle (handler)
*/
public handler b2BodyY(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_y(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return a body's rotation.

pBody: The body handle.

Returns: The value in radians.

Example:
put b2BodyAngle(tBody) * 180 / pi into tDegrees

Description:
Convert to degrees for drawing. The simulation's angle is
counter-clockwise with y up. A stale or 0 handle returns 0.

References: b2BodyX (handler), b2SetTransform (handler)
*/
public handler b2BodyAngle(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_angle(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the x component of a body's linear velocity.

pBody: The body handle.

Returns: The value in m/s.

Example:
put b2BodyVX(tBody) into tValue

Description:
A stale or 0 handle returns 0.

References: b2BodyVY (handler), b2SetVelocity (handler)
*/
public handler b2BodyVX(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_vx(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the y component of a body's linear velocity.

pBody: The body handle.

Returns: The value in m/s.

Example:
put b2BodyVY(tBody) into tValue

Description:
A stale or 0 handle returns 0.

References: b2BodyVX (handler), b2SetVelocity (handler)
*/
public handler b2BodyVY(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_vy(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return a body's angular velocity.

pBody: The body handle.

Returns: The value in radians per second.

Example:
put b2BodyAngularVelocity(tBody) into tValue

Description:
A stale or 0 handle returns 0.

References: b2SetAngularVelocity (handler)
*/
public handler b2BodyAngularVelocity(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_omega(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return a body's mass.

pBody: The body handle.

Returns: The value in kilograms.

Example:
put b2BodyMass(tBody) into tValue

Description:
The mass comes from the body's shapes and their density, unless set with
<b2SetMassData>. A static body reads 0. A stale or 0 handle returns 0.

References: b2BodyMassDataUpdate (handler), b2SetMassData (handler)
*/
public handler b2BodyMass(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_mass(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Report whether a body is awake.

pBody: The body handle.

Returns: true if the body is awake, false if it sleeps.

Example:
if not b2BodyIsAwake(tBody) then put "resting" into tState

Description:
A sleeping body costs nothing to simulate and wakes when touched. A
stale or 0 handle returns false.

References: b2SetAwake (handler), b2AwakeBodyCount (handler)
*/
public handler b2BodyIsAwake(in pBody as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _body_is_awake(pBody) into tR
   end unsafe
   return tR is 1
end handler

/**
Summary: Return the x position of a body's centre of mass in world coordinates.

pBody: The body handle.

Returns: The value in metres.

Example:
put b2BodyWorldCenterX(tBody) into tValue

Description:
Differs from <b2BodyX> when the shapes sit off the body's origin. A
stale or 0 handle returns 0.

References: b2BodyWorldCenterY (handler), b2BodyLocalCenterX (handler)
*/
public handler b2BodyWorldCenterX(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_world_center_x(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the y position of a body's centre of mass in world coordinates.

pBody: The body handle.

Returns: The value in metres.

Example:
put b2BodyWorldCenterY(tBody) into tValue

Description:
Differs from <b2BodyY> when the shapes sit off the body's origin. A
stale or 0 handle returns 0.

References: b2BodyWorldCenterX (handler), b2BodyLocalCenterY (handler)
*/
public handler b2BodyWorldCenterY(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_world_center_y(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return a body's type code.

pBody: The body handle.

Returns: 0 static, 1 kinematic, 2 dynamic.

Example:
if b2BodyType(tBody) is 2 then b2ApplyImpulse tBody, 0, 5, true

Description:
A stale handle also reads 0, the same as a static body.

References: b2SetBodyType (handler), b2NewBody (handler)
*/
public handler b2BodyType(in pBody as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _body_type(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Report whether a body is a bullet.

pBody: The body handle.

Returns: true if the body uses bullet (continuous) collision against
dynamic bodies.

Example:
put b2BodyIsBullet(tBody) into tIsBullet

Description:
A stale or 0 handle returns false.

References: b2SetBullet (handler)
*/
public handler b2BodyIsBullet(in pBody as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _body_is_bullet(pBody) into tR
   end unsafe
   return tR is 1
end handler

/**
Summary: Report whether a body takes part in the simulation.

pBody: The body handle.

Returns: true if enabled, false if disabled.

Example:
if not b2BodyIsEnabled(tBody) then b2EnableBody tBody

Description:
A stale or 0 handle returns false.

References: b2EnableBody (handler), b2DisableBody (handler)
*/
public handler b2BodyIsEnabled(in pBody as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _body_is_enabled(pBody) into tR
   end unsafe
   return tR is 1
end handler

/**
Summary: Return a body's linear damping.

pBody: The body handle.

Returns: The value.

Example:
put b2BodyLinearDamping(tBody) into tValue

Description:
Set it with <b2SetLinearDamping>. A stale or 0 handle returns 0.

References: b2SetLinearDamping (handler)
*/
public handler b2BodyLinearDamping(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_linear_damping(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return a body's angular damping.

pBody: The body handle.

Returns: The value.

Example:
put b2BodyAngularDamping(tBody) into tValue

Description:
Set it with <b2SetAngularDamping>. A stale or 0 handle returns 0.

References: b2SetAngularDamping (handler)
*/
public handler b2BodyAngularDamping(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_angular_damping(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return a body's gravity scale.

pBody: The body handle.

Returns: The value.

Example:
put b2BodyGravityScale(tBody) into tValue

Description:
1 is normal gravity, 0 none. Set it with <b2SetGravityScale>. A stale or
0 handle returns 0.

References: b2SetGravityScale (handler)
*/
public handler b2BodyGravityScale(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_gravity_scale(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Move a body to a new position and angle at once.

pBody: The body handle.

pX: The new x position in metres.

pY: The new y position in metres.

pAngle: The new rotation in radians.

Example:
b2SetTransform tBody, 0, 10, 0

Description:
A teleport: the body does not travel there, so it can end up overlapping
others. To move a kinematic body smoothly use <b2SetTargetTransform>. A
non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2SetTargetTransform (handler), b2BodyX (handler),
b2BodyAngle (handler)
*/
public handler b2SetTransform(in pBody as Integer, in pX as Number, in pY as Number, in pAngle as Number)
   unsafe
      _body_set_transform(pBody, pX, pY, pAngle)
   end unsafe
end handler

/**
Summary: Set a body's linear velocity.

pBody: The body handle.

pVx: The x velocity in m/s.

pVy: The y velocity in m/s.

Example:
b2SetVelocity tBody, 0, 8

Description:
A non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2BodyVX (handler), b2ApplyImpulse (handler)
*/
public handler b2SetVelocity(in pBody as Integer, in pVx as Number, in pVy as Number)
   unsafe
      _body_set_velocity(pBody, pVx, pVy)
   end unsafe
end handler

/**
Summary: Set a body's angular velocity.

pBody: The body handle.

pOmega: The angular velocity in radians per second; positive is
counter-clockwise.

Example:
b2SetAngularVelocity tBody, 2 * pi

Description:
A non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2BodyAngularVelocity (handler), b2ApplyTorque (handler)
*/
public handler b2SetAngularVelocity(in pBody as Integer, in pOmega as Number)
   unsafe
      _body_set_angular_velocity(pBody, pOmega)
   end unsafe
end handler

/**
Summary: Apply a force at a body's centre of mass.

pBody: The body handle.

pFx: The x component of the force in newtons.

pFy: The y component of the force in newtons.

pWake: true to wake the body if it sleeps.

Example:
b2ApplyForce tBody, 0, 50, true

Description:
A force acts over time: apply it every step for as long as it should
push. For a one-off kick use <b2ApplyImpulse>. A non-finite value is
ignored. A stale or 0 handle is a harmless no-op.

References: b2ApplyImpulse (handler), b2ApplyForceAt (handler),
b2ApplyTorque (handler)
*/
public handler b2ApplyForce(in pBody as Integer, in pFx as Number, in pFy as Number, in pWake as Boolean)
   unsafe
      _body_apply_force(pBody, pFx, pFy, bi(pWake))
   end unsafe
end handler

/**
Summary: Apply a linear impulse at a body's centre of mass.

pBody: The body handle.

pIx: The x component of the impulse in newton-seconds.

pIy: The y component of the impulse in newton-seconds.

pWake: true to wake the body if it sleeps.

Example:
b2ApplyImpulse tPlayer, 0, 6, true

Description:
An impulse changes the velocity at once; use it for jumps and kicks. A
non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2ApplyForce (handler), b2ApplyImpulseAt (handler),
b2SetVelocity (handler)
*/
public handler b2ApplyImpulse(in pBody as Integer, in pIx as Number, in pIy as Number, in pWake as Boolean)
   unsafe
      _body_apply_impulse(pBody, pIx, pIy, bi(pWake))
   end unsafe
end handler

/**
Summary: Apply a torque to a body.

pBody: The body handle.

pTorque: The torque in newton-metres; positive is counter-clockwise.

pWake: true to wake the body if it sleeps.

Example:
b2ApplyTorque tWheel, 20, true

Description:
Like a force, a torque acts over time; apply it every step. A non-finite
value is ignored. A stale or 0 handle is a harmless no-op.

References: b2ApplyAngularImpulse (handler), b2ApplyForce (handler)
*/
public handler b2ApplyTorque(in pBody as Integer, in pTorque as Number, in pWake as Boolean)
   unsafe
      _body_apply_torque(pBody, pTorque, bi(pWake))
   end unsafe
end handler

/**
Summary: Apply an angular impulse to a body.

pBody: The body handle.

pImpulse: The angular impulse; positive is counter-clockwise.

pWake: true to wake the body if it sleeps.

Example:
b2ApplyAngularImpulse tBody, 1.5, true

Description:
Changes the spin at once. A non-finite value is ignored. A stale or 0
handle is a harmless no-op.

References: b2ApplyTorque (handler), b2SetAngularVelocity (handler)
*/
public handler b2ApplyAngularImpulse(in pBody as Integer, in pImpulse as Number, in pWake as Boolean)
   unsafe
      _body_apply_angular_impulse(pBody, pImpulse, bi(pWake))
   end unsafe
end handler

/**
Summary: Mark a body as a bullet, or clear the mark.

pBody: The body handle.

pFlag: true for continuous collision against dynamic bodies as well as
static ones.

Example:
b2SetBullet tBall, true

Description:
Use it for small, very fast dynamic bodies that would otherwise pass
through others. It costs time, so use it sparingly. A stale or 0 handle
is a harmless no-op.

References: b2BodyIsBullet (handler), b2EnableContinuous (handler)
*/
public handler b2SetBullet(in pBody as Integer, in pFlag as Boolean)
   unsafe
      _body_set_bullet(pBody, bi(pFlag))
   end unsafe
end handler

/**
Summary: Wake a body, or put it to sleep.

pBody: The body handle.

pFlag: true to wake the body, false to put it to sleep.

Example:
b2SetAwake tBody, true

Description:
A stale or 0 handle is a harmless no-op.

References: b2BodyIsAwake (handler), b2EnableSleep (handler)
*/
public handler b2SetAwake(in pBody as Integer, in pFlag as Boolean)
   unsafe
      _body_set_awake(pBody, bi(pFlag))
   end unsafe
end handler

/**
Summary: Stop a body rotating, or let it rotate again.

pBody: The body handle.

pFlag: true to lock the rotation.

Example:
b2SetFixedRotation tPlayer, true

Description:
Handy for platformer characters that must stay upright. A stale or 0
handle is a harmless no-op.

References: b2BodyIsFixedRotation (handler)
*/
public handler b2SetFixedRotation(in pBody as Integer, in pFlag as Boolean)
   unsafe
      _body_set_fixed_rotation(pBody, bi(pFlag))
   end unsafe
end handler

/**
Summary: Change a body's type.

pBody: The body handle.

pType: The new type: 0 static, 1 kinematic, 2 dynamic.

Example:
b2SetBodyType tCrate, 2

Description:
A type outside 0 to 2 is ignored. A stale or 0 handle is a harmless
no-op.

References: b2BodyType (handler), b2NewBody (handler)
*/
public handler b2SetBodyType(in pBody as Integer, in pType as Integer)
   unsafe
      _body_set_type(pBody, pType)
   end unsafe
end handler

/**
Summary: Set how quickly a body's linear velocity dies away.

pBody: The body handle.

pDamping: The linear damping, 0 or more; 0 means none.

Example:
b2SetLinearDamping tBody, 0.5

Description:
Damping slows a body even in empty space, like air drag. A negative or
non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2BodyLinearDamping (handler), b2SetAngularDamping (handler)
*/
public handler b2SetLinearDamping(in pBody as Integer, in pDamping as Number)
   unsafe
      _body_set_linear_damping(pBody, pDamping)
   end unsafe
end handler

/**
Summary: Set how quickly a body's spin dies away.

pBody: The body handle.

pDamping: The angular damping, 0 or more; 0 means none.

Example:
b2SetAngularDamping tBody, 1

Description:
A negative or non-finite value is ignored. A stale or 0 handle is a
harmless no-op.

References: b2BodyAngularDamping (handler), b2SetLinearDamping (handler)
*/
public handler b2SetAngularDamping(in pBody as Integer, in pDamping as Number)
   unsafe
      _body_set_angular_damping(pBody, pDamping)
   end unsafe
end handler

/**
Summary: Scale how strongly gravity acts on one body.

pBody: The body handle.

pScale: The gravity multiplier: 1 normal, 0 none, negative to fall
upward.

Example:
b2SetGravityScale tBalloon, -0.2

Description:
A non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2BodyGravityScale (handler), b2SetGravity (handler)
*/
public handler b2SetGravityScale(in pBody as Integer, in pScale as Number)
   unsafe
      _body_set_gravity_scale(pBody, pScale)
   end unsafe
end handler

/**
Summary: Set the speed below which a body may fall asleep.

pBody: The body handle.

pThreshold: The sleep speed threshold in m/s, 0 or more.

Example:
b2SetSleepThreshold tBody, 0.05

Description:
A negative or non-finite value is ignored. A stale or 0 handle is a
harmless no-op.

References: b2EnableSleep (handler), b2BodyIsAwake (handler)
*/
public handler b2SetSleepThreshold(in pBody as Integer, in pThreshold as Number)
   unsafe
      _body_set_sleep_threshold(pBody, pThreshold)
   end unsafe
end handler

/**
Summary: Return a disabled body to the simulation.

pBody: The body handle.

Example:
b2EnableBody tBody

Description:
A stale or 0 handle is a harmless no-op.

References: b2DisableBody (handler), b2BodyIsEnabled (handler)
*/
public handler b2EnableBody(in pBody as Integer)
   unsafe
      _body_enable(pBody)
   end unsafe
end handler

/**
Summary: Take a body out of the simulation without destroying it.

pBody: The body handle.

Example:
b2DisableBody tBody

Description:
A disabled body does not move or collide, and keeps its shapes and
joints until <b2EnableBody> returns it. A stale or 0 handle is a
harmless no-op.

References: b2EnableBody (handler), b2BodyIsEnabled (handler),
b2DestroyBody (handler)
*/
public handler b2DisableBody(in pBody as Integer)
   unsafe
      _body_disable(pBody)
   end unsafe
end handler

-- ---- shapes ----------------------------------------------------------
/**
Summary: Attach a box shape to a body, centred on its origin.

pBody: The body handle.

pHalfW: Half the box's width in metres; must be above 0.

pHalfH: Half the box's height in metres; must be above 0.

pDensity: The density in kg/m^2; 0 makes the shape massless. A negative
value counts as 0.

pFriction: The friction coefficient, usually 0 to 1. A negative value
counts as 0.

pRestitution: The bounciness, 0 (none) to 1 (full). A negative value
counts as 0.

Returns: A shape handle, or 0 when the body is stale or a half size is
not above 0.

Example:
put b2NewDynamicBody(tWorld, 0, 5) into tBody
put b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0.1) into tShape

Description:
Any pending options from the shape-def builder (<b2ShapeDefSensor>,
<b2ShapeDefFilter> and the rest) apply to this shape and are then
cleared. Contact events are on by default, so <b2ContactsUpdate> sees
the shape. For an offset or rotated box, build a polygon with
<b2PolyBegin>.

References: b2AddCircle (handler), b2AddPolygon (handler),
b2DestroyShape (handler)
*/
public handler b2AddBox(in pBody as Integer, in pHalfW as Number, in pHalfH as Number, in pDensity as Number, in pFriction as Number, in pRestitution as Number) returns Integer
   variable tR as Integer
   unsafe
      put _shape_add_box(pBody, pHalfW, pHalfH, pDensity, pFriction, pRestitution) into tR
   end unsafe
   return tR
end handler

/**
Summary: Attach a circle shape to a body.

pBody: The body handle.

pCx: The x of the centre in the body's local frame, in metres.

pCy: The y of the centre in the body's local frame, in metres.

pRadius: The radius in metres; must be above 0.

pDensity: The density in kg/m^2; 0 makes the shape massless. A negative
value counts as 0.

pFriction: The friction coefficient, usually 0 to 1. A negative value
counts as 0.

pRestitution: The bounciness, 0 (none) to 1 (full). A negative value
counts as 0.

Returns: A shape handle, or 0 when the body is stale or the radius is
not above 0.

Example:
put b2AddCircle(tBall, 0, 0, 0.25, 1, 0.2, 0.6) into tShape

Description:
Any pending options from the shape-def builder (<b2ShapeDefSensor>,
<b2ShapeDefFilter> and the rest) apply to this shape and are then
cleared. Contact events are on by default, so <b2ContactsUpdate> sees
the shape.

References: b2AddBox (handler), b2AddCapsule (handler),
b2SetShapeCircle (handler)
*/
public handler b2AddCircle(in pBody as Integer, in pCx as Number, in pCy as Number, in pRadius as Number, in pDensity as Number, in pFriction as Number, in pRestitution as Number) returns Integer
   variable tR as Integer
   unsafe
      put _shape_add_circle(pBody, pCx, pCy, pRadius, pDensity, pFriction, pRestitution) into tR
   end unsafe
   return tR
end handler

/**
Summary: Attach a capsule shape (a rounded line) to a body.

pBody: The body handle.

pX1: The x of the first centre in the body's local frame, in metres.

pY1: The y of the first centre, in metres.

pX2: The x of the second centre, in metres.

pY2: The y of the second centre, in metres.

pRadius: The radius in metres; must be above 0.

pDensity: The density in kg/m^2; 0 makes the shape massless. A negative
value counts as 0.

pFriction: The friction coefficient, usually 0 to 1. A negative value
counts as 0.

pRestitution: The bounciness, 0 (none) to 1 (full). A negative value
counts as 0.

Returns: A shape handle, or 0 on failure (stale body, radius not above
0, or the two centres the same).

Example:
put b2AddCapsule(tPlayer, 0, -0.4, 0, 0.4, 0.3, 1, 0.1, 0) into tShape

Description:
Any pending options from the shape-def builder (<b2ShapeDefSensor>,
<b2ShapeDefFilter> and the rest) apply to this shape and are then
cleared. Contact events are on by default, so <b2ContactsUpdate> sees
the shape. When both centres coincide use <b2AddCircle> instead.

References: b2AddCircle (handler), b2SetShapeCapsule (handler)
*/
public handler b2AddCapsule(in pBody as Integer, in pX1 as Number, in pY1 as Number, in pX2 as Number, in pY2 as Number, in pRadius as Number, in pDensity as Number, in pFriction as Number, in pRestitution as Number) returns Integer
   variable tR as Integer
   unsafe
      put _shape_add_capsule(pBody, pX1, pY1, pX2, pY2, pRadius, pDensity, pFriction, pRestitution) into tR
   end unsafe
   return tR
end handler

/**
Summary: Attach a line segment shape to a body.

pBody: The body handle.

pX1: The x of the first end in the body's local frame, in metres.

pY1: The y of the first end, in metres.

pX2: The x of the second end, in metres.

pY2: The y of the second end, in metres.

pFriction: The friction coefficient, usually 0 to 1. A negative value
counts as 0.

pRestitution: The bounciness, 0 (none) to 1 (full). A negative value
counts as 0.

Returns: A shape handle, or 0 on failure (stale body or the two ends the
same).

Example:
put b2NewStaticBody(tWorld, 0, 0) into tGround
get b2AddSegment(tGround, -20, 0, 20, 0, 0.6, 0)

Description:
Segments are massless, so they suit static bodies (ground, walls). A
segment is two-sided: bodies collide with it from either side. For
one-sided platforms and smooth terrain use a chain (<b2ChainBegin>). Any
pending options from the shape-def builder (<b2ShapeDefSensor>,
<b2ShapeDefFilter> and the rest) apply to this shape and are then
cleared. Contact events are on by default, so <b2ContactsUpdate> sees
the shape.

References: b2ChainBegin (handler), b2SetShapeSegment (handler)
*/
public handler b2AddSegment(in pBody as Integer, in pX1 as Number, in pY1 as Number, in pX2 as Number, in pY2 as Number, in pFriction as Number, in pRestitution as Number) returns Integer
   variable tR as Integer
   unsafe
      put _shape_add_segment(pBody, pX1, pY1, pX2, pY2, pFriction, pRestitution) into tR
   end unsafe
   return tR
end handler

/**
Summary: Start a new vertex list for a polygon or a query proxy.

Example:
b2PolyBegin
b2PolyAddPoint -0.5, 0
b2PolyAddPoint 0.5, 0
b2PolyAddPoint 0, 0.8
put b2AddPolygon(tBody, 1, 0.3, 0) into tShape

Description:
The vertex builder avoids passing arrays across the binding. Clear it
here, add up to 8 points with <b2PolyAddPoint>, then use them in
<b2AddPolygon>, <b2SetShapePolygon>, <b2OverlapShape> or <b2ShapeCast>.
The points stay until the next <b2PolyBegin>.

References: b2PolyAddPoint (handler), b2AddPolygon (handler)
*/
public handler b2PolyBegin()
   unsafe
      _poly_begin()
   end unsafe
end handler

/**
Summary: Add one point to the vertex builder.

pX: The x of the point in metres (the body's local frame for a polygon,
world coordinates for a query).

pY: The y of the point in metres.

Example:
b2PolyBegin
b2PolyAddPoint 0, 0
b2PolyAddPoint 1, 0
b2PolyAddPoint 0, 1

Description:
The builder holds at most 8 points; extra points and non-finite values
are ignored.

References: b2PolyBegin (handler), b2AddPolygon (handler)
*/
public handler b2PolyAddPoint(in pX as Number, in pY as Number)
   unsafe
      _poly_add(pX, pY)
   end unsafe
end handler

/**
Summary: Attach a convex polygon, built from the vertex builder, to a body.

pBody: The body handle.

pDensity: The density in kg/m^2; 0 makes the shape massless. A negative
value counts as 0.

pFriction: The friction coefficient, usually 0 to 1. A negative value
counts as 0.

pRestitution: The bounciness, 0 (none) to 1 (full). A negative value
counts as 0.

Returns: A shape handle, or 0 when the body is stale, fewer than 3
points were added or the hull degenerates.

Example:
b2PolyBegin
b2PolyAddPoint -0.5, 0
b2PolyAddPoint 0.5, 0
b2PolyAddPoint 0, 0.8
put b2AddPolygon(tBody, 1, 0.3, 0) into tShape

Description:
The points from <b2PolyAddPoint> are taken as a convex hull, so their
order does not matter and inner points are dropped. Any pending options
from the shape-def builder (<b2ShapeDefSensor>, <b2ShapeDefFilter> and
the rest) apply to this shape and are then cleared. Contact events are
on by default, so <b2ContactsUpdate> sees the shape.

References: b2PolyBegin (handler), b2PolyAddPoint (handler),
b2SetShapePolygon (handler)
*/
public handler b2AddPolygon(in pBody as Integer, in pDensity as Number, in pFriction as Number, in pRestitution as Number) returns Integer
   variable tR as Integer
   unsafe
      put _shape_add_polygon(pBody, pDensity, pFriction, pRestitution) into tR
   end unsafe
   return tR
end handler

/**
Summary: Remove a shape from its body.

pShape: The shape handle.

Example:
b2DestroyShape tShape
put 0 into tShape

Description:
The body's mass is updated. A stale or 0 handle is a harmless no-op.

References: b2AddBox (handler), b2DestroyBody (handler)
*/
public handler b2DestroyShape(in pShape as Integer)
   unsafe
      _shape_destroy(pShape)
   end unsafe
end handler

/**
Summary: Change a shape's friction.

pShape: The shape handle.

pFriction: The friction coefficient, 0 or more (usually 0 to 1).

Example:
b2SetShapeFriction tShape, 0.5

Description:
A negative or non-finite value is ignored. A stale or 0 handle is a
harmless no-op.

References: b2ShapeFriction (handler)
*/
public handler b2SetShapeFriction(in pShape as Integer, in pFriction as Number)
   unsafe
      _shape_set_friction(pShape, pFriction)
   end unsafe
end handler

/**
Summary: Change a shape's restitution (bounciness).

pShape: The shape handle.

pRestitution: The restitution, 0 or more (usually 0 to 1).

Example:
b2SetShapeRestitution tShape, 0.5

Description:
A negative or non-finite value is ignored. A stale or 0 handle is a
harmless no-op.

References: b2ShapeRestitution (handler)
*/
public handler b2SetShapeRestitution(in pShape as Integer, in pRestitution as Number)
   unsafe
      _shape_set_restitution(pShape, pRestitution)
   end unsafe
end handler

/**
Summary: Change a shape's density.

pShape: The shape handle.

pDensity: The density in kg/m^2, 0 or more.

Example:
b2SetShapeDensity tShape, 0.5

Description:
The body's mass is recomputed. A negative or non-finite value is
ignored. A stale or 0 handle is a harmless no-op.

References: b2ShapeDensity (handler)
*/
public handler b2SetShapeDensity(in pShape as Integer, in pDensity as Number)
   unsafe
      _shape_set_density(pShape, pDensity)
   end unsafe
end handler

/**
Summary: Return the body a shape belongs to.

pShape: The shape handle.

Returns: The body handle, or 0 for a stale shape.

Example:
put b2ShapeBody(tShape) into tBody

Description:
Useful when a query or sensor event hands you a shape.

References: b2BodyShapeCount (handler), b2QueryShape (handler)
*/
public handler b2ShapeBody(in pShape as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _shape_body(pShape) into tR
   end unsafe
   return tR
end handler

/**
Summary: Report whether a world point lies inside a shape.

pShape: The shape handle.

pX: The x of the point in world metres.

pY: The y of the point in world metres.

Returns: true if the point is inside the shape.

Example:
if b2ShapeTestPoint(tShape, tX, tY) then put "hit" into tResult

Description:
A stale or 0 handle returns false.

References: b2BodyAtPoint (handler), b2OverlapPoint (handler)
*/
public handler b2ShapeTestPoint(in pShape as Integer, in pX as Number, in pY as Number) returns Boolean
   variable tR as Integer
   unsafe
      put _shape_test_point(pShape, pX, pY) into tR
   end unsafe
   return tR is 1
end handler

-- ---- joints ----------------------------------------------------------
/**
Summary: Pin two bodies together at a point they can rotate about.

pWorld: The world handle.

pBodyA: The first body handle.

pBodyB: The second body handle.

pAx: The x of the anchor on body A, in A's local frame (metres).

pAy: The y of the anchor on body A, in A's local frame (metres).

pBx: The x of the anchor on body B, in B's local frame (metres).

pBy: The y of the anchor on body B, in B's local frame (metres).

pCollide: true to let the two joined bodies still collide with each
other.

Returns: A joint handle, or 0 when a handle is stale or a number is not
finite.

Example:
put b2RevoluteJoint(tWorld, tCar, tWheel, 1, -0.5, 0, 0, false) into tHinge

Description:
A hinge or axle. Add a limit with <b2RevoluteEnableLimit> and a motor
with <b2RevoluteEnableMotor>. Free it with <b2DestroyJoint>.

References: b2RevoluteEnableLimit (handler),
b2RevoluteEnableMotor (handler), b2RevoluteAngle (handler)
*/
public handler b2RevoluteJoint(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pAx as Number, in pAy as Number, in pBx as Number, in pBy as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_revolute(pWorld, pBodyA, pBodyB, pAx, pAy, pBx, pBy, bi(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Switch a revolute joint's angle limit and set its range.

pJoint: The revolute joint handle.

pEnable: true to turn the limit on, false to turn it off.

pLowerRad: The lower angle in radians.

pUpperRad: The upper angle in radians.

Example:
b2RevoluteEnableLimit tHinge, true, -pi / 4, pi / 4

Description:
Both ends are clamped into plus or minus 0.95 pi, as Box2D requires. The
call is ignored when the lower angle is above the upper or a value is
not finite. A stale or 0 handle is a harmless no-op.

References: b2RevoluteIsLimitEnabled (handler),
b2RevoluteLowerLimit (handler), b2RevoluteUpperLimit (handler)
*/
public handler b2RevoluteEnableLimit(in pJoint as Integer, in pEnable as Boolean, in pLowerRad as Number, in pUpperRad as Number)
   unsafe
      _revolute_enable_limit(pJoint, bi(pEnable), pLowerRad, pUpperRad)
   end unsafe
end handler

/**
Summary: Switch a revolute joint's motor and set its speed and torque.

pJoint: The revolute joint handle.

pEnable: true to turn the motor on, false to turn it off.

pSpeed: The target speed in radians per second.

pMaxTorque: The most torque the motor may apply, in newton-metres.

Example:
b2RevoluteEnableMotor tHinge, true, 2 * pi, 100

Description:
The call is ignored when a value is not finite. A stale or 0 handle is a
harmless no-op.

References: b2RevoluteSetMotorSpeed (handler),
b2RevoluteSetMaxMotorTorque (handler),
b2RevoluteIsMotorEnabled (handler)
*/
public handler b2RevoluteEnableMotor(in pJoint as Integer, in pEnable as Boolean, in pSpeed as Number, in pMaxTorque as Number)
   unsafe
      _revolute_enable_motor(pJoint, bi(pEnable), pSpeed, pMaxTorque)
   end unsafe
end handler

/**
Summary: Return a revolute joint's current angle.

pJoint: The revolute joint handle.

Returns: The angle of body B relative to body A, in radians.

Example:
put b2RevoluteAngle(tHinge) into tAngle

Description:
A stale or 0 handle returns 0.

References: b2RevoluteJoint (handler), b2RevoluteEnableLimit (handler)
*/
public handler b2RevoluteAngle(in pJoint as Integer) returns Number
   variable tR as Number
   unsafe
      put _revolute_angle(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Link two bodies with a rod of fixed length.

pWorld: The world handle.

pBodyA: The first body handle.

pBodyB: The second body handle.

pAx: The x of the anchor on body A, in A's local frame (metres).

pAy: The y of the anchor on body A, in A's local frame (metres).

pBx: The x of the anchor on body B, in B's local frame (metres).

pBy: The y of the anchor on body B, in B's local frame (metres).

pLength: The rest length in metres (values under 0.005 are raised to
0.005).

pCollide: true to let the two joined bodies still collide with each
other.

Returns: A joint handle, or 0 when a handle is stale or a number is not
finite.

Example:
put b2DistanceJoint(tWorld, tAnchor, tBob, 0, 0, 0, 0, 3, false) into tRope

Description:
Make it springy with <b2DistanceEnableSpring>, or let the length vary
within a range with <b2DistanceSetLengthRange>.

References: b2DistanceSetLength (handler),
b2DistanceEnableSpring (handler), b2DistanceSetLengthRange (handler)
*/
public handler b2DistanceJoint(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pAx as Number, in pAy as Number, in pBx as Number, in pBy as Number, in pLength as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_distance(pWorld, pBodyA, pBodyB, pAx, pAy, pBx, pBy, pLength, bi(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Change a distance joint's rest length.

pJoint: The distance joint handle.

pLength: The new rest length in metres.

Example:
b2DistanceSetLength tRope, 2

Description:
A non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2DistanceLength (handler),
b2DistanceCurrentLength (handler)
*/
public handler b2DistanceSetLength(in pJoint as Integer, in pLength as Number)
   unsafe
      _distance_set_length(pJoint, pLength)
   end unsafe
end handler

/**
Summary: Let a distance joint's length vary within a range.

pJoint: The distance joint handle.

pMin: The shortest allowed length in metres.

pMax: The longest allowed length in metres.

Example:
b2DistanceSetLengthRange tRope, 1, 3

Description:
This also switches the joint's limit on. The call is ignored when the
minimum is above the maximum or a value is not finite. A stale or 0
handle is a harmless no-op.

References: b2DistanceIsLimitEnabled (handler),
b2DistanceMinLength (handler), b2DistanceMaxLength (handler)
*/
public handler b2DistanceSetLengthRange(in pJoint as Integer, in pMin as Number, in pMax as Number)
   unsafe
      _distance_set_length_range(pJoint, pMin, pMax)
   end unsafe
end handler

/**
Summary: Make a distance joint springy, or rigid again.

pJoint: The distance joint handle.

pEnable: true to turn the spring on.

pHertz: The spring stiffness as a frequency in hertz.

pDamping: The damping ratio; 0 is bouncy, 1 settles without overshoot.

Example:
b2DistanceEnableSpring tRope, true, 4, 0.5

Description:
The call is ignored when a value is not finite. A stale or 0 handle is a
harmless no-op.

References: b2DistanceIsSpringEnabled (handler),
b2DistanceSpringHertz (handler), b2DistanceEnableMotor (handler)
*/
public handler b2DistanceEnableSpring(in pJoint as Integer, in pEnable as Boolean, in pHertz as Number, in pDamping as Number)
   unsafe
      _distance_enable_spring(pJoint, bi(pEnable), pHertz, pDamping)
   end unsafe
end handler

/**
Summary: Return a distance joint's rest length.

pJoint: The distance joint handle.

Returns: The rest length in metres.

Example:
put b2DistanceLength(tRope) into tLength

Description:
This is the length <b2DistanceSetLength> sets; <b2DistanceCurrentLength>
is the live separation. A stale or 0 handle returns 0.

References: b2DistanceSetLength (handler),
b2DistanceCurrentLength (handler)
*/
public handler b2DistanceLength(in pJoint as Integer) returns Number
   variable tR as Number
   unsafe
      put _distance_length(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Glue two bodies together rigidly.

pWorld: The world handle.

pBodyA: The first body handle.

pBodyB: The second body handle.

pAx: The x of the anchor on body A, in A's local frame (metres).

pAy: The y of the anchor on body A, in A's local frame (metres).

pBx: The x of the anchor on body B, in B's local frame (metres).

pBy: The y of the anchor on body B, in B's local frame (metres).

pRefAngle: The angle of body B relative to body A to hold, in radians.

pCollide: true to let the two joined bodies still collide with each
other.

Returns: A joint handle, or 0 when a handle is stale or a number is not
finite.

Example:
put b2WeldJoint(tWorld, tA, tB, 0.5, 0, -0.5, 0, 0, false) into tWeld

Description:
Rigid by default; make it springy with <b2WeldSetStiffness>.

References: b2WeldSetStiffness (handler), b2WeldReferenceAngle (handler)
*/
public handler b2WeldJoint(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pAx as Number, in pAy as Number, in pBx as Number, in pBy as Number, in pRefAngle as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_weld(pWorld, pBodyA, pBodyB, pAx, pAy, pBx, pBy, pRefAngle, bi(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Make a weld joint springy, or rigid again.

pJoint: The weld joint handle.

pLinearHertz: The linear stiffness in hertz; 0 is rigid.

pLinearDamping: The linear damping ratio.

pAngularHertz: The angular stiffness in hertz; 0 is rigid.

pAngularDamping: The angular damping ratio.

Example:
b2WeldSetStiffness tWeld, 5, 0.7, 5, 0.7

Description:
The call is ignored when a value is not finite. A stale or 0 handle is a
harmless no-op.

References: b2WeldLinearHertz (handler), b2WeldAngularHertz (handler)
*/
public handler b2WeldSetStiffness(in pJoint as Integer, in pLinearHertz as Number, in pLinearDamping as Number, in pAngularHertz as Number, in pAngularDamping as Number)
   unsafe
      _weld_set_stiffness(pJoint, pLinearHertz, pLinearDamping, pAngularHertz, pAngularDamping)
   end unsafe
end handler

/**
Summary: Let body B slide along an axis fixed in body A.

pWorld: The world handle.

pBodyA: The first body handle.

pBodyB: The second body handle.

pAx: The x of the anchor on body A, in A's local frame (metres).

pAy: The y of the anchor on body A, in A's local frame (metres).

pBx: The x of the anchor on body B, in B's local frame (metres).

pBy: The y of the anchor on body B, in B's local frame (metres).

pAxisX: The x of the slide axis in body A's frame (it is normalised).

pAxisY: The y of the slide axis in body A's frame.

pRefAngle: The angle of body B relative to body A to hold, in radians.

pCollide: true to let the two joined bodies still collide with each
other.

Returns: A joint handle, or 0 when a handle is stale, a number is not
finite or the axis is zero.

Example:
put b2PrismaticJoint(tWorld, tGround, tLift, 0, 0, 0, 0, 0, 1, 0, false) into tSlider

Description:
A piston or elevator. Add a limit with <b2PrismaticEnableLimit> and a
motor with <b2PrismaticEnableMotor>.

References: b2PrismaticEnableLimit (handler),
b2PrismaticEnableMotor (handler), b2PrismaticTranslation (handler)
*/
public handler b2PrismaticJoint(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pAx as Number, in pAy as Number, in pBx as Number, in pBy as Number, in pAxisX as Number, in pAxisY as Number, in pRefAngle as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_prismatic(pWorld, pBodyA, pBodyB, pAx, pAy, pBx, pBy, pAxisX, pAxisY, pRefAngle, bi(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Switch a prismatic joint's travel limit and set its range.

pJoint: The prismatic joint handle.

pEnable: true to turn the limit on.

pLower: The lower translation in metres.

pUpper: The upper translation in metres.

Example:
b2PrismaticEnableLimit tSlider, true, 0, 4

Description:
The call is ignored when the lower value is above the upper or a value
is not finite. A stale or 0 handle is a harmless no-op.

References: b2PrismaticIsLimitEnabled (handler),
b2PrismaticLowerLimit (handler)
*/
public handler b2PrismaticEnableLimit(in pJoint as Integer, in pEnable as Boolean, in pLower as Number, in pUpper as Number)
   unsafe
      _prismatic_enable_limit(pJoint, bi(pEnable), pLower, pUpper)
   end unsafe
end handler

/**
Summary: Switch a prismatic joint's motor and set its speed and force.

pJoint: The prismatic joint handle.

pEnable: true to turn the motor on.

pSpeed: The target speed in m/s.

pMaxForce: The most force the motor may apply, in newtons.

Example:
b2PrismaticEnableMotor tSlider, true, 1, 500

Description:
This is the only setter for the maximum force. The call is ignored when
a value is not finite. A stale or 0 handle is a harmless no-op.

References: b2PrismaticSetMotorSpeed (handler),
b2PrismaticMaxMotorForce (handler), b2PrismaticIsMotorEnabled (handler)
*/
public handler b2PrismaticEnableMotor(in pJoint as Integer, in pEnable as Boolean, in pSpeed as Number, in pMaxForce as Number)
   unsafe
      _prismatic_enable_motor(pJoint, bi(pEnable), pSpeed, pMaxForce)
   end unsafe
end handler

/**
Summary: Return how far a prismatic joint has slid.

pJoint: The prismatic joint handle.

Returns: The translation along the axis, in metres.

Example:
put b2PrismaticTranslation(tSlider) into tPos

Description:
A stale or 0 handle returns 0.

References: b2PrismaticSpeed (handler), b2PrismaticEnableLimit (handler)
*/
public handler b2PrismaticTranslation(in pJoint as Integer) returns Number
   variable tR as Number
   unsafe
      put _prismatic_translation(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Attach a wheel: a sprung sliding axis plus free spin.

pWorld: The world handle.

pBodyA: The first body handle.

pBodyB: The second body handle.

pAx: The x of the anchor on body A, in A's local frame (metres).

pAy: The y of the anchor on body A, in A's local frame (metres).

pBx: The x of the anchor on body B, in B's local frame (metres).

pBy: The y of the anchor on body B, in B's local frame (metres).

pAxisX: The x of the suspension axis in body A's frame (it is
normalised).

pAxisY: The y of the suspension axis in body A's frame.

pCollide: true to let the two joined bodies still collide with each
other.

Returns: A joint handle, or 0 when a handle is stale, a number is not
finite or the axis is zero.

Example:
put b2WheelJoint(tWorld, tCar, tWheel, 1, -0.6, 0, 0, 0, 1, false) into tAxle

Description:
Built for vehicle wheels. Set the suspension with <b2WheelEnableSpring>
and the drive with <b2WheelEnableMotor>.

References: b2WheelEnableSpring (handler), b2WheelEnableMotor (handler)
*/
public handler b2WheelJoint(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pAx as Number, in pAy as Number, in pBx as Number, in pBy as Number, in pAxisX as Number, in pAxisY as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_wheel(pWorld, pBodyA, pBodyB, pAx, pAy, pBx, pBy, pAxisX, pAxisY, bi(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Switch a wheel joint's suspension spring and set it.

pJoint: The wheel joint handle.

pEnable: true to turn the spring on.

pHertz: The spring stiffness in hertz.

pDamping: The damping ratio.

Example:
b2WheelEnableSpring tAxle, true, 4, 0.7

Description:
The call is ignored when a value is not finite. A stale or 0 handle is a
harmless no-op.

References: b2WheelIsSpringEnabled (handler),
b2WheelSpringHertz (handler)
*/
public handler b2WheelEnableSpring(in pJoint as Integer, in pEnable as Boolean, in pHertz as Number, in pDamping as Number)
   unsafe
      _wheel_enable_spring(pJoint, bi(pEnable), pHertz, pDamping)
   end unsafe
end handler

/**
Summary: Switch a wheel joint's drive motor and set it.

pJoint: The wheel joint handle.

pEnable: true to turn the motor on.

pSpeed: The target spin in radians per second.

pMaxTorque: The most torque the motor may apply, in newton-metres.

Example:
b2WheelEnableMotor tAxle, true, -10, 50

Description:
The call is ignored when a value is not finite. A stale or 0 handle is a
harmless no-op.

References: b2WheelIsMotorEnabled (handler),
b2WheelMotorSpeed (handler), b2WheelMaxMotorTorque (handler)
*/
public handler b2WheelEnableMotor(in pJoint as Integer, in pEnable as Boolean, in pSpeed as Number, in pMaxTorque as Number)
   unsafe
      _wheel_enable_motor(pJoint, bi(pEnable), pSpeed, pMaxTorque)
   end unsafe
end handler

/**
Summary: Drag a body toward a target point.

pWorld: The world handle.

pBodyA: A reference body, usually a static one; it is not moved.

pBodyB: The body to drag.

pTargetX: The x of the target in world metres.

pTargetY: The y of the target in world metres.

pHertz: How stiffly the body follows, in hertz.

pDamping: The damping ratio.

pMaxForce: The most force the joint may pull with, in newtons.

Returns: A joint handle, or 0 when a handle is stale or a number is not
finite.

Example:
put b2MouseJoint(tWorld, tGround, tPicked, tX, tY, 5, 0.7, 1000 * b2BodyMass(tPicked)) into tDrag

Description:
Use it for mouse or touch dragging: move the target each frame with
<b2MouseSetTarget> and destroy the joint on release.

References: b2MouseSetTarget (handler), b2BodyAtPoint (handler),
b2DestroyJoint (handler)
*/
public handler b2MouseJoint(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pTargetX as Number, in pTargetY as Number, in pHertz as Number, in pDamping as Number, in pMaxForce as Number) returns Integer
   variable tR as Integer
   unsafe
      put _joint_mouse(pWorld, pBodyA, pBodyB, pTargetX, pTargetY, pHertz, pDamping, pMaxForce) into tR
   end unsafe
   return tR
end handler

/**
Summary: Move a mouse joint's target.

pJoint: The mouse joint handle.

pTargetX: The x of the new target in world metres.

pTargetY: The y of the new target in world metres.

Example:
b2MouseSetTarget tDrag, tX, tY

Description:
A non-finite value is ignored. A stale or 0 handle is a harmless no-op.

References: b2MouseJoint (handler), b2MouseTargetX (handler)
*/
public handler b2MouseSetTarget(in pJoint as Integer, in pTargetX as Number, in pTargetY as Number)
   unsafe
      _mouse_set_target(pJoint, pTargetX, pTargetY)
   end unsafe
end handler

/**
Summary: Remove a joint.

pJoint: The joint handle.

Example:
b2DestroyJoint tDrag
put 0 into tDrag

Description:
The two bodies stay. A stale or 0 handle is a harmless no-op.

References: b2RevoluteJoint (handler), b2DestroyBody (handler)
*/
public handler b2DestroyJoint(in pJoint as Integer)
   unsafe
      _joint_destroy(pJoint)
   end unsafe
end handler

-- ---- world queries ---------------------------------------------------
-- Cast a ray from (x1,y1) to (x2,y2). Returns true on hit; then read the
-- hit details with b2RayBody / b2RayX / b2RayNormalX / b2RayFraction etc.
/**
Summary: Cast a ray through a world and find the closest hit.

pWorld: The world handle.

pX1: The x of the start point in world metres.

pY1: The y of the start point.

pX2: The x of the end point.

pY2: The y of the end point.

Returns: true if the ray hit a shape.

Example:
if b2CastRayClosest(tWorld, 0, 10, 0, -10) then
   put b2RayBody() into tHitBody
   put b2RayY() into tGroundY
end if

Description:
On a hit, read the result with <b2RayBody>, <b2RayShape>, <b2RayX>,
<b2RayY>, <b2RayNormalX>, <b2RayNormalY> and <b2RayFraction>. Each cast
clears the previous result, so a miss or a stale world leaves them all
0. For every hit along the ray use <b2RayCastAll>.

References: b2RayBody (handler), b2RayX (handler),
b2RayCastAll (handler)
*/
public handler b2CastRayClosest(in pWorld as Integer, in pX1 as Number, in pY1 as Number, in pX2 as Number, in pY2 as Number) returns Boolean
   variable tR as Integer
   unsafe
      put _cast_ray_closest(pWorld, pX1, pY1, pX2, pY2) into tR
   end unsafe
   return tR is 1
end handler

/**
Summary: Return the body the last closest ray hit.

Returns: A body handle, or 0 after a miss.

Example:
if b2CastRayClosest(tWorld, tX1, tY1, tX2, tY2) then put b2RayBody() into tValue

Description:
Reads the result stored by the last <b2CastRayClosest>.

References: b2CastRayClosest (handler)
*/
public handler b2RayBody() returns Integer
   variable tR as Integer
   unsafe
      put _ray_body() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the shape the last closest ray hit.

Returns: A shape handle, or 0 after a miss.

Example:
if b2CastRayClosest(tWorld, tX1, tY1, tX2, tY2) then put b2RayShape() into tValue

Description:
Reads the result stored by the last <b2CastRayClosest>.

References: b2CastRayClosest (handler)
*/
public handler b2RayShape() returns Integer
   variable tR as Integer
   unsafe
      put _ray_shape() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the x of the last closest ray's hit point.

Returns: The x in world metres, or 0 after a miss.

Example:
if b2CastRayClosest(tWorld, tX1, tY1, tX2, tY2) then put b2RayX() into tValue

Description:
Reads the result stored by the last <b2CastRayClosest>.

References: b2CastRayClosest (handler)
*/
public handler b2RayX() returns Number
   variable tR as Number
   unsafe
      put _ray_x() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the y of the last closest ray's hit point.

Returns: The y in world metres, or 0 after a miss.

Example:
if b2CastRayClosest(tWorld, tX1, tY1, tX2, tY2) then put b2RayY() into tValue

Description:
Reads the result stored by the last <b2CastRayClosest>.

References: b2CastRayClosest (handler)
*/
public handler b2RayY() returns Number
   variable tR as Number
   unsafe
      put _ray_y() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the x of the surface normal at the last ray hit.

Returns: The normal's x component, or 0 after a miss.

Example:
if b2CastRayClosest(tWorld, tX1, tY1, tX2, tY2) then put b2RayNormalX() into tValue

Description:
Reads the result stored by the last <b2CastRayClosest>.

References: b2CastRayClosest (handler)
*/
public handler b2RayNormalX() returns Number
   variable tR as Number
   unsafe
      put _ray_normal_x() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the y of the surface normal at the last ray hit.

Returns: The normal's y component, or 0 after a miss.

Example:
if b2CastRayClosest(tWorld, tX1, tY1, tX2, tY2) then put b2RayNormalY() into tValue

Description:
Reads the result stored by the last <b2CastRayClosest>.

References: b2CastRayClosest (handler)
*/
public handler b2RayNormalY() returns Number
   variable tR as Number
   unsafe
      put _ray_normal_y() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return how far along the last closest ray the hit was.

Returns: A fraction from 0 (start) to 1 (end), or 0 after a miss.

Example:
if b2CastRayClosest(tWorld, tX1, tY1, tX2, tY2) then put b2RayFraction() into tValue

Description:
Reads the result stored by the last <b2CastRayClosest>.

References: b2CastRayClosest (handler)
*/
public handler b2RayFraction() returns Number
   variable tR as Number
   unsafe
      put _ray_fraction() into tR
   end unsafe
   return tR
end handler

-- Return the handle of a body whose shape covers world point (x,y), else 0.
/**
Summary: Find a body whose shape covers a world point.

pWorld: The world handle.

pX: The x of the point in world metres.

pY: The y of the point in world metres.

Returns: A body handle, or 0 if no shape covers the point.

Example:
put b2BodyAtPoint(tWorld, tMouseX, tMouseY) into tPicked

Description:
Handy for click-picking. When several bodies overlap the point you get
the first one found; <b2OverlapPoint> lists them all.

References: b2OverlapPoint (handler), b2MouseJoint (handler),
b2ShapeTestPoint (handler)
*/
public handler b2BodyAtPoint(in pWorld as Integer, in pX as Number, in pY as Number) returns Integer
   variable tR as Integer
   unsafe
      put _body_at_point(pWorld, pX, pY) into tR
   end unsafe
   return tR
end handler

-- ---- contact events --------------------------------------------------
-- Call b2ContactsUpdate(world) once after each b2Step. It returns the number
-- of begin-touch events and snapshots them. Then iterate 1..count and read
-- the two body handles for each event. Indices are 1-based.
/**
Summary: Snapshot the contact events of the last step.

pWorld: The world handle.

Returns: The number of begin-touch events.

Example:
b2Step tWorld, 1/60, 4
repeat with i = 1 to b2ContactsUpdate(tWorld)
   put b2ContactBeginBodyA(i), b2ContactBeginBodyB(i) & cr after tLog
end repeat

Description:
Call it once after each <b2Step>. It stores the begin-touch, end-touch
and hit events together; read them with <b2ContactBeginBodyA>,
<b2ContactEndBodyA>, <b2ContactHitBodyA> and their siblings. Indices are
1-based. A stale world clears the snapshot and returns 0.

References: b2ContactBeginCount (handler), b2ContactEndCount (handler),
b2ContactHitCount (handler)
*/
public handler b2ContactsUpdate(in pWorld as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _contacts_update(pWorld) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return how many pairs began touching in the snapshot.

Returns: The begin-touch count from the last <b2ContactsUpdate>.

Example:
put b2ContactBeginCount() into tCount

Description:
The same number <b2ContactsUpdate> returned.

References: b2ContactsUpdate (handler), b2ContactBeginBodyA (handler)
*/
public handler b2ContactBeginCount() returns Integer
   variable tR as Integer
   unsafe
      put _contact_begin_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return how many pairs stopped touching in the snapshot.

Returns: The end-touch count from the last <b2ContactsUpdate>.

Example:
repeat with i = 1 to b2ContactEndCount()
   put b2ContactEndBodyA(i) into tBody
end repeat

Description:
Read each pair with <b2ContactEndBodyA> and <b2ContactEndBodyB>.

References: b2ContactsUpdate (handler), b2ContactEndBodyA (handler)
*/
public handler b2ContactEndCount() returns Integer
   variable tR as Integer
   unsafe
      put _contact_end_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the first body of a pair that began touching.

pIndex: The 1-based event index, from 1 to <b2ContactBeginCount>.

Returns: A body handle, or 0 when the index is out of range.

Example:
repeat with i = 1 to b2ContactBeginCount()
   put b2ContactBeginBodyA(i) && b2ContactBeginBodyB(i) & cr after tLog
end repeat

Description:
Reads the snapshot taken by <b2ContactsUpdate>.

References: b2ContactBeginBodyB (handler),
b2ContactBeginCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactBeginBodyA(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _contact_begin_a(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the second body of a pair that began touching.

pIndex: The 1-based event index, from 1 to <b2ContactBeginCount>.

Returns: A body handle, or 0 when the index is out of range.

Example:
repeat with i = 1 to b2ContactBeginCount()
   put b2ContactBeginBodyA(i) && b2ContactBeginBodyB(i) & cr after tLog
end repeat

Description:
Reads the snapshot taken by <b2ContactsUpdate>.

References: b2ContactBeginBodyA (handler),
b2ContactBeginCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactBeginBodyB(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _contact_begin_b(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the first body of a pair that stopped touching.

pIndex: The 1-based event index, from 1 to <b2ContactEndCount>.

Returns: A body handle, or 0 when the index is out of range.

Example:
repeat with i = 1 to b2ContactEndCount()
   put b2ContactEndBodyA(i) && b2ContactEndBodyB(i) & cr after tLog
end repeat

Description:
Reads the snapshot taken by <b2ContactsUpdate>. A body destroyed before
the snapshot reads 0.

References: b2ContactEndBodyB (handler), b2ContactEndCount (handler),
b2ContactsUpdate (handler)
*/
public handler b2ContactEndBodyA(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _contact_end_a(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the second body of a pair that stopped touching.

pIndex: The 1-based event index, from 1 to <b2ContactEndCount>.

Returns: A body handle, or 0 when the index is out of range.

Example:
repeat with i = 1 to b2ContactEndCount()
   put b2ContactEndBodyA(i) && b2ContactEndBodyB(i) & cr after tLog
end repeat

Description:
Reads the snapshot taken by <b2ContactsUpdate>. A body destroyed before
the snapshot reads 0.

References: b2ContactEndBodyA (handler), b2ContactEndCount (handler),
b2ContactsUpdate (handler)
*/
public handler b2ContactEndBodyB(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _contact_end_b(pIndex - 1) into tR
   end unsafe
   return tR
end handler

-- =====================================================================
-- ABI v3 additions: public API
-- =====================================================================

-- ---- shape-def builder (one-shot; consumed by the next shape creation) ----
/**
Summary: Clear every pending shape-def option.

Example:
b2ShapeDefReset

Description:
Options set with <b2ShapeDefSensor>, <b2ShapeDefFilter> and the other
b2ShapeDef handlers are normally used up by the next shape. A creation
call that is refused (for example a zero radius) can leave them pending,
so call this to start clean.

References: b2ShapeDefSensor (handler), b2ShapeDefFilter (handler)
*/
public handler b2ShapeDefReset()
   unsafe
      _shapedef_reset()
   end unsafe
end handler

/**
Summary: Make the next shape a sensor.

pFlag: true for a sensor: it reports overlaps but does not collide.

Example:
b2ShapeDefSensor true
b2ShapeDefEnableSensorEvents true
put b2AddCircle(tBody, 0, 0, 2, 0, 0, 0) into tZone

Description:
It applies to the next shape created (<b2AddBox>, <b2AddCircle>,
<b2AddCapsule>, <b2AddSegment>, <b2AddPolygon>) and is then cleared.
Read sensor events with <b2SensorsUpdate> or poll with
<b2ShapeSensorOverlapsUpdate>.

References: b2ShapeDefEnableSensorEvents (handler),
b2SensorsUpdate (handler), b2ShapeIsSensor (handler)
*/
public handler b2ShapeDefSensor(in pFlag as Boolean)
   unsafe
      _shapedef_set_sensor(bi(pFlag))
   end unsafe
end handler

/**
Summary: Turn begin and end contact events on or off for the next shape.

pFlag: true to enable begin and end contact events.

Example:
b2ShapeDefEnableContactEvents true
put b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0) into tShape

Description:
It applies to the next shape created (<b2AddBox>, <b2AddCircle>,
<b2AddCapsule>, <b2AddSegment>, <b2AddPolygon>) and is then cleared.
Contact events are on by default for every shape this binding creates.

References: b2ShapeEnableContactEvents (handler),
b2ContactsUpdate (handler)
*/
public handler b2ShapeDefEnableContactEvents(in pFlag as Boolean)
   unsafe
      _shapedef_set_enable_contact_events(bi(pFlag))
   end unsafe
end handler

/**
Summary: Turn sensor events on or off for the next shape.

pFlag: true to enable sensor events.

Example:
b2ShapeDefEnableSensorEvents true
put b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0) into tShape

Description:
It applies to the next shape created (<b2AddBox>, <b2AddCircle>,
<b2AddCapsule>, <b2AddSegment>, <b2AddPolygon>) and is then cleared.
Both the sensor and the shape visiting it need sensor events.

References: b2ShapeDefSensor (handler), b2SensorsUpdate (handler),
b2ShapeEnableSensorEvents (handler)
*/
public handler b2ShapeDefEnableSensorEvents(in pFlag as Boolean)
   unsafe
      _shapedef_set_enable_sensor_events(bi(pFlag))
   end unsafe
end handler

/**
Summary: Turn hit events on or off for the next shape.

pFlag: true to enable hit events.

Example:
b2ShapeDefEnableHitEvents true
put b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0) into tShape

Description:
It applies to the next shape created (<b2AddBox>, <b2AddCircle>,
<b2AddCapsule>, <b2AddSegment>, <b2AddPolygon>) and is then cleared. Hit
events report impacts faster than <b2HitEventThreshold>.

References: b2ShapeEnableHitEvents (handler),
b2ContactHitCount (handler)
*/
public handler b2ShapeDefEnableHitEvents(in pFlag as Boolean)
   unsafe
      _shapedef_set_enable_hit_events(bi(pFlag))
   end unsafe
end handler

/**
Summary: Turn pre-solve events on or off for the next shape.

pFlag: true to enable pre-solve events.

Example:
b2ShapeDefEnablePreSolveEvents true
put b2AddBox(tBody, 0.5, 0.5, 1, 0.3, 0) into tShape

Description:
It applies to the next shape created (<b2AddBox>, <b2AddCircle>,
<b2AddCapsule>, <b2AddSegment>, <b2AddPolygon>) and is then cleared. The
binding exposes no pre-solve callback, so this flag only matters to
Box2D itself.

References: b2ShapeEnablePreSolveEvents (handler)
*/
public handler b2ShapeDefEnablePreSolveEvents(in pFlag as Boolean)
   unsafe
      _shapedef_set_enable_presolve_events(bi(pFlag))
   end unsafe
end handler

/**
Summary: Set the collision filter for the next shape.

pCategory: The category bits this shape belongs to (0 to 2^53-1).

pMask: The category bits this shape collides with (0 to 2^53-1).

pGroup: The group index: shapes sharing a positive group always collide,
a shared negative group never do; 0 means no group.

Example:
b2ShapeDefFilter 2, 1, 0
put b2AddCircle(tBody, 0, 0, 0.2, 1, 0, 0) into tShape

Description:
It applies to the next shape created (<b2AddBox>, <b2AddCircle>,
<b2AddCapsule>, <b2AddSegment>, <b2AddPolygon>) and is then cleared. It
also applies to the next <b2CreateChain>. An out-of-range or non-finite
category or mask makes the call ignored.

References: b2SetShapeFilter (handler), b2ShapeFilterCategory (handler)
*/
public handler b2ShapeDefFilter(in pCategory as Number, in pMask as Number, in pGroup as Integer)
   unsafe
      _shapedef_set_filter(pCategory, pMask, pGroup)
   end unsafe
end handler

/**
Summary: Set the user material id for the next shape.

pId: An integer of your choosing, for example to pick a sound or effect.

Example:
b2ShapeDefMaterialId 3
put b2AddBox(tBody, 1, 0.2, 1, 0.5, 0) into tShape

Description:
It applies to the next shape created (<b2AddBox>, <b2AddCircle>,
<b2AddCapsule>, <b2AddSegment>, <b2AddPolygon>) and is then cleared.

References: b2ShapeMaterialId (handler), b2SetShapeMaterialId (handler)
*/
public handler b2ShapeDefMaterialId(in pId as Integer)
   unsafe
      _shapedef_set_material_id(pId)
   end unsafe
end handler

-- ---- contact HIT events (snapshotted by b2ContactsUpdate; 1-based) ----
/**
Summary: Return how many hit events the last snapshot holds.

Returns: The hit event count from the last <b2ContactsUpdate>.

Example:
get b2ContactsUpdate(tWorld)
repeat with i = 1 to b2ContactHitCount()
   if b2ContactHitSpeed(i) > 5 then put b2ContactHitBodyA(i) into tHard
end repeat

Description:
A hit event is an impact faster than <b2HitEventThreshold> between
shapes with hit events enabled (<b2ShapeDefEnableHitEvents> or
<b2ShapeEnableHitEvents>). Use it for impact sounds and damage.

References: b2ContactsUpdate (handler), b2ContactHitSpeed (handler),
b2SetHitEventThreshold (handler)
*/
public handler b2ContactHitCount() returns Integer
   variable tR as Integer
   unsafe
      put _contact_hit_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the first body of a hit event.

pIndex: The 1-based hit index, from 1 to <b2ContactHitCount>.

Returns: A body handle, or 0 when the index is out of range.

Example:
put b2ContactHitBodyA(1) into tValue

Description:
Reads the hit events snapshotted by <b2ContactsUpdate>.

References: b2ContactHitCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactHitBodyA(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _contact_hit_a(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the second body of a hit event.

pIndex: The 1-based hit index, from 1 to <b2ContactHitCount>.

Returns: A body handle, or 0 when the index is out of range.

Example:
put b2ContactHitBodyB(1) into tValue

Description:
Reads the hit events snapshotted by <b2ContactsUpdate>.

References: b2ContactHitCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactHitBodyB(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _contact_hit_b(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the x of a hit event's impact point.

pIndex: The 1-based hit index, from 1 to <b2ContactHitCount>.

Returns: The x in world metres, or 0 when the index is out of range.

Example:
put b2ContactHitX(1) into tValue

Description:
Reads the hit events snapshotted by <b2ContactsUpdate>.

References: b2ContactHitCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactHitX(in pIndex as Integer) returns Number
   variable tR as Number
   unsafe
      put _contact_hit_x(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the y of a hit event's impact point.

pIndex: The 1-based hit index, from 1 to <b2ContactHitCount>.

Returns: The y in world metres, or 0 when the index is out of range.

Example:
put b2ContactHitY(1) into tValue

Description:
Reads the hit events snapshotted by <b2ContactsUpdate>.

References: b2ContactHitCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactHitY(in pIndex as Integer) returns Number
   variable tR as Number
   unsafe
      put _contact_hit_y(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the x of a hit event's normal.

pIndex: The 1-based hit index, from 1 to <b2ContactHitCount>.

Returns: The normal's x component, or 0 when the index is out of range.

Example:
put b2ContactHitNormalX(1) into tValue

Description:
Reads the hit events snapshotted by <b2ContactsUpdate>.

References: b2ContactHitCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactHitNormalX(in pIndex as Integer) returns Number
   variable tR as Number
   unsafe
      put _contact_hit_nx(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return the y of a hit event's normal.

pIndex: The 1-based hit index, from 1 to <b2ContactHitCount>.

Returns: The normal's y component, or 0 when the index is out of range.

Example:
put b2ContactHitNormalY(1) into tValue

Description:
Reads the hit events snapshotted by <b2ContactsUpdate>.

References: b2ContactHitCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactHitNormalY(in pIndex as Integer) returns Number
   variable tR as Number
   unsafe
      put _contact_hit_ny(pIndex - 1) into tR
   end unsafe
   return tR
end handler

/**
Summary: Return a hit event's approach speed.

pIndex: The 1-based hit index, from 1 to <b2ContactHitCount>.

Returns: The speed in m/s, or 0 when the index is out of range.

Example:
put b2ContactHitSpeed(1) into tValue

Description:
Reads the hit events snapshotted by <b2ContactsUpdate>.

References: b2ContactHitCount (handler), b2ContactsUpdate (handler)
*/
public handler b2ContactHitSpeed(in pIndex as Integer) returns Number
   variable tR as Number
   unsafe
      put _contact_hit_speed(pIndex - 1) into tR
   end unsafe
   return tR
end handler

-- ---- sensor events (shape handles; 1-based) ----
/**
Summary: Snapshot the sensor events of the last step.

pWorld: The world handle.

Returns: The number of begin-overlap events.

Example:
repeat with i = 1 to b2SensorsUpdate(tWorld)
   if b2SensorBeginSensorShape(i) is tGoal then put b2SensorBeginVisitorShape(i) into tScorer
end repeat

Description:
Call it once after each <b2Step>. Sensor events name SHAPES, not bodies:
use <b2ShapeBody> to find the body. Both the sensor and its visitor need
sensor events enabled. A stale world clears the snapshot and returns 0.

References: b2SensorBeginSensorShape (handler),
b2SensorEndCount (handler), b2ShapeDefSensor (handler)
*/
public handler b2SensorsUpdate(in pWorld as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _sensors_update(pWorld) into tR
   end unsafe
   return tR
end handler

/**
