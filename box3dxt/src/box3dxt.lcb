Description: An impulse is a one-off: a jump, a hit, a shot.
*/
public handler b3BodyApplyImpulse(in pBody as Integer, in pIx as Number, in pIy as Number, in pIz as Number, in pPx as Number, in pPy as Number, in pPz as Number, in pWake as Boolean) returns nothing
   unsafe
      _body_apply_impulse(pBody, pIx, pIy, pIz, pPx, pPy, pPz, asInt(pWake))
   end unsafe
end handler

