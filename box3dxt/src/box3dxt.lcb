*/
public handler b3WorldUpdateSensorEvents(in pWorld as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _world_update_sensor_events(pWorld) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how many shapes entered a sensor in the last step.

Returns: The count.
*/
public handler b3SensorBeginCount() returns Integer
   variable tR as Integer
   unsafe
      put _sensor_begin_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the sensor that something entered.

pIndex: Which item, counted from 1.

Returns: The sensor shape handle, or 0.
*/
public handler b3SensorBeginSensor(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _sensor_begin_sensor(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the shape that entered a sensor.

pIndex: Which item, counted from 1.

Returns: The shape handle, or 0.
*/
public handler b3SensorBeginVisitor(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _sensor_begin_visitor(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how many shapes left a sensor in the last step.

Returns: The count.
*/
public handler b3SensorEndCount() returns Integer
   variable tR as Integer
   unsafe
      put _sensor_end_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the sensor that something left.

pIndex: Which item, counted from 1.

Returns: The sensor shape handle, or 0.
*/
public handler b3SensorEndSensor(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _sensor_end_sensor(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the shape that left a sensor.

pIndex: Which item, counted from 1.

Returns: The shape handle, or 0.
*/
public handler b3SensorEndVisitor(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _sensor_end_visitor(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Collects every body that moved in the last step.

pWorld: A world handle from <b3WorldCreate>.

Returns: How many bodies moved.

Description: The cheap way to draw a scene: bodies that are asleep are not
listed, so a resting world costs nothing. Read the list with <b3MoveBody>
and <b3MoveTransform>, or all of it at once with <b3MovesText>.
*/
public handler b3WorldUpdateMoves(in pWorld as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _world_update_moves(pWorld) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how many bodies the last collected move list holds.

Returns: The count.
*/
public handler b3MoveCount() returns Integer
   variable tR as Integer
   unsafe
      put _move_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the body of one move.

pIndex: Which item, counted from 1.

Returns: The body handle, or 0.
*/
public handler b3MoveBody(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _move_body(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Reports whether a moved body fell asleep at the end of the step.

pIndex: Which item, counted from 1.

Returns: True if it did.
*/
public handler b3MoveFellAsleep(in pIndex as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _move_fell_asleep(pIndex) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Returns where one moved body is now.

pIndex: Which item, counted from 1.

Returns: Seven numbers as text, "x,y,z,qx,qy,qz,qw".
*/
public handler b3MoveTransform(in pIndex as Integer) returns String
   variable tP as Pointer
   unsafe
      put _move_transform(pIndex) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns the whole move list as text.

Returns: One line per body: "body,x,y,z,qx,qy,qz,qw,fellAsleep".

Example:
b3WorldStep sWorld, 1/60, 4
get b3WorldUpdateMoves(sWorld)
repeat for each line tMove in b3MovesText()
   -- item 1 is the body, items 2 to 4 its position
end repeat

Description: One call across the boundary for a whole frame, which is what
makes thousands of bodies drawable from script.
*/
public handler b3MovesText() returns String
   variable tP as Pointer
   unsafe
      put _moves_text() into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Collects the joints whose force or torque passed its threshold in
the last step.

pWorld: A world handle from <b3WorldCreate>.

Returns: How many joints.

Description: Set the thresholds with <b3JointSetForceThreshold> and
<b3JointSetTorqueThreshold>: the way to make a joint breakable.
*/
public handler b3WorldUpdateJointEvents(in pWorld as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _world_update_joint_events(pWorld) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how many joints the last collected joint event list holds.

Returns: The count.
*/
public handler b3JointEventCount() returns Integer
   variable tR as Integer
   unsafe
      put _joint_event_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns one joint that passed its threshold.

pIndex: Which item, counted from 1.

Returns: The joint handle, or 0.
*/
public handler b3JointEventJoint(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _joint_event_joint(pIndex) into tR
   end unsafe
   return tR
end handler

-- =====================================================================
-- Rotations
-- =====================================================================

/**
Summary: Makes the rotation of an angle about an axis.

pAx: The x of the axis.

pAy: The y of the axis.

pAz: The z of the axis.

pRadians: The angle, in radians.

Returns: The quaternion as text, "x,y,z,w".

Example:
put b3QuatFromAxisAngle(0, 1, 0, pi / 2) into tQuarterTurn
*/
public handler b3QuatFromAxisAngle(in pAx as Number, in pAy as Number, in pAz as Number, in pRadians as Number) returns String
   variable tP as Pointer
   unsafe
      put _quat_from_axis_angle(pAx, pAy, pAz, pRadians) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Makes a rotation from three angles.

pRx: The angle about x, in radians.

pRy: The angle about y.

pRz: The angle about z.

Returns: The quaternion as text, "x,y,z,w".
*/
public handler b3QuatFromEuler(in pRx as Number, in pRy as Number, in pRz as Number) returns String
   variable tP as Pointer
   unsafe
      put _quat_from_euler(pRx, pRy, pRz) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Combines two rotations.

pAx: The x of the first rotation.

pAy: The y of the first rotation.

pAz: The z of the first rotation.

pAw: The w of the first rotation.

pBx: The x of the second rotation.

pBy: The y of the second.

pBz: The z of the second.

pBw: The w of the second.

Returns: The quaternion as text, "x,y,z,w".

Description: The result is the second rotation followed by the first.
*/
public handler b3QuatMultiply(in pAx as Number, in pAy as Number, in pAz as Number, in pAw as Number, in pBx as Number, in pBy as Number, in pBz as Number, in pBw as Number) returns String
   variable tP as Pointer
   unsafe
      put _quat_multiply(pAx, pAy, pAz, pAw, pBx, pBy, pBz, pBw) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Turns a direction by a rotation.

pQx: The x part of the rotation quaternion.

pQy: The y part of the rotation quaternion.

pQz: The z part of the rotation quaternion.

pQw: The w (scalar) part of the rotation quaternion.

pX: The x of the direction.

pY: The y of the direction.

pZ: The z of the direction.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3QuatRotate(in pQx as Number, in pQy as Number, in pQz as Number, in pQw as Number, in pX as Number, in pY as Number, in pZ as Number) returns String
   variable tP as Pointer
   unsafe
      put _quat_rotate(pQx, pQy, pQz, pQw, pX, pY, pZ) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Splits a rotation into an axis and an angle.

pQx: The x part of the rotation quaternion.

pQy: The y part of the rotation quaternion.

pQz: The z part of the rotation quaternion.

pQw: The w (scalar) part of the rotation quaternion.

Returns: Four numbers as text, "axisX,axisY,axisZ,radians".
*/
public handler b3QuatToAxisAngle(in pQx as Number, in pQy as Number, in pQz as Number, in pQw as Number) returns String
   variable tP as Pointer
   unsafe
      put _quat_to_axis_angle(pQx, pQy, pQz, pQw) into tP
   end unsafe
   return textOf(tP)
end handler

-- =====================================================================
-- Joints
-- =====================================================================

/**
Summary: Joins two bodies with a hinge.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pPx: The x of the hinge point, in world coordinates.

pPy: The y of the hinge point.

pPz: The z of the hinge point.

pAx: The x of the hinge axis, in world coordinates.

pAy: The y of the axis.

pAz: The z of the axis.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: The bodies stay together at the point and turn only about
the axis, like a door, a wheel on an axle or an elbow. The b3Revolute calls
add limits, a motor and a spring.
*/
public handler b3JointRevolute(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pPx as Number, in pPy as Number, in pPz as Number, in pAx as Number, in pAy as Number, in pAz as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_revolute(pWorld, pBodyA, pBodyB, pPx, pPy, pPz, pAx, pAy, pAz, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Joins two bodies with a slider.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pPx: The x of a point on the slide, in world coordinates.

pPy: The y of the point.

pPz: The z of the point.

pAx: The x of the slide direction, in world coordinates.

pAy: The y of the direction.

pAz: The z of the direction.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: The bodies cannot turn against each other and move only along
the axis: a piston, a lift, a drawer.
*/
public handler b3JointPrismatic(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pPx as Number, in pPy as Number, in pPz as Number, in pAx as Number, in pAy as Number, in pAz as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_prismatic(pWorld, pBodyA, pBodyB, pPx, pPy, pPz, pAx, pAy, pAz, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Joins two bodies with a ball and socket.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pPx: The x of the socket point, in world coordinates.

pPy: The y of the point.

pPz: The z of the point.

pAx: The x of the cone axis, in world coordinates.

pAy: The y of the axis.

pAz: The z of the axis.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: The bodies stay together at the point and turn freely about it:
a shoulder, a rope link. The axis is what the cone and twist limits are
measured from.
*/
public handler b3JointSpherical(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pPx as Number, in pPy as Number, in pPz as Number, in pAx as Number, in pAy as Number, in pAz as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_spherical(pWorld, pBodyA, pBodyB, pPx, pPy, pPz, pAx, pAy, pAz, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Glues two bodies together.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pPx: The x of the weld point, in world coordinates.

pPy: The y of the point.

pPz: The z of the point.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: Rigid by default. Give it a frequency with the b3Weld calls and
it bends like a stiff spring.
*/
public handler b3JointWeld(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pPx as Number, in pPy as Number, in pPz as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_weld(pWorld, pBodyA, pBodyB, pPx, pPy, pPz, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Keeps two points of two bodies a fixed distance apart.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pAx: The x of the point on the first body, in world coordinates.

pAy: The y of that point.

pAz: The z of that point.

pBx: The x of the point on the second body, in world coordinates.

pBy: The y of that point.

pBz: The z of that point.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: A rod, or with the b3Distance calls a spring or a rope with a
minimum and maximum length. The starting distance is the length.
*/
public handler b3JointDistance(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pAx as Number, in pAy as Number, in pAz as Number, in pBx as Number, in pBy as Number, in pBz as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_distance(pWorld, pBodyA, pBodyB, pAx, pAy, pAz, pBx, pBy, pBz, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Joins a wheel to a chassis: it spins, rides a suspension and can
steer.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pPx: The x of the wheel centre, in world coordinates.

pPy: The y of the centre.

pPz: The z of the centre.

pUx: The x of the suspension direction (usually up), in world coordinates.

pUy: The y of that direction.

pUz: The z of that direction.

pSx: The x of the axle the wheel spins about, in world coordinates.

pSy: The y of the axle.

pSz: The z of the axle.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: The first body is the chassis and the second the wheel. The
axle must not point along the suspension.
*/
public handler b3JointWheel(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pPx as Number, in pPy as Number, in pPz as Number, in pUx as Number, in pUy as Number, in pUz as Number, in pSx as Number, in pSy as Number, in pSz as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_wheel(pWorld, pBodyA, pBodyB, pPx, pPy, pPz, pUx, pUy, pUz, pSx, pSy, pSz, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Drives one body relative to another with a force and torque.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: With no settings it does nothing. The b3Motor calls give it a
target velocity or a spring: a top-down character, friction against the
ground, a conveyor.
*/
public handler b3JointMotor(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_motor(pWorld, pBodyA, pBodyB, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Keeps an axis of one body parallel to the same axis of another.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

pAx: The x of the axis to keep parallel, in world coordinates.

pAy: The y of the axis.

pAz: The z of the axis.

pCollide: True if the two joined bodies should still collide with each
other.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).

Description: The bodies are free to move and to turn about the axis: keeping
something upright.
*/
public handler b3JointParallel(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer, in pAx as Number, in pAy as Number, in pAz as Number, in pCollide as Boolean) returns Integer
   variable tR as Integer
   unsafe
      put _joint_parallel(pWorld, pBodyA, pBodyB, pAx, pAy, pAz, asInt(pCollide)) into tR
   end unsafe
   return tR
end handler

/**
Summary: Stops two bodies colliding with each other and does nothing else.

pWorld: A world handle from <b3WorldCreate>.

pBodyA: The first body, in the same world.

pBodyB: The second body, in the same world. It must not be the first.

Returns: A joint handle, or 0 if the arguments were refused (see
<b3LastError>).
*/
public handler b3JointFilter(in pWorld as Integer, in pBodyA as Integer, in pBodyB as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _joint_filter(pWorld, pBodyA, pBodyB) into tR
   end unsafe
   return tR
end handler

/**
Summary: Destroys a joint.

pJoint: A joint handle from one of the b3Joint creators.

pWake: True to wake the two bodies.
*/
public handler b3JointDestroy(in pJoint as Integer, in pWake as Boolean) returns nothing
   unsafe
      _joint_destroy(pJoint, asInt(pWake))
   end unsafe
end handler

/**
Summary: Reports whether a handle names a live joint.

pJoint: A joint handle from one of the b3Joint creators.

Returns: True for a live joint.
*/
public handler b3JointIsValid(in pJoint as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _joint_is_valid(pJoint) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Returns what kind of joint a handle names.

pJoint: A joint handle from one of the b3Joint creators.

Returns: 0 parallel, 1 distance, 2 filter, 3 motor, 4 prismatic, 5 revolute,
6 spherical, 7 weld, 8 wheel; -1 for no joint.
*/
public handler b3JointType(in pJoint as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _joint_type(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the first body of a joint.

pJoint: A joint handle from one of the b3Joint creators.

Returns: The body handle, or 0.
*/
public handler b3JointBodyA(in pJoint as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _joint_body_a(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the second body of a joint.

pJoint: A joint handle from one of the b3Joint creators.

Returns: The body handle, or 0.
*/
public handler b3JointBodyB(in pJoint as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _joint_body_b(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Chooses whether the two bodies of a joint collide with each other.

pJoint: A joint handle from one of the b3Joint creators.

pFlag: True to turn it on, false to turn it off.
*/
public handler b3JointSetCollideConnected(in pJoint as Integer, in pFlag as Boolean) returns nothing
   unsafe
      _joint_set_collide_connected(pJoint, asInt(pFlag))
   end unsafe
end handler

/**
Summary: Reports whether the two bodies of a joint collide with each other.

pJoint: A joint handle from one of the b3Joint creators.

Returns: True if they do.
*/
public handler b3JointCollideConnected(in pJoint as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _joint_collide_connected(pJoint) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Wakes the two bodies of a joint.

pJoint: A joint handle from one of the b3Joint creators.
*/
public handler b3JointWakeBodies(in pJoint as Integer) returns nothing
   unsafe
      _joint_wake_bodies(pJoint)
   end unsafe
end handler

/**
Summary: Returns where a joint is attached to its first body.

pJoint: A joint handle from one of the b3Joint creators.

Returns: Seven numbers as text, "x,y,z,qx,qy,qz,qw".
*/
public handler b3JointLocalFrameA(in pJoint as Integer) returns String
   variable tP as Pointer
   unsafe
      put _joint_local_frame_a(pJoint) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns where a joint is attached to its second body.

pJoint: A joint handle from one of the b3Joint creators.

Returns: Seven numbers as text, "x,y,z,qx,qy,qz,qw".
*/
public handler b3JointLocalFrameB(in pJoint as Integer) returns String
   variable tP as Pointer
   unsafe
      put _joint_local_frame_b(pJoint) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Moves where a joint is attached to its first body.

pJoint: A joint handle from one of the b3Joint creators.

pX: The x of the attachment, in the body's coordinates.

pY: The y of the attachment.

pZ: The z of the attachment.

pQx: The x part of the rotation quaternion.

pQy: The y part of the rotation quaternion.

pQz: The z part of the rotation quaternion.

pQw: The w (scalar) part of the rotation quaternion.

Description: Advanced: the creators place the frames from world points,
which is nearly always what is wanted.
*/
public handler b3JointSetLocalFrameA(in pJoint as Integer, in pX as Number, in pY as Number, in pZ as Number, in pQx as Number, in pQy as Number, in pQz as Number, in pQw as Number) returns nothing
   unsafe
      _joint_set_local_frame_a(pJoint, pX, pY, pZ, pQx, pQy, pQz, pQw)
   end unsafe
end handler

/**
Summary: Moves where a joint is attached to its second body.

pJoint: A joint handle from one of the b3Joint creators.

pX: The x of the attachment, in the body's coordinates.

pY: The y of the attachment.

pZ: The z of the attachment.

pQx: The x part of the rotation quaternion.

pQy: The y part of the rotation quaternion.

pQz: The z part of the rotation quaternion.

pQw: The w (scalar) part of the rotation quaternion.
*/
public handler b3JointSetLocalFrameB(in pJoint as Integer, in pX as Number, in pY as Number, in pZ as Number, in pQx as Number, in pQy as Number, in pQz as Number, in pQw as Number) returns nothing
   unsafe
      _joint_set_local_frame_b(pJoint, pX, pY, pZ, pQx, pQy, pQz, pQw)
   end unsafe
end handler

/**
Summary: Returns the force a joint is applying to hold its bodies.

pJoint: A joint handle from one of the b3Joint creators.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3JointConstraintForce(in pJoint as Integer) returns String
   variable tP as Pointer
