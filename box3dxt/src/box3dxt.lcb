public handler b3BodyApplyTorque(in pBody as Integer, in pTx as Number, in pTy as Number, in pTz as Number, in pWake as Boolean) returns nothing
   unsafe
      _body_apply_torque(pBody, pTx, pTy, pTz, asInt(pWake))
   end unsafe
end handler

