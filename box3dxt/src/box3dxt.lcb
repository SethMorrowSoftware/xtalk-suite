public handler b3WorldIsSleepingEnabled(in pWorld as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _world_is_sleeping_enabled(pWorld) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Turns continuous collision on or off.

pWorld: A world handle from <b3WorldCreate>.

pFlag: True to turn it on, false to turn it off.

