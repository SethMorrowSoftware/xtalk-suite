   end unsafe
   return tR
end handler

/**
Summary: Tunes how stiffly overlapping shapes are pushed apart.

pWorld: A world handle from <b3WorldCreate>.

pHertz: The contact stiffness in cycles per second, 0 to 10000 (30 is the
default).

pDamping: The contact damping ratio, 0 to 1000 (10 is the default).

pSpeed: The fastest that overlap is pushed out, in m/s.

Description: Advanced. The defaults suit almost every scene.
*/
public handler b3WorldSetContactTuning(in pWorld as Integer, in pHertz as Number, in pDamping as Number, in pSpeed as Number) returns nothing
   unsafe
      _world_set_contact_tuning(pWorld, pHertz, pDamping, pSpeed)
   end unsafe
