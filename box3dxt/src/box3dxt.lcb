      put _joint_constraint_force(pJoint) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns the torque a joint is applying to hold its bodies.

pJoint: A joint handle from one of the b3Joint creators.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3JointConstraintTorque(in pJoint as Integer) returns String
   variable tP as Pointer
   unsafe
      put _joint_constraint_torque(pJoint) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns how far apart a joint's anchor points have been pulled.

pJoint: A joint handle from one of the b3Joint creators.

Returns: Metres; 0 for a wheel joint, which Box3D does not measure yet.
*/
public handler b3JointLinearSeparation(in pJoint as Integer) returns Number
   variable tR as Number
   unsafe
      put _joint_linear_separation(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how far a joint has been bent past what it allows.

pJoint: A joint handle from one of the b3Joint creators.

Returns: Radians; 0 for a wheel joint, which Box3D does not measure yet.
*/
public handler b3JointAngularSeparation(in pJoint as Integer) returns Number
   variable tR as Number
   unsafe
      put _joint_angular_separation(pJoint) into tR
   end unsafe
   return tR
end handler

/**
Summary: Sets the force above which a joint reports a joint event.

pJoint: A joint handle from one of the b3Joint creators.

pValue: The force in newtons, 0 or more.
*/
