-- =====================================================================
-- Ray casts and overlap queries
-- =====================================================================

/**
Summary: Limits the ray casts and overlap queries that follow to some
categories.

pCategory: The category bits, a whole number from 0 to 2^53 - 1.

pMask: The mask bits: the categories this one meets.

Description: A query sees a shape when the query's mask includes the shape's
category and the shape's mask includes the query's category. Stays in force
until <b3QueryResetFilter>.
*/
public handler b3QuerySetFilter(in pCategory as Number, in pMask as Number) returns nothing
   unsafe
      _query_set_filter(pCategory, pMask)
   end unsafe
end handler

/**
Summary: Lets ray casts and overlap queries see every shape again.
*/
public handler b3QueryResetFilter() returns nothing
   unsafe
      _query_reset_filter()
   end unsafe
end handler

/**
Summary: Casts a ray through a world and collects everything it passes
through.

pWorld: A world handle from <b3WorldCreate>.

pOx: The x of the start point.

pOy: The y of the start point.

pOz: The z of the start point.

pDx: The x of the travel: how far, not a direction.

pDy: The y of the travel.

pDz: The z of the travel.

Returns: How many shapes were hit; read them, nearest first, with
<b3HitShape>, <b3HitBody>, <b3HitFraction>, <b3HitPoint> and <b3HitNormal>.

Example:
if b3CastRay(sWorld, 0, 10, 0, 0, -20, 0) > 0 then
   put b3HitBody(1) into tFirstBodyBelow
end if
*/
public handler b3CastRay(in pWorld as Integer, in pOx as Number, in pOy as Number, in pOz as Number, in pDx as Number, in pDy as Number, in pDz as Number) returns Integer
   variable tR as Integer
   unsafe
      put _cast_ray(pWorld, pOx, pOy, pOz, pDx, pDy, pDz) into tR
   end unsafe
   return tR
end handler

/**
Summary: Casts a ray through a world and keeps only the first thing it hits.

pWorld: A world handle from <b3WorldCreate>.

pOx: The x of the start point.

pOy: The y of the start point.

pOz: The z of the start point.

pDx: The x of the travel: how far, not a direction.

pDy: The y of the travel.

pDz: The z of the travel.

Returns: 1 if something was hit (read it as hit 1), else 0.
*/
public handler b3CastRayClosest(in pWorld as Integer, in pOx as Number, in pOy as Number, in pOz as Number, in pDx as Number, in pDy as Number, in pDz as Number) returns Integer
   variable tR as Integer
   unsafe
      put _cast_ray_closest(pWorld, pOx, pOy, pOz, pDx, pDy, pDz) into tR
   end unsafe
   return tR
end handler

/**
Summary: Sweeps a sphere through a world and collects everything it touches.

pWorld: A world handle from <b3WorldCreate>.

pOx: The x of the start point.

pOy: The y of the start point.

pOz: The z of the start point.

pRadius: The radius of the swept sphere, in metres.

pDx: The x of the travel: how far, not a direction.

pDy: The y of the travel.

pDz: The z of the travel.

Returns: How many shapes were hit; read them, nearest first, with
<b3HitShape>, <b3HitBody>, <b3HitFraction>, <b3HitPoint> and <b3HitNormal>.
*/
public handler b3CastSphere(in pWorld as Integer, in pOx as Number, in pOy as Number, in pOz as Number, in pRadius as Number, in pDx as Number, in pDy as Number, in pDz as Number) returns Integer
   variable tR as Integer
   unsafe
      put _cast_sphere(pWorld, pOx, pOy, pOz, pRadius, pDx, pDy, pDz) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how many hits the last cast found.

Returns: The count.
*/
public handler b3HitCount() returns Integer
   variable tR as Integer
   unsafe
      put _hit_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the shape of one hit of the last cast.

pIndex: Which item, counted from 1.

Returns: The shape handle, or 0.
*/
public handler b3HitShape(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _hit_shape(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the body of one hit of the last cast.

pIndex: Which item, counted from 1.

Returns: The body handle, or 0.
*/
public handler b3HitBody(in pIndex as Integer) returns Integer
   variable tR as Integer
   unsafe
      put _hit_body(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns how far along the cast one hit was.

pIndex: Which item, counted from 1.

Returns: 0 at the start of the cast, 1 at its end.
*/
public handler b3HitFraction(in pIndex as Integer) returns Number
   variable tR as Number
   unsafe
      put _hit_fraction(pIndex) into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns where one hit of the last cast was.

pIndex: Which item, counted from 1.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3HitPoint(in pIndex as Integer) returns String
   variable tP as Pointer
   unsafe
      put _hit_point(pIndex) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns which way the surface faces at one hit of the last cast.

pIndex: Which item, counted from 1.

Returns: A unit direction as text, "x,y,z".
*/
public handler b3HitNormal(in pIndex as Integer) returns String
   variable tP as Pointer
   unsafe
      put _hit_normal(pIndex) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Lists the shapes whose boxes overlap a box.

pWorld: A world handle from <b3WorldCreate>.

pLx: The lowest x of the box.

pLy: The lowest y.

pLz: The lowest z.

pUx: The highest x of the box.

pUy: The highest y.

pUz: The highest z.

Returns: How many; read them with <b3ListItem>.
*/
public handler b3OverlapAABB(in pWorld as Integer, in pLx as Number, in pLy as Number, in pLz as Number, in pUx as Number, in pUy as Number, in pUz as Number) returns Integer
   variable tR as Integer
   unsafe
      put _overlap_aabb(pWorld, pLx, pLy, pLz, pUx, pUy, pUz) into tR
   end unsafe
   return tR
end handler

/**
Summary: Lists the shapes that overlap a sphere.

pWorld: A world handle from <b3WorldCreate>.

pX: The x of its centre.

pY: The y of its centre.

pZ: The z of its centre.

pRadius: The radius in metres, 0.001 to 10000.

Returns: How many; read them with <b3ListItem>.
*/
public handler b3OverlapSphere(in pWorld as Integer, in pX as Number, in pY as Number, in pZ as Number, in pRadius as Number) returns Integer
   variable tR as Integer
