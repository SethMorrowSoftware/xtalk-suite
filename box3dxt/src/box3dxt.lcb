Summary: Kicks a body at its centre of mass, changing its velocity at once.

pBody: A body handle from <b3BodyCreate>.

pIx: The x component of the impulse.

pIy: The y component of the impulse.

pIz: The z component of the impulse.

pWake: True to wake the body if it is asleep.
*/
public handler b3BodyApplyImpulseToCenter(in pBody as Integer, in pIx as Number, in pIy as Number, in pIz as Number, in pWake as Boolean) returns nothing
   unsafe
      _body_apply_impulse_to_center(pBody, pIx, pIy, pIz, asInt(pWake))
   end unsafe
end handler

/**
Summary: Spins a body, changing its angular velocity at once.

pBody: A body handle from <b3BodyCreate>.

pIx: The x component of the impulse.

pIy: The y component of the impulse.

pIz: The z component of the impulse.

pWake: True to wake the body if it is asleep.
*/
public handler b3BodyApplyAngularImpulse(in pBody as Integer, in pIx as Number, in pIy as Number, in pIz as Number, in pWake as Boolean) returns nothing
   unsafe
      _body_apply_angular_impulse(pBody, pIx, pIy, pIz, asInt(pWake))
   end unsafe
end handler

/**
Summary: Returns the mass of a body.

pBody: A body handle from <b3BodyCreate>.

Returns: Kilograms; 0 for a static or kinematic body, or a dynamic one with
no shapes.
*/
public handler b3BodyMass(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_mass(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Recomputes a body's mass from its shapes.

pBody: A body handle from <b3BodyCreate>.

Description: Only needed after shapes were added, removed or re-weighed with
the update put off.
*/
public handler b3BodyApplyMassFromShapes(in pBody as Integer) returns nothing
   unsafe
      _body_apply_mass_from_shapes(pBody)
   end unsafe
end handler

/**
Summary: Returns a body's centre of mass in its own coordinates.

pBody: A body handle from <b3BodyCreate>.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3BodyLocalCenter(in pBody as Integer) returns String
   variable tP as Pointer
   unsafe
      put _body_local_center(pBody) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns a body's centre of mass in world coordinates.

pBody: A body handle from <b3BodyCreate>.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3BodyWorldCenter(in pBody as Integer) returns String
   variable tP as Pointer
   unsafe
      put _body_world_center(pBody) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Converts a world point into a body's own coordinates.

pBody: A body handle from <b3BodyCreate>.

pX: The x of the world point.

pY: The y of the world point.

pZ: The z of the world point.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3BodyLocalPoint(in pBody as Integer, in pX as Number, in pY as Number, in pZ as Number) returns String
   variable tP as Pointer
   unsafe
