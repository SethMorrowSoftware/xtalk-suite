   end unsafe
   return textOf(tP)
end handler

/**
Summary: Converts a point in a body's own coordinates into a world point.

pBody: A body handle from <b3BodyCreate>.

pX: The x of the point, in the body's coordinates.

pY: The y of the point.

pZ: The z of the point.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3BodyWorldPoint(in pBody as Integer, in pX as Number, in pY as Number, in pZ as Number) returns String
   variable tP as Pointer
   unsafe
      put _body_world_point(pBody, pX, pY, pZ) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Converts a world direction into a body's own coordinates.

pBody: A body handle from <b3BodyCreate>.

pX: The x of the world direction.

pY: The y of the world direction.

pZ: The z of the world direction.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3BodyLocalVector(in pBody as Integer, in pX as Number, in pY as Number, in pZ as Number) returns String
   variable tP as Pointer
   unsafe
      put _body_local_vector(pBody, pX, pY, pZ) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Converts a direction in a body's own coordinates into a world
direction.

pBody: A body handle from <b3BodyCreate>.

pX: The x of the direction, in the body's coordinates.

pY: The y of the direction.

pZ: The z of the direction.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3BodyWorldVector(in pBody as Integer, in pX as Number, in pY as Number, in pZ as Number) returns String
   variable tP as Pointer
   unsafe
      put _body_world_vector(pBody, pX, pY, pZ) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns how fast a point of a body is moving.

pBody: A body handle from <b3BodyCreate>.

pX: The x of the world point.

pY: The y of the world point.

pZ: The z of the world point.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3BodyPointVelocity(in pBody as Integer, in pX as Number, in pY as Number, in pZ as Number) returns String
   variable tP as Pointer
   unsafe
      put _body_point_velocity(pBody, pX, pY, pZ) into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Sets how quickly a body's movement dies away.

pBody: A body handle from <b3BodyCreate>.

pValue: The damping, 0 (none) or more.
*/
public handler b3BodySetLinearDamping(in pBody as Integer, in pValue as Number) returns nothing
   unsafe
      _body_set_linear_damping(pBody, pValue)
   end unsafe
end handler

/**
Summary: Returns how quickly a body's movement dies away.

pBody: A body handle from <b3BodyCreate>.

Returns: The damping.
*/
public handler b3BodyLinearDamping(in pBody as Integer) returns Number
   variable tR as Number
   unsafe
      put _body_linear_damping(pBody) into tR
   end unsafe
   return tR
end handler

/**
Summary: Sets how quickly a body's spin dies away.

pBody: A body handle from <b3BodyCreate>.

pValue: The damping, 0 (none) or more.
