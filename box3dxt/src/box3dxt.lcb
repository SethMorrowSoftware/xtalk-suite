-- =====================================================================
-- Helpers (private)
-- =====================================================================
-- A Boolean for the C side, which takes an int.
private handler asInt(in pFlag as Boolean) returns Integer
   if pFlag then
      return 1
   end if
   return 0
end handler

-- The binding and the native library must come from the same release: a
-- changed export list read through an old binding is a marshalling fault in
-- a call that looks right in both files. The number is B3X_ABI_VERSION in
-- src/box3d_shim.c (the suite's check-binary-freshness.py compares the two).
-- Called where a script first reaches the library: b3WorldCreate, which
-- everything else needs a handle from, and b3LibraryVersion.
private handler checkABI()
   variable tV as Integer
   unsafe
      put _abi_version() into tV
   end unsafe
   if tV is not 1 then
      throw "box3dxt: incompatible native library (this binding needs ABI 1) - update the box3dxt library beside the engine"
   end if
end handler

-- A text result of the shim, copied into a String. The shim hands back a
-- pointer to a buffer IT owns, so the foreign handlers return Pointer and
-- never ZStringNative: the engine frees a returned C string, and freeing a
-- static buffer kills the host (the first engine run, 2026-11-20). The
-- bytes are ASCII; 4 is the engine's MCStringEncoding value for UTF-8,
-- sodiumxt's proven way to build a String from bytes.
private handler textOf(in pText as Pointer) returns String
   variable tLength as Integer
   variable tResult as String
   variable tOk as CBool
   unsafe
      put _text_length(pText) into tLength
      put MCStringCreateWithBytes(pText, tLength, 4, false, tResult) into tOk
   end unsafe
   if not tOk then
      return ""
   end if
   return tResult
end handler

-- =====================================================================
-- The library
-- =====================================================================

/**
Summary: Returns the ABI number of the native library that is loaded.

Returns: The ABI number; this binding needs 1.
*/
public handler b3ABIVersion() returns Integer
   variable tR as Integer
   unsafe
      put _abi_version() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the versions of the native library and of Box3D inside it.

Returns: Text such as "box3dxt ABI 1; Box3D 0.2.0".

Example:
put b3LibraryVersion() into field "status"

Description: The first call that reaches the native library. It throws if
the library on disk has a different ABI from this binding, which means the
two come from different releases.
*/
public handler b3LibraryVersion() returns String
   variable tP as Pointer
   checkABI()
   unsafe
      put _library_version() into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns why the last refused call was refused.

Returns: A short sentence, or empty if nothing has been refused since the
last successful create.

Description: A call given a bad argument does nothing and returns 0 or
empty; it never throws. This says what was wrong. Creators (worlds, bodies,
shapes, joints) set it; a successful create clears it.
*/
public handler b3LastError() returns String
   variable tP as Pointer
   unsafe
      put _last_error() into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Returns how many of Box3D's internal checks have failed since the
library loaded.

Returns: The count. Always 0 with a released library, which is built without
those checks.

Description: For people who build the native library themselves with Box3D's
asserts on. A failed check is counted and the call carries on; it never
stops the host.
*/
public handler b3AssertCount() returns Integer
   variable tR as Integer
   unsafe
      put _assert_count() into tR
   end unsafe
   return tR
end handler

/**
Summary: Returns the last Box3D internal check that failed.

Returns: Text "condition (file:line)", or empty.
*/
public handler b3AssertText() returns String
   variable tP as Pointer
   unsafe
      put _assert_text() into tP
   end unsafe
   return textOf(tP)
end handler

/**
Summary: Reports whether the solver is using AVX2 on this computer.

Returns: True on an x86-64 processor with AVX2; false elsewhere (the solver
then uses SSE2, NEON or plain code).
*/
public handler b3HasAVX2() returns Boolean
   variable tR as Integer
   unsafe
      put _has_avx2() into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Returns how many bodies have been removed because their motion
stopped being a number.

Returns: The count since the library loaded.

Description: A scene can drive the solver to NaN: most often a joint between
bodies that have no shapes, and so no mass. After every step the binding
removes such a body, with its shapes and joints, because leaving it would
crash the host later. A script that sees this number grow should look at
<b3LastError> and at how the bodies it lost were built.
*/
public handler b3UnstableCount() returns Integer
   variable tR as Integer
   unsafe
      put _unstable_count() into tR
   end unsafe
   return tR
end handler

-- =====================================================================
-- Worlds
-- =====================================================================

/**
Summary: Creates a physics world.

pGx: The x component of gravity in m/s^2.

pGy: The y component of gravity in m/s^2; y points up, so -10 is down.

pGz: The z component of gravity in m/s^2.

pWorkers: How many worker threads the world steps with, 1 to 32. Use 1
unless a scene has thousands of bodies.

Returns: A world handle, or 0 if the arguments were refused or 128 worlds
already exist.

Example:
put b3WorldCreate(0, -10, 0, 1) into sWorld

Description: Everything else lives in a world. Distances are metres, time is
seconds, mass is kilograms and angles are radians; y points up. Advance it
with <b3WorldStep> and free it with <b3WorldDestroy>.
*/
public handler b3WorldCreate(in pGx as Number, in pGy as Number, in pGz as Number, in pWorkers as Integer) returns Integer
   variable tR as Integer
   checkABI()
   unsafe
      put _world_create(pGx, pGy, pGz, pWorkers) into tR
   end unsafe
   return tR
end handler

/**
Summary: Destroys a world and everything in it.

pWorld: A world handle from <b3WorldCreate>.

Description: Every body, shape and joint of the world is destroyed with it
and their handles go dead. A dead or 0 handle is ignored.
*/
public handler b3WorldDestroy(in pWorld as Integer) returns nothing
   unsafe
      _world_destroy(pWorld)
   end unsafe
end handler

/**
Summary: Reports whether a handle names a live world.

pWorld: A world handle from <b3WorldCreate>.

Returns: True for a live world.
*/
public handler b3WorldIsValid(in pWorld as Integer) returns Boolean
   variable tR as Integer
   unsafe
      put _world_is_valid(pWorld) into tR
   end unsafe
   return tR is not 0
end handler

/**
Summary: Advances a world by a slice of time.

pWorld: A world handle from <b3WorldCreate>.

pSeconds: The time to advance, in seconds: above 0, at most 1. 1/60 is the
usual choice.

pSubsteps: How many sub-steps the solver takes, 1 to 64. 4 is the usual
choice.

Example:
b3WorldStep sWorld, 1/60, 4

Description: Call it at a fixed rate with a fixed step: once per frame with
1/60 and 4 sub-steps suits most scenes. Read positions afterwards
(<b3WorldUpdateMoves> gives every body that moved in one call). A step of 0
seconds, or more than 1, is ignored.
*/
public handler b3WorldStep(in pWorld as Integer, in pSeconds as Number, in pSubsteps as Integer) returns nothing
   unsafe
      _world_step(pWorld, pSeconds, pSubsteps)
   end unsafe
end handler

/**
Summary: Sets the gravity of a world.

pWorld: A world handle from <b3WorldCreate>.

pGx: The x component of gravity in m/s^2.

pGy: The y component of gravity in m/s^2; y points up, so -10 is down.

pGz: The z component of gravity in m/s^2.
*/
public handler b3WorldSetGravity(in pWorld as Integer, in pGx as Number, in pGy as Number, in pGz as Number) returns nothing
   unsafe
      _world_set_gravity(pWorld, pGx, pGy, pGz)
   end unsafe
end handler

/**
Summary: Returns the gravity of a world.

pWorld: A world handle from <b3WorldCreate>.

Returns: The three numbers as text, "x,y,z".
*/
public handler b3WorldGravity(in pWorld as Integer) returns String
   variable tP as Pointer
   unsafe
      put _world_gravity(pWorld) into tP
   end unsafe
   return textOf(tP)
end handler

