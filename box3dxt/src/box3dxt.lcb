pBody: A body handle from <b3BodyCreate>.

pFx: The x component of the force, in newtons.

pFy: The y component of the force.

pFz: The z component of the force.

pWake: True to wake the body if it is asleep.
*/
public handler b3BodyApplyForceToCenter(in pBody as Integer, in pFx as Number, in pFy as Number, in pFz as Number, in pWake as Boolean) returns nothing
   unsafe
      _body_apply_force_to_center(pBody, pFx, pFy, pFz, asInt(pWake))
   end unsafe
end handler

