/**
Summary: Returns the fastest any body in a world may move.

pWorld: A world handle from <b3WorldCreate>.

Returns: The speed in m/s.
*/
public handler b3WorldMaxLinearSpeed(in pWorld as Integer) returns Number
   variable tR as Number
   unsafe
      put _world_max_linear_speed(pWorld) into tR
   end unsafe
   return tR
end handler

