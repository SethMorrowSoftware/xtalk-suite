end sweepEveryHandler
-- <<< END SWEEP <<<

-- ---------------------------------------------------------------------
put 0 into sPassed
put 0 into sFailed
put "INFO engine " & the version && the platform && the processor & return
try
   set the revLibraryMapping["box3dxt"] to $1
   load extension from file $0
   check "the extension loads", the result is empty and "org.openxtalk.library.boxthreed" is among the lines of the loadedExtensions, \
         "result '" & oneLine(the result) & "'"
   if sFailed is 0 then
      put "INFO " & b3LibraryVersion() & return
      testLibrary
      testDrop
      testQueriesAndEvents
      testJointsAndGeometry
      testTypedBoundary
      testModel $2
      testRender
      sweepEveryHandler
      check "nothing above tripped a Box3D assert or lost a body", b3AssertCount() is 0 and b3UnstableCount() is 0, \
            b3AssertCount() && b3AssertText() && b3UnstableCount()
   end if
catch tError
   check "the run finished", false, oneLine(tError)
end try
put "SUMMARY " & sPassed && sFailed & return
quit sFailed
?>
