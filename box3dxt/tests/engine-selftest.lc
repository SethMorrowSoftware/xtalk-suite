<?lc
-- engine-selftest.lc - box3dxt on a REAL engine, with no window.
--
-- Run by OXT-Beyond's server engine (server-community, from the -binaries
-- archive of a release), which is the same engine core, the same LCB virtual
-- machine and the same foreign-function interface as the IDE's:
--
--   server-community tests/engine-selftest.lc MODULE LIBRARY MODEL
--      MODULE   box3dxt.lcm, compiled from src/box3dxt.lcb by lc-compile
--      LIBRARY  the built native library WITHOUT its extension
--               (.../box3dxt for .../box3dxt.so)
--      MODEL    the full path of tests/models/teapot.obj (a missing one is
--               a FAIL, not a skipped scene)
--
-- tests/smoke_test.c proves the C shim. This proves the layer above it, the
-- one a compile cannot: that every binding resolves by name in the built
-- library, that every argument and result marshals (a Boolean as an int, a
-- C string as text, a double as a number), and that a scene built from
-- SCRIPT simulates. Two halves:
--
--   the SCENES, written by hand: a drop, a ray, events, a hinge, a hull,
--     and a real model read from its .obj file;
--   the SWEEP, generated (tools/check-lcb-signatures.py --write, and the
--     gate holds it): every public handler called once with zeros. Zeros
--     are safe by the binding's contract (a 0 handle is a no-op), so a call
--     that throws or kills the engine here is a binding that does not match
--     its C definition.
--
-- Every check prints PASS or FAIL, then a line SUMMARY passed failed; the
-- exit status is the number of failures (1 when the run did not finish).
-- What this is NOT: a pass in the IDE or on Windows, macOS, Android or the
-- web. It runs the Linux x86-64 library on the Linux x86-64 server engine.

local sPassed, sFailed

on check pName, pOk, pDetail
   if pOk then
      add 1 to sPassed
      put "PASS " & pName & return
   else
      add 1 to sFailed
      put "FAIL " & pName & " - " & pDetail & return
      put "::error title=box3dxt engine self-test::" & pName & " - " & pDetail & return
   end if
end check

function near pA, pB, pTolerance
   if pA is not a number or pB is not a number then return false
   return abs(pA - pB) <= pTolerance
end near

function oneLine pText
   replace return with " " in pText
   return pText
end oneLine

command stepWorld pWorld, pSteps
   repeat pSteps times
      b3WorldStep pWorld, 1/60, 4
   end repeat
end stepWorld

-- ---------------------------------------------------------------------
-- The scenes
-- ---------------------------------------------------------------------
command testLibrary
   check "ABI", b3ABIVersion() is 2, b3ABIVersion()
   check "version text", b3LibraryVersion() begins with "box3dxt ABI 2; Box3D ", b3LibraryVersion()
   check "a Boolean comes back as a Boolean", b3HasAVX2() is true or b3HasAVX2() is false, b3HasAVX2()
   check "no asserts at load", b3AssertCount() is 0 and b3AssertText() is empty, b3AssertText()
end testLibrary

command testDrop
   local tWorld, tGround, tBall, tShape, tBefore
   put b3WorldCreate(0, -10, 0, 1) into tWorld
   check "world created", tWorld > 0 and b3WorldIsValid(tWorld) is true, tWorld && b3LastError()
   check "gravity is text with items", b3WorldGravity(tWorld) is "0,-10,0", b3WorldGravity(tWorld)
   put b3BodyCreate(tWorld, 0, 0, -1, 0) into tGround
   check "floor shape", b3ShapeAddBox(tGround, 20, 1, 20, 0, 0.6, 0) > 0, b3LastError()
   put b3BodyCreate(tWorld, 2, 0, 5, 0) into tBall
   put b3ShapeAddSphere(tBall, 0, 0, 0, 0.5, 1, 0.6, 0) into tShape
   check "ball shape", tShape > 0 and b3ShapeBody(tShape) is tBall, tShape && b3LastError()
   check "position text", b3BodyPosition(tBall) is "0,5,0", b3BodyPosition(tBall)
   check "mass of a 0.5 m ball of density 1", near(b3BodyMass(tBall), 4/3 * pi * 0.125, 0.001), b3BodyMass(tBall)
   check "counts", b3WorldBodyCount(tWorld) is 2 and b3WorldShapeCount(tWorld) is 2 and b3BodyShapeCount(tBall) is 1, \
         b3WorldBodyCount(tWorld) && b3WorldShapeCount(tWorld)
   put b3BodyY(tBall) into tBefore
   stepWorld tWorld, 30
   check "it falls", b3BodyY(tBall) < tBefore - 0.5 and item 2 of b3BodyVelocity(tBall) < -1, b3BodyY(tBall) && b3BodyVelocity(tBall)
   stepWorld tWorld, 240
   check "it rests on the floor", near(b3BodyY(tBall), 0.5, 0.03), b3BodyY(tBall)
   check "transform has seven items", the number of items of b3BodyTransform(tBall) is 7, b3BodyTransform(tBall)
   check "matrix has twelve items", the number of items of b3BodyMatrix(tBall) is 12, b3BodyMatrix(tBall)

   -- Booleans, both ways across the boundary
   b3BodySetBullet tBall, true
   check "Boolean in, Boolean out (true)", b3BodyIsBullet(tBall) is true, b3BodyIsBullet(tBall)
   b3BodySetBullet tBall, false
   check "Boolean in, Boolean out (false)", b3BodyIsBullet(tBall) is false, b3BodyIsBullet(tBall)
   b3BodySetMotionLocks tBall, false, true, false, true, false, true
   check "six Booleans in one call", b3BodyMotionLocks(tBall) is "0,1,0,1,0,1", b3BodyMotionLocks(tBall)
   b3BodySetMotionLocks tBall, false, false, false, false, false, false

   -- an impulse, a teleport, the type
   b3BodyApplyImpulseToCenter tBall, 0, 5, 0, true
   check "an impulse changes the velocity at once", item 2 of b3BodyVelocity(tBall) > 1, b3BodyVelocity(tBall)
   b3BodySetTransform tBall, 3, 4, 5, 0, 0, 0, 1
   check "teleport", near(b3BodyX(tBall), 3, 0.0001) and near(b3BodyY(tBall), 4, 0.0001) and near(b3BodyZ(tBall), 5, 0.0001), b3BodyPosition(tBall)
   b3BodySetType tBall, 1
   check "type", b3BodyType(tBall) is 1 and b3BodyType(0) is 0, b3BodyType(tBall)
   b3BodySetType tBall, 2

   -- refusals: 0 or empty back, an explanation, no throw
   check "a negative radius is refused", b3ShapeAddSphere(tBall, 0, 0, 0, -1, 1, 0.6, 0) is 0 and b3LastError() is not empty, b3LastError()
   check "a dead handle reads as nothing", b3BodyX(987654) is 0 and b3BodyPosition(987654) is empty and b3BodyIsValid(987654) is false, \
         b3BodyX(987654) && b3BodyPosition(987654)
   b3BodyDestroy tBall
   check "destroyed: the handle is dead and its shape with it", b3BodyIsValid(tBall) is false and b3ShapeIsValid(tShape) is false, \
         b3BodyIsValid(tBall) && b3ShapeIsValid(tShape)
   b3BodyDestroy tBall
   b3BodySetPosition tBall, 1, 2, 3
   check "calls on a dead handle are harmless", b3WorldBodyCount(tWorld) is 1, b3WorldBodyCount(tWorld)
   b3WorldDestroy tWorld
   check "world destroyed", b3WorldIsValid(tWorld) is false and b3BodyIsValid(tGround) is false, b3WorldIsValid(tWorld)
end testDrop

command testQueriesAndEvents
   local tWorld, tGround, tBox, tBoxShape, tBall, tBallShape, tBegins, tMoves, tSawBall, tZone, tZoneShape, tEnters
   put b3WorldCreate(0, -10, 0, 1) into tWorld
   put b3BodyCreate(tWorld, 0, 0, -1, 0) into tGround
   get b3ShapeAddBox(tGround, 20, 1, 20, 0, 0.6, 0)
   put b3BodyCreate(tWorld, 0, 0, 3, 0) into tBox
   put b3ShapeAddBox(tBox, 1, 0.5, 1, 0, 0.6, 0) into tBoxShape
   b3WorldStep tWorld, 1/60, 4

   check "a ray straight down hits the box, then the floor", b3CastRay(tWorld, 0, 10, 0, 0, -20, 0) is 2 and b3HitCount() is 2, b3HitCount()
   check "nearest first", b3HitShape(1) is tBoxShape and b3HitBody(1) is tBox and b3HitBody(2) is tGround, b3HitShape(1) && b3HitBody(1)
   check "hit fraction", near(b3HitFraction(1), 6.5 / 20, 0.001), b3HitFraction(1)
   check "hit point and normal are text", near(item 2 of b3HitPoint(1), 3.5, 0.001) and near(item 2 of b3HitNormal(1), 1, 0.001), \
         b3HitPoint(1) && b3HitNormal(1)
   check "closest", b3CastRayClosest(tWorld, 0, 10, 0, 0, -20, 0) is 1 and b3HitShape(1) is tBoxShape, b3HitShape(1)
   check "a miss", b3CastRay(tWorld, 50, 10, 50, 0, 5, 0) is 0 and b3HitShape(1) is 0, b3HitCount()
   check "overlap box", b3OverlapAABB(tWorld, -0.5, 2.9, -0.5, 0.5, 3.1, 0.5) is 1 and b3ListItem(1) is tBoxShape and b3ListCount() is 1, b3ListCount()
   check "list index out of range", b3ListItem(0) is 0 and b3ListItem(2) is 0, b3ListItem(2)
   -- a shape's category starts as EVERY bit, so a query filter only bites
   -- once a shape has been given a category of its own
   b3ShapeSetFilter tBoxShape, 4, 65535, 0
   b3QuerySetFilter 1, 2
   check "a filter that skips the box", b3CastRay(tWorld, 0, 10, 0, 0, -20, 0) is 1 and b3HitBody(1) is tGround, b3HitCount()
   b3QueryResetFilter
   check "filter reset (a zero-argument command)", b3CastRay(tWorld, 0, 10, 0, 0, -20, 0) is 2, b3HitCount()

   -- events: off by default, so ask for them
   b3ShapeOptionsSetEvents true, true, true
   put b3BodyCreate(tWorld, 2, 5, 3, 0) into tBall
   put b3ShapeAddSphere(tBall, 0, 0, 0, 0.5, 1, 0.6, 0) into tBallShape
   b3ShapeOptionsReset
   check "events option reached the shape", b3ShapeAreContactEventsEnabled(tBallShape) is true and b3ShapeAreHitEventsEnabled(tBallShape) is true, \
         b3ShapeAreContactEventsEnabled(tBallShape)
   put 0 into tBegins
   put 0 into tMoves
   put false into tSawBall
   repeat 120 times
      b3WorldStep tWorld, 1/60, 4
      if b3WorldUpdateContactEvents(tWorld) > 0 and b3ContactBeginCount() > 0 then
         add b3ContactBeginCount() to tBegins
         if b3ContactBeginShapeA(1) is tBallShape or b3ContactBeginShapeB(1) is tBallShape then put true into tSawBall
      end if
      if b3WorldUpdateMoves(tWorld) > 0 then
         add 1 to tMoves
         if tMoves is 1 then
            check "the move list names the ball", b3MoveBody(1) is tBall and b3MoveCount() is 1, b3MoveBody(1)
            check "moves text: one line, nine items", the number of lines of b3MovesText() is 1 and the number of items of line 1 of b3MovesText() is 9 \
                  and item 1 of b3MovesText() is tBall, oneLine(b3MovesText())
         end if
      end if
   end repeat
   check "one begin-touch event, naming the ball", tBegins is 1 and tSawBall, tBegins && tSawBall
   check "the ball moved for a while", tMoves > 20, tMoves
   stepWorld tWorld, 240
   check "then fell asleep", b3BodyIsAwake(tBall) is false and b3WorldAwakeBodyCount(tWorld) is 0, b3WorldAwakeBodyCount(tWorld)
   check "a sleeping world reports no moves", b3WorldUpdateMoves(tWorld) is 0, b3MoveCount()

   -- a sensor
   b3ShapeOptionsSetSensor true
   b3ShapeOptionsSetEvents false, false, true
   put b3BodyCreate(tWorld, 0, 10, 3, 0) into tZone
   put b3ShapeAddSphere(tZone, 0, 0, 0, 1, 0, 0, 0) into tZoneShape
   b3ShapeOptionsReset
   check "sensor shape", b3ShapeIsSensor(tZoneShape) is true and b3ShapeIsSensor(tBallShape) is false, b3ShapeIsSensor(tZoneShape)
   b3BodySetTransform tBall, 10, 6, 0, 0, 0, 0, 1
   b3BodySetAwake tBall, true
   put 0 into tEnters
   repeat 120 times
      b3WorldStep tWorld, 1/60, 4
      if b3WorldUpdateSensorEvents(tWorld) > 0 and b3SensorBeginCount() > 0 then
         if b3SensorBeginSensor(1) is tZoneShape and b3SensorBeginVisitor(1) is tBallShape then add 1 to tEnters
      end if
   end repeat
   check "the ball entered the sensor once", tEnters is 1, tEnters
   b3WorldDestroy tWorld
end testQueriesAndEvents

command testJointsAndGeometry
   local tWorld, tAnchor, tArm, tHinge, tQuat, tHull, tGround, tMesh, tField, tCount
   put b3WorldCreate(0, -10, 0, 1) into tWorld
   put b3BodyCreate(tWorld, 0, 0, 10, 0) into tAnchor
   get b3ShapeAddBox(tAnchor, 0.1, 0.1, 0.1, 0, 0.6, 0)
   put b3BodyCreate(tWorld, 2, 1, 10, 0) into tArm
   get b3ShapeAddBox(tArm, 1, 0.1, 0.1, 1, 0.6, 0)
   put b3JointRevolute(tWorld, tAnchor, tArm, 0, 10, 0, 0, 0, 1, false) into tHinge
   check "hinge", tHinge > 0 and b3JointType(tHinge) is 5 and b3JointIsValid(tHinge) is true, tHinge && b3LastError()
   check "its bodies", b3JointBodyA(tHinge) is tAnchor and b3JointBodyB(tHinge) is tArm and b3JointCollideConnected(tHinge) is false, b3JointBodyA(tHinge)
   stepWorld tWorld, 45
   check "the arm swings down about z", b3RevoluteAngle(tHinge) < -0.5 and b3BodyY(tArm) < 9.8, b3RevoluteAngle(tHinge) && b3BodyY(tArm)
   check "and stays on the hinge", near(sqrt(b3BodyX(tArm) ^ 2 + (b3BodyY(tArm) - 10) ^ 2), 1, 0.02), b3BodyPosition(tArm)
   b3RevoluteSetLimits tHinge, -0.25, 0.25
   b3RevoluteEnableLimit tHinge, true
   check "limit set and on", b3RevoluteIsLimitEnabled(tHinge) is true and near(b3RevoluteLowerLimit(tHinge), -0.25, 0.0001) \
         and near(b3RevoluteUpperLimit(tHinge), 0.25, 0.0001), b3RevoluteLowerLimit(tHinge)
   stepWorld tWorld, 240
   check "the limit holds the arm", near(b3RevoluteAngle(tHinge), -0.25, 0.03), b3RevoluteAngle(tHinge)
   b3RevoluteSetMotorSpeed tHinge, 1.5
   check "a scalar joint setting round-trips", near(b3RevoluteMotorSpeed(tHinge), 1.5, 0.0001), b3RevoluteMotorSpeed(tHinge)
   check "a revolute call on no joint reads 0", b3RevoluteMotorSpeed(0) is 0 and b3PrismaticSpeed(tHinge) is 0, b3PrismaticSpeed(tHinge)
   check "the same two bodies twice is refused politely", b3JointRevolute(tWorld, tArm, tArm, 0, 10, 0, 0, 0, 1, false) is 0 and b3LastError() is not empty, b3LastError()
   b3JointDestroy tHinge, true
   check "joint destroyed", b3JointIsValid(tHinge) is false and b3JointType(tHinge) is -1, b3JointType(tHinge)

   -- rotations
   put b3QuatFromAxisAngle(0, 1, 0, pi / 2) into tQuat
   check "quaternion of a quarter turn about y", near(item 2 of tQuat, sqrt(0.5), 0.0001) and near(item 4 of tQuat, sqrt(0.5), 0.0001) \
         and near(item 1 of tQuat, 0, 0.0001), tQuat
   check "it turns x into -z", near(item 3 of b3QuatRotate(item 1 of tQuat, item 2 of tQuat, item 3 of tQuat, item 4 of tQuat, 1, 0, 0), -1, 0.0001), \
         b3QuatRotate(item 1 of tQuat, item 2 of tQuat, item 3 of tQuat, item 4 of tQuat, 1, 0, 0)

   -- a hull, a mesh and a height field from the geometry buffers
   b3GeometryBegin
   repeat for each item tX in "-1,1"
      repeat for each item tY in "-1,1"
         repeat for each item tZ in "-1,1"
            get b3GeometryAddPoint(tX * 0.5, tY * 0.25, tZ * 0.5)
         end repeat
      end repeat
   end repeat
   check "eight points", b3GeometryPointCount() is 8, b3GeometryPointCount()
   put b3ShapeAddHull(tArm, 1, 0.6, 0) into tHull
   check "hull", tHull > 0 and b3ShapeType(tHull) is 3, tHull && b3LastError()
   put b3BodyCreate(tWorld, 0, 30, 0, 0) into tGround
   b3GeometryBegin
   get b3GeometryAddPoint(-5, 0, -5)
   get b3GeometryAddPoint(5, 0, -5)
   get b3GeometryAddPoint(5, 0, 5)
   get b3GeometryAddPoint(-5, 0, 5)
   check "triangles count up", b3GeometryAddTriangle(1, 3, 2) is 1 and b3GeometryAddTriangle(1, 4, 3) is 2, b3LastError()
   put b3ShapeAddMesh(tGround, 0.6, 0) into tMesh
   check "mesh", tMesh > 0 and b3ShapeType(tMesh) is 4, tMesh && b3LastError()
   check "a mesh on a moving body is refused", b3ShapeAddMesh(tArm, 0.6, 0) is 0 and b3LastError() is not empty, b3LastError()
   check "a ray lands on the mesh", b3CastRayClosest(tWorld, 30, 5, 0, 0, -10, 0) is 1 and b3HitShape(1) is tMesh and near(item 2 of b3HitPoint(1), 0, 0.01), b3HitPoint(1)
   b3GeometryBegin
   put 0 into tCount
   repeat 16 times
      add 1 to tCount
      get b3GeometryAddHeight((tCount mod 4) * 0.5)
   end repeat
   put b3ShapeAddHeightField(b3BodyCreate(tWorld, 0, 60, 0, 0), 4, 4, 2, 1, 2, 0.6, 0) into tField
   check "height field", tField > 0 and b3ShapeType(tField) is 2, tField && b3LastError()
   b3WorldDestroy tWorld
end testJointsAndGeometry

-- A REAL MODEL, loaded the way a stack would: the Utah teapot's .obj file
-- (tests/models/teapot.obj) read as text, its "v" lines into
-- b3GeometryAddPoint and its "f" lines into b3GeometryAddTriangle. The C
-- smoke test checks the same model against a ray-triangle test of its own;
-- this checks that thousands of points and triangles cross the binding from
-- SCRIPT and make the same shapes.
command testModel pPath
   local tData, tLine, tPoints, tTriangles, tTop, tWorld, tGround, tPot, tMesh
   local tFalling, tHull, tSteps, tMass
   put url ("binfile:" & pPath) into tData
   check "the model file is read", the number of lines of tData > 1000, "'" & pPath & "': " & the result
   if the number of lines of tData <= 1000 then exit testModel
   put b3WorldCreate(0, -10, 0, 1) into tWorld
   put b3BodyCreate(tWorld, 0, 0, -0.5, 0) into tGround
   get b3ShapeAddBox(tGround, 20, 0.5, 20, 0, 0.6, 0)

   -- the mesh: every point, then every triangle (an .obj counts points from 1,
   -- and so does b3GeometryAddTriangle)
   put 0 into tPoints
   put 0 into tTriangles
   put 0 into tTop
   b3GeometryBegin
   repeat for each line tLine in tData
      if word 1 of tLine is "v" then
         put b3GeometryAddPoint(word 2 of tLine + 0, word 3 of tLine + 0, word 4 of tLine + 0) into tPoints
         put max(tTop, word 3 of tLine) into tTop
      else if word 1 of tLine is "f" then
         put b3GeometryAddTriangle(word 2 of tLine + 0, word 3 of tLine + 0, word 4 of tLine + 0) into tTriangles
      end if
   end repeat
   check "every point and triangle of the model was taken", tPoints is 3644 and tTriangles is 6320 and b3GeometryPointCount() is 3644, \
         tPoints && tTriangles && b3LastError()
   put b3BodyCreate(tWorld, 0, 0, 0, 0) into tPot
   put b3ShapeAddMesh(tPot, 0.6, 0) into tMesh
   check "the teapot is a mesh", tMesh > 0 and b3ShapeType(tMesh) is 4, tMesh && b3LastError()
   check "a ray from above lands on its knob", b3CastRayClosest(tWorld, 0.0131, 6, 0.0173, 0, -5.9, 0) is 1 and b3HitShape(1) is tMesh \
         and near(item 2 of b3HitPoint(1), tTop, 0.05), b3HitCount() && b3HitPoint(1) && "top" && tTop
   check "a ray from the side lands on its body", b3CastRayClosest(tWorld, -6, 1.0, 0.5, 12, 0, 0) is 1 and b3HitShape(1) is tMesh \
         and item 1 of b3HitPoint(1) < 0, b3HitCount() && b3HitPoint(1)
   -- a mesh is ONE-SIDED: from inside the pot a ray meets only the backs of
   -- its triangles, and passes through
   check "a ray from inside the pot passes out through it", b3CastRayClosest(tWorld, 0.0131, 1, 0.0173, 0, 10, 0) is 0, b3HitCount() && b3HitPoint(1)

   -- the same file as a convex hull on a body that falls, at 0.3 of its size
   put b3BodyCreate(tWorld, 2, 8, 1, 8) into tFalling
   b3GeometryBegin
   repeat for each line tLine in tData
      if word 1 of tLine is "v" then get b3GeometryAddPoint(word 2 of tLine * 0.3, word 3 of tLine * 0.3, word 4 of tLine * 0.3)
   end repeat
   put b3ShapeAddHull(tFalling, 1, 0.6, 0) into tHull
   check "the teapot's points make a hull", tHull > 0 and b3ShapeType(tHull) is 3, tHull && b3LastError()
   put b3BodyMass(tFalling) into tMass
   check "the hull weighs more than the pot holds and less than its box", tMass > 0.69 and tMass < 2.19, tMass
   put 0 into tSteps
   repeat while b3BodyIsAwake(tFalling) and tSteps < 900
      b3WorldStep tWorld, 1/60, 4
      add 1 to tSteps
   end repeat
   check "the falling teapot comes to rest on the floor", b3BodyIsAwake(tFalling) is false and b3BodyY(tFalling) > -0.1 and b3BodyY(tFalling) < 1.5, \
         tSteps && b3BodyPosition(tFalling)
   b3WorldDestroy tWorld
   check "the model's world is gone", b3ShapeIsValid(tMesh) is false and b3BodyIsValid(tFalling) is false, b3ShapeIsValid(tMesh)
end testModel

-- The typed boundary (suite engine note 6.4): an EMPTY value into a typed
-- parameter is an error the engine raises before the call is made. That is
-- the engine's rule and not the binding's; what is held here is that it is
-- an error a script can catch and not a fault, and that 0 is the safe "no
-- handle".
-- The renderer, through the binding: the same square-on box the native
-- smoke test derives by hand, so every number here is that test's. What
-- only an engine can show is the picture arriving as binary DATA of the
-- right length with its bytes intact (zero bytes included: a text copy
-- would stop at the first), and the picture coordinates of a click.
command testRender
   local tWorld, tBox, tShape, tData, tAt, tRay, tSpot, tBall, tBallShape, tText
   check "no picture before the first render", b3RenderWidth() is 0 and b3RenderByteCount() is 0 and b3RenderPixels() is empty \
         and b3RenderPixel(0, 0) is -1 and b3RenderRay(1, 1) is empty, b3RenderWidth() && b3RenderByteCount()
   check "the camera starts where the docs say", b3RenderCamera() is "0,4,12,0,1,0,50", b3RenderCamera()
   check "no world, no picture, and a reason", b3RenderWorld(0, 64, 64, 0) is false and b3LastError() is "not a world", b3LastError()
   put b3WorldCreate(0, -10, 0, 1) into tWorld
   check "a picture too big is refused", b3RenderWorld(tWorld, 2049, 64, 0) is false and b3RenderWorld(tWorld, 64, 64, 3) is false \
         and b3LastError() is not empty, b3LastError()
   put b3BodyCreate(tWorld, 0, 0, 0, 0) into tBox
   put b3ShapeAddBox(tBox, 1, 1, 1, 0, 0.5, 0) into tShape
   check "a new shape has no colour of its own", b3ShapeColor(tShape) is empty, b3ShapeColor(tShape)
   b3ShapeSetColor tShape, 200, 100, 50
   b3ShapeSetColor tShape, 200, 100, 256
   check "a shape keeps the colour it is given", b3ShapeColor(tShape) is "200,100,50", b3ShapeColor(tShape)
   b3RenderSetCamera 0, 0, 10, 0, 0, 0, 50
   b3RenderSetCamera 0, 0, 10, 0, 0, 10, 50
   check "a camera looking at itself is refused", b3RenderCamera() is "0,0,10,0,0,0,50", b3RenderCamera()
   b3RenderSetLight 0, 0, -1
   b3RenderSetBackground 10, 20, 30
   check "a world is rendered", b3RenderWorld(tWorld, 200, 100, 0) is true and b3LastError() is empty, b3LastError()
   check "the picture is the size asked for", b3RenderWidth() is 200 and b3RenderHeight() is 100 and b3RenderByteCount() is 80000 \
         and b3RenderTriangleCount() is 12, b3RenderWidth() && b3RenderHeight() && b3RenderByteCount() && b3RenderTriangleCount()
   put b3RenderPixels() into tData
   check "the picture crosses as data, every byte of it", the number of bytes in tData is 80000, the number of bytes in tData
   put 4 * (50 * 200 + 100) into tAt
   check "its bytes are 0, red, green, blue, rows from the top", byteToNum(byte tAt + 1 of tData) is 0 and byteToNum(byte tAt + 2 of tData) is 200 \
         and byteToNum(byte tAt + 3 of tData) is 100 and byteToNum(byte tAt + 4 of tData) is 50 \
         and byteToNum(byte 2 of tData) is 10 and byteToNum(byte 3 of tData) is 20 and byteToNum(byte 4 of tData) is 30 \
         and byteToNum(byte 80000 of tData) is 30, \
         byteToNum(byte tAt + 1 of tData) && byteToNum(byte tAt + 2 of tData) && byteToNum(byte tAt + 3 of tData) && byteToNum(byte tAt + 4 of tData)
   check "a pixel is its colour as one number", b3RenderPixel(100, 50) is 200 * 65536 + 100 * 256 + 50 and b3RenderPixel(0, 0) is 10 * 65536 + 20 * 256 + 30 \
         and b3RenderPixel(200, 0) is -1, b3RenderPixel(100, 50) && b3RenderPixel(0, 0)
   check "the pixel names its shape and its distance", b3RenderShapeAt(100, 50) is tShape and b3RenderShapeAt(0, 0) is 0 \
         and near(b3RenderDepth(100, 50), 9, 0.001) and b3RenderDepth(0, 0) is 0, b3RenderShapeAt(100, 50) && b3RenderDepth(100, 50)
   put b3RenderProject(1, 1, 1) into tSpot
   check "a point of the world lands where the arithmetic says", near(item 1 of tSpot, 111.915, 0.01) and near(item 2 of tSpot, 38.085, 0.01) \
         and near(item 3 of tSpot, 9, 0.000001), tSpot
   check "a point behind the camera lands nowhere", b3RenderProject(0, 0, 11) is empty, b3RenderProject(0, 0, 11)
   -- a click: the ray through a picture point, cast into the world
   put b3RenderRay(105.5, 45.5) into tRay
   check "the ray through a pixel starts at the camera", the number of items in tRay is 6 and item 1 to 3 of tRay is "0,0,10" and item 6 of tRay < -0.99, tRay
   check "cast, it finds the shape that pixel shows", b3CastRayClosest(tWorld, item 1 of tRay, item 2 of tRay, item 3 of tRay, \
         50 * item 4 of tRay, 50 * item 5 of tRay, 50 * item 6 of tRay) is 1 and b3HitShape(1) is b3RenderShapeAt(105, 45) \
         and near(item 3 of b3HitPoint(1), 1, 0.001), b3HitCount() && b3HitPoint(1)
   check "a wireframe leaves the face empty", b3RenderWorld(tWorld, 200, 100, 1) and b3RenderShapeAt(100, 50) is 0 and b3RenderShapeAt(88, 50) is tShape, \
         b3RenderShapeAt(100, 50) && b3RenderShapeAt(88, 50)
   check "outlines leave it filled", b3RenderWorld(tWorld, 200, 100, 2) and b3RenderPixel(100, 50) is 200 * 65536 + 100 * 256 + 50, b3RenderPixel(100, 50)
   b3ShapeClearColor tShape
   check "a colour taken away is gone", b3ShapeColor(tShape) is empty and b3RenderWorld(tWorld, 200, 100, 0) and b3RenderPixel(100, 50) is 9214604, b3RenderPixel(100, 50)
   -- triangles as text
   put b3ShapeTrianglesText(tShape) into tText
   check "a box is twelve triangles of nine numbers", the number of lines in tText is 12 and the number of items in line 1 of tText is 9 \
         and the number of items in line 12 of tText is 9, the number of lines in tText && line 1 of tText
   put b3BodyCreate(tWorld, 2, 3, 0, 0) into tBall
   put b3ShapeAddSphere(tBall, 0, 0, 0, 0.5, 1, 0.5, 0) into tBallShape
   put b3ShapeTrianglesText(tBallShape) into tText
   check "a long list crosses whole", the number of lines in tText > 100 and the number of items in the last line of tText is 9 \
         and b3ShapeTrianglesText(0) is empty, the number of lines in tText
   -- a picture resized, and many in a row (each a fresh copy of the data)
   repeat 50 times
      get b3RenderWorld(tWorld, 320, 240, 2)
      put b3RenderPixels() into tData
   end repeat
   check "fifty pictures in a row, each whole", the number of bytes in tData is 307200 and b3RenderByteCount() is 307200, the number of bytes in tData
   b3WorldDestroy tWorld
   check "the world gone, the picture stays", b3RenderWidth() is 320 and b3RenderShapeAt(160, 120) is 0 and the number of bytes in b3RenderPixels() is 307200, \
         b3RenderWidth()
   b3RenderSetBackground 32, 36, 42
   b3RenderSetCamera 0, 4, 12, 0, 1, 0, 50
end testRender

command testTypedBoundary
   local tThrew
   put false into tThrew
   try
      get b3BodyX(empty)
   catch tError
      put true into tThrew
   end try
   check "an empty handle is a catchable script error (pass 0, not empty)", tThrew, "b3BodyX(empty) did not throw on this engine"
   check "0 is the safe no-handle", b3BodyX(0) is 0 and b3BodyIsValid(0) is false, b3BodyX(0)
end testTypedBoundary

