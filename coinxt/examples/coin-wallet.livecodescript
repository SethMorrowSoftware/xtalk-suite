function waTypeName
   if sWaScriptType is "p2pkh" then
      return "BIP-44, addresses starting 1 or m"
   end if
   if sWaScriptType is "p2sh-p2wpkh" then
      return "BIP-49, SegWit wrapped in P2SH, addresses starting 3 or 2"
   end if
   if sWaScriptType is "p2tr" then
      return "BIP-86, taproot, addresses starting bc1p"
   end if
   if sWaScriptType is "p2wsh" then
      return "BIP-48, m-of-n multisig, addresses starting bc1q and long"
   end if
   return "BIP-84, native SegWit, addresses starting bc1q"
end waTypeName

function waDescriptorFor pChange
   local tXpub, tKeys, tI, tCount
   if sWaKind is "multisig" then
      put waEmptyList() into tKeys
      put cwListCount(sWaCosigners) into tCount
      repeat with tI = 1 to tCount
         put cwListAdd(tKeys, cwXKeyRespell(sWaCosigners[tI], sWaNetwork, \
               "p2pkh", true)) into tKeys
      end repeat
      return cwDescriptorMultisig(sWaM, tKeys, pChange, true)
   end if
   -- The descriptor carries the BIP-32 xpub spelling even for a wpkh()
   -- wallet: the wrapper already names the script type, and Bitcoin Core
   -- rejects a SLIP-132 zpub inside a descriptor outright.
   put cwXKeyRespell(sWaAccountXpub, sWaNetwork, "p2pkh", true) into tXpub
   return cwDescriptor(sWaScriptType, tXpub, sWaFingerprint, \
         waAccountPath(), pChange)
end waDescriptorFor

command waWalletClick pRole
   local tEntropy, tText, tI, tCount, tLine, tKey, tInfo
   if pRole is "kindSeed" then
      put "seed" into sWaKind
      put "new" into sWaSeedChoice
      put empty into field "wl_mnemonic"
      put empty into sWaMnemonic
      uiStatus "Press Generate for a fresh seed, or type one you already have.", ""
   else if pRole is "kindRestore" then
      put "seed" into sWaKind
      put "restore" into sWaSeedChoice
      put kWaTestMnemonic into field "wl_mnemonic"
      uiStatus "Type your own phrase over the test one, then press Open.", ""
   else if pRole is "kindWatch" then
      put "watch" into sWaKind
      waDropSeed
      uiStatus "Paste an account xpub, ypub, zpub, tpub, upub or vpub below.", ""
   else if pRole is "kindKey" then
      put "key" into sWaKind
      waDropSeed
      uiStatus "Paste one private key in WIF form below.", ""
   else if pRole is "kindMulti" then
      put "multisig" into sWaKind
      put "p2wsh" into sWaScriptType
      -- NO waDropSeed HERE, and the distinction is the whole point of the
      -- kind. Watch-only and imported-key wallets hold somebody else's public
      -- material and must not be carrying a seed; a MULTISIG wallet is one of
      -- the n cosigners, so its own seed is what it signs with. Dropping it
      -- here left a wallet that could derive every address and contribute no
      -- signature to any of them - waCosignerKeys answers with nothing when
      -- sWaAccountXprv is empty, and only the seed path fills that in.
      uiStatus "Paste EVERY cosigner's account key, one per line, INCLUDING " & \
            "your own - the address is a function of the whole key set - then " & \
            "set how many signatures are required.", ""
   else if pRole is "netMain" then
      waSetNetwork "mainnet"
   else if pRole is "netTest" then
      waSetNetwork "testnet"
   else if pRole is "netTest4" then
      waSetNetwork "testnet4"
   else if pRole is "netSignet" then
      waSetNetwork "signet"
   else if pRole is "netReg" then
      waSetNetwork "regtest"
   else if pRole is "typeLegacy" then
      waSetType "p2pkh"
   else if pRole is "typeNested" then
      waSetType "p2sh-p2wpkh"
   else if pRole is "typeNative" then
      waSetType "p2wpkh"
   else if pRole is "typeTaproot" then
      waSetType "p2tr"
   else if pRole is "typeMulti" then
      waSetType "p2wsh"
   else if pRole is "generate" then
      waGenerateSeed
   else if pRole is "open" then
      waOpenWallet
   else if pRole is "addCosigner" then
      waAddCosigners
   else if pRole is "copyXpub" then
      set the clipboardData["text"] to sWaAccountXpub
      uiCopyFlash "wl_copyXpub"
   else if pRole is "copyDesc" then
      set the clipboardData["text"] to waDescriptorFor(0) & return & waDescriptorFor(1)
      uiCopyFlash "wl_copyDesc"
   else if pRole is "backup" then
      put waBackupChecklist() into field "wl_out"
      exit waWalletClick
   end if
   waRefreshAll
end waWalletClick

command waSetNetwork pNetwork
   -- MAINNET IS ALLOWED, INCLUDING WITH THE PUBLISHED TEST SEED, and the
   -- warning is carried instead of the refusal. That is a deliberate choice
   -- and worth stating plainly, because the risk is real: those twelve words
   -- are printed in BIP-39, so anyone can sweep an address derived from them.
   -- What the wallet owes in return is that the warning cannot be missed and
   -- cannot be dismissed - it is on the Wallet screen, on Receive next to the
   -- address somebody is about to be paid at, and on Send. It reappears on
   -- every repaint because it is computed, not acknowledged once.
   -- Changing network changes every address in the wallet, so it re-derives
   -- and drops the chain state rather than showing addresses from one network
   -- beside balances from another.
   -- AND IT ROLLS BACK. A re-derive can refuse - a watch-only key belongs to
   -- one chain, and waDeriveAccount says so - and this handler used to have
   -- already committed the new network and dropped the coins by the time it
   -- heard. What was left was a wallet on mainnet showing testnet addresses
   -- under an error about the switch, which is neither chain. The old state
   -- is kept in locals and put back on a throw, which is re-thrown AFTER the
   -- try because a throw inside a catch does not reach the caller here.
   local tOldNet, tOldUtxos, tOldHistory, tOldTip, tError, tFailed
   put sWaNetwork into tOldNet
   put sWaUtxos into tOldUtxos
   put sWaHistory into tOldHistory
   put sWaTipHeight into tOldTip
   put pNetwork into sWaNetwork
   put waEmptyList() into sWaUtxos
   put waEmptyList() into sWaHistory
   put empty into sWaTipHeight
   put empty into sWaTipAt
   put empty into sWaFeesAt
   put "" into tFailed
   -- A WATCH-ONLY WALLET RE-DERIVES TOO. The condition was "has a mnemonic",
   -- which a watch-only wallet never has - so a network switch on one ran no
   -- derive at all: the chain check that waDeriveAccount's watch branch exists
   -- for never ran, and the addresses stayed the OLD chain's under a network
   -- label that said otherwise. The gate found it on its first run by asking
   -- for a refusal that never came.
   if sWaHaveCoin is "true" and (sWaMnemonic is not empty or sWaAccountXpub is not empty) then
      try
         waDeriveAccount
      catch tError
         put tError into tFailed
      end try
   end if
   if tFailed is not "" then
      put tOldNet into sWaNetwork
      put tOldUtxos into sWaUtxos
      put tOldHistory into sWaHistory
      put tOldTip into sWaTipHeight
      throw "still on " & tOldNet & ": " & tFailed
   end if
   -- Changing the network can invalidate the BACKEND as well as the addresses,
   -- and the backend half used to go unsaid: the Esplora root moved under the
   -- wallet's feet and a mainnet-only Electrum server stayed selected.
   --
   -- STOP FIRST. A request already in flight was asked about an address on the
   -- OTHER chain, and its answer arrives after the addresses have been
   -- re-derived - so waMergeUtxos files a coin under an address this wallet no
   -- longer derives, and waRecomputeBalance, which sums every row of sWaUtxos
   -- whatever its address, adds the other chain's coins to this chain's
   -- balance. Dropping sWaUtxos two lines above is not enough on its own,
   -- because the reply lands afterwards.
   waNetAbort
   -- AND RETUNE THE PORT, which on clearnet Electrum is what selects the
   -- chain. See waRetunePort: this is the half that used to go unsaid.
   waRetunePort
   waRefreshNetState
   if sWaNetState is "failed" then
      uiStatus "Now on " & pNetwork & ", and the backend cannot serve it: " & \
            sWaNetWhy, "bad"
      exit waSetNetwork
   end if
   uiStatus "Now on " & pNetwork & ". Addresses and balances were dropped, " & \
         "because they belong to the other chain.", "warn"
end waSetNetwork

command waSetType pType
   -- Same rollback as waSetNetwork, for the same reason.
   local tOldType, tOldKind, tOldUtxos, tOldHistory, tError, tFailed
   put sWaScriptType into tOldType
   put sWaKind into tOldKind
   put sWaUtxos into tOldUtxos
   put sWaHistory into tOldHistory
   put pType into sWaScriptType
   if pType is "p2wsh" then
      put "multisig" into sWaKind
   else if sWaKind is "multisig" then
      put "seed" into sWaKind
   end if
   put waEmptyList() into sWaUtxos
   put waEmptyList() into sWaHistory
   put "" into tFailed
   if sWaHaveCoin is "true" and sWaMnemonic is not empty and sWaKind is "seed" then
      try
         waDeriveAccount
      catch tError
         put tError into tFailed
      end try
   end if
   if tFailed is not "" then
      put tOldType into sWaScriptType
      put tOldKind into sWaKind
      put tOldUtxos into sWaUtxos
      put tOldHistory into sWaHistory
      throw "still " & tOldType & ": " & tFailed
   end if
   uiStatus "Script type " & pType & ": " & waTypeName() & ".", ""
end waSetType

command waGenerateSeed
   -- Fresh key material is the CALLER's job in this family and the only
   -- sanctioned source is SodiumXT. There is deliberately no fallback: an
   -- engine random() seeded from the clock is exactly the kind of thing that
   -- looks like it worked.
   local tEntropy, tWords
   if sWaHaveSodium is not "true" then
      throw "Generate needs SodiumXT for entropy, and it is not installed. " & \
            "A seed made from anything weaker is a seed somebody else can " & \
            "guess, so there is no fallback here on purpose."
   end if
   put sxRandomBytes(32) into tEntropy
   put cxMnemonicFromEntropy(tEntropy) into tWords
   put empty into tEntropy
   put tWords into field "wl_mnemonic"
   put tWords into sWaMnemonic
   put empty into tWords
   put "seed" into sWaKind
   waDeriveAccount
   uiStatus "A new 24-word seed. WRITE IT DOWN NOW, on paper, before you do " & \
         "anything else with this window.", "warn"
end waGenerateSeed

command waOpenWallet
   -- EVERYTHING IS READ AND CHECKED BEFORE ANYTHING IS WRITTEN. This handler
   -- used to commit the label, the account number, the path, an empty coin
   -- list and an empty history - and, for a seed wallet, the PHRASE ITSELF
   -- into sWaMnemonic - and only then ask waDeriveAccount whether the phrase
   -- was any good. When it was not, the throw left all of that behind: a
   -- wallet with somebody's half-typed phrase as its state, no coins, and
   -- every later network or script-type click re-validating the same bad
   -- phrase and throwing the same sentence. That is the twenty-seven-line
   -- engine log of 2026-09-01. A failed Open now changes nothing at all.
   local tText, tInfo, tNode, tAccountText, tLabel, tAccount, tPath
   local tPhrase, tWhy, tFormat
   put waSafeText(cwTrim(field "wl_label")) into tLabel
   if tLabel is "" then
      put "Wallet" into tLabel
   end if
   -- INTO A LOCAL FIRST, and this is the fourth site of the same shape in
   -- this file: `field "wl_account" + 0` binds the arithmetic INTO the chunk
   -- target, so the engine is asked for a field named `wl_account` plus zero.
   -- It is the account NUMBER, so getting it wrong derives a different
   -- wallet from the same seed.
   put sWaAccount into tAccount
   put field "wl_account" into tAccountText
   if tAccountText is an integer then
      put tAccountText + 0 into tAccount
   end if
   -- VALIDATED HERE, ONCE, so waAccountPath's eight readers never see a path
   -- that has not parsed. An empty box means the standard path, which is what
   -- every wallet this app made before today used.
   put waCheckedPath(field "wl_path") into tPath
   -- THE PHRASE, for the two kinds that have one. A multisig wallet is one of
   -- the cosigners and signs with its own seed, and this branch used to exit
   -- before the line that read the seed box - so a person who chose Multisig,
   -- typed their phrase and pressed Open had their phrase silently ignored and
   -- their cosigner key derived from whatever sWaMnemonic held before, which
   -- at boot is the PUBLISHED test seed. An empty box on a multisig wallet
   -- keeps the seed already open (a cosigner may have opened it first); a
   -- non-empty box is adopted, after the same check the seed kind gets.
   put "" into tPhrase
   put "" into tFormat
   if sWaKind is "seed" or sWaKind is "multisig" then
      put cwTrim(field "wl_mnemonic") into tPhrase
      if sWaKind is "seed" or tPhrase is not "" then
         put waSeedFormatOf(tPhrase) into tFormat
         if tFormat is "" or tFormat is "electrum-2fa" then
            put waMnemonicProblem(tPhrase) into tWhy
            throw "that seed phrase cannot open a wallet: " & tWhy & \
                  " Nothing has changed; whatever was open is still open."
         end if
      end if
   end if
   -- Every check that can refuse has run. Commit.
   put tLabel into sWaLabel
   put tAccount into sWaAccount
   put tPath into sWaCustomPath
   -- AN ELECTRUM SEED NAMES ITS OWN PATH AND SCRIPT TYPE, and this is the
   -- only place a format is allowed to override what the buttons say: the
   -- alternative is a valid seed opening the wrong wallet, which shows a zero
   -- balance and reads like an empty wallet rather than a mistake.
   if tFormat is "electrum-segwit" then
      put "m/0'" into sWaCustomPath
      put "p2wpkh" into sWaScriptType
      set the defaultStack to the short name of this stack
      put sWaCustomPath into field "wl_path"
   else if tFormat is "electrum-standard" then
      put "m" into sWaCustomPath
      put "p2pkh" into sWaScriptType
      set the defaultStack to the short name of this stack
      put sWaCustomPath into field "wl_path"
   end if
   if sWaKind is "watch" then
      put cwTrim(field "wl_xkey") into tText
      -- DECODED WITH THE CONTEXT THIS SCREEN ALREADY HAS. Most extended-key
      -- versions name several (network, script type) pairs - a tpub matches
      -- six - so without the network and type the person just chose, a signet
      -- taproot key comes back "testnet p2pkh" and is then either refused as
      -- belonging to another chain or watched with LEGACY addresses.
      put cwXKeyDecode(tText, sWaNetwork, sWaScriptType) into tNode
      if tNode["network"] is not sWaNetwork then
         throw "that extended key belongs to " & tNode["network"] & \
               " and this wallet is on " & sWaNetwork & \
               ". Switch the network, or paste the right key."
      end if
      -- AND IT MUST NOT BE A PRIVATE KEY. This branch checked the NETWORK and
      -- nothing else, so an account xprv - one character from its xpub, and
      -- the line directly above it in whatever a signing wallet exported -
      -- was stored in sWaAccountXpub and thereafter treated as public by
      -- everything downstream: printed on the Wallet screen under "account
      -- extended PUBLIC key (safe to hand out)", put on the clipboard by
      -- Copy, written into the wallet file on the line labelled `xpub`, and
      -- exported by Tools. It was not watch-only either: waDeriveAddresses
      -- re-fills every record through waAccountNode, which prefers the
      -- private half, so the records carried seckeys again while the status
      -- line said "This wallet cannot sign anything."
      --
      -- wallet-core ships cwXKeyIsPrivate for exactly this question and
      -- nothing in this stack was calling it.
      if cwXKeyIsPrivate(tText) is true then
         throw "that is a PRIVATE extended key, and this is the watch-only " & \
               "box. Watching it would put a spending key on the Wallet " & \
               "screen labelled as safe to hand out, and into the wallet " & \
               "file. Paste the matching PUBLIC key instead (xpub, ypub, " & \
               "zpub, tpub, upub or vpub), or choose Restore if you meant " & \
               "to open a spending wallet."
      end if
      put waEmptyList() into sWaUtxos
      put waEmptyList() into sWaHistory
      put tText into sWaAccountXpub
      put empty into sWaAccountXprv
      waDropSeed
      put tNode["scripttype"] into sWaScriptType
      put cwFingerprint(cxHexEncode(tNode["pubkey"])) into sWaFingerprint
      waDeriveAddresses
      if tNode["ambiguous"] is true then
         uiStatus "Watching " & tNode["scripttype"] & " addresses on " & \
               sWaNetwork & ". That key's version bytes do not say which " & \
               "of " & tNode["candidates"] & " it is, so the choice above " & \
               "decided it - change it there if these are the wrong " & \
               "addresses. This wallet cannot sign anything.", "warn"
      else
         uiStatus "Watching " & tNode["scripttype"] & " addresses from that " & \
               "account key. This wallet cannot sign anything.", "ok"
      end if
      exit waOpenWallet
   end if
   if sWaKind is "key" then
      put cwTrim(field "wl_xkey") into tText
      put cwWifInfo(tText, sWaNetwork) into tInfo
      put waEmptyList() into sWaUtxos
      put waEmptyList() into sWaHistory
      put tText into sWaImportedWif
      put empty into sWaAccountXpub
      put empty into sWaAccountXprv
      waDropSeed
      waDeriveAddresses
      if tInfo["warning"] is not "" then
         uiStatus tInfo["warning"] & ". Nothing was derived on the wrong chain.", "bad"
      else
         uiStatus "One key imported. It has exactly one address per script " & \
               "type, and no chain to scan.", "ok"
      end if
      exit waOpenWallet
   end if
   if tPhrase is not "" then
      put tPhrase into sWaMnemonic
      put field "wl_pass" into sWaPassphrase
   end if
   put waEmptyList() into sWaUtxos
   put waEmptyList() into sWaHistory
   if sWaKind is "multisig" then
      waAddCosigners
      exit waOpenWallet
   end if
   waDeriveAccount
   uiStatus "Open: " & sWaLabel & ", " & sWaScriptType & " on " & sWaNetwork & \
         ", " & waAddressCount() & " addresses derived.", "ok"
end waOpenWallet

command waAddCosigners
   -- Every cosigner's ACCOUNT key, one per line. They are checked for the
   -- same network before anything is derived, because a multisig built from
   -- keys on two chains produces an address nobody can ever spend from and
   -- there is no later moment at which that becomes obvious.
   local tText, tI, tCount, tLine, tNode, tList, tKey, tMText
   put field "wl_xkey" into tText
   put waEmptyList() into tList
   put the number of lines of tText into tCount
   repeat with tI = 1 to tCount
      put cwTrim(line tI of tText) into tLine
      if tLine is "" then
         next repeat
      end if
      put cwXKeyDecode(tLine, sWaNetwork, "p2wsh") into tNode
      if tNode["network"] is not sWaNetwork then
         throw "cosigner " & tI & " is a " & tNode["network"] & " key and this " & \
               "wallet is on " & sWaNetwork & ". A multisig mixing chains " & \
               "produces an address nobody can spend."
      end if
      put cwListAdd(tList, tLine) into tList
   end repeat
   if cwListCount(tList) < 1 then
      throw "paste at least one cosigner account key, one per line."
   end if
   put field "wl_m" into tMText
   if tMText is an integer then
      put tMText + 0 into sWaM
   end if
   if sWaM < 1 or sWaM > cwListCount(tList) then
      throw "the number of required signatures must be between 1 and the " & \
            "number of cosigners (" & cwListCount(tList) & ")."
   end if
   put tList into sWaCosigners
   put "multisig" into sWaKind
   put "p2wsh" into sWaScriptType
   -- RE-DERIVE THIS WALLET'S OWN ACCOUNT KEY AT THE BIP-48 PATH. Switching to
   -- multisig changes the derivation path, and whatever sWaAccountXprv held
   -- was derived for the old script type - so without this the wallet either
   -- holds no private half at all (and can never sign, the defect this
   -- comment exists for) or holds one for a key that is not in the witness
   -- script. waDeriveAccount ends by deriving the addresses, so that call
   -- covers both; the no-seed case still just lists the multisig addresses.
   if sWaHaveCoin is "true" and sWaMnemonic is not empty then
      waDeriveAccount
   else
      waDeriveAddresses
   end if
   if sWaAccountXprv is empty then
      uiStatus sWaM & "-of-" & cwListCount(tList) & " multisig, " & \
            waAddressCount() & " addresses derived - but this wallet holds " & \
            "no seed, so it can WATCH these addresses and cannot sign for " & \
            "them. Open a seed wallet first if one of these keys is yours.", "warn"
   else
      uiStatus sWaM & "-of-" & cwListCount(tList) & " multisig, " & \
            waAddressCount() & " addresses derived. Every cosigner must derive " & \
            "the same addresses, which BIP-67 key ordering is what guarantees.", "ok"
   end if
end waAddCosigners

function waBackupChecklist
   local tOut
   put "BACKING THIS WALLET UP" & return & return into tOut
   put "1. Write the seed phrase on PAPER. Not a photo, not a password" & return after tOut
   put "   manager you cannot reach without a working computer, not this" & return after tOut
   put "   window. Twelve or twenty-four ordinary words." & return & return after tOut
   put "2. Write down the BIP-39 passphrase separately IF you used one." & return after tOut
   put "   It is not in the phrase and cannot be recovered from it. An" & return after tOut
   put "   empty passphrase is normal; a forgotten one is a lost wallet." & return & return after tOut
   put "3. Write down the derivation path: " & \
         waAccountPath() & return after tOut
   put "   Another wallet restoring your phrase needs it to find the same" & return after tOut
   put "   addresses. " & sWaScriptType && "(" & waTypeName() & ")." & return & return after tOut
   put "4. Check the backup by restoring it: type the words back in on a" & return after tOut
   put "   fresh open of this stack and confirm the first receive address" & return after tOut
   put "   matches. A backup nobody has ever restored is a hope." & return & return after tOut
   if sWaKind is "multisig" then
      put "5. MULTISIG: keep every cosigner's account key too. The seed" & return after tOut
      put "   alone cannot rebuild the address; it needs all " & \
            cwListCount(sWaCosigners) & " public keys." & return & return after tOut
   end if
   put "The first receive address for this wallet right now:" & return after tOut
   put "   " & waFirstAddress() & return after tOut
   return tOut
end waBackupChecklist

function waFirstAddress
   local tRec
   if waAddressCount() < 1 then
      return "(nothing derived yet)"
   end if
   put sWaAddresses[1] into tRec
   return tRec["address"]
end waFirstAddress

