-- ---- update from main -------------------------------------------------------
-- A wallet that replaces its own code is a wallet whose code can be replaced,
-- so the flow is built to be READ before it is trusted: the fetch is one
-- `get URL` of a fixed address (kWaUpdateUrl); waUpdateCheck refuses anything
-- that is not recognisably this script and names what it saw; the offer
-- shows the version and the SHA-256 so a person can compare it with the
-- commit they expect; and the swap happens only on Update. What survives the
-- swap is what the wallet file carries plus the Network screen's settings,
-- parked in a stack property for the milliseconds between the old script's
-- last statement and the new script's boot, and cleared there (and on close).
--
-- THE SWAP ITSELF is engine work the headless gate cannot model: `set the
-- script of this stack` from inside one of that script's own handlers, then
-- preOpenStack and openStack sent to the new one. Everything around it -
-- the check, the carry, the restore, the route - is gated.

command waUpdateFromMain
   local tText, tCurrent, tInfo, tError, tOffer
   set the defaultStack to the short name of this stack
   uiStatus "Fetching " & kWaUpdateUrl & " ...", ""
   waLog "update: fetching " & kWaUpdateUrl
   get URL kWaUpdateUrl
   put the result into tError
   put it into tText
   if tError is not empty then
      throw "could not fetch main: " & tError
   end if
   put the script of this stack into tCurrent
   put waUpdateCheck(tText, tCurrent) into tInfo
   waLog "update: main is version " & tInfo["version"] & ", " & tInfo["chars"] & \
         " chars, sha256 " & tInfo["sha"] & "; this is version " & kWaVersion
   put "Replace this wallet's script with the one on main?" & return & return & \
         "main:  version " & tInfo["version"] & ", " & tInfo["chars"] & \
         " chars" & return & "sha256 " & tInfo["sha"] & return & return & \
         "this:  version " & kWaVersion & return & return & \
         "The wallet in memory and the Network settings are carried across; " & \
         "the log stays; the window is rebuilt where it needs to be." into tOffer
   answer tOffer with "Update" or "Cancel"
   if it is not "Update" then
      uiStatus "Not updated. This is still version " & kWaVersion & ".", ""
      waLog "update: declined"
      exit waUpdateFromMain
   end if
   waUpdateApply tText, tInfo
end waUpdateFromMain

function waUpdateCheck pText, pCurrent
   -- Is pText THIS SCRIPT, from main, and different? Refuses, with the reason,
   -- anything else; answers the version, the size and the SHA-256 of what
   -- it accepted. pCurrent is the running script, passed in so this can be
   -- driven with any two texts.
   local tOut, tLine, tPos, tEnd, tChars, tCurChars, tVersion, tSlice
   if pText is empty then
      throw "main sent nothing back."
   end if
   put line 1 of pText into tLine
   if tLine is not line 1 of pCurrent then
      throw "that is not this script: it begins " & quote & \
            char 1 to 60 of tLine & quote & " where this one begins " & \
            quote & line 1 of pCurrent & quote & "."
   end if
   put the number of chars of pText into tChars
   put the number of chars of pCurrent into tCurChars
   if tChars < tCurChars / 2 then
      throw "main's copy is " & tChars & " chars against this script's " & \
            tCurChars & ", which is too short to be a whole wallet (a " & \
            "truncated download, most likely)."
   end if
   if tChars > tCurChars * 3 then
      throw "main's copy is " & tChars & " chars against this script's " & \
            tCurChars & ", which is too large to be this wallet."
   end if
   -- AT A LINE START, because this handler's own source carries the same
   -- characters mid-line (the literal below), and an unanchored search
   -- found that occurrence first in a copy whose real declaration was gone
   put offset(return & "constant kWaVersion = " & quote, pText) into tPos
   if tPos is 0 then
      throw "main's copy declares no kWaVersion, so it is not a version of " & \
            "this wallet."
   end if
   add 1 to tPos
   -- the forty chars after the opening quote, sliced first: the three-
   -- argument offset (with a skip) is not a form the family's interpreter
   -- models, and a form the gate cannot run is a form nobody has run
   put char (tPos + 23) to (tPos + 62) of pText into tSlice
   put offset(quote, tSlice) into tEnd
   if tEnd < 2 then
      throw "main's copy has an unreadable kWaVersion."
   end if
   put char 1 to (tEnd - 1) of tSlice into tVersion
   -- WHOLE LINES, not substrings: "command waUpdateRestore" is a prefix of
   -- "command waUpdateRestoreX", and the literal in this very handler would
   -- satisfy a substring test on a copy that had lost the handler
   if not (pText contains return & "command waUpdateRestore" & return) then
      throw "main's copy (version " & tVersion & ") has no waUpdateRestore, " & \
            "so your wallet would not come back after the swap. Not offered."
   end if
   if not (pText contains return & "on openStack" & return) \
         or not (pText contains return & "on preOpenStack" & return) then
      throw "main's copy (version " & tVersion & ") has no openStack, so it " & \
            "could not boot. Not offered."
   end if
   if pText is pCurrent then
      throw "this is already what main has (version " & tVersion & ")."
   end if
   put tVersion into tOut["version"]
   put tChars into tOut["chars"]
   put cxHexEncode(cxSha256(textEncode(pText, "utf-8"))) into tOut["sha"]
   return tOut
end waUpdateCheck

function waUpdateCarry
   -- What crosses the swap: the wallet as the wallet file would hold it,
   -- and the settings the file does not carry, as update:* rows after it.
   local tOut, tTab
   put numToChar(9) into tTab
   put waSerializeWallet() into tOut
   put "update:from" & tTab & kWaVersion & return after tOut
   put "update:backend" & tTab & sWaBackend & return after tOut
   put "update:host" & tTab & sWaHost & return after tOut
   put "update:port" & tTab & sWaPort & return after tOut
   put "update:socks" & tTab & sWaSocksPort & return after tOut
   put "update:screen" & tTab & sWaScreen & return after tOut
   return tOut
end waUpdateCarry

command waUpdateStash pCarry
   set the uWaUpdateCarry of this stack to pCarry
end waUpdateStash

command waUpdateApply pText, pInfo
   -- ENGINE ONLY: the swap. The old script's handler keeps running to its
   -- end after the set; the new script answers every message after that,
   -- starting with the two the boot needs.
   local tError, tCarry, tFailed
   put waUpdateCarry() into tCarry
   waNetAbort
   put "false" into sWaPolling
   waUpdateStash tCarry
   -- captured and thrown AFTER the try: a throw inside a catch does not
   -- reach the caller on OXT (the checker's rule, from the engine)
   put empty into tFailed
   try
      set the script of this stack to pText
   catch tError
      put tError into tFailed
   end try
   if tFailed is not empty then
      waUpdateStash empty
      put "true" into sWaPolling
      send "waTick" to me in kWaTick milliseconds
      throw "main's script (version " & pInfo["version"] & ") did not " & \
            "compile on this engine, so nothing changed: " & tFailed
   end if
   waLog "update: the script is now version " & pInfo["version"] & \
         " (sha256 " & pInfo["sha"] & "); rebooting"
   send "preOpenStack" to this stack in 0 milliseconds
   send "openStack" to this stack in 0 milliseconds
end waUpdateApply

command waUpdateRestore
   -- The other side of the swap, from waBoot: if a carry is parked on the
   -- stack, read it back, clear it, and say what happened.
   local tCarry, tWallet, tI, tCount, tLine, tTab, tName, tValue, tFrom, tScreen
   local tError, tBackend, tHost, tPort, tSocks
   set the defaultStack to the short name of this stack
   put the uWaUpdateCarry of this stack into tCarry
   if tCarry is empty then
      exit waUpdateRestore
   end if
   set the uWaUpdateCarry of this stack to empty
   put numToChar(9) into tTab
   put empty into tWallet
   put empty into tFrom
   put empty into tScreen
   put the number of lines of tCarry into tCount
   repeat with tI = 1 to tCount
      put line tI of tCarry into tLine
      if char 1 to 7 of tLine is "update:" then
         put char 8 to (offset(tTab, tLine) - 1) of tLine into tName
         put char (offset(tTab, tLine) + 1) to -1 of tLine into tValue
         if tName is "from" then
            put tValue into tFrom
         else if tName is "backend" then
            put tValue into tBackend
         else if tName is "host" then
            put tValue into tHost
         else if tName is "port" then
            put tValue into tPort
         else if tName is "socks" then
            put tValue into tSocks
         else if tName is "screen" then
            put tValue into tScreen
         end if
      else
         put tLine & return after tWallet
      end if
   end repeat
   try
      waLoadInto tWallet
   catch tError
      waLog "update: the carried wallet did not load (" & tError & \
            "); open it from its file"
      uiStatus "Updated to version " & kWaVersion & ", but the wallet in " & \
            "memory did not carry across: " & tError, "bad"
      exit waUpdateRestore
   end try
   -- THE NETWORK SETTINGS GO ON AFTER THE WALLET LOADS, not before: loading
   -- resets the backend to its defaults, and the first full gate run
   -- (2026-09-03) came back with the carried backend and a default host and
   -- port - a person's own server, lost in the update.
   if tBackend is not empty then
      put tBackend into sWaBackend
   end if
   if tHost is not empty then
      put tHost into sWaHost
   end if
   if tPort is not empty then
      put tPort into sWaPort
   end if
   if tSocks is not empty then
      put tSocks into sWaSocksPort
   end if
   waRefreshNetState
   waApplyNetworkFields
   if tScreen is not empty then
      waShow tScreen
   end if
   waRefreshAll
   waLog "updated to version " & kWaVersion & " from " & tFrom & \
         "; the wallet and the Network settings came across"
   uiStatus "Updated to version " & kWaVersion & " from " & tFrom & ".", "ok"
end waUpdateRestore

-- ==============================================================================
-- THE WALLET FILE
--
-- Sealed with XChaCha20-Poly1305 under an Argon2id key when SodiumXT is
-- installed, and written in the clear with a loud warning when it is not.
-- There is no third option: a "light" encryption made from what is available
-- without SodiumXT would be a password field that does nothing, which is
-- worse than no password field at all.
--
-- The plaintext HEADER is the AEAD's associated data, so it is readable (a
-- person can see which network and which script type a file is for without
-- unlocking it) and is still authenticated: change one byte of it and the
-- unseal fails rather than opening a wallet that claims to be something else.
-- ==============================================================================

command waSaveWallet
   local tPath, tPassword, tPlain, tSalt, tKey, tHeader, tSealed, tError
   set the defaultStack to the short name of this stack
   put cwTrim(field "st_path") into tPath
   if tPath is "" then
      throw "give the file a path first."
   end if
   put field "st_password" into tPassword
   put waSerializeWallet() into tPlain
   if tPassword is "" or sWaHaveSodium is not "true" then
      if sWaHaveSodium is not "true" and tPassword is not "" then
         throw "SodiumXT is not installed, so this wallet cannot encrypt " & \
               "anything. Clear the password field to save in the clear, and " & \
               "know what that means."
      end if
      put kWaFileMagic & "|plain|" & sWaNetwork & "|" & sWaScriptType & return & \
            tPlain into tSealed
      put tSealed into URL ("binfile:" & tPath)
      put the result into tError
      put empty into tPlain
      if tError is not empty then
         put empty into tSealed
         waForgetPassword
         throw "the wallet file could not be written to " & tPath & ": " & \
               tError & ". NOTHING has been saved."
      end if
      -- tSealed carries the whole plaintext on this branch, mnemonic and all
      put empty into tSealed
      waForgetPassword
      uiStatus "Saved UNENCRYPTED to " & tPath & ". The seed is in that file " & \
            "in plain text.", "warn"
      exit waSaveWallet
   end if
   put sxRandomBytes(sxPwSaltBytes()) into tSalt
   put sxPwHash(textEncode(tPassword, "utf-8"), tSalt, 32, kWaKdfOps, \
         sxPwMemSensitive()) into tKey
   put kWaFileMagic & "|sealed|" & sWaNetwork & "|" & sWaScriptType & "|" & \
         cxHexEncode(tSalt) into tHeader
   put tHeader & return & cxHexEncode(sxAeadEncrypt(textEncode(tPlain, "utf-8"), \
         textEncode(tHeader, "utf-8"), tKey)) into tSealed
   put empty into tKey
   put empty into tPlain
   put tSealed into URL ("binfile:" & tPath)
   -- A WRITE THAT FAILED IS NOT A BACKUP, and this is the one place in the
   -- wallet where being wrong about that costs everything: neither write
   -- checked `the result`, so a full disk, a path inside a directory that
   -- does not exist, or a read-only volume was reported as "Saved, sealed" -
   -- and the whole point of the sentence is that somebody then stops
   -- worrying about their seed. It is a THROW rather than a status line
   -- because the caller turns a throw into a red message the person has to
   -- read, and a warning beside the word "Saved" is not that.
   put the result into tError
   put empty into tPassword
   if tError is not empty then
      waForgetPassword
      throw "the wallet file could not be written to " & tPath & ": " & \
            tError & ". NOTHING has been saved."
   end if
   waForgetPassword
   uiStatus "Saved, sealed, to " & tPath & ".", "ok"
end waSaveWallet

command waForgetPassword
   -- THE PASSWORD DOES NOT STAY ON THE SCREEN. st_password is an ordinary
   -- input field sitting directly beside st_path, which names the file it
   -- unlocks, so leaving it rendered discloses both to any screenshot,
   -- screen-share or passer-by for the rest of the session. waSaveWallet is
   -- careful with every other secret it touches; this was the one left behind.
   set the defaultStack to the short name of this stack
   if there is a field "st_password" then
      put empty into field "st_password"
   end if
end waForgetPassword

command waLoadWallet
   local tPath, tRaw, tHeader, tBody, tPassword, tSalt, tKey, tPlain, tError, tFailed, tStart
   set the defaultStack to the short name of this stack
   put cwTrim(field "st_path") into tPath
   put URL ("binfile:" & tPath) into tRaw
   if tRaw is empty then
      throw "there is nothing at " & tPath & "."
   end if
   put line 1 of tRaw into tHeader
   -- same reason as the Content-Length above: the offset of the body is
   -- computed into a local rather than inside the chunk expression
   put the number of chars of tHeader into tStart
   add 2 to tStart
   put char tStart to -1 of tRaw into tBody
   if waField2(tHeader, 1) is not kWaFileMagic then
      throw "that file is not a CoinXT wallet."
   end if
   if waField2(tHeader, 2) is "plain" then
      waLoadInto tBody
      waForgetPassword
      uiStatus "Opened an UNENCRYPTED wallet file.", "warn"
      exit waLoadWallet
   end if
   if sWaHaveSodium is not "true" then
      throw "that file is sealed and SodiumXT is not installed, so it cannot " & \
            "be opened here."
   end if
   put field "st_password" into tPassword
   if tPassword is "" then
      throw "that file is sealed. Type its password."
   end if
   put cxHexDecode(waField2(tHeader, 5)) into tSalt
   put sxPwHash(textEncode(tPassword, "utf-8"), tSalt, 32, kWaKdfOps, \
         sxPwMemSensitive()) into tKey
   put "" into tPlain
   put false into tFailed
   try
      -- sxAeadDecrypt THROWS on a wrong key or on any tampering, including
      -- tampering with the plaintext header, which is why the header is the
      -- associated data. try/catch IS the authentication here.
      put textDecode(sxAeadDecrypt(cxHexDecode(tBody), \
            textEncode(tHeader, "utf-8"), tKey), "utf-8") into tPlain
   catch tError
      put true into tFailed
   end try
   put empty into tKey
   -- THROWN AFTER `end try`, NEVER INSIDE THE CATCH. A throw issued inside a
   -- catch block does not reach the caller on this engine: the handler falls
   -- through and returns whatever its result variable holds, which here would
   -- be an empty wallet reported as a successful open.
   if tFailed then
      throw "that password does not open this file (or the file has been " & \
            "altered - the header is authenticated too)."
   end if
   waLoadInto tPlain
   put empty into tPlain
   put empty into tPassword
   waForgetPassword
   uiStatus "Opened " & sWaLabel & " from " & tPath & ".", "ok"
end waLoadWallet

function waField2 pLine, pIndex
   -- The pIndex-th pipe-separated field, split by hand for the same reason
   -- waField splits on comma by hand.
   local tRest, tI, tPos
   put pLine into tRest
   put 1 into tI
   repeat while tI < pIndex
      put offset("|", tRest) into tPos
      if tPos is 0 then
         return ""
      end if
      put char (tPos + 1) to -1 of tRest into tRest
      add 1 to tI
   end repeat
   put offset("|", tRest) into tPos
   if tPos is 0 then
      return tRest
   end if
   return char 1 to (tPos - 1) of tRest
end waField2

function waSerializeWallet
   -- One field per line, name and value separated by a tab, so the file is
   -- readable by a person and by anything else. The labels come last because
   -- there can be many of them.
   local tOut, tTab, tI, tCount, tKey, tKeys
   put numToChar(9) into tTab
   if waSafeText(sWaLabel) is not sWaLabel then
      throw "this wallet's name carries a tab or a newline, which is this " & \
            "file format's record separator. Nothing has been saved."
   end if
   put "label" & tTab & sWaLabel & return into tOut
   put "network" & tTab & sWaNetwork & return after tOut
   put "scripttype" & tTab & sWaScriptType & return after tOut
   put "kind" & tTab & sWaKind & return after tOut
   put "account" & tTab & sWaAccount & return after tOut
   if sWaCustomPath is not empty then
      put "path" & tTab & sWaCustomPath & return after tOut
   end if
   put "unit" & tTab & sWaUnit & return after tOut
   put "m" & tTab & sWaM & return after tOut
   -- ONLY THE KIND THAT OWNS A SECRET WRITES IT. Belt to waDropSeed's
   -- braces: even if some future path leaves a stale mnemonic behind, a
   -- watch-only file cannot carry one, because a watch-only wallet has no
   -- line to put it on. The reverse holds too - a seed wallet does not write
   -- somebody else's imported WIF.
   if sWaKind is "seed" or sWaKind is "multisig" then
      put "mnemonic" & tTab & sWaMnemonic & return after tOut
      put "passphrase" & tTab & sWaPassphrase & return after tOut
   end if
   put "xpub" & tTab & sWaAccountXpub & return after tOut
   if sWaKind is "key" then
      put "wif" & tTab & sWaImportedWif & return after tOut
   end if
   put cwListCount(sWaCosigners) into tCount
   repeat with tI = 1 to tCount
      put "cosigner" & tTab & sWaCosigners[tI] & return after tOut
   end repeat
   put cwListCount(sWaLeaves) into tCount
   repeat with tI = 1 to tCount
      put "leaf" & tTab & waLeafLine(sWaLeaves[tI]) & return after tOut
   end repeat
   put the keys of sWaLabels into tKeys
   sort lines of tKeys
   put the number of lines of tKeys into tCount
   repeat with tI = 1 to tCount
      put line tI of tKeys into tKey
      if tKey is not "" then
         -- BELT TO waSafeText'S BRACES. Stripping at every door is the fix;
         -- refusing here is what makes a door somebody adds later loud
         -- instead of silent, because this is the one place where a stray
         -- separator stops being a display bug and becomes a forged record.
         if waSafeText(tKey) is not tKey \
               or waSafeText(sWaLabels[tKey]) is not sWaLabels[tKey] then
            throw "a label or address in this wallet carries a tab or a " & \
                  "newline, which is this file format's own record " & \
                  "separator, so saving it would write records nobody " & \
                  "chose. Nothing has been saved. Clear the label on " & \
                  tKey & " and save again."
         end if
         put "label:" & tKey & tTab & sWaLabels[tKey] & return after tOut
      end if
   end repeat
   put the keys of sWaFrozen into tKeys
   sort lines of tKeys
   put the number of lines of tKeys into tCount
   repeat with tI = 1 to tCount
      put line tI of tKeys into tKey
      if tKey is not "" then
         put "frozen" & tTab & tKey & return after tOut
      end if
   end repeat
   return tOut
end waSerializeWallet

command waLoadInto pText
   -- A FILE THAT UNSEALS AND THEN FAILS TO PARSE LEAVES NO WALLET. Without
   -- this, waDeserializeWallet's throw stopped it partway through: the fields
   -- it had already assigned stayed assigned, so the screens showed a wallet
   -- half from the file and half from whatever was open before, under an
   -- error message about the file. Nothing about that mixture is anybody's
   -- wallet. Reset, and re-throw AFTER the try - a throw inside a catch does
   -- not reach the caller on this engine, which this file records twice.
   local tError, tWhy
   put empty into tWhy
   try
      waDeserializeWallet pText
   catch tError
      put line 1 of tError into tWhy
   end try
   if tWhy is not empty then
      waResetWallet
      throw "that file did not parse (" & tWhy & "), so nothing was loaded " & \
            "and the wallet has been reset rather than left half open."
   end if
end waLoadInto

command waDeserializeWallet pText
   local tI, tCount, tLine, tTab, tPos, tName, tValue, tCosigners, tInscriptions
   put numToChar(9) into tTab
   put waEmptyList() into tCosigners
   put waEmptyList() into tInscriptions
   -- EVERY PIECE OF KEY MATERIAL IS CLEARED FIRST, not just the two arrays
   -- this handler happens to append to. sWaAccountXprv is never WRITTEN to a
   -- wallet file, so without this it survives the load with the PREVIOUS
   -- wallet's value - and waAccountNode prefers the private half, so loading
   -- somebody else's watch-only file produced a wallet that showed their
   -- xpub, derived OUR addresses, and would sign. A load starts from nothing.
   put empty into sWaLabels
   put empty into sWaFrozen
   put waEmptyList() into sWaLeaves
   put empty into sWaMnemonic
   put empty into sWaPassphrase
   put empty into sWaAccountXpub
   put empty into sWaAccountXprv
   put empty into sWaFingerprint
   put empty into sWaImportedWif
   put empty into sWaCustomPath
   put waEmptyList() into sWaAddresses
   put waEmptyList() into sWaCosigners
   put the number of lines of pText into tCount
   repeat with tI = 1 to tCount
      put line tI of pText into tLine
      put offset(tTab, tLine) into tPos
      if tPos is 0 then
         next repeat
      end if
      put char 1 to (tPos - 1) of tLine into tName
      put char (tPos + 1) to -1 of tLine into tValue
      if tName is "label" then
         put tValue into sWaLabel
      else if tName is "network" then
         put tValue into sWaNetwork
      else if tName is "scripttype" then
         put tValue into sWaScriptType
      else if tName is "kind" then
         put tValue into sWaKind
      else if tName is "account" then
         put tValue + 0 into sWaAccount
      else if tName is "path" then
         -- CHECKED ON THE WAY IN. A file is not a person: waLoadInto turns a
         -- throw here into "that file did not parse, so nothing was loaded",
         -- which is the right answer for a path that would otherwise reach
         -- the descriptor and the PSBT metadata unexamined.
         put waCheckedPath(tValue) into sWaCustomPath
      else if tName is "unit" then
         put tValue into sWaUnit
      else if tName is "m" then
         put tValue + 0 into sWaM
      else if tName is "mnemonic" then
         put tValue into sWaMnemonic
      else if tName is "passphrase" then
         put tValue into sWaPassphrase
      else if tName is "xpub" then
         put tValue into sWaAccountXpub
      else if tName is "wif" then
         put tValue into sWaImportedWif
      else if tName is "cosigner" then
         put cwListAdd(tCosigners, tValue) into tCosigners
      else if tName is "frozen" then
         put "true" into sWaFrozen[tValue]
      else if char 1 to 6 of tName is "label:" then
         put tValue into sWaLabels[char 7 to -1 of tName]
      else if tName is "leaf" then
         put cwListAdd(tInscriptions, waLeafKeyFrom(tValue)) into tInscriptions
      end if
   end repeat
   put tCosigners into sWaCosigners
   put tInscriptions into sWaLeaves
   put waEmptyList() into sWaUtxos
   put waEmptyList() into sWaHistory
   if sWaKind is "seed" and sWaMnemonic is not empty then
      waDeriveAccount
   else
      waDeriveAddresses
   end if
   set the defaultStack to the short name of this stack
   put sWaMnemonic into field "wl_mnemonic"
end waDeserializeWallet

-- ==== DEMO SELF-CHECK v1 BEGIN (verbatim copy; master: tools/demo-selfcheck.livecodescript; gate: tools/check-demo-selfcheck-drift.py) ====
-- The sentinel is a CONSTANT so the probe compares against one spelling; a
-- literal repeated at the write and the read is a check that can pass while
-- disagreeing with itself.
constant kScProbe = "self-check: delayed write reached the status line"
local sScLines          -- the whole block, kept so a Copy button has something
local sScPassed, sScFailed, sScSkipped
local sScLogField       -- the adopting demo's own log field, set by scBegin

command scBegin pLogField
   put pLogField into sScLogField
   put empty into sScLines
   put 0 into sScPassed
   put 0 into sScFailed
   put 0 into sScSkipped
   scLine "== boot self-check (nothing is hosted, connected, or bound) =="
end scBegin

-- Each line is LOGGED as it is made, not accumulated and flushed at the end.
-- The first draft did both - a flush after the synchronous half and another
-- after the probe - which printed every synchronous line twice.
command scLine pText
   put pText & return after sScLines
   -- pin the stack: scFinish reaches here from a `send ... in` tick, and the
   -- field is named unqualified (OXT-ENGINE-NOTES 5.3)
   set the defaultStack to the short name of this stack
   if sScLogField is empty or there is no field sScLogField then
      exit scLine
   end if
   put pText & return after field sScLogField
   set the vscroll of field sScLogField to the formattedHeight of field sScLogField
end scLine

command scAssert pName, pOk
   if pOk then
      add 1 to sScPassed
      scLine "PASS  " & pName
   else
      add 1 to sScFailed
      scLine "FAIL  " & pName
   end if
end scAssert

-- SKIP, never FAIL, for an absent extension: a missing member is an
-- environment, and only a present-and-broken member is a defect.
command scSkip pName, pReason
   add 1 to sScSkipped
   scLine "SKIP  " & pName & " (" & pReason & ")"
end scSkip

-- An empty value prints as nothing, which reads as a missing check rather than
-- an answer of empty; every observed value in a self-check goes through here.
-- This is the playLoudness lesson (OXT-ENGINE-NOTES 5.4) as a helper: a check
-- that reports only its own name costs a whole engine pass to diagnose.
function scShow pValue
   if pValue is empty then
      return "empty"
   end if
   return pValue
end scShow

-- Returns the comma-list of control names in pList that do not exist, or empty.
-- The adopter passes EVERY control name its own script references, derived from
-- the source rather than hand-picked: a missing control is not cosmetic, it is
-- the "Chunk: error in object expression" class, and finding it at boot beats
-- finding it when somebody clicks.
function scMissing pList
   local tName, tMissing, tC, tFound
   set the defaultStack to the short name of this stack
   repeat for each item tName in pList
      -- ALL FOUR CONTROL TYPES. The kit builds fields (uiLabel/uiWrap/uiCap/
      -- uiSection/uiInput/uiArea/uiTable), buttons (uiButton/uiCheckbox) AND
      -- GRAPHICS (uiGfx/uiPanel/uiPill). The first version of this asked only
      -- about fields and buttons, so every uiPill a demo builds - the Tor
      -- pills in both Quick Shares, for one - reported as a missing control on
      -- a stack where it exists.
      --
      -- AND IMAGES (2026-08-31), for the same reason one step further out. A
      -- demo may build a control the KIT does not: coinxt's wallet paints a
      -- QR into an image, which is the only way a BMP this family builds
      -- becomes something a phone can read. Registered and built, it reported
      -- as missing - found by coinxt/tools/check-wallet-boot.py, which boots
      -- the stack headlessly, so this one cost no engine time. The lesson is
      -- the one this block already carries twice: the list of types a demo
      -- can build is not the list of types the KIT builds.
      --
      -- AND EVERY CARD (2026-08-29). Unqualified `there is a field X` answers
      -- for the CURRENT card only (engine notes 5.6) - OBSERVED when
      -- riptide's five-card boot reported all 63 off-card controls missing
      -- from a stack where every one existed. A single-card demo walks its
      -- one card here, exactly the old behaviour.
      put false into tFound
      repeat with tC = 1 to the number of cards of this stack
         if there is a field tName of card tC \
               or there is a button tName of card tC \
               or there is a graphic tName of card tC \
               or there is an image tName of card tC then
            put true into tFound
            exit repeat
         end if
      end repeat
      if not tFound then
         put tName & comma after tMissing
      end if
   end repeat
   if tMissing is empty then
      return empty
   end if
   return char 1 to -2 of tMissing
end scMissing

-- Call LAST in <pfx>ScRun. It arms the probe below; 400ms lands it before the
-- usual 800ms dashboard tick, so nothing races for the status line.
--
-- SAY THAT THE REPORT IS UNFINISHED, for the reason the suite harness carries a
-- RUN NOT FINISHED trailer: a report that simply stops reads exactly like a
-- report that ended, and the difference cost that harness a round trip on
-- 2026-08-19. One line is cheaper than the ambiguity.
command scArmProbe
   scLine "      ...one delayed-write check still to come; the count line " \
         & "below it is the end of the block"
   send "scTickProbe" to me in 400 milliseconds
end scArmProbe

-- THE ONE CHECK THAT NEEDS A TIMER.
--
-- OXT-ENGINE-NOTES 5.3 says an unqualified control reference inside a delayed
-- handler resolves against THE DEFAULTSTACK, not the stack whose script is
-- running - and that entry is classed DOCUMENTED, not OBSERVED, because this
-- tree has never actually watched the unpinned form fail. It also names the run
-- that would settle it: open a second stack in front and let a `send ... in`
-- handler write an unqualified field.
--
-- So this probe READS the defaultStack before pinning and PRINTS what it found.
-- On an ordinary run that line is context. On a run with another window in front
-- it is the measurement 5.3 is missing, taken for free and at no risk, because
-- the pin lands immediately afterwards and the write is verified.
command scTickProbe
   local tWas, tPrev, tPrevColor, tGot, tErr
   put the defaultStack into tWas
   set the defaultStack to the short name of this stack
   if there is no field "uiStatus" then
      scSkip "a delayed handler writes the status line", "the chrome is not built"
      scFinish
      exit scTickProbe
   end if
   -- RESTORE THE COLOUR TOO, not just the text. uiStatus takes a KIND, and
   -- handing it back "ok" would repaint a "bad" line green - so a stack whose
   -- extension is missing would end this probe claiming to be fine.
   put field "uiStatus" into tPrev
   put the foregroundColor of field "uiStatus" into tPrevColor
   try
      uiStatus kScProbe, empty
      put field "uiStatus" into tGot
   catch tErr
      put "THREW:" && tErr into tGot
   end try
   uiStatus tPrev, empty
   set the foregroundColor of field "uiStatus" to tPrevColor
   scAssert "a delayed handler writes the status line " \
         & "(defaultStack on entry: " & scShow(tWas) & ")", (tGot is kScProbe)
   scFinish
end scTickProbe

command scFinish
   scLine "      " & sScPassed & " passed, " & sScFailed & " failed, " \
         & sScSkipped & " skipped - select this block and copy it into the " \
         & "OXT pass record"
   if sScFailed is 0 then
      scLine "      boot self-check GREEN (this is the single-machine claim; " \
            & "the live legs are the runbook's)"
      exit scFinish
   end if
   scLine "      boot self-check has FAILURES above - report them before " \
         & "running any live leg"
   -- ONLY ON FAILURE does this touch the status line, and the asymmetry is
   -- deliberate. Green, the demo's own "Ready ..." line is the more useful
   -- thing to be reading and the detail is in the log a few lines up. Red, the
   -- log may be on a tab nobody has clicked - so the one surface a person is
   -- certainly looking at has to say so. Fail loud, pass quiet.
   uiStatus "Boot self-check: " & sScFailed & " FAILED (see the log)", "bad"
end scFinish
