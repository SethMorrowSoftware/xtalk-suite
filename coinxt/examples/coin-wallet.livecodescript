command waHistoryClick pRole
   local tRec, tI, tLine
   if pRole is "refresh" then
      if sWaBackend is "offline" then
         throw "history comes from a backend. Choose one on the Network screen."
      end if
      waSyncIfIdle
   else if pRole is "inspect" then
      put waSelectedHistory() into tRec
      if tRec is "" then
         throw "select a transaction first."
      end if
      if tRec["raw"] is "" then
         -- ASK THE BACKEND, RATHER THAN TELLING THE PERSON TO. Both backends
         -- have had a raw-transaction request since the transports were
         -- written and nothing pressed it; the message said "ask the backend
         -- for it" about a wallet with no button that did. The answer lands
         -- on every history row carrying that txid and paints this panel
         -- when it does.
         if sWaBackend is "offline" then
            throw "this wallet does not hold the raw bytes of that " & \
                  "transaction, and it is offline. Choose a backend and " & \
                  "press Inspect again, or paste the transaction on the " & \
                  "Tools screen."
         end if
         put cwLower(tRec["txid"]) into sWaInspectWanted
         waEnsurePolling
         waNetQueue "tx", tRec["txid"]
         waLog "inspect: asked " & sWaHost & " for the bytes of " & tRec["txid"]
         put "Asking " & sWaHost & " for the bytes of " & tRec["txid"] & \
               "..." & return & return & "They will appear here when they " & \
               "arrive." into field "hs_detail"
         uiStatus "Asked the backend for that transaction.", ""
         exit waHistoryClick
      end if
      put waInspectRaw(tRec["raw"]) into field "hs_detail"
      exit waHistoryClick
   else if pRole is "bump" then
      put waSelectedHistory() into tRec
      if tRec is "" then
         throw "select a transaction first."
      end if
      -- waBumpFee BUILDS it when this window still holds what that spend was
      -- made of, and prints the advice when it does not. The button is one
      -- button either way: a person with a stuck transaction should not have
      -- to know which case they are in before they press something.
      waBumpFee tRec
      exit waHistoryClick
   else if pRole is "copyTxid" then
      put waSelectedHistory() into tRec
      if tRec is "" then
         throw "select a transaction first."
      end if
      set the clipboardData["text"] to tRec["txid"]
      uiCopyFlash "hs_copyTxid"
   end if
   waRefreshScreen
end waHistoryClick

function waCpfpCoins pTxid
   -- The unfrozen, unconfirmed coins this wallet holds from one transaction:
   -- what a child-pays-for-parent bump can spend.
   local tI, tCount, tRec, tOut, tKey
   put waEmptyList() into tOut
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      if tRec["txid"] is not pTxid then
         next repeat
      end if
      if tRec["confirmations"] + 0 > 0 then
         next repeat
      end if
      put tRec["txid"] & ":" & tRec["vout"] into tKey
      if sWaFrozen[tKey] is "true" then
         next repeat
      end if
      if sWaSpentBy[tKey] is not "" then
         -- a child already spends it; a second one would only replace the first
         next repeat
      end if
      put cwListAdd(tOut, tRec) into tOut
   end repeat
   return tOut
end waCpfpCoins

command waCpfpBuild pRec, pKids
   -- The child: every unconfirmed coin of the parent that is ours, spent to
   -- this wallet's next change address, at a fee that pays for the parent's
   -- bytes as well as its own at the rate on the Send screen. A miner takes
   -- the pair as a package, so the parent's shortfall is what the child adds.
   --
   -- The parent's SIZE comes from its bytes (the history row's raw, fetched
   -- like Inspect fetches them) or from the backend's weight where Esplora
   -- gave one; its FEE is known only where the backend said it - Electrum's
   -- history does not - and when it is unknown the child pays for both sizes
   -- in full, as if the parent had paid nothing, and says so.
   local tRate, tParentVsize, tParentFee, tFeeKnown, tTx, tI, tCount, tRec
   local tInputs, tOutputs, tSel, tTotalIn, tChangeRec, tTypes, tOutTypes
   local tChildVsize, tWant, tFee, tFloor, tValue, tDust, tRaw, tNew, tOut
   set the defaultStack to the short name of this stack
   put field "sd_rate" into tRate
   if tRate is not a number or tRate <= 0 then
      throw "set a fee rate on the Send screen first: the child pays for " & \
            "the parent at that rate."
   end if
   if pRec["vsize"] is an integer and pRec["vsize"] > 0 then
      put pRec["vsize"] into tParentVsize
   else if pRec["raw"] is not "" then
      put cwTxDecode(pRec["raw"]) into tTx
      put tTx["vsize"] into tParentVsize
   else
      if sWaBackend is "offline" then
         throw "the parent's size is needed to price the child, and this " & \
               "wallet is offline. Choose a backend and press Inspect first."
      end if
      put cwLower(pRec["txid"]) into sWaInspectWanted
      waEnsurePolling
      waNetQueue "tx", pRec["txid"]
      waLog "cpfp: asking the backend for the bytes of " & pRec["txid"]
      throw "asking the backend for the parent's bytes; press Bump again " & \
            "when they arrive (the log will say)."
   end if
   put false into tFeeKnown
   put 0 into tParentFee
   if pRec["fee"] is an integer and pRec["fee"] >= 0 then
      put pRec["fee"] into tParentFee
      put true into tFeeKnown
   end if
   put waNextChangeOrMore() into tChangeRec
   put waEmptyList() into tInputs
   put waEmptyList() into tSel
   put 0 into tTotalIn
   put cwListCount(pKids) into tCount
   repeat with tI = 1 to tCount
      put pKids[tI] into tRec
      put cwListAdd(tInputs, cwTxInput(tRec["txid"], tRec["vout"], kCwSeqRbf)) into tInputs
      put cwListAdd(tSel, tRec) into tSel
      add tRec["value"] to tTotalIn
   end repeat
   put waEmptyList() into tOutTypes
   put cwListAdd(tOutTypes, waChangeType()) into tOutTypes
   put cwEstimateVsize(cwSimpleInputs(waInputType(), tCount, sWaM, \
         cwListCount(sWaCosigners)), tOutTypes) into tChildVsize
   put waCeilSat(tRate * (tChildVsize + tParentVsize)) into tWant
   put tWant - tParentFee into tFee
   put cwFeeFor(tChildVsize, 1) into tFloor
   if tFee < tFloor then
      put tFloor into tFee
   end if
   put tTotalIn - tFee into tValue
   put cwDustThreshold(waChangeType()) into tDust
   if tValue < tDust then
      throw "the " & waAmount(tTotalIn) & " this wallet holds from that " & \
            "transaction cannot carry a fee of " & waAmount(tFee) & " and " & \
            "leave more than dust. Lower the rate on the Send screen, or " & \
            "let it confirm on its own."
   end if
   put waEmptyList() into tOutputs
   put cwListAdd(tOutputs, cwTxOutput(tValue, tChangeRec["script"])) into tOutputs
   put waSignSpend(tInputs, tOutputs, tSel, 0) into tRaw
   put cwTxDecode(tRaw) into tNew
   put tRaw into sWaLastRaw
   -- recorded with no payees and the whole value as change, so it can be
   -- replaced in its turn if the rate proves too low
   waRecordSpend tNew["txid"], tSel, waEmptyList(), tValue, tChangeRec, 0, \
         kCwSeqRbf, tFee, tNew["vsize"] + 0
   put "CHILD PAYS FOR PARENT (CPFP)" & return & return into tOut
   put "  parent     " & pRec["txid"] & return after tOut
   put "  child      " & tNew["txid"] & return & return after tOut
   put "  the parent weighs " & tParentVsize & " vB and paid " after tOut
   if tFeeKnown is true then
      put waAmount(tParentFee) & return after tOut
   else
      put "an amount this backend does not report, so the" & return & \
            "  child pays for both sizes in full, as if the parent had paid " & \
            "nothing" & return after tOut
   end if
   put "  the child weighs " & tNew["vsize"] & " vB and pays " & waAmount(tFee) & \
         return after tOut
   put "  together they pay " & waAmount(tFee + tParentFee) & " over " & \
         (tNew["vsize"] + tParentVsize) & " vB, about " & \
         cwCeilDiv(tFee + tParentFee, tNew["vsize"] + tParentVsize) & \
         " sat/vB, which is the rate you asked for" & return & return after tOut
   put "  it spends " & tCount & " coin(s) of the parent, " & waAmount(tTotalIn) & \
         ", and pays" & return after tOut
   put "    " & waAmount(tValue) & "  ->  " & tChangeRec["address"] & \
         "  (this wallet's next change address)" & return & return after tOut
   put "  It is replaceable in its turn, so a rate that proves too low can " & \
         "be raised." & return & return after tOut
   put tRaw & return & return after tOut
   put "NOTHING HAS BEEN BROADCAST. The Send screen's Broadcast button will" & return after tOut
   put "push it; a miner that takes the child must take the parent with it." after tOut
   put tOut into field "hs_detail"
   uiStatus "Built a child that pays for " & char 1 to 16 of pRec["txid"] & \
         "... at " & tRate & " sat/vB for the pair. Broadcast is on the " & \
         "Send screen.", "ok"
end waCpfpBuild

private function waHistoryRows
   -- sWaHistory is keyed by (txid, ADDRESS), because that is what
   -- waUsedAddresses reads: an address is used if any transaction touched it,
   -- and a transaction paying two of this wallet's addresses must mark both.
   -- What a PERSON wants to read is one row per transaction, so the two views
   -- are separated here rather than by making one of them wrong. The painter
   -- and the row selector both go through this, or the highlighted line would
   -- index a different transaction than the one on screen.
   local tSeen, tList, tI, tCount, tRec
   put empty into tSeen
   put waEmptyList() into tList
   put cwListCount(sWaHistory) into tCount
   repeat with tI = 1 to tCount
      put sWaHistory[tI] into tRec
      if tSeen[tRec["txid"]] is not "true" then
         put "true" into tSeen[tRec["txid"]]
         put cwListAdd(tList, tRec) into tList
      end if
   end repeat
   return tList
end waHistoryRows

function waSelectedHistory
   local tLine, tI
   set the defaultStack to the short name of this stack
   put the hilitedLine of field "hs_table" into tLine
   if tLine is empty or tLine < 2 then
      return ""
   end if
   local tRows
   put waHistoryRows() into tRows
   put tLine - 1 into tI
   if tI < 1 or tI > cwListCount(tRows) then
      return ""
   end if
   return tRows[tI]
end waSelectedHistory

command waBumpFee pRec
   -- BUILD THE REPLACEMENT, rather than describing one.
   --
   -- What stood here was advice: it computed the floor a replacement must
   -- clear, told the person to go and re-tick the same coins on the Coins
   -- screen and rebuild the payment by hand, and called that deliberate -
   -- "building it where you can see every line is safer than a button that
   -- rebuilds it out of sight". The safety argument is real and it is kept:
   -- this prints every line of what it built and signs nothing until it has
   -- checked its own arithmetic against the transaction it actually produced.
   -- What was not defensible was the reason underneath it, which is that the
   -- wallet could not do it. Reconstructing a spend by hand under time
   -- pressure, from a fee estimate that has already proved wrong once, is the
   -- moment a person pays the wrong address.
   --
   -- The replacement is the SAME transaction with a smaller change output:
   -- same inputs, same sequence opt-in, same payments to the same people, and
   -- the extra fee comes out of the coins that were coming back to you
   -- anyway. Nothing is re-selected, so there is no path here that spends a
   -- coin the original did not.
   local tOld, tSel, tPays, tI, tCount, tRec, tInputs, tOutputs, tSeq, tKids
   local tOldFee, tVsize, tFloor, tRate, tWant, tDelta, tNewChange, tChangeRec
   local tTotalIn, tTotalOut, tRaw, tNew, tRealFee, tOut, tDust, tError, tSpender
   set the defaultStack to the short name of this stack
   if pRec["confirmations"] + 0 > 0 then
      throw "that transaction is confirmed. There is nothing left to bump, " & \
            "and nothing on earth can replace it now."
   end if
   put sWaSpends[pRec["txid"]] into tOld
   -- A TRANSACTION WHOSE OUTPUT A PENDING SPEND OF OURS ALREADY USES is not
   -- replaced: the replacement makes different outputs, so the child would
   -- be spending a coin that never exists - which is what the 2026-09-03
   -- evening run did, and both children were refused by every node.
   put waPendingSpenderOf(pRec["txid"]) into tSpender
   if tSpender is not "" and tSpender is not pRec["txid"] then
      throw "an output of that transaction is already spent by " & tSpender & \
            ", which this wallet built and queued; replacing the parent would " & \
            "leave that one spending a coin that never exists. Bump the child " & \
            "instead, or wait for the parent to confirm."
   end if
   -- CHILD PAYS FOR PARENT (2026-09-04), when a replacement cannot: a
   -- transaction this wallet did not build, one built without the RBF
   -- opt-in, or one that kept no change - and an INCOMING payment that is
   -- stuck, which is the case a replacement can never touch. If this wallet
   -- holds an unconfirmed output of it, a child spending that output back to
   -- this wallet at a fee that carries both is the one bump left.
   put waCpfpCoins(pRec["txid"]) into tKids
   if cwListCount(tKids) > 0 and (tOld is "" \
         or tOld["sequence"] + 0 >= kCwSeqNoRbf or tOld["change"] + 0 <= 0 \
         or tOld["changerec"] is "") then
      -- A TRANSACTION THIS WALLET BUILT NEEDS NO ROUND TRIP for its size or
      -- its fee: both are in the spend record. The 2026-09-03 log asked the
      -- backend for the bytes of the wallet's own note transaction and told
      -- the person to press Bump again when they arrived.
      if tOld is not "" then
         if pRec["vsize"] is not an integer then
            put tOld["vsize"] into pRec["vsize"]
         end if
         if pRec["fee"] is not an integer then
            put tOld["fee"] into pRec["fee"]
         end if
      end if
      waCpfpBuild pRec, tKids
      exit waBumpFee
   end if
   if tOld is "" then
      -- The honest answer, and the advice is still the right thing to print.
      put waBumpAdvice(pRec) & return & return & \
            "THIS WALLET CANNOT BUILD THE REPLACEMENT FOR YOU HERE, because " & \
            "it does not hold what that transaction was made of. Signing " & \
            "commits to each input's VALUE, and those coins left this " & \
            "wallet's coin list when the transaction was signed. A spend " & \
            "made in THIS window can be bumped with one press; one made " & \
            "before the wallet was last reopened has to be rebuilt by hand, " & \
            "as above." into field "hs_detail"
      uiStatus "No record of how that transaction was built.", "warn"
      exit waBumpFee
   end if
   if tOld["sequence"] + 0 >= kCwSeqNoRbf then
      throw "that transaction was built WITHOUT the BIP-125 opt-in, so no " & \
            "replacement for it will relay. A node will simply drop the " & \
            "second one. Tick 'replaceable' on the Send screen before " & \
            "signing, and every spend after it can be bumped."
   end if
   put tOld["selected"] into tSel
   put tOld["pays"] into tPays
   put tOld["fee"] + 0 into tOldFee
   put tOld["vsize"] + 0 into tVsize
   put tOld["changerec"] into tChangeRec
   if tOld["change"] + 0 <= 0 or tChangeRec is "" then
      throw "that transaction paid out everything it spent and kept no " & \
            "change, so there is no output here to take a bigger fee from. " & \
            "A replacement would have to spend another coin, which is a " & \
            "different transaction and not a bump - build it on the Send " & \
            "screen."
   end if
   -- THE FLOOR IS BIP-125'S, AND THE RATE IS THE PERSON'S. cwRbfMinFee is the
   -- minimum that will relay at all; whatever is in the Send screen's rate
   -- box is what they actually want to pay, and the replacement pays the
   -- HIGHER of the two, because a bump to the bare floor is a bump that gets
   -- stuck again.
   put cwRbfMinFee(tOldFee, tVsize) into tFloor
   put field "sd_rate" into tRate
   if tRate is not a number then
      put 0 into tRate
   end if
   if tRate < 0 then
      put 0 into tRate
   end if
   put waCeilSat(tRate * tVsize) into tWant
   if tWant < tFloor then
      put tFloor into tWant
   end if
   put tWant - tOldFee into tDelta
   if tDelta <= 0 then
      throw "a replacement has to pay MORE than the transaction it evicts. " & \
            "That one already paid " & waAmount(tOldFee) & "."
   end if
   put tOld["change"] + 0 - tDelta into tNewChange
   put cwDustThreshold(waChangeType()) into tDust
   if tNewChange < tDust then
      throw "taking another " & waAmount(tDelta) & " out of the change would " & \
            "leave " & tNewChange & " sat, which is below the " & tDust & \
            " sat dust threshold for " & waChangeType() & ". Either lower the " & \
            "rate on the Send screen, or let this one confirm on its own."
   end if
   -- Rebuild it, input for input and output for output.
   put kCwSeqRbf into tSeq
   put waEmptyList() into tInputs
   put 0 into tTotalIn
   put cwListCount(tSel) into tCount
   repeat with tI = 1 to tCount
      put tSel[tI] into tRec
      put cwListAdd(tInputs, cwTxInput(tRec["txid"], tRec["vout"], tSeq)) into tInputs
      add tRec["value"] to tTotalIn
   end repeat
   put waEmptyList() into tOutputs
   put 0 into tTotalOut
   put cwListCount(tPays) into tCount
   repeat with tI = 1 to tCount
      put tPays[tI] into tRec
      put cwListAdd(tOutputs, cwTxOutput(tRec["value"], tRec["script"])) into tOutputs
      add tRec["value"] to tTotalOut
   end repeat
   put cwListAdd(tOutputs, cwTxOutput(tNewChange, tChangeRec["script"])) into tOutputs
   add tNewChange to tTotalOut
   put waSignSpend(tInputs, tOutputs, tSel, tOld["locktime"]) into tRaw
   put cwTxDecode(tRaw) into tNew
   -- CHECK THE ARITHMETIC AGAINST THE TRANSACTION, not against the estimate.
   -- A signature is one or two bytes shorter about half the time, so the real
   -- vsize is not quite the predicted one - and BIP-125's floor is computed
   -- over the REPLACEMENT'S OWN size. A bump that misses the floor by a byte
   -- is refused by every node, silently, and looks exactly like a bump that
   -- was never sent.
   put tTotalIn - tTotalOut into tRealFee
   if tRealFee < cwRbfMinFee(tOldFee, tNew["vsize"] + 0) then
      throw "the replacement came out at " & tNew["vsize"] & " vB, and " & \
            waAmount(tRealFee) & " does not clear the BIP-125 floor for that " & \
            "size. Nothing has been kept. Raise the rate on the Send screen " & \
            "and try again."
   end if
   put tRaw into sWaLastRaw
   -- The replacement can itself be replaced, so it is recorded like any other.
   waRecordSpend tNew["txid"], tSel, tPays, tNewChange, tChangeRec, \
         tOld["locktime"], tSeq, tRealFee, tNew["vsize"] + 0
   put "REPLACEMENT BUILT AND SIGNED (BIP-125)" & return & return into tOut
   put "  replaces  " & pRec["txid"] & return after tOut
   put "  new txid  " & tNew["txid"] & return & return after tOut
   put "  it paid       " & waAmount(tOldFee) & " over " & tVsize & " vB" & return after tOut
   put "  this pays     " & waAmount(tRealFee) & " over " & tNew["vsize"] & \
         " vB  (" & cwCeilDiv(tRealFee, tNew["vsize"] + 0) & " sat/vB)" & return after tOut
   put "  the floor was " & waAmount(tFloor) & return & return after tOut
   put "  the extra " & waAmount(tDelta) & " came out of the change:" & return after tOut
   put "    " & waAmount(tOld["change"]) & "  ->  " & waAmount(tNewChange) & \
         "  at " & tChangeRec["address"] & return & return after tOut
   put "  every payment is unchanged:" & return after tOut
   put cwListCount(tPays) into tCount
   repeat with tI = 1 to tCount
      put tPays[tI] into tRec
      put "    " & waAmount(tRec["value"]) & "  ->  " & tRec["address"] & return after tOut
   end repeat
   put return & "  and it spends exactly the same " & cwListCount(tSel) & \
         " coin(s), so nothing new is being" & return after tOut
   put "  touched. It is replaceable in its turn." & return & return after tOut
   put tRaw & return & return after tOut
   put "NOTHING HAS BEEN BROADCAST. The Send screen's Broadcast button will" & return after tOut
   put "push it, and until then both transactions exist only here. Whichever" & return after tOut
   put "one a miner confirms, the other is gone." after tOut
   put tOut into field "hs_detail"
   uiStatus "Built a replacement paying " & waAmount(tRealFee) & \
         ". Broadcast it on the Send screen.", "ok"
end waBumpFee

private function waCeilSat pValue
   -- Round a fee UP to a whole satoshi. A rate is a decimal and a fee is not,
   -- and rounding a fee DOWN is the one direction that can put a replacement
   -- under the floor it was built to clear.
   local tInt
   put trunc(pValue) into tInt
   if pValue > tInt then
      add 1 to tInt
   end if
   return tInt
end waCeilSat

function waBumpAdvice pRec
   local tOut, tOld, tFloor
   put "BUMPING THE FEE (BIP-125)" & return & return into tOut
   if pRec["confirmations"] + 0 > 0 then
      return "That transaction is confirmed. There is nothing left to bump."
   end if
   put pRec["fee"] into tOld
   if tOld is "" then
      put 0 into tOld
   end if
   put cwRbfMinFee(tOld, pRec["vsize"] + 0) into tFloor
   put "A replacement must pay everything the transaction it evicts paid," & return after tOut
   put "PLUS the incremental relay fee over its own size. For this one:" & return & return after tOut
   put "  it paid       " & waAmount(tOld) & return after tOut
   put "  its size      " & pRec["vsize"] & " vB" & return after tOut
   put "  a replacement must pay at least " & waAmount(tFloor) & return & return after tOut
   put "To do it by hand: tick the same coins on the Coins screen, choose" & return after tOut
   put "'Ticked coins' on Send, pay the same destination, and set a fee rate" & return after tOut
   put "above " & cwCeilDiv(tFloor, pRec["vsize"] + 0) & " sat/vB." & return & return after tOut
   put "A replacement is a NEW transaction that must spend the same coins, so" & return after tOut
   put "every line of it is worth reading before it is signed - which is why" & return after tOut
   put "the Bump button prints the whole thing rather than just doing it." after tOut
   return tOut
end waBumpAdvice

