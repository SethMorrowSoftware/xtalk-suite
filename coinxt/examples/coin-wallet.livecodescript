-- ("230,340"-style comma lists). Pair it with a uiLabel header carrying
-- the same tabStops, set by the adopter.
command uiTable pName, pRect, pTabStops
   uiArea pName, pRect
   set the listBehavior of field pName to true
   if pTabStops is not empty then
      set the tabStops of field pName to pTabStops
   end if
end uiTable

command uiButton pName, pLabel, pRect
   if there is no button pName then
      create button
      set the name of the last button to pName
   end if
   set the rect of button pName to pRect
   set the label of button pName to pLabel
end uiButton

-- A script-managed checkbox: autoHilite OFF because the family drives
-- toggle state from script locals (a mode the environment cannot honour
-- must never stay silently armed - the quickshare pill lesson), so the
-- hilite is set explicitly by the adopter's state machine.
command uiCheckbox pName, pLabel, pRect
   uiButton pName, pLabel, pRect
   set the style of button pName to "checkbox"
   set the autoHilite of button pName to false
end uiCheckbox

-- Create-or-reuse a named graphic: the chrome layer (cards, pills,
-- dividers, drop targets). Created BEFORE the controls that sit on it, so
-- it stays behind them in z-order. roundRect + antialiased by default;
-- callers restyle.
command uiGfx pName, pRect
   if there is no graphic pName then
      create graphic
      set the name of the last graphic to pName
   end if
   set the rect of graphic pName to pRect
   set the style of graphic pName to "roundRect"
   set the antialiased of graphic pName to true
end uiGfx

-- A dashboard card: a rounded, hairline-bordered, softly shadowed panel
-- placed BEHIND a group of controls. It only groups visually; clicks on
-- it fall through to the adopter's `default: pass mouseUp`.
command uiPanel pName, pRect
   local tShadow, tErr
   uiGfx pName, pRect
   set the roundRadius of graphic pName to 14
   set the filled of graphic pName to true
   set the backgroundColor of graphic pName to kUiCard
   set the lineSize of graphic pName to 1
   -- a graphic strokes its outline in the foregroundColor; borderColor is
   -- set too so whichever the engine honours, the hairline lands
   set the foregroundColor of graphic pName to kUiCardLine
   set the borderColor of graphic pName to kUiCardLine
   -- soft drop shadow is an LC-9-era feature, so it is a PURE
   -- enhancement: an engine without it just skips it (the try) and the
   -- hairline still separates the card from the page
   try
      put "90,98,114" into tShadow["color"]
      put 30 into tShadow["opacity"]
      put 10 into tShadow["size"]
      put 0 into tShadow["spread"]
      put 2 into tShadow["distance"]
      put 90 into tShadow["angle"]
      set the dropShadow of graphic pName to tShadow
   catch tErr
   end try
end uiPanel

-- A status pill: rounded chip + centered label, colored by state kind -
-- "ok" green, "wait" amber, "bad" red, anything else the muted on-band
-- blue. The adopter repaints it from ONE place so its handlers cannot
-- disagree about the colors (the nocloud Tor-pill discipline).
command uiPill pName, pText, pRect, pKind
   local tOldDelim, tTop, tBot, tFH
   put the itemDelimiter into tOldDelim
   set the itemDelimiter to comma
   put item 2 of pRect into tTop
   put item 4 of pRect into tBot
   set the itemDelimiter to tOldDelim
   uiGfx (pName & "Bg"), pRect
   set the roundRadius of graphic (pName & "Bg") to (tBot - tTop)
   set the filled of graphic (pName & "Bg") to true
   set the lineSize of graphic (pName & "Bg") to 0
   if pKind is "ok" then
      set the backgroundColor of graphic (pName & "Bg") to "205,240,214"
   else if pKind is "wait" then
      set the backgroundColor of graphic (pName & "Bg") to "250,240,199"
   else if pKind is "bad" then
      set the backgroundColor of graphic (pName & "Bg") to "243,215,213"
   else
      set the backgroundColor of graphic (pName & "Bg") to "31,64,116"
   end if
   uiLabel pName, pText, pRect, 10
   set the textAlign of field pName to "center"
   if pKind is "ok" then
      set the foregroundColor of field pName to "22,101,52"
   else if pKind is "wait" then
      set the foregroundColor of field pName to "133,98,14"
   else if pKind is "bad" then
      set the foregroundColor of field pName to "135,44,38"
   else
      set the foregroundColor of field pName to kUiAccentSub
   end if
   -- center the label on the chip midline by measured height
   put the formattedHeight of field pName into tFH
   if tFH > 0 and tFH < (tBot - tTop) then
      set the height of field pName to tFH
      set the top of field pName to (tTop + ((tBot - tTop - tFH) div 2))
   end if
end uiPill

-- Click-to-copy feedback: flash the button's label to "Copied!" for
-- 1200 ms, then restore the real label (stashed in uRealLabel).
command uiCopyFlash pBtn
   if there is no button pBtn then
      exit uiCopyFlash
   end if
   if the uRealLabel of button pBtn is empty then
      set the uRealLabel of button pBtn to the label of button pBtn
   end if
   set the label of button pBtn to "Copied!"
   send ("uiCopyFlashReset" && quote & pBtn & quote) to me in 1200 milliseconds
end uiCopyFlash

command uiCopyFlashReset pBtn
   -- Pinned for the same reason uiStatus is: this one arrives 1200ms later by
   -- `send`, so the defaultStack is whatever is current THEN, not the stack
   -- that flashed the button. Its existence guard means the failure is silent
   -- rather than loud - the label just never comes back, or comes back on
   -- another stack's button - which is why it needed finding rather than
   -- reporting itself.
   set the defaultStack to the short name of this stack
   if there is no button pBtn then
      exit uiCopyFlashReset
   end if
   if the uRealLabel of button pBtn is not empty then
      set the label of button pBtn to the uRealLabel of button pBtn
   end if
end uiCopyFlashReset

-- The honesty/custody footer every demo carries: what the stack is, what
-- it is not, and its engine-evidence state.
command uiFooter pText, pRect
   uiWrap "uiFooter", pText, pRect, 11
   set the textStyle of field "uiFooter" to "italic"
   set the foregroundColor of field "uiFooter" to kUiMuted
end uiFooter
-- ---- contextual menus -------------------------------------------------------
--
-- A RIGHT-CLICK MENU, as one hidden popup button per menu.
--
-- The engine's contextual menu is a BUTTON whose style is "menu" and whose
-- menuMode is "popup": its text is the item list, one per line, `popup`
-- shows it at a point, and choosing an item sends `menuPick` with the item's
-- LABEL. The button needs no script - with no handler of its own the message
-- walks the hierarchy and arrives at the card and then the stack, which is
-- where an adopter's router already lives.
--
-- OPT-IN, AND THAT IS DELIBERATE. This block is carried byte-identical by
-- every demo in the suite, so a kit that BUILT a menu would change eighteen
-- stacks to serve one. Nothing here runs unless an adopter calls
-- uiContextMenu, and a demo that never does is unchanged in behaviour.
--
-- NONE OF THIS HAS RUN ON AN ENGINE. `popup`, `menuMode` and `menuPick` are
-- documented LiveCode and OpenXTalk is a fork of it, but this suite has never
-- exercised a menu and the headless runners model no mouse button at all - so
-- an adopter's right-click handler belongs in a `try`, and losing the menu
-- must never cost the ordinary click. uiPopupMenu answers whether it worked
-- rather than throwing, so the caller can decide.

command uiContextMenu pName, pItems
   -- One hidden popup button, created once and refilled on every call so a
   -- menu can change with the screen it belongs to. The rect is small and
   -- inside the window because a stack's controls are measured by
   -- tools/check-stack-size.py whether they are visible or not.
   if there is no button pName then
      -- THE KIT'S OWN IDIOM, and not `create button pName`. Every other
      -- builder in this block creates the control unnamed and then names the
      -- last one, which is the spelling the family's headless runners model
      -- and the one every adopter has already been through an engine with.
      create button
      set the name of the last button to pName
   end if
   set the style of button pName to "menu"
   set the menuMode of button pName to "popup"
   set the text of button pName to pItems
   set the rect of button pName to "2,2,18,18"
   set the visible of button pName to false
end uiContextMenu

function uiPopupMenu pName
   -- WHICH menu, recorded before it opens. menuPick carries the item's label
   -- and nothing else, so an adopter with two menus would otherwise have to
   -- keep every label in the stack globally unique - a constraint that is
   -- invisible until the day two screens both want "Copy".
   --
   -- Answers true or false rather than throwing: on an engine without popup
   -- menus the right thing is for the click to do nothing, not for the
   -- adopter's mouseDown to die.
   local tError
   if there is no button pName then
      return false
   end if
   set the uUiMenu of this stack to pName
   try
      popup button pName at the clickLoc
   catch tError
      set the uUiMenu of this stack to empty
      return false
   end try
   return true
end uiPopupMenu

function uiMenuSource
   -- The name of the menu the last menuPick came from.
   return the uUiMenu of this stack
end uiMenuSource

-- ==== SUITE UI KIT v2 END ====

-- ---- state -------------------------------------------------------------------
-- Everything the wallet knows, in one place. The engine layer below holds NO
-- state at all, so this is the whole of it and there is nowhere else to look.

local sWaBuilt            -- "true" once the window has been built
local sWaScreen           -- the visible screen's name
local sWaHaveCoin         -- "true" when the coinxt extension answered
local sWaHaveSodium       -- "true" when sodiumxt answered
local sWaSodiumWhy        -- why not, when it did not
local sWaHaveOnion        -- "true" when the OnionXT script layer is present

local sWaNetwork          -- mainnet | testnet | signet | regtest
local sWaScriptType       -- p2pkh | p2sh-p2wpkh | p2wpkh | p2tr | p2wsh
local sWaKind             -- seed | watch | key | multisig
local sWaAccount          -- the BIP-44 account number
local sWaCustomPath       -- an account path typed by hand; empty = the standard one
local sWaLabel            -- the wallet's own name
local sWaUnit             -- BTC | mBTC | sat

local sWaMnemonic         -- the seed phrase, while a seed wallet is open
local sWaPassphrase       -- the BIP-39 passphrase (the "25th word")
local sWaAccountXpub      -- the account extended key, always present
local sWaAccountXprv      -- the account extended PRIVATE key, seed wallets only
local sWaFingerprint      -- the master fingerprint, for descriptors and PSBT
local sWaImportedWif      -- a single imported key, for a key wallet
local sWaCosigners        -- a list of cosigner account xpubs, multisig only
local sWaM                -- the m of m-of-n, multisig only

local sWaAddresses        -- list of derived address records, both chains
local sWaLabels           -- array: address -> the user's label for it
local sWaUtxos            -- list of UTXO records
local sWaHistory          -- list of transaction records
local sWaBalance          -- array: confirmed, unconfirmed, frozen
local sWaSelected         -- array: "txid:vout" -> true, the ticked coins
local sWaFrozen           -- array: "txid:vout" -> true
local sWaRbf              -- "true" when spends opt in to BIP-125 replaceability
local sWaSeedChoice       -- "new" | "restore": which seed button is lit

local sWaBackend          -- esplora-tor | electrum-tor | esplora-clear | offline
local sWaHost             -- the backend host
local sWaPort             -- the backend port
local sWaSocksPort        -- the Tor SOCKS port
local sWaSock             -- the clearnet Electrum socket ("host:port"), empty when none
local sWaBooted           -- "true" once waBoot has run, however it was reached
local sWaNetState         -- idle | dialing | busy | ok | partial | failed
local sWaNetWhy           -- the last network message
local sWaTipHeight        -- the chain tip, when a backend has told us
local sWaFeeRates         -- array: target blocks -> sat/vB, from the backend
local sWaSyncFailures     -- requests this sync gave up on; a sync is not "ok" while it is set

local sWaQueue            -- list of pending request records
local sWaInFlight         -- the request record being served, or empty
local sWaStream           -- the OnionXT stream handle in flight, or empty
local sWaStreamTo         -- "host:port" that stream was dialled to; the Electrum
                          -- transport keeps it open between requests (2026-09-03)
local sWaLastPaint        -- the milliseconds of the last full repaint during a sync
local sWaBatch            -- "false" once this server has refused a JSON-RPC batch
local sWaBatchCap         -- how many requests the next batch may carry after a refusal (empty: kWaBatchSize); halved per refusal until batching is off
local sWaBatchMembers     -- the requests inside the batch in flight (waNetPump)
local sWaHttpPhase        -- the Esplora reply decoder's phase: head, size, data,
                          -- gap, trailer, len, close, done (waHttpFeed)
local sWaHttpHead         -- that reply's status line and headers
local sWaHttpBad          -- a non-2xx status line, held until the body has arrived so the refusal can quote the reason instead of the headers
local sWaHttpBody         -- ...and its body so far, de-chunked
local sWaHttpLeft         -- bytes still to come in the current chunk or body
local sWaHttpDrop         -- "true" when the reply said Connection: close
local sWaTipAt            -- the milliseconds the tip was last answered, or empty
local sWaFeesAt           -- ...and the fee estimate; a sync asks only for what is stale
local sWaBuffer           -- the bytes accumulated for the in-flight request
local sWaReqId            -- a monotonic id, so a late reply cannot be mistaken
local sWaPolling          -- "true" while the tick is armed

local sWaLog              -- the request/response log text
local sWaLastPsbt         -- the PSBT the Tools screen is holding
local sWaLastRaw          -- the raw transaction the Send screen produced
-- WHAT EACH SIGNED SPEND WAS MADE OF, keyed by txid. Recorded at the moment
-- of signing because that is the only moment the wallet still holds it: a
-- replacement must spend the SAME inputs, and BIP-143 commits to each input's
-- VALUE, which is the one number the raw transaction does not carry. By the
-- time a person wants to bump, the coins have left sWaUtxos - so without this
-- the wallet can compute what a replacement must pay and cannot build one,
-- which is exactly the state waBumpAdvice used to describe as a deliberate
-- choice.
--
-- It holds no private key and nothing that is not already in the transaction
-- it names, so it is saved with the wallet like the labels are.
local sWaSpends
local sWaLeaves
local sWaLastCommit, sWaLastLock, sWaLastReveal           -- list of {kind, index, type, bodyhex, height}: the one-leaf taproot outputs this wallet prepared (inscription commits, timelocks), re-attached after every derivation and saved with the wallet
local sWaSpentBy                                            -- "txid:vout" -> the txid of the transaction THIS WALLET BROADCAST that spends it; memory only, and the mark comes off the moment the backend lists the coin as unspent again (waNoteBroadcast, waMergeUtxos)
local sWaInspectWanted    -- the txid the History screen is waiting on bytes for
local sWaQrCache          -- array: payload -> the BMP bytes already rendered
local sWaCtrlByScreen     -- array: screen -> comma list of its control names
local sWaBusyUntil        -- the milliseconds a long build is allowed to run to

-- ==============================================================================
-- LIFECYCLE
-- ==============================================================================

on preOpenStack
   -- pinned: since 2026-09-04 these two are also sent from a timer after an
   -- update replaced the script (waUpdateApply), and a delayed handler's
   -- unqualified control references resolve against the defaultStack
   set the defaultStack to the short name of this stack
   waBuild
end preOpenStack

on openStack
   set the defaultStack to the short name of this stack
   -- The self-check is called from HERE rather than from inside waBoot,
   -- because tools/check-demo-selfcheck-drift.py reads this handler's body
   -- looking for it: a run handler reached only through a helper is a run
   -- handler the gate cannot see, and the gate is right to want to see it.
   waBoot
   waScRun
end openStack

on closeStack
   -- FREE WHAT WE OPENED. There is no deterministic unload hook in this
   -- engine, so every socket, stream and timer this stack started is stopped
   -- here, and every teardown is safe to call twice.
   local tError
   put "false" into sWaPolling
   waNetAbort
   -- an update's carry that was never read back must not outlive the window
   set the uWaUpdateCarry of this stack to empty
   try
      oxShutdown
   catch tError
   end try
   -- key hygiene: the seed and the account private key do not outlive the
   -- window. The wallet file, if there is one, already has them.
   put empty into sWaMnemonic
   put empty into sWaPassphrase
   put empty into sWaAccountXprv
   put empty into sWaImportedWif
   -- AND THE ADDRESS RECORDS, which is the one this comment used to be wrong
   -- about. cwAddressAt puts the derived private key into every record when
   -- the account node holds one, so sWaAddresses is 2 x kWaPrefill spendable
   -- keys - more key material than the three lines above it, left behind by a
   -- teardown that said the seed does not outlive the window.
   put waEmptyList() into sWaAddresses
   put empty into sWaSelected
   if there is a field "wl_mnemonic" then
      put empty into field "wl_mnemonic"
   end if
   if there is a field "wl_pass" then
      put empty into field "wl_pass"
   end if
   if there is a field "wl_xkey" then
      put empty into field "wl_xkey"
   end if
   if there is a field "st_password" then
      put empty into field "st_password"
   end if
end closeStack

command waBoot
   -- The order matters. Probe first, because every screen's advice depends on
   -- which extensions answered; then load or start a wallet; then arm the
   -- pump; then run the boot self-check, which reports what all of that found.
   put "true" into sWaBooted
   waProbe
   waResetWallet
   waShow "wallet"
   waRefreshAll
   put "true" into sWaPolling
   send "waTick" to me in kWaTick milliseconds
   -- LAST, so it lands on a booted wallet: the state an update carried
   -- across the script swap (waUpdateApply), if there is one
   waUpdateRestore
end waBoot

command waProbe
   -- Capability probing, the family idiom: call the real primitive inside a
   -- try and believe the answer, because there is no `there is a library`
   -- test and an absent extension raises a catchable execution error.
   local tError, tVersion
   put "false" into sWaHaveCoin
   put "false" into sWaHaveSodium
   put "false" into sWaHaveOnion
   put empty into sWaSodiumWhy
   try
      get cxSha256("probe")
      put "true" into sWaHaveCoin
   catch tError
      put "false" into sWaHaveCoin
   end try
   try
      -- sxVersion runs the ABI compare before it reads anything, so a string
      -- back proves BOTH the extension and a matching native binary. A mixed
      -- package lands in the same catch as a missing one, which is why the
      -- reason is kept and shown rather than reduced to a boolean.
      put sxVersion() into tVersion
      get sxRandomBytes(8)
      put "true" into sWaHaveSodium
   catch tError
      put "false" into sWaHaveSodium
      put line 1 of tError into sWaSodiumWhy
   end try
   try
      get oxVersion()
      put "true" into sWaHaveOnion
   catch tError
      put "false" into sWaHaveOnion
   end try
end waProbe

command waResetWallet
   -- A wallet that has not been opened yet, but a REAL one: the published
   -- test mnemonic on testnet, so every screen has something true to show and
   -- nobody has to type a seed to find out what the thing does.
   put "testnet" into sWaNetwork
   put "p2wpkh" into sWaScriptType
   put "seed" into sWaKind
   put 0 into sWaAccount
   put empty into sWaCustomPath
   put "Demonstration wallet" into sWaLabel
   put "BTC" into sWaUnit
   put kWaTestMnemonic into sWaMnemonic
   put empty into sWaPassphrase
   put empty into sWaImportedWif
   put 2 into sWaM
   put waEmptyList() into sWaCosigners
   put waEmptyList() into sWaUtxos
   put waEmptyList() into sWaHistory
   put waEmptyList() into sWaAddresses
   put waEmptyList() into sWaLeaves
   put empty into sWaLabels
   put empty into sWaSelected
   put empty into sWaFrozen
   -- REPLACEABLE BY DEFAULT. A fee estimate is a guess about a market, and a
   -- transaction that cannot be bumped turns a wrong guess into a wait with
   -- no remedy. Every wallet this one is modelled on defaults the same way.
   put "true" into sWaRbf
   put "restore" into sWaSeedChoice
   put 0 into sWaBalance["confirmed"]
   put 0 into sWaBalance["unconfirmed"]
   put 0 into sWaBalance["frozen"]
   put "offline" into sWaBackend
   put kWaEsploraOnion into sWaHost
   put 80 into sWaPort
   put kWaSocksDefault into sWaSocksPort
   put "idle" into sWaNetState
   put empty into sWaNetWhy
   put empty into sWaTipHeight
   put empty into sWaFeeRates
   put 0 into sWaSyncFailures
   put waEmptyList() into sWaQueue
   put empty into sWaInFlight
   put empty into sWaStream
   put empty into sWaBuffer
   put 0 into sWaReqId
   put empty into sWaLastPsbt
   put empty into sWaLastRaw
   put empty into sWaQrCache
   if sWaHaveCoin is "true" then
      waDeriveAccount
   end if
end waResetWallet

function waEmptyList
   local tList
   put 0 into tList["n"]
   return tList
end waEmptyList

-- ---- the pump ----------------------------------------------------------------

on waTick
   -- PIN THE STACK FIRST. This handler arrives from `send ... in`, and
   -- everything it reaches writes to controls by unqualified name; inside
   -- openStack the defaultStack happens to be this stack and here it is
   -- whatever is in front (tools/check-timer-stack-pin.py holds this).
   set the defaultStack to the short name of this stack
   local tError
   if sWaPolling is not "true" then
      exit waTick
   end if
   try
      waNetPump
   catch tError
      waLog "pump error: " & tError
   end try
   send "waTick" to me in kWaTick milliseconds
end waTick

-- ==============================================================================
-- THE WINDOW
--
-- Every control of every screen is created ONCE, at open, and screens are
-- switched by visibility. There is no reparenting in this engine (no way to
-- move a control into a group after the fact), so a "tab" is a naming
-- convention plus a show/hide sweep, and that is what this is: every screen's
-- controls are named "<code>_<thing>", the sweep matches the first three
-- characters, and the chrome and the navigation rail match none of them and
-- therefore never move.
--
-- Building everything up front costs one pass at startup and buys two things:
-- the boot self-check can assert that every control this script names exists
-- (a lazily built screen would report its own controls missing), and a screen
-- switch is a visibility change rather than a construction.
-- ==============================================================================

command waBuild
   -- THE SCREEN MUST ALWAYS UNLOCK. `lock screen` with an unguarded body is
   -- how a script error becomes a frozen ENGINE: the throw skips the unlock,
   -- the compositor never repaints, and OXT and the IDE both appear hung with
   -- no error anybody can read. That is not a hypothetical - it is what a
   -- Windows tester saw, and the freeze hid whatever really threw. An error
   -- here is now an error message on a window that redraws.
   --
   -- waDefaults runs FIRST because waBuild is called from preOpenStack, which
   -- is BEFORE waBoot sets any wallet state, and several things a screen can
   -- reach ask wallet-core for the script type. cwTypeIndex refuses an empty
   -- one - correctly, it is a closed set - with "unknown script type """,
   -- which is a true statement about a variable nobody had assigned yet.
   local tError
   if the uUiVersion of this stack is kWaUiVersion then
      exit waBuild
   end if
   waDefaults
   lock screen
   try
      waBuildAll
   catch tError
      unlock screen
      waLog "BUILD FAILED: " & tError
      answer "The wallet could not build its window:" & return & return & \
            tError & return & return & "Nothing else has run. Please report " & \
            "this with the text above."
      exit waBuild
   end try
   unlock screen
   set the uUiVersion of this stack to kWaUiVersion
   put "true" into sWaBuilt
end waBuild

command waDefaults
   -- The state every screen may read, set before the window is built. These
   -- are the same values waResetWallet uses; it is called later, from waBoot,
   -- and re-setting them there is harmless. What is NOT harmless is a painter
   -- reaching wallet-core with an empty script type.
   if sWaNetwork is "" then
      put "testnet" into sWaNetwork
   end if
   if sWaScriptType is "" then
      put "p2wpkh" into sWaScriptType
   end if
   if sWaKind is "" then
      put "seed" into sWaKind
   end if
   if sWaAccount is "" then
      put 0 into sWaAccount
   end if
   if sWaM is "" then
      put 2 into sWaM
   end if
   if sWaUnit is "" then
      put "BTC" into sWaUnit
   end if
   if sWaBackend is "" then
      put "offline" into sWaBackend
   end if
   if sWaCosigners is "" then
      put waEmptyList() into sWaCosigners
   end if
   if sWaAddresses is "" then
      put waEmptyList() into sWaAddresses
   end if
   if sWaUtxos is "" then
      put waEmptyList() into sWaUtxos
   end if
   if sWaHistory is "" then
      put waEmptyList() into sWaHistory
   end if
end waDefaults

private command waBuildAll
   uiChrome "CoinXT Wallet", kWaWidth, kWaHeight, kWaBandH
   waBuildNav
   waBuildWallet
   waBuildReceive
   waBuildAddresses
   waBuildSend
   waBuildCoins
   waBuildHistory
   waBuildOrdinals
   waBuildVault
   waBuildTools
   waBuildNetwork
   waBuildLog
   waBuildSettings
   uiFooter "CoinXT Wallet " & kWaVersion & " - a DEMONSTRATION wallet. " & \
         "Script memory is not locked, so a seed typed here can be paged to " & \
         "disk: use testnet, or an amount you would be relaxed about losing. " & \
         "Verified statically and by tools/check-wallet-vectors.py against an " & \
         "independent implementation; needs an OXT pass (Tor: + a live-Tor pass).", \
         "16,598,1184,636"
   waTips
end waBuildAll

-- ---- tooltips ----------------------------------------------------------------
-- Every button a person might wonder about says what it does on hover
-- (2026-09-04). The kit builds no tooltips, so this is the wallet's own
-- pass over its own controls, after the build; a name that does not exist
-- is skipped rather than thrown on, because a tooltip is never worth a
-- failed boot.

private command waTip pName, pText
   if there is a button pName then
      set the tooltip of button pName to pText
   else if there is a field pName then
      set the tooltip of field pName to pText
   end if
