   end if
   if tBlocks < 144 then
      return tBlocks & " blocks (about " & cwIntDiv(tBlocks * 10 + 59, 60) & " hours)"
   end if
   put cwIntDiv(tBlocks + 71, 144) into tDays
   return tBlocks & " blocks (about " & tDays & " days)"
