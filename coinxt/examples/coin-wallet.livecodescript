function waInscribeRevealText
   local tI, tCount, tCoin, tRec, tAddrRec, tRate, tVsize, tFee, tValue, tDust
   local tInputs, tOutputs, tSel, tTo, tRaw, tNew, tOut
   put "" into tCoin
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      put waRecordFor(tRec["address"]) into tAddrRec
      if tAddrRec is not "" and tAddrRec["leafscript"] is not "" \
            and tAddrRec["lockheight"] is "" and tRec["frozen"] is not "true" then
         put tRec into tCoin
         exit repeat
      end if
   end repeat
   if tCoin is "" then
      if cwListCount(sWaLeaves) is 0 then
         throw "nothing to reveal: write the content above and press 1 first."
      end if
      throw "no commit is funded yet. Pay the commit address, press Refresh " & \
            "so the coin is seen, then press 2 again."
   end if
   if sWaKind is "watch" then
      throw "this watch-only wallet cannot sign the reveal."
   end if
   put field "sd_rate" into tRate
   if tRate is not a number or tRate <= 0 then
      throw "set a fee rate on the Send screen first: the reveal pays at that rate."
   end if
   put waNextUnusedOrMore() into tTo
   put 11 + cwTapscriptInputVsize(tAddrRec["leafscript"]) + 43 into tVsize
   put waCeilSat(tRate * tVsize) into tFee
   if tFee < cwFeeFor(tVsize, 1) then
      put cwFeeFor(tVsize, 1) into tFee
   end if
   put tCoin["value"] - tFee into tValue
   put cwDustThreshold("p2tr") into tDust
   if tValue < tDust then
      throw "the commit holds " & waAmount(tCoin["value"]) & ", and the reveal " & \
            "needs " & waAmount(tFee) & " in fees at " & tRate & " sat/vB plus an " & \
            "output above " & tDust & " sat. Lower the rate, or fund the commit again."
   end if
   put waEmptyList() into tInputs
   put cwListAdd(tInputs, cwTxInput(tCoin["txid"], tCoin["vout"], kCwSeqRbf)) into tInputs
   put waEmptyList() into tSel
   put cwListAdd(tSel, tCoin) into tSel
   put waEmptyList() into tOutputs
   put cwListAdd(tOutputs, cwTxOutput(tValue, tTo["script"])) into tOutputs
   put waSignSpend(tInputs, tOutputs, tSel, 0) into tRaw
   put cwTxDecode(tRaw) into tNew
   put tRaw into sWaLastRaw
   waRecordSpend tNew["txid"], tSel, waEmptyList(), tValue, tTo, 0, kCwSeqRbf, \
         tFee, tNew["vsize"] + 0
   -- THE INSCRIBED SAT IS FROZEN BEFORE IT EXISTS. The reveal's first output
   -- carries the inscription on its first sat, and a later spend that picked
   -- it as an ordinary coin would hand the inscription to a miner as fee or
   -- to a payee who never asked. The freeze is keyed by outpoint, so it is
   -- in place the moment the coin is seen, and it is saved with the wallet.
   put "true" into sWaFrozen[tNew["txid"] & ":0"]
   put "INSCRIPTION REVEAL SIGNED" & return & return into tOut
   put "  inscription " & tNew["txid"] & "i0" & return after tOut
   put "  content     " & tAddrRec["note"] & return after tOut
   put "  commit      " & tCoin["txid"] & ":" & tCoin["vout"] & "  " & \
         waAmount(tCoin["value"]) & return after tOut
   put "  reveal      " & tNew["txid"] & ", " & tNew["vsize"] & " vB, fee " & \
         waAmount(tFee) & " (" & tRate & " sat/vB)" & return after tOut
   put "  lands on    " & tTo["address"] & "  (receive index " & tTo["index"] & \
         ", first sat of the first output)" & return & return after tOut
   put "The witness carries the envelope; Inspect on this transaction reads " & \
         "it back." & return & return after tOut
   put "The output that receives it is FROZEN on the Coins screen from now, so " & \
         "no ordinary spend can pick the inscribed sat up as a fee or a " & \
         "payment. Unfreeze it there when you mean to move the inscription." & \
         return & return after tOut
   put tRaw & return & return after tOut
   put "NOTHING HAS BEEN BROADCAST. The Send screen's Broadcast button will push it." after tOut
   put tNew["txid"] into sWaLastReveal
   waLog "inscribe: reveal " & tNew["txid"] & " spends " & tCoin["txid"] & ":" & \
         tCoin["vout"] & " through the leaf, " & tNew["vsize"] & " vB"
   uiStatus "Reveal signed: " & tNew["txid"] & "i0. Broadcast is on the Send screen.", "ok"
   return tOut
end waInscribeRevealText

command waSignMessage
   local tAddr, tRec, tSig, tKey, tType, tMsg, tFormat
   set the defaultStack to the short name of this stack
   put cwTrim(field "tl_msgAddr") into tAddr
   if tAddr is "" then
      put waFirstAddress() into tAddr
      put tAddr into field "tl_msgAddr"
   end if
   put waRecordFor(tAddr) into tRec
   if tRec is "" then
      throw tAddr & " is not an address this wallet holds a key for."
   end if
   put tRec["scripttype"] into tType
   if tType is "p2wsh" then
      throw "a multisig address has no single key to sign with, in either " & \
            "format. Sign with one of the cosigners' own addresses."
   end if
   -- WHICH FORMAT (2026-09-04). Taproot has no 2011 header, so it is always
   -- BIP-322; native SegWit is BIP-322 when the box is ticked and the 2011
   -- format with its 39 header otherwise, because both are in use and the
   -- verifier on the other end decides which it can read; legacy and nested
   -- stay 2011, which is what the world expects of them.
   put "2011" into tFormat
   if tType is "p2tr" or (tType is "p2wpkh" and \
         the hilite of button "tl_msg322" is true) then
      put "BIP-322" into tFormat
   end if
   put waSeckeyFor(tRec) into tKey
   if tFormat is "BIP-322" then
      put cwBip322Sign(tKey, field "tl_msg", tType, tRec["script"], \
            tRec["pubkey"]) into tSig
   else
      put cwMsgSign(tKey, field "tl_msg", tType, true) into tSig
   end if
   put empty into tKey
   put tSig into field "tl_msgSig"
   -- the message goes into a local first, for the reason waNetDeliver gives
   put field "tl_msg" into tMsg
   put "SIGNED (" & tFormat & ")" & return & return & "address   " & tAddr & \
         return & "message   " & tMsg & return & "signature " & tSig & return & \
         return & "Anyone can check this with the address, the message and the " & \
         "signature. Nothing about it can move coins." into field "tl_out"
   uiStatus "Signed as " & tAddr & " (" & tFormat & ").", "ok"
end waSignMessage

command waVerifyMessage
   local tRec, tAddr
   set the defaultStack to the short name of this stack
   put cwTrim(field "tl_msgAddr") into tAddr
   -- the format is read off the signature: the 2011 format is exactly 65
   -- bytes (header, r, s) and a BIP-322 witness stack never is
   if the number of bytes of base64Decode(cwStripWhitespace(field "tl_msgSig")) is 65 then
      put cwMsgVerify(sWaNetwork, tAddr, field "tl_msg", field "tl_msgSig") into tRec
   else
      put cwBip322Verify(sWaNetwork, tAddr, field "tl_msg", field "tl_msgSig") into tRec
   end if
   if tRec["ok"] is true then
      put "VERIFIED" & return & return & "The holder of the key to" & return & \
            "  " & tAddr & return & "signed exactly this message." & return into field "tl_out"
      if tRec["why"] is not "" then
         put return & tRec["why"] after field "tl_out"
      end if
      uiStatus "Verified against " & tAddr & " (" & tRec["kind"] & ").", "ok"
   else
      put "NOT VERIFIED" & return & return & tRec["why"] & return & return & \
            "One changed character in the message is enough to do this, and " & \
            "so is one changed character in the address." into field "tl_out"
      uiStatus "Not verified: " & tRec["why"], "bad"
   end if
end waVerifyMessage

command waPsbtSign
   local tKeys, tRec, tI, tCount, tNode, tResult
   if sWaLastPsbt is empty then
      throw "no PSBT is held. Paste one and press 'Hold as the current PSBT'."
   end if
   put waSigningKeys() into tKeys
   if cwListCount(tKeys) < 1 then
      throw "this wallet holds no private keys, so it cannot sign a PSBT."
   end if
   put cwPsbtSign(sWaLastPsbt, tKeys, sWaNetwork) into tResult
   put empty into tKeys
   put tResult["psbt"] into sWaLastPsbt
   put "SIGNED " & tResult["signed"] & " input(s)." & return & return & \
         cwPsbtSummary(sWaLastPsbt, sWaNetwork) into field "tl_out"
   if tResult["why"] is not "" then
      put return & "Not signed:" & return & tResult["why"] after field "tl_out"
   end if
   put return & sWaLastPsbt after field "tl_out"
   uiStatus "Signed " & tResult["signed"] & " input(s) of the held PSBT.", "ok"
end waPsbtSign

private function waSigningKeys
   -- Every private key this wallet can produce for its own derived addresses.
   -- Built on demand and handed straight to the signer, which is the only
   -- place they exist; the caller empties the list immediately afterwards.
   -- A MULTISIG RECORD HAS NO "seckey" OF ITS OWN, and that is why this used
   -- to answer with nothing at all for the one wallet kind PSBT exists for.
   -- cwMultisigAddressAt sets "witnessscript", "script" and "pubkeys"; the
   -- private half is this wallet's cosigner key, which waCosignerKeys derives
   -- from the account xprv. waSeckeyFor threw for every such record, the
   -- try/catch below swallowed each throw, the list came back empty, and
   -- waPsbtSign refused with "no keys". Both shapes are collected now, and
   -- the result is deduplicated because one cosigner key can serve several
   -- addresses.
   local tList, tI, tCount, tRec, tKey, tError, tJ, tSeen, tCos, tK
   put waEmptyList() into tList
   put waEmptyList() into tSeen
   put cwListCount(sWaAddresses) into tCount
   repeat with tI = 1 to tCount
      put sWaAddresses[tI] into tRec
      put "" into tKey
      try
         put waSeckeyFor(tRec) into tKey
      catch tError
         put "" into tKey
      end try
      if tKey is "" and tRec["witnessscript"] is not "" then
         try
            put waCosignerKeys(tRec) into tCos
            if cwListCount(tCos) > 0 then
               put tCos[1] into tKey
            end if
         catch tError
            put "" into tKey
         end try
      end if
      if tKey is not "" and cwHexListHas(tSeen, tKey) is not true then
         put cwListAdd(tSeen, tKey) into tSeen
         put "" into tK
         put tKey into tK["seckey"]
         put cwListAdd(tList, tK) into tList
      end if
   end repeat
   return tList
end waSigningKeys

command waPsbtFinalize
   local tResult, tRec
   if sWaLastPsbt is empty then
      throw "no PSBT is held."
   end if
   put cwPsbtFinalize(sWaLastPsbt) into tResult
   if tResult["complete"] is not true then
      put "NOT COMPLETE - this cannot be broadcast yet:" & return & return & \
            tResult["why"] & return & return & \
            "Send the PSBT to whoever holds the missing keys, and combine " & \
            "what they send back." into field "tl_out"
      uiStatus "The PSBT is not fully signed.", "warn"
      exit waPsbtFinalize
   end if
   put tResult["raw"] into sWaLastRaw
   put cwTxDecode(tResult["raw"]) into tRec
   put "FINALIZED" & return & return & "txid  " & tRec["txid"] & return & \
         "vsize " & tRec["vsize"] & " vB" & return & return & tResult["raw"] & \
         return & return & "Nothing has been broadcast. The Send screen's " & \
         "Broadcast button will push it, or copy it out." into field "tl_out"
   uiStatus "Finalized " & tRec["txid"] & ".", "ok"
end waPsbtFinalize

command waPsbtCombine pOther
   local tCombined
   if sWaLastPsbt is empty then
      throw "no PSBT is held to combine with."
   end if
   if pOther is "" then
      throw "paste the other cosigner's PSBT into the box first."
   end if
   put cwPsbtCombine(sWaLastPsbt, pOther) into tCombined
   put tCombined into sWaLastPsbt
   put "COMBINED." & return & return & cwPsbtSummary(tCombined, sWaNetwork) & \
         return & tCombined into field "tl_out"
   uiStatus "Combined. Try Finalize.", "ok"
end waPsbtCombine

command waNewKey
   -- A SINGLE KEY WITH NO WALLET BEHIND IT, which is the other half of what a
   -- key tool is for. Everything else here derives from a seed; sometimes what
   -- is wanted is one key, made now, that no seed will ever produce again.
   --
   -- The entropy is SodiumXT's and there is no fallback, for the reason
   -- waGenerateSeed gives: a key made from anything weaker is a key somebody
   -- else can guess. cxWifEncode refuses a value that is zero or at or above
   -- the group order, so the 1-in-2^128 case fails closed here rather than
   -- encoding something no node will accept.
   local tEntropy, tHex, tWif, tInfo, tOut, tWifNet
   set the defaultStack to the short name of this stack
   if sWaHaveSodium is not "true" then
      throw "a new key needs SodiumXT for entropy and it is not installed. " & \
            "There is no fallback here on purpose."
   end if
   put "testnet" into tWifNet
   if sWaNetwork is "mainnet" then
      put "mainnet" into tWifNet
   end if
   put sxRandomBytes(32) into tEntropy
   put cxHexEncode(tEntropy) into tHex
   put empty into tEntropy
   put cxWifEncode(tHex, tWifNet, true) into tWif
   put empty into tHex
   put cwWifInfo(tWif, sWaNetwork) into tInfo
   put "A NEW SINGLE KEY" & return & return into tOut
   put "  network      " & sWaNetwork & return after tOut
   put "  WIF          " & tWif & return after tOut
   put "  public key   " & tInfo["pubkey"] & return & return after tOut
   put "  P2PKH        " & tInfo["p2pkh"] & return after tOut
   put "  P2SH-P2WPKH  " & tInfo["p2sh-p2wpkh"] & return after tOut
   put "  P2WPKH       " & tInfo["p2wpkh"] & return & return after tOut
   put "THIS KEY IS NOT IN THIS WALLET and nothing here will remember it. " & \
         "Copy it somewhere before you move on. To spend from it later, " & \
         "open an Import-key wallet with that WIF." after tOut
   put tOut into field "tl_out"
   put empty into tWif
   uiStatus "Made one key. It is NOT part of this wallet - copy it now.", "warn"
end waNewKey

command waDeriveAtPath pPath
   -- ONE ADDRESS AT ANY PATH, from this wallet's own master key.
   --
   -- The Wallet screen's custom path changes where the whole wallet lives;
   -- this answers a narrower question that comes up while looking for it -
   -- "what is at m/44'/0'/0'/0/7?" - without moving anything. It is how you
   -- find which path an old wallet used: try one, compare the address.
   local tPath, tSeed, tMaster, tNode, tHex, tWif, tInfo, tOut, tWifNet
   set the defaultStack to the short name of this stack
   put cwTrim(pPath) into tPath
   if tPath is "" then
      throw "type a derivation path into the box above, like " & \
            "m/44'/0'/0'/0/7, and press Derive at path."
   end if
   if sWaMnemonic is empty then
      throw "this wallet has no seed phrase, so there is no master key to " & \
            "derive from. Open a seed or a restored wallet first."
   end if
   -- cwParsePath is the authority on the shape and refuses a trailing
   -- separator, an empty level and a level out of range, so a mistyped path
   -- is a sentence rather than a confident wrong address.
   get cwParsePath(tPath)
   put "testnet" into tWifNet
   if sWaNetwork is "mainnet" then
      put "mainnet" into tWifNet
   end if
   put cxMnemonicToSeed(cxMnemonicNormalize(sWaMnemonic), sWaPassphrase) into tSeed
   put cxHdFromSeed(tSeed) into tMaster
   put empty into tSeed
   put cxHdDerivePath(tMaster, tPath) into tNode
   put empty into tMaster
   put cxHexEncode(tNode["seckey"]) into tHex
   put empty into tNode
   if tHex is "" then
      throw "that path produced no private key, so there is nothing to show."
   end if
   put cxWifEncode(tHex, tWifNet, true) into tWif
   put empty into tHex
   put cwWifInfo(tWif, sWaNetwork) into tInfo
   put "DERIVED AT " & tPath & return & return into tOut
   put "  network      " & sWaNetwork & return after tOut
   put "  WIF          " & tWif & return after tOut
   put "  public key   " & tInfo["pubkey"] & return & return after tOut
   put "  P2PKH        " & tInfo["p2pkh"] & return after tOut
   put "  P2SH-P2WPKH  " & tInfo["p2sh-p2wpkh"] & return after tOut
   put "  P2WPKH       " & tInfo["p2wpkh"] & return & return after tOut
   put "This is the key at that exact path. It is shown, not imported: " & \
         "nothing about this wallet has changed. If this is where your coins " & \
         "are, put the ACCOUNT part of the path in the Custom path box on " & \
         "the Wallet screen and open the wallet there." after tOut
   put tOut into field "tl_out"
   put empty into tWif
   uiStatus "Derived " & tPath & ". Nothing was imported.", "ok"
end waDeriveAtPath

command waSweep pWif
   -- Read a private key and say what it can reach. Sweeping proper needs a
   -- backend to find the coins; this half - which addresses the key unlocks -
   -- works offline and is the half people get wrong.
   local tInfo, tOut
   if pWif is "" then
      throw "paste a WIF private key into the box first."
   end if
   put cwWifInfo(pWif, sWaNetwork) into tInfo
   put "THAT KEY UNLOCKS" & return & return into tOut
   put "  network     " & tInfo["network"] & return after tOut
   put "  compressed  " & tInfo["compressed"] & return after tOut
   put "  P2PKH       " & tInfo["p2pkh"] & return after tOut
   if tInfo["p2wpkh"] is "" then
      put "  P2WPKH      none - an UNCOMPRESSED key has no SegWit address" & \
            return after tOut
      put "              (BIP-143 forbids one, so an address offered here " & \
            "would be unspendable)" & return after tOut
   else
      put "  P2SH-P2WPKH " & tInfo["p2sh-p2wpkh"] & return after tOut
      put "  P2WPKH      " & tInfo["p2wpkh"] & return after tOut
   end if
   if tInfo["warning"] is not "" then
      put return & "  WARNING: " & tInfo["warning"] & return after tOut
   end if
   put return & "To sweep it: open this wallet as an 'Import key' wallet with " & \
         "that WIF, let it find the coins, then send MAX to an address of " & \
         "your real wallet." after tOut
   put tOut into field "tl_out"
   uiStatus "Read the key. It has not been imported.", ""
end waSweep

command waEntropyToMnemonic pHex
   local tBytes, tWords, tLen
   if pHex is "" then
      throw "paste 16, 20, 24, 28 or 32 bytes of hex entropy."
   end if
   put cxHexDecode(cwLower(pHex)) into tBytes
   put the number of bytes of tBytes into tLen
   put cxMnemonicFromEntropy(tBytes) into tWords
   put empty into tBytes
   put "ENTROPY TO MNEMONIC" & return & return & tLen & " bytes = " & \
         (tLen * 8) & " bits" & return & return & tWords & return & return & \
         "This is BIP-39's own mapping and is reversible: the same entropy " & \
         "always gives the same words. It is here so you can check a dice " & \
         "roll or a hardware source against what this wallet would derive." \
         into field "tl_out"
   put empty into tWords
   uiStatus "Converted " & tLen & " bytes of entropy.", "ok"
end waEntropyToMnemonic

command waWordsToEntropy pWords, pPassphrase
   -- THE OTHER DIRECTION, and the round trip proved rather than asserted.
   --
   -- Entropy-to-words shipped alone, which made this screen a one-way street:
   -- you could check what a dice roll would become, but not what a phrase you
   -- already hold came FROM - and the entropy is the thing you write on
   -- steel, the thing a different wallet's "advanced import" asks for, and
   -- the only form in which two implementations can be compared without
   -- trusting either one's wordlist.
   --
   -- It runs the trip BOTH WAYS and refuses to report a result the return
   -- journey does not reproduce. That is not decoration: the entropy is
   -- recovered by stripping checksum bits, and an off-by-one there yields a
   -- perfectly plausible hex string that regenerates DIFFERENT WORDS. A
   -- number that looks right and is wrong is the whole failure mode of this
   -- conversion, and comparing the words back is the only cheap way to catch
   -- it.
   local tWords, tEntropy, tHex, tBack, tBits, tLen, tOut, tPass, tCount
   put cxMnemonicNormalize(cwTrim(pWords)) into tWords
   if tWords is "" then
      throw "paste a BIP-39 seed phrase into the box."
   end if
   if cxMnemonicValidate(tWords) is not true then
      throw "that is not a valid BIP-39 phrase: the checksum does not match, " & \
            "so at least one word is wrong, missing or out of order. Nothing " & \
            "has been derived from it."
   end if
   put cxMnemonicToEntropy(tWords) into tEntropy
   put cxHexEncode(tEntropy) into tHex
   put the number of bytes of tEntropy into tLen
   put cxMnemonicFromEntropy(tEntropy) into tBack
   put empty into tEntropy
   if tBack is not tWords then
      -- Both halves of the trip are in this wallet, so a mismatch is a defect
      -- here and not a bad phrase - which is why it throws rather than
      -- reporting a number with a warning beside it.
      put empty into tBack
      throw "the entropy did not round-trip back to the same words. That is a " & \
            "defect in this wallet's BIP-39 code, not in your phrase. Nothing " & \
            "is being reported, because the number would be wrong."
   end if
   put empty into tBack
   put tLen * 8 into tBits
   put "SEED PHRASE" & return & return into tOut
   -- COUNTED FROM THE ENTROPY, not from the string. `the number of words of`
   -- is not the plain answer it looks like - LiveCode's word chunk treats a
   -- double-quoted run as ONE word - and CoinXT's own BIP-39 code does not use
   -- it either, splitting with its own cxSplitWords and counting items. Here
   -- there is a better source than either: BIP-39 fixes the relation, the
   -- checksum has already passed, and the entropy above round-tripped back to
   -- exactly these words, so (ENT + ENT/32) / 11 IS the word count.
   put cwIntDiv(tBits + cwIntDiv(tBits, 32), 11) into tCount
   put "  words       " & tCount & return after tOut
   put "  entropy     " & tLen & " bytes, " & tBits & " bits" & return after tOut
   put "  checksum    " & cwIntDiv(tBits, 32) & " bit(s), and it matches" & \
         return & return after tOut
   put "  " & tHex & return & return after tOut
   put "That hex and those words are the same secret written two ways, and" & return after tOut
   put "this wallet just proved it by converting back. Either one restores" & return after tOut
   put "this wallet anywhere; both are worth exactly what the coins are." & return & \
         return after tOut
   -- THE PASSPHRASE IS PART OF THE SEED AND NOT PART OF THE PHRASE, which is
   -- the single most misunderstood thing about BIP-39 and the reason both
   -- seeds are printed side by side. There is no wrong passphrase: every one
   -- of them opens a valid, empty, different wallet, and nothing anywhere
   -- will tell you that you typed it wrong.
   put "  master key WITHOUT a passphrase" & return after tOut
   put "    " & waSeedFingerprint(tWords, "") & return after tOut
   put cwTrim(pPassphrase) into tPass
   if tPass is not "" then
      put "  master key WITH the passphrase in the box" & return after tOut
      put "    " & waSeedFingerprint(tWords, tPass) & return after tOut
      put return & "Those two fingerprints are different wallets. The passphrase is" & return after tOut
      put "not a password on this phrase - it is a thirteenth word, and there is" & return after tOut
      put "no such thing as getting it wrong: every passphrase opens a real," & return after tOut
      put "empty, different wallet, and nothing will ever tell you which one you" & return after tOut
      put "meant." & return after tOut
   else
      put return & "No passphrase was given. Type one in the box beside these buttons" & return after tOut
      put "and press this again to see the different wallet it opens." & return after tOut
   end if
   put tOut into field "tl_out"
   put empty into tOut
   put empty into tWords
   uiStatus "That phrase is " & tBits & " bits of entropy, round-tripped.", "ok"
end waWordsToEntropy

private function waSeedFingerprint pWords, pPassphrase
   -- The BIP-32 master fingerprint for a (phrase, passphrase) pair: four
   -- bytes that name a wallet without revealing one. Printed rather than the
   -- seed itself, because the point here is COMPARING two derivations and the
   -- 64-byte seed is as spendable as the phrase.
   local tSeed, tMaster, tFp
   put cxMnemonicToSeed(pWords, pPassphrase) into tSeed
   put cxHdFromSeed(tSeed) into tMaster
   put empty into tSeed
   put cwFingerprint(cxHexEncode(tMaster["pubkey"])) into tFp
   put empty into tMaster
   return tFp
end waSeedFingerprint

function waExportText
   local tOut, tError
   put "EXPORT" & return & return into tOut
   put "wallet        " & sWaLabel & return after tOut
   put "network       " & sWaNetwork & return after tOut
   put "script type   " & sWaScriptType & return after tOut
   put "account path  " & waAccountPath() & \
         return after tOut
   put "fingerprint   " & sWaFingerprint & return & return after tOut
   put "account extended public key (SLIP-132 spelling):" & return after tOut
   put "  " & sWaAccountXpub & return & return after tOut
   try
      put "the same key in the BIP-32 spelling, which is what descriptors" & return after tOut
      put "and Bitcoin Core want:" & return after tOut
      put "  " & cwXKeyRespell(sWaAccountXpub, sWaNetwork, "p2pkh", true) & \
            return & return after tOut
      put "descriptors (receive, then change):" & return after tOut
      put "  " & waDescriptorFor(0) & return after tOut
      put "  " & waDescriptorFor(1) & return & return after tOut
   catch tError
      put "  (no descriptor for this wallet kind)" & return & return after tOut
   end try
   put "None of the above can spend anything. All of it reveals every" & return after tOut
   put "address this account will ever use, which is a privacy cost and not" & return after tOut
   put "a custody one." after tOut
   return tOut
end waExportText

function waInspectAnything pText
   -- Paste anything and find out what it is. The order of the tests is the
   -- order of how specific they are, so a PSBT is never mistaken for base64
   -- noise and a WIF is never mistaken for an address.
   local tError, tOut
   if pText is "" then
      return "Paste something into the box: a raw transaction in hex, a PSBT " & \
            "in base64, a WIF private key, an extended key, an address, or a " & \
            "bitcoin: URI."
   end if
   if cwBolt11IsInvoice(pText) then
      return waInvoiceText(pText)
   end if
   if waCarryLineToScreen(pText) then
      return "That line belongs to the " & waScreenLabel(waScreenIndexOf(sWaScreen)) & \
            " screen, which is open now with it filled in. Press the numbered " & \
            "button there."
   end if
   try
      return waInspectRaw(pText)
   catch tError
   end try
   try
      return cwPsbtSummary(pText, sWaNetwork) & return & \
            "Press 'Hold as the current PSBT' to sign or finalize it."
   catch tError
   end try
   try
      return waInspectXKey(pText)
   catch tError
   end try
   try
      return waInspectWif(pText)
   catch tError
   end try
   try
      return waInspectUri(pText)
   catch tError
   end try
   try
      return waInspectAddress(pText)
   catch tError
   end try
   return "That is not a raw transaction, a PSBT, an extended key, a WIF, a " & \
         "payment URI or an address that this wallet recognises on " & \
         sWaNetwork & "."
end waInspectAnything

function waValidateAnything pText
   -- A VERDICT, not a description. Inspect answers "what is this?"; this
   -- answers "is it safe to paste into a payment box, and on which chain?" -
   -- and those are different jobs, which is why the reports read differently.
   -- Inspect tells you the depth and the fingerprint. This tells you VALID or
   -- NOT VALID on a line of its own, and then why.
   --
   -- IT CHECKS EVERY NETWORK, not the one this wallet happens to be set to.
   -- The mistake that costs money here is not a mistyped address - a checksum
   -- catches that - it is a WELL-FORMED address for the wrong chain, which
   -- every validator that only asks about the current network reports as
   -- simply invalid, with nothing to say that it is a perfectly good testnet
   -- address you are about to try to pay from mainnet.
   local tText
   put cwTrim(pText) into tText
   if tText is "" then
      throw "paste an address or an extended key into the box."
   end if
   if waLooksExtended(tText) then
      return waValidateXKey(tText)
   end if
   if cwBolt11IsInvoice(tText) then
      return waInvoiceText(tText)
   end if
   return waValidateAddress(tText)
end waValidateAnything

function waInvoiceText pText
   -- A Lightning invoice, read out for a person about to pay it somewhere
   -- else: who (the payee node key, recovered from the signature), how much,
   -- for what, until when, and the on-chain fallback and route hints if it
   -- carries them. This wallet cannot pay it - that takes a Lightning node
   -- - and says so; what it can do is show what the invoice says.
   local tInv, tError, tWhy, tOut, tI, tJ, tCount, tHops, tHop, tBits, tList
   local tSats, tPart, tNet
   put "" into tWhy
   try
      put cwBolt11Decode(pText) into tInv
   catch tError
      put tError into tWhy
   end try
   if tWhy is not "" then
      put "NOT A VALID LIGHTNING INVOICE" & return & return into tOut
      put "  " & char 1 to 40 of cwTrim(pText) & "..." & return & return after tOut
      put "  why  " & tWhy & return & return after tOut
      put "A Lightning invoice is signed by the node that issued it, so a" & return after tOut
      put "single wrong character fails here rather than paying nobody." after tOut
      return tOut
   end if
   put "LIGHTNING INVOICE (BOLT11)" & return & return into tOut
   put tInv["network"] into tNet
   put "  network      " & tNet after tOut
   if tNet is not sWaNetwork then
      put "   (this wallet is on " & sWaNetwork & ")" after tOut
   end if
   put return after tOut
   if tInv["amountmsat"] is "" then
      put "  amount       any (the invoice names none)" & return after tOut
   else
      put cwDecDivMod(tInv["amountmsat"], 1000) into tPart
      put "  amount       " & tInv["amountmsat"] & " msat" after tOut
      if tPart["q"] is not "0" then
         put " = " & waAmount(tPart["q"] + 0) after tOut
         if tPart["r"] is not 0 then
            put " and " & tPart["r"] & " msat" after tOut
         end if
      end if
      put return after tOut
   end if
   put "  payee node   " & tInv["payee"] & return after tOut
   if tInv["description"] is not "" then
      put "  for          " & tInv["description"] & return after tOut
   end if
   if tInv["descriptionhash"] is not "" then
      put "  for (hash)   " & tInv["descriptionhash"] & return after tOut
   end if
   put "  payment hash " & tInv["paymenthash"] & return after tOut
   put "  issued       " & cwUnixDate(tInv["timestamp"]) & "  (" & tInv["timestamp"] & ")" & \
         return after tOut
   put "  expires      " & tInv["expiry"] & " s after that: " & \
         cwUnixDate(tInv["timestamp"] + tInv["expiry"]) & return after tOut
   put "  final cltv   " & tInv["cltv"] & " blocks" & return after tOut
   if tInv["fallback"] is not "" then
      put "  fallback     " & tInv["fallback"] & "  (an on-chain address this " & \
            "wallet CAN pay)" & return after tOut
   end if
   if tInv["metadata"] is not "" then
      put "  metadata     " & tInv["metadata"] & return after tOut
   end if
   put tInv["features"] into tBits
   put cwListCount(tBits) into tCount
   if tCount > 0 then
      put "" into tList
      repeat with tI = 1 to tCount
         if tList is not "" then
            put ", " after tList
         end if
         put tBits[tI] after tList
      end repeat
      put "  features     bits " & tList & return after tOut
   end if
   put cwListCount(tInv["routes"]) into tCount
   repeat with tI = 1 to tCount
      put tInv["routes"] into tHops
      put tHops[tI] into tHops
      put "  route hint " & tI & return after tOut
      put cwListCount(tHops) into tJ
      repeat with tJ = 1 to cwListCount(tHops)
         put tHops[tJ] into tHop
         put "    via " & tHop["pubkey"] & return after tOut
         put "        channel " & tHop["channel"] & ", fee " & tHop["feebase"] & \
               " msat + " & tHop["feeppm"] & " ppm, cltv delta " & \
               tHop["cltvdelta"] & return after tOut
      end repeat
   end repeat
   put return & "This wallet holds no Lightning channels, so it cannot pay this; " & \
         "what it can do is tell you, before you pay it elsewhere, exactly " & \
         "what it asks and who signed it." after tOut
   return tOut
end waInvoiceText

private function waLooksExtended pText
   -- Base58 and 111 characters is an extended key and nothing else this
   -- wallet takes. Asked by SHAPE rather than by trying the decoder, so a
   -- mistyped xpub is reported as a broken extended key rather than falling
   -- through to the address branch and reported as a broken address.
   local tLen
   put the number of chars of pText into tLen
   if tLen < 100 or tLen > 120 then
      return false
   end if
   return "xpub,xprv,ypub,yprv,zpub,zprv,tpub,tprv,upub,uprv,vpub,vprv" \
         contains char 1 to 4 of pText
end waLooksExtended

private function waValidateAddress pText
   local tOut, tI, tNet, tGood, tKind, tScript, tPayable, tCount, tFirst
   local tSavedDelim
   if cwSpIsAddress(pText) then
      return waValidateSpAddress(pText)
   end if
   -- THE DELIMITER IS GLOBAL MUTABLE STATE. Save, set, use, restore is this
   -- file's convention for every `item` read, and the reason is written out
   -- above cxBech32EncodeValues: a handler somewhere else that set it to tab
   -- and did not put it back turns this walk into one item, silently.
   put the itemDelimiter into tSavedDelim
   set the itemDelimiter to comma
   put "" into tGood
   put "" into tFirst
   put 0 into tCount
   repeat with tI = 1 to the number of items of kCwNetworks
      put item tI of kCwNetworks into tNet
      if cwAddressIsValid(tNet, pText) then
         -- THE SEPARATOR GOES IN FRONT, never on the end to be stripped after.
         -- A trailing separator is a value the reader has to remember to
         -- remove, and `item 1 of` a list that ends in one is a different
         -- question from `item 1 of` a list that does not.
         if tFirst is "" then
            put tNet into tFirst
            put tNet into tGood
         else
            put "," & tNet after tGood
         end if
         add 1 to tCount
      end if
   end repeat
   set the itemDelimiter to tSavedDelim
   put (cwAddressIsValid(sWaNetwork, pText)) into tPayable
   if tCount is 0 then
      put "NOT VALID ANYWHERE" & return & return into tOut
      put "  " & pText & return & return after tOut
      put "This is not an address on any chain this wallet knows." & return & \
            return after tOut
      put "  why  " & cwAddressProblem(sWaNetwork, pText) & return & return after tOut
      put "A single wrong character is enough to do this, and that is the" & return after tOut
      put "checksum working: an address you cannot pay is very much better" & return after tOut
      put "than an address that pays somebody else." after tOut
      return tOut
   end if
   if tPayable then
      put "VALID on " & sWaNetwork & return & return into tOut
   else
      put "VALID, BUT NOT ON THIS WALLET'S CHAIN" & return & return into tOut
   end if
   put "  " & pText & return & return after tOut
   put cwScriptForAddress(tFirst, pText) into tScript
   put cwScriptKind(tScript) into tKind
   put "  shape        " & waScriptKindName(tKind) & return after tOut
   put "  scriptPubKey " & tScript & return after tOut
   put "  chains       " & tGood & return after tOut
   if tCount > 1 then
      put "               (testnet, signet and regtest share one prefix, so an" & return after tOut
      put "               address good on one is good on all three)" & return after tOut
   end if
   put "  this wallet  " & sWaNetwork & return & return after tOut
   if tPayable is not true then
      put "THIS WALLET CANNOT PAY IT. The address is well formed - it is simply" & return after tOut
      put "for another chain, which is the mistake a checksum cannot catch and" & return after tOut
      put "the one that actually loses coins. Switch the wallet's network, or" & return after tOut
      put "get an address for " & sWaNetwork & "." & return after tOut
      return tOut
   end if
   if waIsMine(pText) then
      put "THIS IS ONE OF YOUR OWN ADDRESSES. Paying it moves coins from this" & return after tOut
      put "wallet back into it, less the fee." & return after tOut
   else
      put "Not an address this wallet derives, so paying it sends coins away." & return after tOut
   end if
   put return & "Dust threshold for this shape: " & \
         waAmount(cwDustThreshold(tKind)) & ". An output below that is" & return after tOut
   put "refused by the network as unspendable." after tOut
   return tOut
end waValidateAddress

private function waValidateSpAddress pText
   -- A BIP-352 address is two keys, not a script, so the report says so
   -- rather than showing a scriptPubKey it does not have.
   local tOut, tKeys, tError, tWhy
   put "" into tWhy
   try
      put cwSpDecode(sWaNetwork, pText) into tKeys
   catch tError
      put tError into tWhy
   end try
   if tWhy is not "" then
      put "NOT A SILENT PAYMENT ADDRESS THIS WALLET CAN PAY" & return & return into tOut
      put "  " & pText & return & return after tOut
      put "  why  " & tWhy & return after tOut
      return tOut
   end if
   put "VALID SILENT PAYMENT ADDRESS (BIP-352) on " & sWaNetwork & return & return into tOut
   put "  " & pText & return & return after tOut
   put "  version      " & tKeys["version"] & return after tOut
   put "  scan key     " & tKeys["scan"] & return after tOut
   put "  spend key    " & tKeys["spend"] & return after tOut
   put "  shape        taproot, derived per transaction" & return & return after tOut
   put "There is no scriptPubKey to show: every payment to this address" & return after tOut
   put "lands on a fresh taproot output derived from the coins that fund" & return after tOut
   put "it, so nothing on the chain links two payments. This wallet can" & return after tOut
   put "pay it from the Send screen (signed here, not as a PSBT); it does" & return after tOut
   put "not scan for payments TO one." after tOut
   return tOut
end waValidateSpAddress

private function waValidateXKey pText
   local tNode, tOut, tError, tChild, tAddr, tI
   put "" into tNode
   try
      put cwXKeyDecode(pText, sWaNetwork, sWaScriptType) into tNode
   catch tError
      put "NOT A VALID EXTENDED KEY" & return & return into tOut
      put "  " & char 1 to 20 of pText & "..." & return & return after tOut
      put "  why  " & line 1 of tError & return & return after tOut
      put "Base58Check carries a four-byte checksum, so one wrong character" & return after tOut
      put "fails here rather than deriving somebody else's addresses." after tOut
      return tOut
   end try
   put "VALID EXTENDED KEY" & return & return into tOut
   put "  kind         " & tNode["kind"] & return after tOut
   put "  network      " & tNode["network"] after tOut
   if tNode["ambiguous"] is true then
      put "   (shared version bytes; also " & tNode["candidates"] & ")" after tOut
   end if
   put return after tOut
   put "  script type  " & tNode["scripttype"] & return after tOut
   put "  depth        " & tNode["depth"] & return after tOut
   put "  child index  " & tNode["index"] & return after tOut
   put "  parent       " & cxHexEncode(tNode["parentfp"]) & return after tOut
   put "  fingerprint  " & cwFingerprint(cxHexEncode(tNode["pubkey"])) & return & \
         return after tOut
   -- THE STRUCTURAL CHECK NO CHECKSUM MAKES. Base58Check proves the bytes
   -- arrived intact; it says nothing about whether they are CONSISTENT. A
   -- master key is depth 0, and BIP-32 fixes its parent fingerprint and its
   -- child index at zero - so a key claiming depth 0 with either of them set
   -- is a key somebody assembled by hand, and one claiming depth 3 with a
   -- zero parent is a key whose header was edited. Neither is caught by the
   -- checksum, and both derive perfectly valid addresses nobody else will
   -- ever see.
   if tNode["depth"] is 0 then
      if cxHexEncode(tNode["parentfp"]) is not "00000000" or tNode["index"] is not 0 then
         put "INCONSISTENT: this claims to be a master key (depth 0), but a" & return after tOut
         put "master key has no parent and no child index. Something built" & return after tOut
         put "these bytes by hand." & return & return after tOut
      end if
   else
      if cxHexEncode(tNode["parentfp"]) is "00000000" then
         put "SUSPECT: depth " & tNode["depth"] & " with an empty parent" & return after tOut
         put "fingerprint. A derived key records the key it came from." & return & \
               return after tOut
      end if
   end if
   -- WHAT IT ACTUALLY PAYS. Two lines of derivation say more about whether
   -- this is the key you meant than every field above it: a person checking
   -- an xpub is nearly always checking it against addresses they have
   -- already seen somewhere else.
   put "The first two addresses on its receive chain (0/0 and 0/1), which is" & return after tOut
   put "what to check against whatever you are comparing this key with:" & return after tOut
   repeat with tI = 0 to 1
      put "" into tAddr
      try
         -- Through the wallet's OWN address builder, not a second derivation
         -- written here: a validator that agrees with a private reimplement-
         -- ation and disagrees with the wallet is worse than no validator.
         put cwAddressAt(tNode, tNode["scripttype"], tNode["network"], 0, tI) \
               into tChild
         put tChild["address"] into tAddr
      catch tError
         put "(not derivable: " & line 1 of tError & ")" into tAddr
      end try
      put "  0/" & tI & "  " & tAddr after tOut
      if waIsMine(tAddr) then
         put "   (THIS WALLET'S)" after tOut
      end if
      put return after tOut
   end repeat
   put return after tOut
   if tNode["kind"] is "private" then
      put "THIS IS A PRIVATE KEY. It is now in this window's memory. Anything" & return after tOut
      put "that reads it can spend every coin under it, forever." after tOut
   else
      put "This is a public key. It cannot spend anything, and it reveals every" & return after tOut
      put "address below it to anyone who holds it." after tOut
   end if
   return tOut
end waValidateXKey

function waDecodeScript pHex
   -- A BARE SCRIPT, which is the one thing the Inspect button could never be
   -- given. Everything it reads is a CONTAINER - a transaction, a PSBT, a
   -- key, an address - and each of those carries its own frame, so a script
   -- on its own (out of a scriptPubKey column, out of somebody else's
   -- debugger, out of a witness this wallet printed) had nowhere to go.
   --
   -- The framing is checked BEFORE anything is rendered, because a chunk
   -- expression past the end of a string answers rather than refusing: a
   -- push claiming forty bytes with ten left prints as a ten-byte push and
   -- reads exactly like a correct decode of a different script.
   local tHex, tWhy, tKind, tOut, tAddr, tError, tLen
   put cwLower(cwTrim(pHex)) into tHex
   if tHex is "" then
      throw "paste a script, as hex, into the box."
   end if
   put cwScriptCheck(tHex) into tWhy
   if tWhy is not "" then
      throw "that is not a well-framed script: " & tWhy
   end if
   put cwIntDiv(the number of chars of tHex, 2) into tLen
   put cwScriptKind(tHex) into tKind
   put "SCRIPT" & return & return into tOut
   put "  size      " & tLen & " byte(s)" & return after tOut
   put "  shape     " & waScriptKindName(tKind) & return after tOut
   put "  opcodes   " & cwScriptAsm(tHex) & return & return after tOut
   if tKind is not "unknown" and tKind is not "nulldata" then
      put "unrecognised" into tAddr
      try
         put cwAddressForScript(sWaNetwork, tHex) into tAddr
      catch tError
         put "no address (" & line 1 of tError & ")" into tAddr
      end try
      put "  as an output on " & sWaNetwork & " this pays" & return after tOut
      put "    " & tAddr & return after tOut
      if waIsMine(tAddr) then
         put "    which is an address THIS WALLET holds." & return after tOut
      end if
      put return after tOut
   end if
   -- A WITNESS SCRIPT AND A REDEEM SCRIPT ARE NOT scriptPubKeys, so their
   -- COMMITMENTS are what a reader needs: the p2wsh and p2sh addresses that
   -- would pay this script are how you check that a multisig quorum somebody
   -- sent you is the one you are already watching.
   put "If this is a witness script or a redeem script, then paying it means" & return after tOut
   put "paying one of these, and matching one of them against an address you" & return after tOut
   put "already trust is how you check that it is the script you think:" & return after tOut
   try
      put "  as P2WSH  " & cwAddressForScript(sWaNetwork, \
            cwScriptP2wsh(tHex)) & return after tOut
   catch tError
      put "  as P2WSH  (not derivable: " & line 1 of tError & ")" & return after tOut
   end try
   try
      put "  as P2SH   " & cwAddressForScript(sWaNetwork, \
            cwScriptP2sh(cxHexEncode(cxHash160(cxHexDecode(tHex))))) & return after tOut
   catch tError
      put "  as P2SH   (not derivable: " & line 1 of tError & ")" & return after tOut
   end try
   put return & "Nothing here was executed. This reads the bytes; it does not" & return after tOut
   put "run them, and a script that decodes cleanly can still be unspendable." after tOut
   return tOut
end waDecodeScript

private function waScriptKindName pKind
   if pKind is "p2pkh" then
      return "p2pkh - pay to a legacy address (1..., m/n...)"
   else if pKind is "p2sh" then
      return "p2sh - pay to a script hash (3..., 2...)"
   else if pKind is "p2wpkh" then
      return "p2wpkh - pay to a SegWit v0 key (bc1q..., tb1q...)"
   else if pKind is "p2wsh" then
      return "p2wsh - pay to a SegWit v0 script (bc1q..., 32 bytes)"
   else if pKind is "p2tr" then
      return "p2tr - pay to Taproot (bc1p..., tb1p...)"
   else if pKind is "nulldata" then
      return "OP_RETURN - provably unspendable, carries data only"
   end if
   return "not one of the five standard output shapes"
end waScriptKindName

function waInspectRaw pHex
   local tTx, tOut, tI, tCount, tRec, tAddr, tError, tIns
   put cwTxDecode(cwTrim(pHex)) into tTx
   put "RAW TRANSACTION" & return & return into tOut
   put "  txid      " & tTx["txid"] & return after tOut
   put "  wtxid     " & tTx["wtxid"] & return after tOut
   put "  version   " & tTx["version"] & "   locktime " & tTx["locktime"] & return after tOut
   put "  size      " & tTx["size"] & " bytes, " & tTx["vsize"] & " vB, weight " & \
         tTx["weight"] & return after tOut
   put "  segwit    " & tTx["segwit"] & "   replaceable " & tTx["rbf"] & return & \
         return after tOut
   put cwListCount(tTx["inputs"]) into tCount
   put "  " & tCount & " input(s):" & return after tOut
   repeat with tI = 1 to tCount
      put tTx["inputs"] into tRec
      put tRec[tI] into tRec
      put "    " & tI & ". " & tRec["txid"] & ":" & tRec["vout"] & \
            "  seq " & tRec["sequence"] & return after tOut
      if tRec["scriptsig"] is not "" then
         put "       scriptSig " & cwScriptAsm(tRec["scriptsig"]) & return after tOut
      end if
      put "       witness " & cwListCount(tRec["witness"]) & " item(s)" & return after tOut
      put waInscriptionIn(tRec["witness"]) into tIns
      if tIns is not "" then
         put "       inscription " & tIns & return after tOut
      end if
   end repeat
   put cwListCount(tTx["outputs"]) into tCount
   put return & "  " & tCount & " output(s), " & waAmount(tTx["outputtotal"]) & \
         " in total:" & return after tOut
   repeat with tI = 1 to tCount
      put tTx["outputs"] into tRec
      put tRec[tI] into tRec
      put "unrecognised" into tAddr
      if tRec["kind"] is "nulldata" then
         put "OP_RETURN " & waDataPreview(cwOpReturnData(tRec["script"])) into tAddr
         if char 1 to 4 of tRec["script"] is "6a5d" then
            put "RUNESTONE" & waRunestoneText(tRec["script"], tCount) into tAddr
         end if
      else
         try
            put cwAddressForScript(sWaNetwork, tRec["script"]) into tAddr
         catch tError
            put "unrecognised (" & tRec["kind"] & ")" into tAddr
         end try
      end if
      put "    " & tI & ". " & waAmount(tRec["value"]) & "  -> " & tAddr after tOut
      if waIsMine(tAddr) then
         put "   (YOURS)" after tOut
      end if
      put return after tOut
   end repeat
   return tOut
end waInspectRaw

function waRunestoneText pScriptHex, pOutputCount
   -- A runestone (Runes protocol) read out of an OP_RETURN OP_13 output, as
   -- the indented lines Inspect prints under it: the etching with its name
   -- (spacers shown as dots, since this source cannot carry the bullet),
   -- symbol, divisibility, premine and mint terms; the mint; the pointer;
   -- every edict; and the CENOTAPH verdict with its flaws, because a
   -- malformed runestone burns what it touches and a reader must say so.
   -- Read only: the wallet neither etches nor tracks balances (docs/wallet.md).
   local tOut, tRs, tE, tTerms, tI, tCount, tEd, tLine, tSym, tFlaws, tName
   put cwRunestoneDecode(pScriptHex, pOutputCount) into tRs
   if tRs["runestone"] is not true then
      return ""
   end if
   put "" into tOut
   put tRs["etching"] into tE
   if tE is not "" then
      put "etching" into tLine
      if tE["name"] is not "" then
         put tE["name"] into tName
         if tE["spacers"] is not "" then
            put cwRuneSpaced(tE["name"], tE["spacers"]) into tName
         end if
         put " " & tName after tLine
      else
         put " (reserved name, allocated by the protocol)" after tLine
      end if
      if tE["symbol"] is not "" then
         put tE["symbol"] into tSym
         if tSym >= 32 and tSym <= 126 then
            put " symbol " & numToChar(tSym) after tLine
         else
            put " symbol U+" & cwUpper(cxHexEncode(cwBeBytes(tSym, 3))) after tLine
         end if
      end if
      if tE["divisibility"] is not "" then
         put " divisibility " & tE["divisibility"] after tLine
      end if
      if tE["premine"] is not "" then
         put " premine " & cwRuneAmountText(tE["premine"], tE["divisibility"]) after tLine
      end if
      if tE["turbo"] is true then
         put " turbo" after tLine
      end if
      put return & "         " & tLine after tOut
      put tE["terms"] into tTerms
      if tTerms is not "" then
         put "open mint:" into tLine
         if tTerms["amount"] is not "" then
            put " " & cwRuneAmountText(tTerms["amount"], tE["divisibility"]) & \
                  " per mint" after tLine
         end if
         if tTerms["cap"] is not "" then
            put ", cap " & tTerms["cap"] after tLine
         end if
         if tTerms["heightstart"] is not "" or tTerms["heightend"] is not "" then
            put ", heights " & tTerms["heightstart"] & ".." & tTerms["heightend"] after tLine
         end if
         if tTerms["offsetstart"] is not "" or tTerms["offsetend"] is not "" then
            put ", offsets " & tTerms["offsetstart"] & ".." & tTerms["offsetend"] after tLine
         end if
         put return & "           " & tLine after tOut
      end if
   end if
   if tRs["mint"] is not "" then
      put return & "         mint " & tRs["mint"] after tOut
   end if
   if tRs["pointer"] is not "" then
      put return & "         pointer: unallocated runes go to output " & \
            (tRs["pointer"] + 1) after tOut
   end if
   put cwListCount(tRs["edicts"]) into tCount
   repeat with tI = 1 to tCount
      put tRs["edicts"] into tEd
      put tEd[tI] into tEd
      put return & "         edict " & tEd["block"] & ":" & tEd["tx"] & \
            "  amount " & tEd["amount"] & "  to output " & (tEd["output"] + 1) after tOut
      if tEd["output"] is pOutputCount then
         put " (split across all outputs)" after tOut
      end if
   end repeat
   if tRs["cenotaph"] is true then
      put "" into tFlaws
      put cwListCount(tRs["flaws"]) into tCount
      repeat with tI = 1 to tCount
         if tFlaws is not "" then
            put ", " after tFlaws
         end if
         put tRs["flaws"] into tEd
         put tEd[tI] after tFlaws
      end repeat
      put return & "         CENOTAPH (" & tFlaws & "): the runes this " & \
            "transaction moves are burned" after tOut
   end if
   return tOut
end waRunestoneText

function waInspectXKey pText
   -- THE INSPECTOR TAKES NO PREFERENCE ON PURPOSE. Everywhere else in this
   -- wallet the screen's own network and script type disambiguate a shared
   -- version; here the whole job is to say what the KEY says, so it reports
   -- the first row and then names every other row the version also allows.
   -- A reader of this screen is asking what the bytes mean, not what this
   -- wallet has decided they mean.
   local tNode, tOut
   put cwXKeyDecode(cwTrim(pText), "", "") into tNode
   put "EXTENDED KEY" & return & return into tOut
   put "  kind        " & tNode["kind"] & return after tOut
   put "  network     " & tNode["network"] & return after tOut
   put "  script type " & tNode["scripttype"] & " (from its version bytes)" & \
         return after tOut
   if tNode["ambiguous"] is true then
      put "  AMBIGUOUS   those version bytes are shared. This key is one of: " & \
            tNode["candidates"] & return & \
            "              BIP-86 kept xpub/tpub for taproot rather than " & \
            "taking its own pair," & return & \
            "              and testnet, signet and regtest share one set of " & \
            "version bytes." & return after tOut
   end if
   put "  depth       " & tNode["depth"] & return after tOut
   put "  child index " & tNode["index"] & return after tOut
   put "  fingerprint " & cwFingerprint(cxHexEncode(tNode["pubkey"])) & return after tOut
   put "  public key  " & cxHexEncode(tNode["pubkey"]) & return & return after tOut
   if tNode["kind"] is "private" then
      put "  This is a PRIVATE key. Anything holding it can spend every coin " & \
            "under it." after tOut
   else
      put "  This is a public key. It cannot spend, and it reveals every " & \
            "address below it." after tOut
   end if
   return tOut
end waInspectXKey

function waInspectWif pText
   local tInfo, tOut
   put cwWifInfo(cwTrim(pText), sWaNetwork) into tInfo
   put "PRIVATE KEY (WIF)" & return & return into tOut
   put "  network     " & tInfo["network"] & return after tOut
   put "  compressed  " & tInfo["compressed"] & return after tOut
   put "  P2PKH       " & tInfo["p2pkh"] & return after tOut
   if tInfo["p2wpkh"] is not "" then
      put "  P2SH-P2WPKH " & tInfo["p2sh-p2wpkh"] & return after tOut
      put "  P2WPKH      " & tInfo["p2wpkh"] & return after tOut
   end if
   put return & "  Whoever has this string owns those coins. It is now in this " & \
         "window's memory and in your clipboard history." after tOut
   return tOut
end waInspectWif

function waInspectUri pText
   local tRec, tOut, tI, tCount, tReq
   put cwUriParse(cwTrim(pText)) into tRec
   if cwAddressIsValid(sWaNetwork, tRec["address"]) is not true then
      -- a unified URI may carry only the invoice ("bitcoin:?lightning=...")
      if tRec["address"] is "" and cwBolt11IsInvoice(tRec["lightning"]) then
         return "PAYMENT URI (BIP-21), Lightning only" & return & return & \
               waInvoiceText(tRec["lightning"])
      end if
      throw "not a URI for this network"
   end if
   put "PAYMENT URI (BIP-21)" & return & return into tOut
   put "  address " & tRec["address"] & return after tOut
   if tRec["amountsat"] > 0 then
      put "  amount  " & waAmount(tRec["amountsat"]) & return after tOut
   end if
   if tRec["label"] is not "" then
      put "  label   " & tRec["label"] & return after tOut
   end if
   if tRec["message"] is not "" then
      put "  message " & tRec["message"] & return after tOut
   end if
   put cwListCount(tRec["required"]) into tCount
   if tCount > 0 then
      put tRec["required"] into tReq
      put return & "  REQUIRED parameters this wallet does not understand:" & return after tOut
      repeat with tI = 1 to tCount
         put "    " & tReq[tI] & return after tOut
      end repeat
      put "  BIP-21 says a wallet must refuse rather than pay and ignore them." after tOut
   end if
   if tRec["lightning"] is not "" then
      -- the unified shape: the same payment offered both ways, and the
      -- invoice read out beneath the on-chain half
      put return & "  lightning: this URI also carries an invoice for the same " & \
            "payment" & return & return after tOut
      put waInvoiceText(tRec["lightning"]) after tOut
   end if
   return tOut
end waInspectUri

function waInspectAddress pText
   local tAddr, tScript, tOut
   put cwTrim(pText) into tAddr
   put cwScriptForAddress(sWaNetwork, tAddr) into tScript
   put "ADDRESS" & return & return into tOut
   put "  address      " & tAddr & return after tOut
   put "  type         " & cwScriptKind(tScript) & return after tOut
   put "  scriptPubKey " & tScript & return after tOut
   put "  disassembled " & cwScriptAsm(tScript) & return after tOut
   put "  scripthash   " & cwElectrumScripthash(tScript) & \
         "  (what an Electrum server is asked about)" & return & return after tOut
   if waIsMine(tAddr) then
      put "  THIS IS ONE OF YOURS." after tOut
   else
      put "  This is not an address this wallet derives." after tOut
   end if
   return tOut
end waInspectAddress

-- ==============================================================================
-- 8. NETWORK
--
-- One queue, one request in flight, three transports and an honest offline
-- mode. Nothing here blocks the interpreter: every transport is a state
-- machine driven by messages, and every request carries a deadline because a
-- peer that accepts a connection and then says nothing is the normal failure,
-- not the exotic one.
-- ==============================================================================

command waPaintNetwork
   local tKind
   set the defaultStack to the short name of this stack
   -- EVERY BACKEND IS IN THIS LIST. waPaintChoice only touches the names it
   -- is given, so a backend missing from it can never be shown as the
   -- selected one - and worse, switching TO it darkens the previously lit
   -- button without lighting anything, so the screen reports no backend at
   -- all while one is running. electrum-clear was added to waBackendChoice
   -- and to the screen and not to this line.
   waPaintChoice "nw_b", \
         "Offline,EsploraTor,ElectrumTor,EsploraClear,ElectrumClear", \
         waBackendChoice()
   if field "nw_host" is empty then
      put sWaHost into field "nw_host"
   end if
   if field "nw_port" is empty then
      put sWaPort into field "nw_port"
   end if
   if field "nw_socks" is empty then
      put sWaSocksPort into field "nw_socks"
   end if
   put "wait" into tKind
   if sWaNetState is "ok" then
      put "ok" into tKind
   else if sWaNetState is "failed" then
      put "bad" into tKind
   else if sWaNetState is "partial" then
      -- NOT "ok". A sync that lost requests holds a balance that is missing
      -- whatever those addresses held, which is a wrong number rather than a
      -- smaller one, and a green pill over it is the wallet asserting
      -- something it does not know.
      put "warn" into tKind
   end if
   uiPill "nw_state", sWaNetState, "196,246,340,268", tKind
   put sWaNetWhy into field "nw_why"
   put waPrivacyText() into field "nw_privacy"
end waPaintNetwork

private function waBackendChoice
   if sWaBackend is "esplora-tor" then
      return "EsploraTor"
   end if
   if sWaBackend is "electrum-tor" then
      return "ElectrumTor"
   end if
   if sWaBackend is "esplora-clear" then
      return "EsploraClear"
   end if
   if sWaBackend is "electrum-clear" then
      return "ElectrumClear"
   end if
   return "Offline"
end waBackendChoice

private function waPrivacyText
   local tOut
   put "OFFLINE tells nobody anything. The wallet derives, builds, signs and " & \
         "exports; you carry the bytes. Everything on the Send screen works " & \
         "except Broadcast." & return & return into tOut
   put "ESPLORA OVER TOR asks a .onion mirror about your addresses over the " & \
         "Tor circuit. The server learns which addresses are asked about " & \
         "together - which is a real leak - but not by whom, and nobody " & \
         "between you and it learns anything. Plain HTTP inside the circuit " & \
         "is correct here: the circuit is the encryption." & return & return after tOut
   put "ELECTRUM OVER TOR is the same privacy with a different protocol. The " & \
         "server is asked about SCRIPT HASHES rather than addresses, which " & \
         "is marginally better, and it can push updates. Both Tor " & \
         "transports run a whole sync down one stream (Esplora over " & \
         "HTTP/1.1 keep-alive since 2026-09-03; a reply that carries no " & \
         "framing, or says close, costs one more dial), so a sync is one " & \
         "rendezvous rather than one per request." & return & return after tOut
   put "ESPLORA OVER CLEARNET uses the engine's own URL library. It is the " & \
         "simplest and the least private: the server learns your addresses " & \
         "AND your IP address, and on http:// so does everyone between you " & \
         "and it. This suite has never measured what this engine does about " & \
         "TLS certificates (OXT-ENGINE-NOTES 6.8), so https:// here is " & \
         "offered without a claim about it rather than with one." & return & return after tOut
   put "ELECTRUM OVER CLEARNET is a PLAIN TCP socket to a public Electrum " & \
         "server - no TLS anywhere in the path and no daemon to be running, " & \
         "which is why it works where the other three may not. The server " & \
         "learns your IP and which script hashes you asked about (not your " & \
         "addresses); anyone between you and it sees that you talked to an " & \
         "Electrum server and how much, but not what about. The chain is " & \
         "chosen by the PORT: 50001 mainnet, 60001 testnet." & return & return after tOut
   if sWaHaveOnion is not "true" then
      put "The OnionXT layer did not answer, so the two Tor options cannot " & \
            "work in this stack. Electrum over clearnet needs neither Tor " & \
            "nor TLS and is the fallback when nothing else connects." after tOut
   else
      put "The Tor options need a tor daemon on 127.0.0.1:" & sWaSocksPort & \
            ". Nothing else does." after tOut
   end if
   return tOut
end waPrivacyText

command waNetworkClick pRole
   if pRole is "bOffline" then
      waSetBackend "offline"
   else if pRole is "bEsploraTor" then
      waSetBackend "esplora-tor"
   else if pRole is "bElectrumTor" then
      waSetBackend "electrum-tor"
   else if pRole is "bEsploraClear" then
      waSetBackend "esplora-clear"
   else if pRole is "bElectrumClear" then
      waSetBackend "electrum-clear"
   else if pRole is "test" then
      -- REFUSED HERE, not three ticks later. Queuing a request while offline
      -- let the pump dial nothing, fail through waNetFail, and report "FAILED:
      -- this wallet is offline" - a failure count, a red pill and a torn-down
      -- connection, for a wallet that had simply not been given a backend
      -- yet. waSync already refuses this at the door; Test now says the same
      -- thing the same way.
      if sWaBackend is "offline" then
         throw "this wallet is offline. Choose a backend above; there is " & \
               "nothing to test yet."
      end if
      waApplyNetworkFields
      waEnsurePolling
      waNetQueue "tip", ""
      waLog "test: asking " & sWaHost & ":" & sWaPort & " for the tip over " & \
            sWaBackend
      uiStatus "Asking " & sWaHost & " for the chain tip.", ""
   else if pRole is "syncNow" then
      waApplyNetworkFields
      waSync
   else if pRole is "stop" then
      waNetAbort
      uiStatus "Stopped. Nothing is in flight.", "warn"
   end if
   waRefreshAll
end waNetworkClick

command waDropSeed
   -- A WALLET THAT CANNOT SIGN MUST NOT BE HOLDING A SEED. Choosing
   -- watch-only, an imported key or multisig used to leave sWaMnemonic and
   -- sWaPassphrase at whatever the previously open seed wallet put there -
   -- and waSerializeWallet writes both unconditionally, so the file a person
   -- made for a wallet the status line had just described as unable to sign
   -- carried their real seed phrase, ready to hand to the cosigner whose
   -- xpub it was. The status line is now true about the state.
   -- AND THE PRIVATE HALF GOES WITH IT, which the sentence above claimed and
   -- the code did not do. Clearing the mnemonic left sWaAccountXprv and the
   -- `seckey` inside every one of the derived address records exactly where
   -- the previous seed wallet put them - and waAccountNode PREFERS the
   -- private half while waSeckeyFor reads the record's key, so a wallet the
   -- status line had just called watch-only still held, and would still use,
   -- full spending keys for somebody else's addresses. The two waOpenWallet
   -- branches that reach here both call waDeriveAddresses immediately
   -- afterwards, so dropping the derived list costs nothing and is the only
   -- way to be rid of the keys inside it.
   set the defaultStack to the short name of this stack
   put empty into sWaMnemonic
   put empty into sWaPassphrase
   put empty into sWaAccountXprv
   put waEmptyList() into sWaAddresses
   if there is a field "wl_mnemonic" then
      put empty into field "wl_mnemonic"
   end if
   if there is a field "wl_pass" then
      put empty into field "wl_pass"
   end if
end waDropSeed

command waApplyNetworkFields
   -- READ THE THREE FIELDS BACK. They are editable, and until this handler
   -- existed nothing anywhere put their contents into sWaHost, sWaPort or
   -- sWaSocksPort - so the SOCKS caption inviting you to type 9150 for Tor
   -- Browser was an invitation to change a number the dial would ignore,
   -- and the failure it produced ("could not dial ...") named neither the
   -- port nor the reason. Refusals are loud rather than silent for the same
   -- reason: a port the wallet quietly declined to use is the bug again.
   local tHost, tPort, tSocks
   set the defaultStack to the short name of this stack
   put cwTrim(field "nw_host") into tHost
   put cwTrim(field "nw_port") into tPort
   put cwTrim(field "nw_socks") into tSocks
   if tHost is not empty then
      put tHost into sWaHost
   end if
   if tPort is not empty then
      if tPort is not an integer or tPort < 1 or tPort > 65535 then
         throw "the port must be a whole number from 1 to 65535; " & \
               quote & tPort & quote & " is not."
      end if
      put tPort + 0 into sWaPort
   end if
   if tSocks is not empty then
      if tSocks is not an integer or tSocks < 1 or tSocks > 65535 then
         throw "the SOCKS port must be a whole number from 1 to 65535; " & \
               quote & tSocks & quote & " is not."
      end if
      put tSocks + 0 into sWaSocksPort
   end if
end waApplyNetworkFields

command waSetBackend pBackend
   waNetAbort
   put pBackend into sWaBackend
   -- another server's tip and fees are another server's answers, and
   -- another server may take a batch this one refused
   put empty into sWaTipAt
   put empty into sWaFeesAt
   put empty into sWaBatch
   put empty into sWaBatchCap
   put "idle" into sWaNetState
   put empty into sWaNetWhy
   if pBackend is "esplora-tor" then
      put kWaEsploraOnion into sWaHost
      put 80 into sWaPort
   else if pBackend is "electrum-tor" then
      put kWaElectrumOnion into sWaHost
      put kWaElectrumPort into sWaPort
      -- the same port-is-the-chain table as the clearnet server, in the one
      -- place that holds it (added 2026-09-02; before that testnet dialled
      -- the mainnet port, which answers well-formedly and emptily)
      waRetunePort
   else if pBackend is "esplora-clear" then
      put kWaEsploraClear into sWaHost
      put 443 into sWaPort
   else if pBackend is "electrum-clear" then
      put kWaElectrumClear into sWaHost
      -- THE PORT IS THE CHAIN SELECTOR here, where Esplora used a path root.
      -- One Electrum connection serves exactly one chain and never says which,
      -- so getting this wrong is the silent-empty-wallet failure again. The
      -- table lives in waRetunePort, in ONE place, because the network can
      -- move without this handler running.
      waRetunePort
   end if
   set the defaultStack to the short name of this stack
   put sWaHost into field "nw_host"
   put sWaPort into field "nw_port"
   waRefreshNetState
   waLog "backend: " & pBackend & " (" & sWaHost & ":" & sWaPort & ")"
end waSetBackend

function waIsElectrum pBackend
   -- WHICH PROTOCOL a backend speaks, as opposed to which transport carries
   -- it. Two backends speak Electrum's JSON-RPC (over Tor, and over a plain
   -- socket) and two speak Esplora's HTTP, and every parse below the
   -- transport layer cares about the first question and not the second.
   --
   -- waNetApply asked `sWaBackend is "electrum-tor"`, which was the same
   -- question and the wrong test, so the clearnet Electrum transport's
   -- replies fell into the ESPLORA parser: a perfectly good
   -- {"result":{"height":5127803,...}} was measured against "is this a bare
   -- integer", and the wallet reported that a working server had answered
   -- with something that is not a height. The connection was fine and the
   -- error pointed at the server.
   --
   -- Same shape as waNeedsTor one commit earlier: a condition written against
   -- the backends that existed when it was written. Both are predicates now,
   -- so a new backend answers both questions by construction.
   return pBackend is "electrum-tor" or pBackend is "electrum-clear"
end waIsElectrum

function waNeedsTor pBackend
   -- WHICH TRANSPORTS NEED TOR, named positively. This was written the other
   -- way round - "not offline and not esplora-clear" - and the clearnet
   -- Electrum transport was added without anybody remembering to add it to
   -- that list, so a transport whose entire purpose is needing neither TLS
   -- nor Tor reported that OnionXT had not answered.
   --
   -- A deny-list of the things a rule does NOT apply to is wrong by default
   -- for anything new; an allow-list of the things it DOES apply to is right
   -- by default. The next transport added here needs no edit to be correct.
   return pBackend is "esplora-tor" or pBackend is "electrum-tor"
end waNeedsTor

private function waCheckedHeight pText, pWhere
   -- A CHAIN TIP IS A NON-NEGATIVE INTEGER, whichever protocol brought it.
   -- The Esplora branch refused anything else and the Electrum branch wrote
   -- `result/height` straight into sWaTipHeight, so the two transports
   -- disagreed about the same quantity - the shape that already produced the
   -- unchecked fee rate, one screen over.
   -- NESTED for the same reason waSetSuggestedRate is: `or` evaluates both
   -- sides, and `<!DOCTYPE html>` is exactly the value this guard exists to
   -- catch.
   if pText is not an integer then
      throw "the " & pWhere & " backend answered the chain-tip request with " & \
            "something that is not a height: " & char 1 to 80 of pText
   end if
   if pText < 0 then
      -- SAME PHRASE AS THE BRANCH ABOVE, deliberately: a caller (and the
      -- gate) matches one string to mean "that was not a chain tip", and two
      -- wordings for one refusal is how a check ends up asserting a message
      -- instead of a behaviour.
      throw "the " & pWhere & " backend answered the chain-tip request with " & \
            "something that is not a height, being negative: " & \
            char 1 to 80 of pText
   end if
   return cwTrim(pText)
end waCheckedHeight

private function waCheckedTxid pText, pWhere
   -- A TXID IS 32 BYTES OF HEX AND NOTHING ELSE. The Esplora branch says, in
   -- its own comment, that reporting a success the backend did not give is
   -- "the failure this whole block exists to stop" - and the Electrum branch
   -- beside it reported a green "Broadcast." for whatever scalar the server
   -- put in `result`, including an error string. A wallet that says a
   -- transaction was sent when it was not is worse than one that says
   -- nothing, because the person stops watching.
   if the number of chars of pText is not 64 or not cwHexIsClean(pText) then
      throw "the " & pWhere & " backend did not return a txid, so this " & \
            "transaction was NOT accepted. It said: " & char 1 to 200 of pText
   end if
   return pText
end waCheckedTxid

private command waCheckList pNode, pWhat
   -- AN ANSWER THAT IS NOT A LIST IS NOT AN EMPTY LIST. waMergeUtxos and
   -- waMergeHistory drop every record for the address and then re-fill from
   -- cwJsonCount(pNode), which answers 0 for a null, a string, a number or a
   -- boolean - so any well-formed reply whose `result` is not an array reads
   -- as "this address has never been used" and DELETES what the address
   -- actually holds. Refuse it instead: a failure is visible and an empty
   -- address is not.
   if cwJsonType(pNode) is not "array" then
      throw "the backend answered the " & pWhat & " request with a " & \
            cwJsonType(pNode) & " rather than a list, so it has not been " & \
            "believed. Nothing about this address has been changed."
   end if
end waCheckList

private function waRateTo8Decimals pText
   -- The first eight decimals of a decimal string, by CHARACTERS and never by
   -- arithmetic, because arithmetic is where the extra digits came from.
   -- Truncation rather than rounding: the caller ceil-divides by a thousand
   -- afterwards, so the most this can lose is a thousandth of a sat/vB.
   local tPos, tWhole, tFrac
   put offset(".", pText) into tPos
   if tPos is 0 then
      return pText
   end if
   put char 1 to (tPos - 1) of pText into tWhole
   put char (tPos + 1) to -1 of pText into tFrac
   if the number of chars of tFrac <= 8 then
      return pText
   end if
   return tWhole & "." & char 1 to 8 of tFrac
end waRateTo8Decimals

private command waSetSuggestedRate pTarget, pRate
   -- One place where a backend-supplied fee rate becomes wallet state, so
   -- there is one rule instead of two. A rate that is not a positive number
   -- at or below kWaMaxSuggestedRate is not written and is said out loud,
   -- because a backend answering nonsense about fees is worth knowing.
   -- NESTED, NOT `or`-ed. LiveCodeScript evaluates BOTH operands of `or`, so
   -- `pRate is not a number or pRate <= 0` still performs the comparison on a
   -- value that is not a number - which the family's interpreter refuses
   -- outright and the engine answers by comparing as TEXT, neither of them
   -- what this guard means. Ask the type question first and only then the
   -- range one. (waBuildSpend carries the older spelling on a value that is
   -- always a field's contents; this one is handed whatever a backend sent.)
   if pRate is not a number then
      waLog "ignored a fee rate of " & pRate & " sat/vB for " & pTarget & \
            " block(s): that is not a number"
      exit waSetSuggestedRate
   end if
   if pRate <= 0 or pRate > kWaMaxSuggestedRate then
      waLog "ignored a fee rate of " & pRate & " sat/vB for " & pTarget & \
            " block(s): not a believable estimate"
      exit waSetSuggestedRate
   end if
   put pRate into sWaFeeRates[pTarget]
end waSetSuggestedRate

private command waRetunePort
   -- THE PORT THAT SELECTS THE CHAIN, recomputed from the network in the one
   -- place that knows the table.
   --
   -- waSetBackend used to hold this inline, and it was the only writer that
   -- knew the network - so changing the NETWORK left it behind. Pick clearnet
   -- Electrum on mainnet, switch the wallet to testnet, and waBackendChainWhy
   -- says fine (the built-in host does carry testnet) while the socket still
   -- dials 50001. A mainnet Electrum server answers a testnet script hash with
   -- an EMPTY LIST - a well-formed "this address has never been used" - so the
   -- wallet reports itself synced, green and empty over funded addresses, with
   -- nothing anywhere to contradict it. That is the failure this member has
   -- already learned once from a real machine, by way of the Esplora API root,
   -- and it came back through the port.
   --
   -- A HOST SOMEBODY TYPED IS LEFT ALONE. The table is the built-in server's,
   -- and this wallet has no table for anybody else's: retuning a custom host's
   -- port would be inventing one. waBackendChainWhy already says it cannot
   -- speak for a host it does not know.
   if sWaBackend is "electrum-clear" and sWaHost is kWaElectrumClear then
      if sWaNetwork is "mainnet" then
         put kWaElectrumClearPort into sWaPort
      else
         put kWaElectrumClearTestPort into sWaPort
      end if
   else if sWaBackend is "electrum-tor" and sWaHost is kWaElectrumOnion then
      -- THE ONION HAS THE SAME TABLE, and until 2026-09-02 this handler did
      -- not know it: only the clearnet server was retuned, so the Tor
      -- transport dialled port 110 for every chain. The 2026-09-02 log never
      -- got far enough to show that (the address it dialled was dead, see
      -- kWaElectrumOnion), but the guard below had been refusing testnet on
      -- the onion for exactly this reason, and lifting the guard without
      -- adding the branch would have swapped a refusal for an empty wallet.
      if sWaNetwork is "mainnet" then
         put kWaElectrumPort into sWaPort
      else
         put kWaElectrumTorTestPort into sWaPort
      end if
   else
      exit waRetunePort
   end if
   set the defaultStack to the short name of this stack
   if there is a field "nw_port" then
      put sWaPort into field "nw_port"
   end if
end waRetunePort

command waRefreshNetState
   -- The two reasons a transport cannot run that are knowable WITHOUT talking
   -- to anything: OnionXT is absent, or the backend does not carry the chain
   -- this wallet is on. Both are recomputed from scratch whenever EITHER half
   -- moves - the backend or the network - so a condition the person has just
   -- fixed clears itself instead of leaving a stale red line, and one they
   -- have just created appears without waiting for a sync to fail.
   --
   -- A live failure from waNetFail is deliberately not preserved across this:
   -- both callers reset the state first, and both have already dropped the
   -- chain state that failure was about.
   local tWhy
   put empty into tWhy
   if waNeedsTor(sWaBackend) and sWaHaveOnion is not "true" then
      -- FIRST, because when both are true this is the one to fix first.
      put "OnionXT did not answer, so this transport cannot run here." into tWhy
   end if
   if tWhy is empty then
      put waBackendChainWhy() into tWhy
   end if
   if tWhy is empty then
      put "idle" into sWaNetState
      put empty into sWaNetWhy
   else
      put "failed" into sWaNetState
      put tWhy into sWaNetWhy
   end if
end waRefreshNetState

command waEnsurePolling
   -- A QUEUE MEANS NOTHING UNLESS THE PUMP IS RUNNING, and until now nothing
   -- that queued a request asked whether it was. waTick exits for good the
   -- moment sWaPolling is not "true" - closeStack sets it, and a re-pasted
   -- script reinitialises every script local so the pending tick fires into
   -- an empty flag - and from then on every request sits in the queue with
   -- nothing behind it: no dial, no open, no FAILED line, a Tor daemon that
   -- never hears a SOCKS handshake, and Refresh reporting a sync "already
   -- running" that will never move. That is indistinguishable, from the
   -- outside, from a broken transport, and it was reported as one on
   -- 2026-09-02. Every path that queues a request now arms the pump first
   -- and SAYS so in the log when it had to, so the next log names the cause.
   if sWaPolling is "true" then
      exit waEnsurePolling
   end if
   put "true" into sWaPolling
   send "waTick" to me in kWaTick milliseconds
   waLog "the request pump was not running; re-armed it"
end waEnsurePolling

command waSync
   -- Ask the backend about everything the wallet needs, in one batch. Each
   -- address becomes its own request because that is what both protocols
   -- offer; the queue serialises them so one slow answer does not open
   -- twenty circuits.
   local tI, tCount, tRec, tWhy
   if sWaBackend is "offline" then
      throw "this wallet is offline. Choose a backend on the Network screen."
   end if
   -- Refuse a backend that does not carry this chain BEFORE any request is
   -- built. Syncing anyway is what produced a green, empty, funded wallet.
   put waBackendChainWhy() into tWhy
   if tWhy is not empty then
      throw tWhy
   end if
   -- ONE SYNC AT A TIME. This appended a whole second batch behind whatever
   -- was still queued, so a second press doubled the round trips - and on a
   -- public server doubled what that server learns - and reset the failure
   -- count that the first batch was still adding to. The engine log of
   -- 2026-09-01 shows exactly that: eighty-two requests, then the same
   -- eighty-two again from id 85. A request in flight on its own (the Test
   -- button's tip) is not a sync and does not block one.
   if cwListCount(sWaQueue) > 0 then
      throw "a sync is already running, with " & cwListCount(sWaQueue) & \
            " request(s) still queued. Let it finish, or press Stop first."
   end if
   waEnsurePolling
   -- A FRESH SYNC IS ALLOWED TO BE GREEN AGAIN. The count is per sync, so a
   -- failure from the last one does not follow this one around.
   put 0 into sWaSyncFailures
   -- only what is stale (kWaTipFresh, kWaFeesFresh); a fresh answer is kept
   if sWaTipAt is empty or the milliseconds - sWaTipAt > kWaTipFresh then
      waNetQueue "tip", ""
   end if
   if sWaFeesAt is empty or the milliseconds - sWaFeesAt > kWaFeesFresh then
      waNetQueue "fees", ""
   end if
   -- HISTORY FIRST, AND UNSPENT OUTPUTS ONLY WHERE THERE IS ANY. History is
   -- the question that has to be asked of every address: it is the History
   -- screen's only source, and an address whose one output has been SPENT
   -- has no unspent outputs and still must count as used, or the Receive
   -- screen offers it again - a privacy loss the person never asked for. But
   -- an address with NO history has no unspent outputs by definition, and a
   -- fresh wallet is forty of those. This queued both kinds for every
   -- address - eighty-two requests to learn that a new wallet is empty - and
   -- the 2026-09-02 engine run over both clearnet transports is where that
   -- was seen for what it costs: on a public server every request is a
   -- thing that server learns, and on Tor every request is a round trip
   -- through three hops. waNetApply queues the utxos request for an address
   -- the moment its history comes back non-empty, so a used address costs
   -- one request more and an unused one costs nothing more; a fresh wallet
   -- is forty-two requests instead of eighty-two.
   put cwListCount(sWaAddresses) into tCount
   repeat with tI = 1 to tCount
      put sWaAddresses[tI] into tRec
      waNetQueue "history", tRec["address"]
   end repeat
   -- IN THE LOG AS WELL AS ON THE STATUS LINE, because the log is what gets
   -- pasted back, and a log that goes from "backend: ..." straight to silence
   -- cannot say whether a sync was ever asked for.
   put cwListCount(sWaQueue) into tCount
   waLog "sync: queued " & tCount & " request(s) to " & sWaHost & \
         ":" & sWaPort & " over " & sWaBackend
   uiStatus "Queued " & tCount & " requests to " & sWaHost & \
         " (unspent outputs are asked for only where the history says there " & \
         "are any).", ""
end waSync

command waNetQueue pKind, pArg
   local tRec
   add 1 to sWaReqId
   put "" into tRec
   put sWaReqId into tRec["id"]
   put pKind into tRec["kind"]
   put pArg into tRec["arg"]
   put cwListAdd(sWaQueue, tRec) into sWaQueue
end waNetQueue

private function waQueueFirst pRec
   -- The queue with pRec at the FRONT. A retry belongs where the request was,
   -- not behind every address after it, because the answers are folded in as
   -- they arrive and a sync that reorders itself is harder to read in the log.
   local tOut, tI, tCount
   put waEmptyList() into tOut
   put cwListAdd(tOut, pRec) into tOut
   put cwListCount(sWaQueue) into tCount
   repeat with tI = 1 to tCount
      put cwListAdd(tOut, sWaQueue[tI]) into tOut
   end repeat
   return tOut
end waQueueFirst

command waNetAbort
   -- SAY WHAT WAS DROPPED. The 2026-09-03 log has request ids jumping from
   -- 73 to 84 with nothing between: the wallet was switched mid-sync, this
   -- handler threw ten queued requests and the one in flight away, and the
   -- next reader of that log had to work that out from the numbers.
   local tError, tDropped
   put cwListCount(sWaQueue) into tDropped
   if sWaInFlight is not empty then
      waLog "abandoned " & sWaInFlight["kind"] & " " & sWaInFlight["arg"] & \
            " in flight and " & tDropped & " queued request(s)"
   else if tDropped > 0 then
      waLog "dropped " & tDropped & " queued request(s)"
   end if
   waSockClose
   waStreamClose
   put empty into sWaInFlight
   put empty into sWaBatchMembers
   put empty into sWaBuffer
   put waEmptyList() into sWaQueue
   if sWaNetState is "busy" or sWaNetState is "dialing" then
      put "idle" into sWaNetState
   end if
end waNetAbort

command waNetPump
   -- One request at a time. Called from the tick, so it must return quickly
   -- and must never throw past its caller.
   local tRec, tI, tCount, tRest, tError, tMembers, tNext, tGather, tBatch
   if sWaInFlight is not empty then
      waNetCheckDeadline
      exit waNetPump
   end if
   if cwListCount(sWaQueue) < 1 then
      exit waNetPump
   end if
   put sWaQueue[1] into tRec
   put waEmptyList() into tRest
   put waEmptyList() into tMembers
   put cwListCount(sWaQueue) into tCount
   -- A RUN OF REQUESTS GOES AS ONE BATCH on an Electrum backend
   -- (kWaBatchSize), whatever their kinds: the tip, the fees and the
   -- histories a sync queues are one line, and so are the unspent-output
   -- requests that follow. The eighth engine log (2026-09-03) batched
   -- histories only and spent two of its five round trips on a tip and a
   -- fee estimate that could have ridden along. A broadcast goes alone, so
   -- its acknowledgement is its own line in the log.
   put "false" into tGather
   if waIsElectrum(sWaBackend) and sWaBatch is not "false" \
         and tRec["kind"] is not "broadcast" then
      put "true" into tGather
   end if
   put cwListAdd(tMembers, tRec) into tMembers
   repeat with tI = 2 to tCount
      put sWaQueue[tI] into tNext
      if tGather is "true" and tNext["kind"] is not "broadcast" \
            and cwListCount(tMembers) < waBatchCap() then
         put cwListAdd(tMembers, tNext) into tMembers
      else
         put "false" into tGather
         put cwListAdd(tRest, tNext) into tRest
      end if
   end repeat
   put tRest into sWaQueue
   put empty into sWaBatchMembers
   if cwListCount(tMembers) > 1 then
      put tMembers into sWaBatchMembers
      put "" into tBatch
      put tRec["id"] into tBatch["id"]
      put "batch" into tBatch["kind"]
      put "of " & cwListCount(tMembers) & " (" & waBatchShape(tMembers) & ")" \
            into tBatch["arg"]
      put tBatch into tRec
   end if
   put the milliseconds + kWaNetDeadline into tRec["deadline"]
   put tRec into sWaInFlight
   -- A PARTIAL LINE ON A KEPT STREAM BELONGS TO THE STREAM, not to the
   -- request that just ended: it is the head of a notification the server
   -- pushed between two requests, and clearing it here would hand its tail
   -- to the next reply as a line that parses as nothing.
   if sWaBackend is not "electrum-tor" or sWaStream is empty then
      put empty into sWaBuffer
   end if
   waHttpReset
   put "busy" into sWaNetState
   try
      waNetStart tRec
   catch tError
      waNetFail tError
   end try
end waNetPump

private command waNetCheckDeadline
   local tRec
   put sWaInFlight into tRec
   if the milliseconds > tRec["deadline"] then
      waNetFail "the backend accepted the connection and then said nothing " & \
            "for " & (kWaNetDeadline / 1000) & " seconds."
   end if
end waNetCheckDeadline

command waNetFail pWhy
   set the defaultStack to the short name of this stack
   local tError, tRec
   -- ONCE MORE, FIRST. A request that was still in flight when the transport
   -- failed - a Tor circuit that closed before sending, a SOCKS handshake that
   -- timed out, a deadline, a dial that threw - is put back at the FRONT of
   -- the queue and tried again before anything is counted. The 2026-09-02
   -- Tor log shows why: two circuits died mid-sync and both times the wallet
   -- moved on to the NEXT address, so a history was never merged, so its
   -- unspent outputs were never asked for - a funded address missing from a
   -- sync that reported itself merely partial. A reply that ARRIVED and did
   -- not parse never gets here with a request in flight (waNetDeliver clears
   -- it before applying), so a deterministic failure is not retried; only
   -- the transport is. The second failure counts, as before.
   put sWaInFlight into tRec
   -- A BATCH THAT FAILED IN TRANSIT is not retried as a batch: whatever
   -- refused it - a reply over kWaMaxBody, a server that dropped the line -
   -- is likelier to refuse it again, and its members retried singly each
   -- get the ordinary once-more below. Nothing is counted here.
   if tRec is not empty and tRec["kind"] is "batch" then
      waStreamClose
      waSockClose
      put empty into sWaInFlight
      put empty into sWaBuffer
      put "idle" into sWaNetState
      waBatchSplit sWaBatchMembers, pWhy
      put empty into sWaBatchMembers
      exit waNetFail
   end if
   if tRec is not empty and tRec["retried"] is not "true" then
      waStreamClose
      waSockClose
      put empty into sWaInFlight
      put empty into sWaBuffer
      put "true" into tRec["retried"]
      put waQueueFirst(tRec) into sWaQueue
      put "idle" into sWaNetState
      waLog "retrying " & tRec["kind"] & " " & tRec["arg"] & " once: " & pWhy
      exit waNetFail
   end if
   waStreamClose
   -- AND THE CLEARNET SOCKET, for the same reason and with sharper teeth.
   -- This handler closed the Tor stream and left sWaSock alone, and on that
   -- transport the connection is PERSISTENT and reused for every request of a
   -- sync. So a deadline left the socket open with the server still owing an
   -- answer, waTick kept pumping the rest of the queue down it, and the next
   -- request's armed read collected the PREVIOUS request's reply. waMergeUtxos
   -- REPLACES every coin at the address it was asked about, so one address's
   -- coins were written under another's - which is exactly the misattribution
   -- the `load URL` branch carries pRec["url"] to prevent, arriving on the new
   -- transport by a different door. A failure tears the connection down; the
   -- next request dials again, which is one connection, not a desynchronised
   -- one.
   waSockClose
   put empty into sWaInFlight
   put empty into sWaBuffer
   put "failed" into sWaNetState
   if tRec is not empty and tRec["kind"] is "broadcast" then
      waUnnoteBroadcast tRec["arg"]
   end if
   add 1 to sWaSyncFailures
   if sWaSyncFailures > 1 then
      put pWhy & " (" & sWaSyncFailures & " request(s) of this sync have " & \
            "failed, so anything below is incomplete)" into sWaNetWhy
   else
      put pWhy & " (this sync is incomplete: a balance missing one " & \
            "address's coins is a wrong number, not a smaller one)" into sWaNetWhy
   end if
   waLog "FAILED: " & pWhy
   uiStatus "Network: " & pWhy, "bad"
   waPaintNav
end waNetFail

command waNetStart pRec
   -- Dispatch one request to whichever transport is selected.
   local tPath, tUrl, tError, tHandle, tBody, tMethod, tSock
   if sWaBackend is "esplora-clear" then
      -- the path is Esplora's business and asked for only here and in
      -- waStreamSendHttp: asked of every record, it threw on the first
      -- Electrum batch, whose kind no HTTP path has (2026-09-03)
      put waEsploraPath(pRec) into tPath
      -- THIS TRANSPORT CANNOT BROADCAST, and it says so instead of pretending.
      -- Esplora takes a transaction by POSTing it to /api/tx; `load URL` does
      -- a GET and carries no body, so the signed transaction would simply be
      -- dropped on the floor while the reply - Esplora's 405 page - was read
      -- back as if it were a txid and reported as "Broadcast." The two Tor
      -- transports build a real POST, which is why the disagreement was
      -- invisible: one of the three quietly did nothing.
      if pRec["kind"] is "broadcast" then
         throw "the clearnet transport in this stack can fetch but not POST, " & \
               "so it cannot broadcast. Use a Tor backend, or copy the raw " & \
               "transaction from the Send screen and push it from somewhere " & \
               "else. Nothing was sent."
      end if
      put waClearScheme() & sWaHost & tPath into tUrl
      waLog "GET  " & tUrl
      -- CORRELATION, not just ordering. `load URL` cannot be cancelled: after
      -- a deadline or a Stop, the abandoned request is still in flight and
      -- its reply arrives while a DIFFERENT record is in sWaInFlight - so
      -- without this the answer for address A is merged under address B and
      -- the wallet records coins at an address that does not hold them. The
      -- Tor transports get this free from the stream handle; this one has to
      -- carry the URL it issued and check it.
      put tUrl into pRec["url"]
      put pRec into sWaInFlight
      -- ASYNCHRONOUS on purpose. `put URL x` blocks the one interpreter
      -- thread, which on a slow or unreachable host freezes the whole
      -- window; the with-message form hands the answer back through the
      -- message path instead.
      load URL tUrl with message "waUrlDone"
      exit waNetStart
   end if
   if sWaBackend is "electrum-clear" then
      -- A PLAIN TCP SOCKET, which is the whole point: no TLS for the engine
      -- to get wrong and no daemon to be running. The socket id IS the
      -- "host:port" string in this engine, so it doubles as the correlation
      -- token the way the Tor stream handle does.
      put sWaHost & ":" & sWaPort into tSock
      put tSock into pRec["sock"]
      put pRec into sWaInFlight
      -- ONE CONNECTION, MANY REQUESTS. Electrum is designed for exactly that
      -- - the id field on every request exists to correlate answers over a
      -- persistent link - and this transport originally opened a fresh socket
      -- per request, which broke twice over. In this engine a socket IS its
      -- "host:port" string, so request 2 asked to open a socket whose id was
      -- the one request 1 had just closed; and a sync is 2 + 2 x the address
      -- count requests, so a full scan would have hammered a public server
      -- with eighty-odd connections in a few seconds. The tip answered and
      -- nothing after it did, which reads as an empty wallet.
      -- AND IT MUST BE THE SOCKET THE SETTINGS NOW NAME. Reuse was tested by
      -- "is one open?" alone, so a host or a port edited on the Network
      -- screen reached sWaHost and sWaPort and the fields and NOT the
      -- connection: every script hash of the sync still went to the server
      -- the person had just acted to leave, and if what they changed was the
      -- chain-selecting port, the old server answered every request for the
      -- other chain with a well-formed empty list. The socket id IS its
      -- "host:port" in this engine, so the comparison is exact and free.
      if sWaSock is not empty and sWaSock is not tSock then
         waLog "backend moved to " & tSock & " - closing " & sWaSock
         waSockClose
      end if
      if sWaSock is not empty then
         put "busy" into sWaNetState
         waSockSend
         exit waNetStart
      end if
      put tSock into sWaSock
      put "dialing" into sWaNetState
      waLog "open " & tSock
      open socket to tSock with message "waSockOpened"
      exit waNetStart
   end if
   if sWaBackend is "esplora-tor" or sWaBackend is "electrum-tor" then
      if sWaHaveOnion is not "true" then
         throw "OnionXT is not loaded, so there is no Tor transport here."
      end if
      put waOnionWhy(sWaHost) into tError
      if tError is not empty then
         throw tError
      end if
      -- ONE STREAM, MANY REQUESTS, on the Electrum transport (2026-09-03).
      -- The first engine log in which this transport spoke to a server
      -- dialled a fresh rendezvous stream for every one of its 173 requests
      -- - the per-request-connection shape the clearnet Electrum transport
      -- was cured of on 2026-09-01, arriving on the Tor transport by the
      -- other door. Electrum is designed for one connection (the id on
      -- every request exists to correlate answers over it), so the stream
      -- the last reply came down is kept open and the next request is
      -- written to it. It has to be the stream the settings NOW name, for
      -- the reason sWaSock compares its id; and a stream the server has
      -- since dropped is "unknown" to OnionXT (a peer close reaches
      -- waStreamClosed, which forgets the handle; oxCloseStream forgets it
      -- too), so anything but a connected stream to this host and port
      -- dials again. Esplora joined it later the same day, over HTTP/1.1
      -- keep-alive with the reply framing in waHttpFeed; a reply that
      -- carries no framing, or says Connection: close, forgets the stream
      -- and the next request dials.
      put sWaHost & ":" & sWaPort into tSock
      if sWaStream is not empty then
         if sWaStreamTo is tSock and oxStreamState(sWaStream) is "connected" then
            put "busy" into sWaNetState
            waStreamSend
            exit waNetStart
         end if
         waLog "backend moved to " & tSock & " or stream " & sWaStream & \
               " is " & oxStreamState(sWaStream) & " - closing it"
         waStreamClose
      end if
      oxSetSocksPort sWaSocksPort
      oxSetCallbackOwner the long id of me
      put "dialing" into sWaNetState
      oxDial sWaHost, sWaPort
      put the result into tHandle
      if tHandle is not an integer then
         throw "could not dial " & tSock & " - " & tHandle
      end if
      put tHandle into sWaStream
      put tSock into sWaStreamTo
      oxSetStreamCallback tHandle, "waStreamEvent"
      waLog "dial " & tSock & " stream " & tHandle
      exit waNetStart
   end if
   throw "this wallet is offline."
end waNetStart

function waClearScheme
   -- https by default and http only when the host is a plain-HTTP mirror the
   -- user typed themselves. The scheme is shown on the Network screen either
   -- way, because "which one am I using" is not a thing a wallet should make
   -- somebody guess.
   if char 1 to 7 of sWaHost is "http://" then
      return ""
   end if
   return "https://"
end waClearScheme

function waEsploraRoot
   -- ESPLORA SERVES EACH CHAIN UNDER ITS OWN ROOT, and this handler used to
   -- emit the mainnet one for every network. This wallet DEFAULTS to testnet,
   -- so that was the common case, not the corner: a freshly generated wallet
   -- derived correct tb1 addresses and then asked the mainnet index about
   -- them.
   --
   -- What it costs is the wrong-but-plausible answer rule 4 exists to refuse.
   -- Esplora replies 400 for an address off its chain, and only the two Tor
   -- transports read an HTTP status (waHttpCheckStatus); the clearnet one goes
   -- through `load URL`, which hands waUrlDone a body and no code - so a
   -- funded address came back as a synced wallet holding nothing. Nobody is
   -- told their coins were looked for in the wrong place.
   --
   --   mainnet   /api
   --   testnet   /testnet/api
   --   signet    /signet/api
   --
   -- Regtest is not in the table because it has no public mirror: the person
   -- runs their own single-network esplora, which serves the bare /api root.
   -- waBackendChainWhy refuses regtest against the built-in hosts, so the
   -- empty prefix here is only ever used with a host they typed themselves.
   if sWaNetwork is "testnet" then
      return "/testnet"
   end if
   if sWaNetwork is "testnet4" then
      return "/testnet4"
   end if
   if sWaNetwork is "signet" then
      return "/signet"
   end if
   return empty
end waEsploraRoot

function waBackendChainWhy
   -- Does the SELECTED BACKEND actually carry the chain this wallet is on?
   -- The two failures are not equally visible, which is the whole reason this
   -- is a guard and not a comment. Esplora answers a foreign address with a
   -- 400 - wrong, but loud on a transport that reads the status. An Electrum
   -- server answers a foreign SCRIPTHASH with an empty list, which is a
   -- perfectly well-formed "this address has never been used": a testnet
   -- wallet on a mainnet server reports itself synced, green, and empty, with
   -- nothing anywhere saying otherwise. Fail closed and name the remedy.
   local tWhy
   if sWaBackend is "offline" then
      return empty
   end if
   -- A host Tor cannot even look up is refused before its chain is asked
   -- about, because the daemon's answer for one is indistinguishable from a
   -- failed circuit (the 2026-09-02 log; see waOnionWhy).
   if waNeedsTor(sWaBackend) then
      put waOnionWhy(sWaHost) into tWhy
      if tWhy is not empty then
         return tWhy
      end if
   end if
   if sWaBackend is "electrum-tor" and sWaHost is kWaElectrumOnion \
         and sWaNetwork is not "mainnet" and sWaNetwork is not "testnet" then
      -- The onion carries mainnet on 110 and testnet on 143 (waRetunePort)
      -- and nothing else. Until 2026-09-02 this guard refused everything but
      -- mainnet, which was right for the v2 address that stood here.
      return "the built-in Electrum onion carries mainnet and testnet " & \
            "only, and this wallet is on " & sWaNetwork & ". An Electrum " & \
            "server answers for the wrong chain with an empty list rather " & \
            "than an error, so this would look like a synced, empty " & \
            "wallet. Put a " & sWaNetwork & " server in the host field."
   end if
   if sWaBackend is "electrum-clear" and sWaHost is kWaElectrumClear \
         and sWaNetwork is not "mainnet" and sWaNetwork is not "testnet" then
      -- The public server carries mainnet on 50001 and testnet on 60001 and
      -- nothing else. Signet and regtest need a server that serves them.
      return "the built-in clearnet Electrum server carries mainnet and " & \
            "testnet only, and this wallet is on " & sWaNetwork & \
            ". Put a " & sWaNetwork & " server in the host field."
   end if
   -- TESTNET4 (2026-09-04): the same bytes as testnet3 and a different chain,
   -- so a backend that indexes testnet3 answers a testnet4 address with a
   -- well-formed nothing. Blockstream's mirrors carry testnet3 only;
   -- mempool.space carries testnet4 under /testnet4, and is the built-in
   -- second Esplora host already. Neither built-in Electrum server carries it.
   if sWaNetwork is "testnet4" and (sWaHost is kWaEsploraOnion \
         or sWaHost is kWaEsploraClear) then
      return "Blockstream's mirrors index testnet3, not testnet4, and " & \
            "would answer every address with an empty list. Put " & \
            kWaEsploraClearAlt & " in the host field: it serves testnet4."
   end if
   if sWaNetwork is "testnet4" and (sWaHost is kWaElectrumOnion \
         or sWaHost is kWaElectrumClear) then
      return "the built-in Electrum servers carry mainnet and testnet3, " & \
            "not testnet4. Put a testnet4 Electrum server in the host " & \
            "field, or use Esplora over clearnet with " & kWaEsploraClearAlt & "."
   end if
   if sWaNetwork is "regtest" and (sWaHost is kWaEsploraOnion \
         or sWaHost is kWaEsploraClear or sWaHost is kWaElectrumOnion \
         or sWaHost is kWaElectrumClear) then
      return "regtest is a chain you run yourself, so no public backend " & \
            "carries it. Put your own node's host in the field above."
   end if
   return empty
end waBackendChainWhy

function waOnionWhy pHost
   -- CAN TOR EVEN LOOK THIS HOST UP? A ".onion" name comes in two shapes:
   -- fifty-six base32 characters (version 3, the only kind the network has
   -- resolved since 2021) or sixteen (version 2, retired). The daemon does
   -- not say "retired" for the old shape: it answers the SOCKS connect with
   -- "general SOCKS server failure", the same words a failed circuit gets,
   -- so the 2026-09-02 engine log showed this wallet retrying a dead
   -- address as if it were weather and then reporting the retry's failure.
   -- Answering here, by shape, turns that into a sentence that names the
   -- remedy. A clearnet name through Tor is legal and is not judged.
   local tLabel, tLen
   put cwLower(cwTrim(pHost)) into tLabel
   if not (tLabel ends with ".onion") then
      return empty
   end if
   delete char -6 to -1 of tLabel
   if tLabel contains "." then
      -- a subdomain of an onion (rare, legal): the onion is the LAST label
      set the itemDelimiter to "."
      put item -1 of tLabel into tLabel
      set the itemDelimiter to comma
   end if
   put the number of chars of tLabel into tLen
   if tLen is 16 then
      return pHost & " is a version-2 onion address, which the Tor " & \
            "network stopped resolving in 2021; the daemon reports one as " & \
            "'general SOCKS server failure'. Put a 56-character " & \
            "(version 3) .onion in the host field."
   end if
   if tLen is not 56 then
      return pHost & " is not a well-formed .onion address (" & tLen & \
            " characters before .onion; version 3 has 56)."
   end if
   return empty
end waOnionWhy

function waIsPublicTestSeed
   -- The wallet PRE-FILLS BIP-39's published test mnemonic so a person can
   -- press every button without inventing a seed first, and on testnet that is
   -- exactly right. It is also a loaded gun: those twelve words are in the
   -- specification, in this repository, and in every BIP-39 test suite ever
   -- written, so every key they derive is public. Carried to mainnet they
   -- produce addresses anyone who has read the spec can sweep, and nothing on
   -- the screen would look any different.
   --
   -- The comparison is EXACT rather than case-folded, because BIP-39 derives
   -- the seed from the mnemonic STRING: a case variant is a genuinely
   -- different seed, not this one. What this guard is actually for is the
   -- pre-filled default, which is byte-identical to the constant.
   return cwSameBytes(cxMnemonicNormalize(cwTrim(sWaMnemonic)), \
         kWaTestMnemonic)
end waIsPublicTestSeed

function waEsploraPath pRec
   local tKind, tArg, tRoot
   put pRec["kind"] into tKind
   put pRec["arg"] into tArg
   -- EVERY path goes through the network root. Building it once here rather
   -- than at the six returns is deliberate: a seventh request kind added
   -- later cannot forget it.
   put waEsploraRoot() into tRoot
   if tKind is "tip" then
      return tRoot & "/api/blocks/tip/height"
   end if
   if tKind is "fees" then
      return tRoot & "/api/fee-estimates"
   end if
   if tKind is "utxos" then
      return tRoot & "/api/address/" & tArg & "/utxo"
   end if
   if tKind is "history" then
      return tRoot & "/api/address/" & tArg & "/txs"
   end if
   if tKind is "tx" then
      return tRoot & "/api/tx/" & tArg & "/hex"
   end if
   if tKind is "broadcast" then
      return tRoot & "/api/tx"
   end if
   throw "unknown request kind " & tKind & "."
end waEsploraPath

on waUrlDone pUrl, pStatus
   -- The engine's URL callback. pStatus is "cached" on success and anything
   -- else on failure; the body is then read back from the URL and the entry
   -- MUST be unloaded on every path or the cache grows without limit.
   set the defaultStack to the short name of this stack
   local tBody, tError, tRec
   put sWaInFlight into tRec
   if tRec is empty or pUrl is not tRec["url"] then
      -- Nothing is waiting for this, or something else is: a reply from a
      -- request this wallet gave up on. Unload it and say nothing - applying
      -- it to whatever is in flight now is how one address's coins end up
      -- recorded against another's.
      try
         unload URL pUrl
      catch tError
      end try
      if tRec is not empty and pUrl is not tRec["url"] then
         waLog "drop  late reply " & pUrl
      end if
      exit waUrlDone
   end if
   if pStatus is not "cached" then
      try
         unload URL pUrl
      catch tError
      end try
      -- NAME THE REMEDY. "the URL library said error" over a URL is where a
      -- person stops, and the two things worth trying are a different public
      -- mirror and a transport that does not need TLS at all.
      waNetFail "the URL library said " & pStatus & " for " & pUrl & \
            " - if that repeats, try host " & kWaEsploraClearAlt & \
            " (same API), or a Tor backend, which runs plain HTTP inside " & \
            "the circuit and so does not depend on this engine's TLS."
      exit waUrlDone
   end if
   put empty into tBody
   try
      put URL pUrl into tBody
   catch tError
      put empty into tBody
   end try
   -- AND THE CAP HERE TOO. `load URL` has already read the whole body by the
   -- time this runs, so this cannot stop the read the way the socket cap can;
   -- what it stops is everything downstream - the parse, the merge and the
   -- 6000-character tail written into the Network screen - from working on a
   -- reply no backend of this kind sends.
   if the number of bytes of tBody > kWaMaxBody then
      try
         unload URL pUrl
      catch tError
      end try
      waNetFail "the backend sent more than " & kWaMaxBody & \
            " bytes for one answer, which is not a shape this wallet asked for."
      exit waUrlDone
   end if
   try
      unload URL pUrl
   catch tError
   end try
   waNetDeliver tBody
end waUrlDone

on waSockOpened pSocket
   -- The engine's callback for `open socket`. Everything here is inside a try
   -- for the reason the Tor path documents: a throw in a socket callback is
   -- swallowed by the engine, so an unguarded bug here is a silent hang.
   set the defaultStack to the short name of this stack
   local tError, tLine
   if pSocket is not sWaSock then
      exit waSockOpened
   end if
   try
      if the result is not empty then
         waNetFail "could not connect to " & pSocket & " - " & the result
         exit waSockOpened
      end if
      put "busy" into sWaNetState
      waSockSend
   catch tError
      waNetFail "the clearnet Electrum socket raised: " & tError
   end try
end waSockOpened

private command waSockSend
   -- Write the in-flight request and arm the read. Shared by the first
   -- request on a new connection and every one that reuses it, so the two
   -- cannot drift.
   local tLine, tRec
   if sWaSock is empty or sWaInFlight is empty then
      exit waSockSend
   end if
   put waElectrumRequest(sWaInFlight) into tLine
   waLog waRequestLogLine(tLine)
   write tLine & numToChar(10) to socket sWaSock
   if the result is not empty then
      -- A WRITE THAT FAILS ON A REUSED CONNECTION is the ordinary way a
      -- server drops an idle client, so the connection is torn down and the
      -- next tick dials again rather than the sync dying here.
      --
      -- TWO THINGS THIS USED TO GET WRONG, and both were silent. It forgot
      -- sWaSock without CLOSING it, so the engine kept the connection and
      -- the next dial asked for a socket whose id - "host:port" in this
      -- engine - was the one still open. And it dropped sWaInFlight on the
      -- floor: the request was never sent and never requeued, so that
      -- address was simply never asked about and its coins never appeared,
      -- which on a balance is a wrong number rather than an error.
      --
      -- Requeued ONCE. A server that refuses the write twice is a failure
      -- worth reporting, not a loop worth running.
      waLog "write failed on " & sWaSock & ": " & the result & " - reconnecting"
      put sWaInFlight into tRec
      waSockClose
      put empty into sWaInFlight
      if tRec["rewritten"] is "true" then
         waNetFail "the backend refused the same request twice on a fresh " & \
               "connection: " & tRec["kind"] & " " & tRec["arg"]
         exit waSockSend
      end if
      put "true" into tRec["rewritten"]
      put waQueueFirst(tRec) into sWaQueue
      put "idle" into sWaNetState
      exit waSockSend
   end if
   -- ONE LINE IS ONE ANSWER. Electrum frames its JSON-RPC by newline, so
   -- reading until one is the whole framing problem solved - no buffer to
   -- accumulate and no completeness heuristic to get wrong.
   read from socket sWaSock until numToChar(10) with message "waSockLine"
end waSockSend

on waSockLine pSocket, pData
   set the defaultStack to the short name of this stack
   local tError
   if pSocket is not sWaSock then
      exit waSockLine
   end if
   try
      if pData is empty then
         waNetFail "the Electrum server closed " & pSocket & \
               " before answering."
         exit waSockLine
      end if
      -- THE SAME CAP THE TOR STREAM HAS. kWaMaxBody was enforced in exactly
      -- one place, the OnionXT data event, so a backend that never stops
      -- sending was refused on one transport of three and could exhaust the
      -- engine's memory on the other two.
      if the number of bytes of pData > kWaMaxBody then
         waNetFail "the backend sent more than " & kWaMaxBody & \
               " bytes for one answer, which is not a shape this wallet " & \
               "asked for."
         exit waSockLine
      end if
      -- The connection is NOT closed here: the next request reuses it.
      waNetDeliver pData
   catch tError
      waNetFail "reading from " & pSocket & " - " & tError
   end try
end waSockLine

private command waSockClose
   local tError
   if sWaSock is empty then
      exit waSockClose
   end if
   try
      close socket sWaSock
   catch tError
   end try
   put empty into sWaSock
end waSockClose

on waStreamEvent pStream, pEvent, pData
   -- OnionXT's per-stream callback: "open", "data", "closed", "error". The
   -- transport wraps this in a try that SWALLOWS an error so the tunnel keeps
   -- running, which means a bug here fails silently - so everything it does
   -- is inside its own try and reported.
   set the defaultStack to the short name of this stack
   local tError
   if pStream is not sWaStream then
      exit waStreamEvent
   end if
   try
      if pEvent is "open" then
         waStreamOpened
      else if pEvent is "data" then
         -- APPENDED, not rebuilt. `put sWaBuffer & pData into sWaBuffer`
         -- copies the whole buffer on every chunk - a two-megabyte history
         -- arriving in Tor-cell-sized pieces was a gigabyte of copying - where
         -- the engine's `after` extends in place (2026-09-03).
         put pData after sWaBuffer
         -- THE DEADLINE IS FOR SILENCE, NOT FOR SIZE. It was set once at the
         -- request and measured a whole reply against forty-five seconds, so
         -- a two-megabyte history over Tor - the 2026-09-02 log has one at
         -- 2155402 chars - could time out while still arriving, and did.
         -- Every chunk that lands pushes it out; only a stream that goes
         -- quiet still expires.
         if sWaInFlight is not empty then
            put the milliseconds + kWaNetDeadline into sWaInFlight["deadline"]
         end if
         if the number of bytes of sWaBuffer > kWaMaxBody then
            waNetFail "the backend sent more than " & kWaMaxBody & \
                  " bytes for one answer, which is not a shape this wallet " & \
                  "asked for."
            exit waStreamEvent
         end if
         if waIsElectrum(sWaBackend) then
            waElectrumMaybeComplete
         else
            waHttpFeed
         end if
      else if pEvent is "closed" then
         waStreamClosed
      else if pEvent is "error" then
         if sWaInFlight is empty then
            waStreamIdleGone "reported: " & pData
         else
            waNetFail "the Tor stream reported: " & pData
         end if
      end if
   catch tError
      waNetFail "handling a stream event: " & tError
   end try
end waStreamEvent

private command waStreamSendElectrum
   -- Write the in-flight request down the open stream. Shared by the first
   -- request on a new stream and every one that reuses it, so the two cannot
   -- drift - the same split as waSockSend on the clearnet transport.
   local tLine
   if sWaStream is empty or sWaInFlight is empty then
      exit waStreamSendElectrum
   end if
   put waElectrumRequest(sWaInFlight) into tLine
   waLog waRequestLogLine(tLine)
   oxWrite sWaStream, textEncode(tLine & numToChar(10), "UTF-8")
   if the result is not empty then
      -- A refused write on a reused stream is the ordinary way a server
      -- drops a quiet client. waNetFail closes the stream and tries the
      -- request once more, and the retry dials afresh.
      waNetFail "writing to the Tor stream: " & the result
   end if
end waStreamSendElectrum

private function waBatchShape pMembers
   -- "tip, fees, 20 history": the kinds in a batch, in order of first
   -- appearance, with a count where there is more than one.
   local tI, tCount, tKind, tKinds, tSeen, tOut
   put cwListCount(pMembers) into tCount
   put empty into tSeen
   put empty into tKinds
   repeat with tI = 1 to tCount
      put pMembers[tI]["kind"] into tKind
      if tSeen[tKind] is empty then
         put tKind & return after tKinds
      end if
      add 1 to tSeen[tKind]
   end repeat
   put empty into tOut
   repeat for each line tKind in tKinds
      if tOut is not empty then
         put ", " after tOut
      end if
      if tSeen[tKind] > 1 then
         put tSeen[tKind] & " " after tOut
      end if
      put tKind after tOut
   end repeat
   return tOut
end waBatchShape

private function waRequestLogLine pLine
   -- The "->" line: a single request verbatim, a batch as its shape and its
   -- ids, because twenty script hashes on one log line hide the two numbers
   -- a reader of the log wants.
   local tCount, tFirst, tLast, tLen
   if sWaInFlight["kind"] is not "batch" then
      return "-> " & pLine
   end if
   put cwListCount(sWaBatchMembers) into tCount
   put sWaBatchMembers[1]["id"] into tFirst
   put sWaBatchMembers[tCount]["id"] into tLast
   -- the length into a local first: `the number of chars of pLine & "..."`
   -- binds the concatenation into the chunk target (engine notes)
   put the number of chars of pLine into tLen
   return "-> batch " & sWaInFlight["arg"] & ", ids " & tFirst & \
         ".." & tLast & " (" & tLen & " chars)"
end waRequestLogLine

private command waStreamClose
   -- Close the Tor stream if one is open and forget it, wherever a path
   -- gives up on it. One handler so the two halves - the close and the
   -- forgetting - cannot come apart, which is the sWaSock lesson. A reply
   -- half-decoded on it is forgotten with it.
   local tError
   if sWaStream is not empty then
      try
         oxCloseStream sWaStream
      catch tError
      end try
   end if
   put empty into sWaStream
   put empty into sWaStreamTo
   waHttpReset
end waStreamClose

private command waStreamOpened
   waStreamSend
end waStreamOpened

private command waStreamSend
   -- The in-flight request, down whichever stream is open: the first one
   -- on a stream just dialled (waStreamOpened) and every one that reuses it
   -- (waNetStart), so the two cannot drift.
   if waIsElectrum(sWaBackend) then
      waStreamSendElectrum
   else
      waStreamSendHttp
   end if
end waStreamSend

private command waStreamSendHttp
   -- HTTP/1.1, KEPT ALIVE (2026-09-03). This was HTTP/1.0 with Connection:
   -- close, so that the body ended when the peer closed and there was no
   -- response framing to get wrong - and the price was a fresh rendezvous
   -- stream for every request: the 2026-09-03 engine log dials one per
   -- request while the Electrum transport beside it runs a whole sync down
   -- one. The framing is waHttpFeed's now, so the stream is asked to stay.
   local tRec, tReq, tCrlf, tBody, tLen
   if sWaStream is empty or sWaInFlight is empty then
      exit waStreamSendHttp
   end if
   put sWaInFlight into tRec
   put numToChar(13) & numToChar(10) into tCrlf
   if tRec["kind"] is "broadcast" then
      put tRec["arg"] into tBody
      -- THE LENGTH GOES INTO A LOCAL FIRST. Whether `the number of chars of
      -- tBody & tCrlf` binds the concatenation into the chunk target is not
      -- settled here: the family's own interpreter models it greedily and one
      -- engine-exercised file in the tree relies on the opposite. If greedy
      -- is what the engine does, this Content-Length would be two too many
      -- and the server would sit waiting for bytes that never arrive - a HANG
      -- rather than an error. A local costs one line and removes the question.
      put the number of chars of tBody into tLen
      put "POST " & waEsploraPath(tRec) & " HTTP/1.1" & tCrlf & \
            "Host: " & sWaHost & tCrlf & \
            "User-Agent: CoinXTWallet/" & kWaVersion & tCrlf & \
            "Content-Type: text/plain" & tCrlf & \
            "Content-Length: " & tLen & tCrlf & \
            "Connection: keep-alive" & tCrlf & tCrlf & tBody into tReq
   else
      put "GET " & waEsploraPath(tRec) & " HTTP/1.1" & tCrlf & \
            "Host: " & sWaHost & tCrlf & \
            "User-Agent: CoinXTWallet/" & kWaVersion & tCrlf & \
            "Connection: keep-alive" & tCrlf & tCrlf into tReq
   end if
   waLog "-> " & line 1 of tReq
   oxWrite sWaStream, textEncode(tReq, "UTF-8")
   if the result is not empty then
      waNetFail "writing to the Tor stream: " & the result
   end if
end waStreamSendHttp

command waHttpReset
   -- The reply decoder back to its first phase, before a request goes out
   -- and after anything that gives up on one.
   put "head" into sWaHttpPhase
   put empty into sWaHttpHead
   put empty into sWaHttpBody
   put 0 into sWaHttpLeft
   put "false" into sWaHttpDrop
   put "" into sWaHttpBad
end waHttpReset

private function waHttpHeader pHead, pName
   -- The value of one header, lower-cased and trimmed, or empty. Header
   -- names are case-insensitive on the wire and nginx and electrs spell
   -- them differently.
   local tI, tCount, tLine, tLen
   put cwLower(pHead) into pHead
   put the number of chars of pName into tLen
   put the number of lines of pHead into tCount
   repeat with tI = 2 to tCount
      put line tI of pHead into tLine
      if char 1 to tLen of tLine is pName and char (tLen + 1) of tLine is ":" then
         return cwTrim(char (tLen + 2) to -1 of tLine)
      end if
   end repeat
   return empty
end waHttpHeader

function waHexToInt pHex
   -- A hex number the way a chunk-size line spells it: digits until the
   -- first thing that is not one (chunk extensions follow a semicolon).
   local tI, tCount, tDigit, tOut
   put 0 into tOut
   put cwLower(cwTrim(pHex)) into pHex
   put the number of chars of pHex into tCount
   repeat with tI = 1 to tCount
      put offset(char tI of pHex, "0123456789abcdef") into tDigit
      if tDigit is 0 then
         exit repeat
      end if
      put tOut * 16 + tDigit - 1 into tOut
   end repeat
   return tOut
end waHexToInt

command waHttpFeed
   -- THE ESPLORA REPLY DECODER, a phase machine over sWaBuffer that consumes
   -- what it has understood and keeps only what it has not, so a two-megabyte
   -- history never sits in the buffer twice. Bytes throughout, for the reason
   -- waHttpBody gave: offset() answers in bytes on a binary value and the
   -- slice must agree with it.
   --
   --   head     until the blank line: status checked at once, framing chosen
   --   len      Content-Length bytes, then done
   --   size     a chunk-size line (hex, extensions after ";"); 0 -> trailer
   --   data     that many bytes into the body, then gap
   --   gap      the CRLF after a chunk, then size
   --   trailer  header lines after the last chunk, until a blank one -> done
   --   close    no framing at all: the body ends when the peer closes
   --            (waStreamClosed), the way every reply did until 2026-09-03,
   --            and such a stream is not kept
   --   done     delivered; the stream is kept unless the reply said close
   local tCrlf, tPos, tTotal, tSkip, tLine, tTake, tLen, tEnc, tConn, tBody
   put numToChar(13) & numToChar(10) into tCrlf
   repeat forever
      put the number of bytes of sWaBuffer into tTotal
      if sWaHttpPhase is "head" then
         put offset(tCrlf & tCrlf, sWaBuffer) into tPos
         put 4 into tSkip
         if tPos is 0 then
            -- some servers send bare LF; accept that rather than failing on
            -- a response that is otherwise fine
            put offset(numToChar(10) & numToChar(10), sWaBuffer) into tPos
            put 2 into tSkip
         end if
         if tPos is 0 then
            exit repeat
         end if
         put byte 1 to (tPos - 1) of sWaBuffer into sWaHttpHead
         waHttpConsume tPos + tSkip - 1
         -- a refusal is known at the head; no point reading its body first
         waHttpCheckStatus sWaHttpHead
         put waHttpHeader(sWaHttpHead, "connection") into tConn
         if tConn is "close" then
            put "true" into sWaHttpDrop
         end if
         put waHttpHeader(sWaHttpHead, "transfer-encoding") into tEnc
         put waHttpHeader(sWaHttpHead, "content-length") into tLen
         if tEnc contains "chunked" then
            put "size" into sWaHttpPhase
         else if tLen is an integer and tLen >= 0 then
            put tLen into sWaHttpLeft
            put "len" into sWaHttpPhase
         else
            put "true" into sWaHttpDrop
            put "close" into sWaHttpPhase
         end if
      else if sWaHttpPhase is "len" then
         if tTotal < sWaHttpLeft then
            put sWaBuffer after sWaHttpBody
            put empty into sWaBuffer
            subtract tTotal from sWaHttpLeft
            exit repeat
         end if
         put byte 1 to sWaHttpLeft of sWaBuffer after sWaHttpBody
         waHttpConsume sWaHttpLeft
         put 0 into sWaHttpLeft
         put "done" into sWaHttpPhase
      else if sWaHttpPhase is "size" then
         put offset(tCrlf, sWaBuffer) into tPos
         if tPos is 0 then
            exit repeat
         end if
         put byte 1 to (tPos - 1) of sWaBuffer into tLine
         waHttpConsume tPos + 1
         put waHexToInt(tLine) into sWaHttpLeft
         if sWaHttpLeft is 0 then
            put "trailer" into sWaHttpPhase
         else
            put "data" into sWaHttpPhase
         end if
      else if sWaHttpPhase is "data" then
         if tTotal is 0 then
            exit repeat
         end if
         if tTotal < sWaHttpLeft then
            put tTotal into tTake
         else
            put sWaHttpLeft into tTake
         end if
         put byte 1 to tTake of sWaBuffer after sWaHttpBody
         waHttpConsume tTake
         subtract tTake from sWaHttpLeft
         if sWaHttpLeft is 0 then
            put "gap" into sWaHttpPhase
         end if
      else if sWaHttpPhase is "gap" then
         if tTotal < 2 then
            exit repeat
         end if
         waHttpConsume 2
         put "size" into sWaHttpPhase
      else if sWaHttpPhase is "trailer" then
         put offset(tCrlf, sWaBuffer) into tPos
         if tPos is 0 then
            exit repeat
         end if
         waHttpConsume tPos + 1
         if tPos is 1 then
            put "done" into sWaHttpPhase
         end if
      else if sWaHttpPhase is "close" then
         put sWaBuffer after sWaHttpBody
         put empty into sWaBuffer
         exit repeat
      else
         -- done: hand it over, and forget a stream the server is closing
         put "head" into sWaHttpPhase
         if sWaHttpBad is not "" then
            put sWaHttpBody into tBody
            put empty into sWaHttpBody
            waNetFail waHttpBadWhy(tBody)
            exit repeat
         end if
         waNetDeliver sWaHttpBody
         put empty into sWaHttpBody
         if sWaHttpDrop is "true" then
            waStreamClose
         end if
         exit repeat
      end if
      if the number of bytes of sWaHttpBody > kWaMaxBody then
         waNetFail "the backend sent more than " & kWaMaxBody & \
               " bytes for one answer, which is not a shape this wallet " & \
               "asked for."
         exit repeat
      end if
   end repeat
end waHttpFeed

private command waHttpConsume pCount
   -- Drop the first pCount bytes of the buffer.
   local tTotal
   put the number of bytes of sWaBuffer into tTotal
   if pCount >= tTotal then
      put empty into sWaBuffer
   else
      put byte (pCount + 1) to tTotal of sWaBuffer into sWaBuffer
   end if
end waHttpConsume

private command waStreamIdleGone pWhat
   -- A STREAM NOTHING WAS WAITING ON is not a failure of anything. The
   -- Electrum stream is kept open between requests (waNetStart, 2026-09-03)
   -- and a server is entitled to drop a quiet client; before the reuse this
   -- could not happen, because a stream was closed the moment its one reply
   -- landed. Forget the handle so the next request dials again, count
   -- nothing, and say so in the log.
   if sWaStream is not empty then
      waLog "the idle stream " & sWaStream & " " & pWhat & \
            "; the next request will dial again"
   end if
   waStreamClose
end waStreamIdleGone

private command waStreamClosed
   local tBody, tSeen
   if sWaInFlight is empty then
      waStreamIdleGone "was closed by the server"
      exit waStreamClosed
   end if
   if waIsElectrum(sWaBackend) then
      waNetFail "the Electrum server closed the connection before answering."
      exit waStreamClosed
   end if
   -- NOTHING ARRIVED is a circuit that failed, not a reply that is malformed,
   -- and the HTTP parser's "no header/body boundary in 0 bytes" said the
   -- second when the first was true. Named for what it is; waNetFail retries
   -- it once like any other transport failure.
   if sWaHttpPhase is "head" and sWaBuffer is empty then
      waNetFail "the Tor stream closed before the server sent anything " & \
            "(the circuit failed)."
      exit waStreamClosed
   end if
   -- A reply with no framing ends here, the way every reply did until
   -- 2026-09-03. The server has closed, so the handle is simply forgotten.
   if sWaHttpPhase is "close" then
      put sWaHttpBody into tBody
      put empty into sWaHttpBody
      put "head" into sWaHttpPhase
      put empty into sWaStream
      put empty into sWaStreamTo
      if sWaHttpBad is not "" then
         waNetFail waHttpBadWhy(tBody)
         exit waStreamClosed
      end if
      waNetDeliver tBody
      exit waStreamClosed
   end if
   -- the two lengths into locals first: `the number of bytes of X & "..."`
   -- binds the concatenation into the chunk target (engine notes)
   put the number of bytes of sWaBuffer into tSeen
   if sWaHttpPhase is "head" then
      waNetFail "the backend's reply has no header/body boundary in " & \
            tSeen & " bytes."
      exit waStreamClosed
   end if
   put the number of bytes of sWaHttpBody into tSeen
   waNetFail "the Tor stream closed in the middle of a framed reply (" & \
         sWaHttpPhase & ", " & tSeen & " body bytes so far)."
end waStreamClosed

private command waHttpCheckStatus pStatus
   -- This is a network buffer. `char` and `line` are Unicode- and
   -- delimiter-aware, and the family rule is that binary is indexed with
   -- `byte` and nothing else. (waHttpBody, which split a whole HTTP/1.0
   -- reply at the blank line, stood here until 2026-09-03; waHttpFeed
   -- decodes a reply as it arrives now, and this is the half it kept.)
   local tCode
   if byte 1 to 4 of pStatus is not "HTTP" then
      throw "that is not an HTTP reply."
   end if
   put byte 10 to 12 of pStatus into tCode
   if tCode is not "200" and tCode is not "201" then
      -- HELD, NOT THROWN: the body is where the reason is. Esplora answers a
      -- refused broadcast with 400 and the node's own words in the body
      -- (bad-txns-inputs-missingorspent, insufficient fee...), and the
      -- 2026-09-03 evening log showed "400 Bad Request / Server: openresty /
      -- Date:" and nothing a person could act on. The decoder reads the
      -- body as it would any other, and the done branch refuses with it.
      put cwTrim(byte 1 to 60 of pStatus) into sWaHttpBad
      put "" into tCode
   end if
end waHttpCheckStatus

private function waHttpBadWhy pBody
   -- The refusal a held status line becomes once its body is in.
   local tWhy, tBody
   put "the backend answered " & sWaHttpBad into tWhy
   put cwTrim(byte 1 to 240 of pBody) into tBody
   if tBody is not "" then
      put ": " & tBody after tWhy
   else
      put "." after tWhy
   end if
   put "" into sWaHttpBad
   return tWhy
end waHttpBadWhy

function waElectrumRequest pRec
   -- JSON-RPC 2.0, one object per line. Addresses never leave this wallet on
   -- this protocol: the server is asked about SCRIPT HASHES, which is the one
   -- genuine privacy difference between the two backends.
   local tKind, tArg, tScript, tHash, tI, tCount, tOut
   put pRec["kind"] into tKind
   put pRec["arg"] into tArg
   if tKind is "batch" then
      -- the members' own requests, in one JSON array; the members are the
      -- ones the pump gathered (sWaBatchMembers), not carried in the record,
      -- so a record stays the small thing the retry path copies around
      put cwListCount(sWaBatchMembers) into tCount
      put "[" into tOut
      repeat with tI = 1 to tCount
         if tI > 1 then
            put "," after tOut
         end if
         put waElectrumRequest(sWaBatchMembers[tI]) after tOut
      end repeat
      return tOut & "]"
   end if
   if tKind is "tip" then
      return "{" & cwJsonString2("jsonrpc") & ":" & cwJsonString2("2.0") & "," & \
            cwJsonString2("id") & ":" & pRec["id"] & "," & \
            cwJsonString2("method") & ":" & cwJsonString2("blockchain.headers.subscribe") & \
            "," & cwJsonString2("params") & ":[]}"
   end if
   if tKind is "fees" then
      return "{" & cwJsonString2("jsonrpc") & ":" & cwJsonString2("2.0") & "," & \
            cwJsonString2("id") & ":" & pRec["id"] & "," & \
            cwJsonString2("method") & ":" & cwJsonString2("blockchain.estimatefee") & \
            "," & cwJsonString2("params") & ":[6]}"
   end if
   if tKind is "utxos" or tKind is "history" then
      put cwScriptForAddress(sWaNetwork, tArg) into tScript
      put cwElectrumScripthash(tScript) into tHash
      if tKind is "utxos" then
         return "{" & cwJsonString2("jsonrpc") & ":" & cwJsonString2("2.0") & "," & \
               cwJsonString2("id") & ":" & pRec["id"] & "," & \
               cwJsonString2("method") & ":" & \
               cwJsonString2("blockchain.scripthash.listunspent") & "," & \
               cwJsonString2("params") & ":[" & cwJsonString2(tHash) & "]}"
      end if
      return "{" & cwJsonString2("jsonrpc") & ":" & cwJsonString2("2.0") & "," & \
            cwJsonString2("id") & ":" & pRec["id"] & "," & \
            cwJsonString2("method") & ":" & \
            cwJsonString2("blockchain.scripthash.get_history") & "," & \
            cwJsonString2("params") & ":[" & cwJsonString2(tHash) & "]}"
   end if
   if tKind is "tx" then
      return "{" & cwJsonString2("jsonrpc") & ":" & cwJsonString2("2.0") & "," & \
            cwJsonString2("id") & ":" & pRec["id"] & "," & \
            cwJsonString2("method") & ":" & \
            cwJsonString2("blockchain.transaction.get") & "," & \
            cwJsonString2("params") & ":[" & cwJsonString2(tArg) & "]}"
   end if
   if tKind is "broadcast" then
      return "{" & cwJsonString2("jsonrpc") & ":" & cwJsonString2("2.0") & "," & \
            cwJsonString2("id") & ":" & pRec["id"] & "," & \
            cwJsonString2("method") & ":" & \
            cwJsonString2("blockchain.transaction.broadcast") & "," & \
            cwJsonString2("params") & ":[" & cwJsonString2(tArg) & "]}"
   end if
   throw "unknown request kind " & tKind & "."
end waElectrumRequest

private command waElectrumMaybeComplete
   -- One JSON object per line: an answer is complete at a newline. Sliced in
   -- BYTES for the same reason waHttpBody is - offset() answers in bytes and
   -- the slice must agree with it.
   --
   -- EVERY line, and the remainder is KEPT. This took the first line and
   -- emptied the buffer, which was fine while a stream carried one reply and
   -- was closed. On the stream that is now kept open between requests the
   -- server can push a headers.subscribe notification at any moment, so one
   -- chunk can hold "notification LF reply LF" - and taking the first line
   -- and dropping the rest would have dropped the REPLY, into a deadline and
   -- a retry, over a block arriving. waNetDeliver ignores the notification
   -- and applies the reply in whichever order they came.
   local tPos, tLine, tLen
   repeat forever
      put offset(numToChar(10), sWaBuffer) into tPos
      if tPos is 0 then
         exit repeat
      end if
      put byte 1 to (tPos - 1) of sWaBuffer into tLine
      put the number of bytes of sWaBuffer into tLen
      if tPos < tLen then
         put byte (tPos + 1) to tLen of sWaBuffer into sWaBuffer
      else
         put empty into sWaBuffer
      end if
      waNetDeliver tLine
   end repeat
end waElectrumMaybeComplete

private function waIsNotification pBody
   -- JSON-RPC with a method and no id: a server-initiated message. Anything
   -- that does not parse answers false and is left for waNetApply to refuse
   -- with its own, better sentence.
   local tNode, tError, tId, tMethod, tText
   -- decoded the way waNetApply decodes it, so the two never disagree about
   -- what a body says
   put pBody into tText
   try
      put textDecode(pBody, "UTF-8") into tText
   catch tError
      put pBody into tText
   end try
   try
      put cwJsonParse(cwTrim(tText)) into tNode
   catch tError
      return false
   end try
   put cwJsonPath(tNode, "id") into tId
   put cwJsonPath(tNode, "method") into tMethod
   if cwJsonType(tId) is not "missing" and cwJsonType(tId) is not "null" then
      return false
   end if
   return cwJsonType(tMethod) is not "missing"
end waIsNotification

command waNetDeliver pBody
   -- One answer, whichever transport brought it. Parsed by kind, folded into
   -- the wallet's state, then the next request starts on the next tick.
   local tRec, tKind, tError, tNode, tOut, tSeen, tArg, tLen, tTail
   set the defaultStack to the short name of this stack
   -- A NOTIFICATION IS NOT AN ANSWER, and it must not be consumed as one.
   -- blockchain.headers.subscribe is a SUBSCRIPTION: the server answers once
   -- with the tip and then pushes a new header on every block, with no id,
   -- for the life of the connection. Handing that to waNetApply while a
   -- request was in flight threw "no id while request N was in flight", which
   -- waNetFail turned into a torn-down socket, a failure count and a retry -
   -- for the request the notification had nothing to do with. It is logged
   -- and dropped here, BEFORE the in-flight record is touched, so the real
   -- answer arrives on the next line into a wallet still waiting for it.
   if waIsElectrum(sWaBackend) and waIsNotification(pBody) then
      waLog "<- notification (no id) from the server, ignored"
      exit waNetDeliver
   end if
   put sWaInFlight into tRec
   if tRec is empty then
      exit waNetDeliver
   end if
   put tRec["kind"] into tKind
   put empty into sWaInFlight
   -- The stream, on either Tor transport, is KEPT for the next request
   -- (waNetStart) since 2026-09-03; it was closed here before, which is what
   -- made every request a new rendezvous. An Esplora reply that cannot be
   -- kept (no framing, or Connection: close) is forgotten by waHttpFeed and
   -- waStreamClosed, not here.
   put the number of chars of pBody into tSeen
   put tRec["arg"] into tArg
   if tKind is "broadcast" then
      -- The argument IS the raw transaction, already on the "->" line
      -- above; echoing it again made the 2026-09-03 log's broadcast reply a
      -- 600-character line that hid the one number on it.
      put the number of chars of tArg into tLen
      put "(a " & tLen & "-hex-char transaction)" into tArg
   end if
   waLog "<- " & tKind & " " & tArg & " (" & tSeen & " chars)"
   -- ONE ANSWER DOES NOT MAKE A SYNC. This cleared the failure state on every
   -- reply, so a scan in which one address's request timed out or was refused
   -- went green on the next address that answered - and the wallet then
   -- reported a balance that was simply missing whatever that address holds.
   -- A number that is quietly incomplete is the failure mode this member
   -- keeps re-learning: "you have nothing" and "you have less than you have"
   -- are both wrong answers that look like working software.
   -- AND THE PILL IS THE STATE, NOT JUST THE SENTENCE. Preserving sWaNetWhy
   -- while still writing "ok" left the indicator that is visible on EVERY
   -- screen green over a sync that lost requests, with the explanation only
   -- on the Network screen. "partial" is its own value so the pill, the rail
   -- and the Network screen all say the same thing.
   if sWaSyncFailures is 0 then
      put "ok" into sWaNetState
      put "" into sWaNetWhy
   else
      put "partial" into sWaNetState
   end if
   try
      -- THE REQUEST ID GOES WITH IT. On Electrum it is the only correlation
      -- there is; see waNetApply.
      waNetApply tKind, tRec["arg"], pBody, tRec["id"]
   catch tError
      waNetFail "could not read the answer to " & tKind & ": " & tError
      exit waNetDeliver
   end try
   if there is a field "nw_out" then
      -- THE FIELD'S CONTENTS GO INTO A LOCAL FIRST. `field "nw_out" & tKind`
      -- binds the concatenation into the CHUNK TARGET, so what is being asked
      -- for is a field whose NAME is the whole log line - which is not a
      -- field, and is not what this line means. waStreamOpened carries the
      -- same note beside a Content-Length and settles it the same way; this
      -- site and the two below were written before that note existed. All
      -- three are places where the wrong answer is silent: a log that never
      -- grows, a signed-message panel missing the message it signed, and a
      -- clipboard copy of a field name.
      -- And the tail of the body FIRST (2026-09-03): this concatenated a
      -- two-megabyte history onto the field's text and then kept 6000 chars.
      put char -6000 to -1 of pBody into tTail
      put field "nw_out" into tOut
      put char -6000 to -1 of (tOut & tKind && tRec["arg"] & return & \
            tTail & return & return) into field "nw_out"
   end if
   -- PAINT WHEN THERE IS SOMETHING TO SHOW, not on every reply. A sync of
   -- fifty replies repainted the whole screen fifty times, each a rebuild
   -- of the visible table from every row and a walk of every coin and
   -- history row for the balances. The screen is painted when the queue
   -- drains - the sync is done, or a lone request answered - and at most
   -- once a second while it is still going, so a person watching still
   -- sees it fill in; the rail's balance is cheap and painted every time.
   if cwListCount(sWaQueue) is 0 or the milliseconds - sWaLastPaint > 1000 then
      put the milliseconds into sWaLastPaint
      waRefreshAll
   else
      waRecomputeBalance
      waPaintNav
   end if
   -- THE NEXT REQUEST GOES NOW, not on the next tick. The pump ran only
   -- from the 250 ms timer, so every reply cost up to a quarter of a second
   -- of nothing before the next request left - seconds of pure waiting
   -- across a sync. Deferred by one event-loop turn rather than called
   -- here, because this handler runs inside the transport's own read
   -- callback and a write from inside a read is a shape this engine has
   -- not been asked to prove.
   if sWaInFlight is empty and cwListCount(sWaQueue) > 0 then
      send "waPumpNow" to me in 0 milliseconds
   end if
end waNetDeliver

command waPumpNow
   -- The tick's pump, without waiting for the tick (waNetDeliver).
   set the defaultStack to the short name of this stack
   local tError
   try
      waNetPump
   catch tError
      waLog "pump error: " & tError
   end try
end waPumpNow

private command waElectrumApply pKind, pArg, pNode
   -- One Electrum RESULT, by kind. The single-reply path reaches here after
   -- its id and error checks; a batch reaches here once per member.
   local tText
   if pKind is "tip" then
      put waCheckedHeight(cwJsonGet(pNode, "height"), "Electrum") \
            into sWaTipHeight
      put the milliseconds into sWaTipAt
      exit waElectrumApply
   end if
   if pKind is "fees" then
      -- Electrum's estimatefee answers in BTC per kilobyte, which is a
      -- different unit from everything else on this screen; converting it
      -- here rather than at each use is what keeps sat/vB meaning sat/vB.
      -- EXPANDED FIRST. estimatefee answers in BTC per kilobyte, which
      -- for any realistic fee is small enough that a server's serializer
      -- writes it with an exponent ("4.22e-06"), and the strict amount
      -- parser refuses that - correctly, but the reply was good and the
      -- sync stopped on it.
      -- A FEE ESTIMATE IS A FLOAT ON THE WIRE, and this is what a float
      -- looks like: the 2026-09-02 engine log carries the real reply
      -- {"result":0.0026374400000000004} - electrs computing 263744/1e8
      -- in IEEE doubles and serialising every digit. cwBtcToSat refuses
      -- more than eight decimals, correctly, because for an AMOUNT a ninth
      -- decimal is money that does not exist; for a RATE it is noise a
      -- thousandth of a satoshi wide, and refusing it failed the fees
      -- request on every Electrum sync, marked each one partial, and left
      -- the Send screen on its default rate. cwExpandExponent had already
      -- met the other float artefact (1e-05); this is the second.
      put waRateTo8Decimals(cwExpandExponent(cwJsonText(pNode))) into tText
      if tText is not "" and tText is a number and tText > 0 then
         -- through the same gate as Esplora's, so the two transports
         -- cannot disagree about what a believable rate is
         waSetSuggestedRate "6", cwCeilDiv(cwBtcToSat(tText), 1000)
         waSetSuggestedRate "1", sWaFeeRates["6"]
         put the milliseconds into sWaFeesAt
      end if
      exit waElectrumApply
   end if
   if pKind is "utxos" then
      waCheckList pNode, "unspent-output"
      waMergeUtxos pArg, pNode, "electrum"
      exit waElectrumApply
   end if
   if pKind is "history" then
      waCheckList pNode, "history"
      waMergeHistory pArg, pNode, "electrum"
      waFollowHistory pArg, pNode, "electrum"
      exit waElectrumApply
   end if
   if pKind is "broadcast" then
      put waCheckedTxid(cwTrim(cwJsonText(pNode)), "Electrum") into tText
      -- In the log as well as on the status line: the 2026-09-03 log's
      -- only record of its broadcast's txid was the fee-bump bookkeeping
      -- line, and the status line is not what gets pasted back.
      waLog "broadcast accepted: txid " & tText
      waNoteBroadcast pArg, tText
      uiStatus "Broadcast. The server returned txid " & tText & ".", "ok"
      exit waElectrumApply
   end if
   if pKind is "tx" then
      -- blockchain.transaction.get answers the hex as a JSON string. This
      -- branch had no case for it: the request existed, the reply fell
      -- off the end of the dispatch and was silently dropped.
      waStoreRawTx pArg, cwJsonText(pNode)
      exit waElectrumApply
   end if
   exit waElectrumApply
end waElectrumApply

private command waBatchApply pNode
   -- The array a batch is answered with: every element to its member by id.
   -- A member the server left unanswered is asked again on its own; an
   -- element nobody asked for is ignored and said so.
   local tI, tCount, tItem, tIdNode, tId, tByOwner, tIdx, tRec, tResult
   local tMembers, tSeen, tWhy, tLeft
   put sWaBatchMembers into tMembers
   put empty into sWaBatchMembers
   if cwJsonType(pNode) is not "array" then
      put cwJsonPath(pNode, "error") into tResult
      if cwJsonType(tResult) is not "missing" and cwJsonType(tResult) is not "null" then
         put cwJsonGet(tResult, "message") into tWhy
      else
         put "a " & cwJsonType(pNode) & " rather than an array" into tWhy
      end if
      waBatchSplit tMembers, tWhy
      exit waBatchApply
   end if
   put cwListCount(tMembers) into tCount
   repeat with tI = 1 to tCount
      put tMembers[tI] into tRec
      put tI into tByOwner[tRec["id"]]
   end repeat
   put empty into tSeen
   put cwJsonCount(pNode) into tCount
   repeat with tI = 1 to tCount
      put cwJsonAt(pNode, tI) into tItem
      put cwJsonPath(tItem, "id") into tIdNode
      put cwJsonText(tIdNode) into tId
      put tByOwner[tId] into tIdx
      if tIdx is empty then
         waLog "batch: an answer for id " & tId & ", which is not in this " & \
               "batch; ignored"
         next repeat
      end if
      put "true" into tSeen[tId]
      put tMembers[tIdx] into tRec
      put cwJsonPath(tItem, "error") into tResult
      if cwJsonType(tResult) is not "missing" and cwJsonType(tResult) is not "null" then
         waBatchMemberFailed tRec, cwJsonGet(tResult, "message")
         next repeat
      end if
      try
         waElectrumApply tRec["kind"], tRec["arg"], cwJsonPath(tItem, "result")
      catch tWhy
         waBatchMemberFailed tRec, tWhy
      end try
   end repeat
   put waEmptyList() into tLeft
   put cwListCount(tMembers) into tCount
   repeat with tI = 1 to tCount
      put tMembers[tI] into tRec
      if tSeen[tRec["id"]] is not "true" then
         put cwListAdd(tLeft, tRec) into tLeft
      end if
   end repeat
   if cwListCount(tLeft) > 0 then
      waLog "batch: " & cwListCount(tLeft) & " member(s) went unanswered; " & \
            "asking for them one at a time"
      waRequeueSingly tLeft
   end if
end waBatchApply

private command waBatchMemberFailed pRec, pWhy
   -- One member of a batch refused or unreadable: counted like a lone
   -- request's second failure, because there is no transport to retry.
   add 1 to sWaSyncFailures
   put "partial" into sWaNetState
   put pRec["kind"] & " " & pRec["arg"] & ": " & pWhy & " (this sync is " & \
         "incomplete: a balance missing one address's coins is a wrong " & \
         "number, not a smaller one)" into sWaNetWhy
   waLog "FAILED: " & pRec["kind"] & " " & pRec["arg"] & ": " & pWhy
end waBatchMemberFailed

command waBatchSplit pMembers, pWhy
   -- The server did not take the batch: put the members back at the front
   -- in their order and try HALF as many on the next line. Not a failure of
   -- anything - nothing has been lost yet. Halving rather than giving up is
   -- the ninth engine log's lesson (2026-09-03): an onion server closed the
   -- connection on a batch of 22 and the sync fell to 41 single requests,
   -- each a Tor round trip, when a smaller line might have gone through -
   -- ElectrumX caps the SIZE of a line, and 22 histories of a busy wallet
   -- can be over it where 11 are not. When the half would be one, batching
   -- is off for this server, as before.
   local tN, tCap
   put cwListCount(pMembers) into tN
   put cwIntDiv(tN, 2) into tCap
   if tCap < 2 then
      put "false" into sWaBatch
      waLog "the server did not take a batch of " & tN & " (" & pWhy & \
            "); asking one at a time from now on"
   else
      put tCap into sWaBatchCap
      waLog "the server did not take a batch of " & tN & " (" & pWhy & \
            "); trying " & tCap & " at a time"
   end if
   waRequeueSingly pMembers
end waBatchSplit

private function waBatchCap
   -- How many requests the next batch may carry: the constant until a
   -- refusal, then whatever the refusals have halved it to.
   if sWaBatchCap is an integer and sWaBatchCap >= 1 then
      return sWaBatchCap
   end if
   return kWaBatchSize
end waBatchCap

private command waRequeueSingly pMembers
   local tOut, tI, tCount
   put waEmptyList() into tOut
   put cwListCount(pMembers) into tCount
   repeat with tI = 1 to tCount
      put cwListAdd(tOut, pMembers[tI]) into tOut
   end repeat
   put cwListCount(sWaQueue) into tCount
   repeat with tI = 1 to tCount
      put cwListAdd(tOut, sWaQueue[tI]) into tOut
   end repeat
   put tOut into sWaQueue
end waRequeueSingly

private command waNetApply pKind, pArg, pBody, pId
   -- pBody arrives as BYTES from every transport. Decoding it here, once, is
   -- what lets everything below treat it as text - and UTF-8 is what both
   -- protocols say their JSON is. textDecode on this engine is LOSSY rather
   -- than throwing (docs/OXT-ENGINE-NOTES: six shipped parsers once believed
   -- otherwise), so nothing here treats a clean decode as proof of anything;
   -- the JSON parser refuses malformed input on its own.
   local tNode, tI, tCount, tItem, tRec, tList, tKey, tText, tResult, tError
   local tIdNode, tGotId
   put pBody into tText
   try
      put textDecode(pBody, "UTF-8") into tText
   catch tError
      put pBody into tText
   end try
   put cwTrim(tText) into tText
   if waIsElectrum(sWaBackend) then
      put cwJsonParse(tText) into tNode
      -- THE ID IS THE CORRELATION, AND ON A REUSED CONNECTION IT IS THE ONLY
      -- ONE. Every request this wallet sends carries an id, and until this
      -- check no reply was ever asked for one - so the field existed to
      -- correlate answers and correlated nothing.
      --
      -- It matters most on electrum-clear, where ONE socket serves the whole
      -- sync. Two well-formed things arrive on it that are not the answer to
      -- the request in flight. A late answer to a request that already timed
      -- out: read as the current one, so one address's coins are written
      -- under another's - and waMergeUtxos REPLACES, so the second address's
      -- real coins go with it. And a NOTIFICATION: the "tip" request is
      -- blockchain.headers.subscribe, which SUBSCRIBES, so a real server
      -- pushes a header object down the same socket at every block. A
      -- notification carries a method and no id and no result, so it parses
      -- cleanly, yields an empty result, and empties an address that is not
      -- empty.
      --
      -- Refuse both, by name. Esplora gets this from the URL it issued and
      -- the Tor stream from its handle; here it is this field or nothing.
      -- A BATCH IS AN ARRAY OF ANSWERS (2026-09-03), each carrying the id
      -- of the member it answers; anything else back to a batch is a server
      -- that does not take one, and the members are asked singly from then
      -- on. A member's own error is that member's failure, not the sync's.
      if pKind is "batch" then
         waBatchApply tNode
         exit waNetApply
      end if
      put cwJsonPath(tNode, "id") into tIdNode
      put cwJsonText(tIdNode) into tGotId
      if cwJsonType(tIdNode) is "missing" or cwJsonType(tIdNode) is "null" then
         throw "the server sent a message with no id while request " & pId & \
               " was in flight. That is a notification, not an answer, and " & \
               "this wallet does not act on one."
      end if
      if tGotId is not pId then
         throw "the server answered request " & tGotId & " while request " & \
               pId & " was in flight, so that reply answers a different " & \
               "question and has been discarded."
      end if
      put cwJsonPath(tNode, "error") into tResult
      if cwJsonType(tResult) is not "missing" and cwJsonType(tResult) is not "null" then
         throw "the Electrum server refused: " & cwJsonGet(tResult, "message")
      end if
      waElectrumApply pKind, pArg, cwJsonPath(tNode, "result")
      exit waNetApply
   end if
   -- Esplora
   -- THE SHAPE OF THE ANSWER IS CHECKED, because on the clearnet transport
   -- there is no status code to check. `load URL` reports "cached" for a 404
   -- or a 405 exactly as it does for a 200: the error PAGE is delivered as
   -- the body. The JSON kinds below are protected by the parser refusing
   -- malformed input; the two that take bare text are not, and a chain tip
   -- of "<!DOCTYPE html>" would sit on the rail looking like a height.
   if pKind is "tip" then
      put waCheckedHeight(tText, "Esplora") into sWaTipHeight
      put the milliseconds into sWaTipAt
      exit waNetApply
   end if
   if pKind is "fees" then
      -- CHECKED BEFORE IT IS BELIEVED. These two numbers become the default
      -- fee rate on the Send screen, so an unchecked one is a backend setting
      -- what this wallet proposes to spend. The Electrum branch above already
      -- tested `is a number` and `> 0`; this one wrote whatever came back,
      -- including a JSON string, a negative, or nothing at all. Keeping the
      -- previous value on a bad answer is the fail-closed direction: a stale
      -- estimate is wrong by a little, an unchecked one by any amount.
      put cwJsonParse(tText) into tNode
      waSetSuggestedRate "1", cwJsonGet(tNode, "1")
      waSetSuggestedRate "6", cwJsonGet(tNode, "6")
      put the milliseconds into sWaFeesAt
      exit waNetApply
   end if
   if pKind is "utxos" then
      put cwJsonParse(tText) into tNode
      waCheckList tNode, "unspent-output"
      waMergeUtxos pArg, tNode, "esplora"
      exit waNetApply
   end if
   if pKind is "history" then
      put cwJsonParse(tText) into tNode
      waCheckList tNode, "history"
      waMergeHistory pArg, tNode, "esplora"
      waFollowHistory pArg, tNode, "esplora"
      exit waNetApply
   end if
   if pKind is "tx" then
      waStoreRawTx pArg, tText
      exit waNetApply
   end if
   if pKind is "broadcast" then
      -- A txid is 32 bytes of hex and nothing else. Reporting a success the
      -- backend did not give is the failure this whole block exists to stop.
      get waCheckedTxid(tText, "Esplora")
      waLog "broadcast accepted: txid " & tText
      waNoteBroadcast pArg, tText
      uiStatus "Broadcast. The backend returned txid " & tText & ".", "ok"
      exit waNetApply
   end if
end waNetApply

command waMergeUtxos pAddress, pNode, pShape
   -- Replace every coin at this address with what the backend just said, and
   -- leave every other address alone. Replacing rather than merging is what
   -- makes a spent coin disappear; merging would leave the wallet claiming a
   -- balance it no longer has.
   local tList, tI, tCount, tRec, tItem, tHeight, tConf, tKey
   put waEmptyList() into tList
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      if tRec["address"] is not pAddress then
         put cwListAdd(tList, tRec) into tList
      end if
   end repeat
   put cwJsonCount(pNode) into tCount
   repeat with tI = 1 to tCount
      put cwJsonAt(pNode, tI) into tItem
      put "" into tRec
      put pAddress into tRec["address"]
      if pShape is "electrum" then
         put cwJsonGet(tItem, "tx_hash") into tRec["txid"]
         put cwJsonGet(tItem, "tx_pos") + 0 into tRec["vout"]
         put cwJsonGet(tItem, "value") + 0 into tRec["value"]
         put cwJsonGet(tItem, "height") into tHeight
         if tHeight is not "" and tHeight + 0 > 0 and sWaTipHeight is not "" then
            put sWaTipHeight - tHeight + 1 into tConf
         else
            put 0 into tConf
         end if
         put tConf into tRec["confirmations"]
         put tHeight into tRec["height"]
      else
         put cwJsonGet(tItem, "txid") into tRec["txid"]
         put cwJsonGet(tItem, "vout") + 0 into tRec["vout"]
         put cwJsonGet(tItem, "value") + 0 into tRec["value"]
         put cwJsonGet(tItem, "status/block_height") into tHeight
         if tHeight is not "" and sWaTipHeight is not "" then
            put sWaTipHeight - tHeight + 1 into tConf
         else
            put 0 into tConf
         end if
         put tConf into tRec["confirmations"]
         put tHeight into tRec["height"]
      end if
      -- THE BACKEND'S WORD OUTRANKS THE WALLET'S MEMORY. A coin still listed
      -- as unspent after this wallet broadcast a spend of it means the
      -- backend has no such spend (dropped, or never seen), and holding the
      -- coin back would hide money the network says is there - so the mark
      -- comes off, and the log names the transaction it was.
      put tRec["txid"] & ":" & tRec["vout"] into tKey
      if sWaSpentBy[tKey] is not "" then
         waLog "the backend still lists " & tKey & " as unspent, which " & \
               sWaSpentBy[tKey] & " spent when it was broadcast; offering it again"
         put "" into sWaSpentBy[tKey]
      end if
      put cwListAdd(tList, tRec) into tList
   end repeat
   put tList into sWaUtxos
end waMergeUtxos

command waFollowHistory pAddress, pNode, pShape
   -- THE SECOND QUESTION IS ASKED ONLY WHEN THE FIRST SAID THERE IS ONE.
   -- A non-empty history queues the unspent-output request for this address;
   -- an empty one does not, and instead REPLACES whatever unspent rows this
   -- address had with none - the same call the utxos reply would have made,
   -- given an empty list - because a re-sync keeps the last sync's coins
   -- until each address answers, and an address whose history has gone
   -- empty (a re-org that took the funding transaction with it) would
   -- otherwise keep a coin the chain no longer has.
   if cwJsonCount(pNode) > 0 then
      waNetQueue "utxos", pAddress
   else
      waMergeUtxos pAddress, pNode, pShape
   end if
end waFollowHistory

command waStoreRawTx pTxid, pHex
   -- The raw bytes of one transaction, onto every history row that carries
   -- its txid (a transaction touching two of this wallet's addresses has two
   -- rows), and into the Inspect panel if that is what was waiting for them.
   -- The txid is CHECKED against the bytes: a backend that answered a
   -- different transaction, or a stale reply landing under a fresh request,
   -- would otherwise be inspected as the one that was asked for.
   local tHex, tTx, tI, tCount, tRec, tHit
   set the defaultStack to the short name of this stack
   put cwLower(cwTrim(pHex)) into tHex
   if not cwHexIsClean(tHex) then
      throw "the backend answered the raw-transaction request with " & \
            "something that is not hex: " & char 1 to 80 of tHex
   end if
   put cwTxDecode(tHex) into tTx
   if tTx["txid"] is not cwLower(pTxid) then
      throw "the backend answered the request for " & pTxid & " with the " & \
            "bytes of " & tTx["txid"] & ", which is a different transaction."
   end if
   put 0 into tHit
   put cwListCount(sWaHistory) into tCount
   repeat with tI = 1 to tCount
      put sWaHistory[tI] into tRec
      if tRec["txid"] is cwLower(pTxid) then
         put tHex into tRec["raw"]
         put tRec into sWaHistory[tI]
         add 1 to tHit
      end if
   end repeat
   waLog "stored the bytes of " & pTxid & " on " & tHit & " history row(s)"
   if sWaInspectWanted is cwLower(pTxid) then
      put empty into sWaInspectWanted
      put waInspectRaw(tHex) into field "hs_detail"
      uiStatus "The bytes of " & pTxid & " arrived.", "ok"
   end if
end waStoreRawTx

command waMergeHistory pAddress, pNode, pShape
   -- Replace every history row for this address, on the same reasoning
   -- waMergeUtxos gives: the backend's answer is the whole truth about this
   -- address, and merging would leave rows a re-org or a replacement has
   -- taken away. Rows are keyed by txid AND address, so one transaction
   -- touching two of this wallet's addresses appears once per address -
   -- which is what makes waUsedAddresses right, and is why the History
   -- screen de-duplicates by txid when it paints.
   local tList, tI, tCount, tRec, tItem, tHeight, tConf
   put waEmptyList() into tList
   put cwListCount(sWaHistory) into tCount
   repeat with tI = 1 to tCount
      put sWaHistory[tI] into tRec
      if tRec["address"] is not pAddress then
         put cwListAdd(tList, tRec) into tList
      end if
   end repeat
   put cwJsonCount(pNode) into tCount
   repeat with tI = 1 to tCount
      put cwJsonAt(pNode, tI) into tItem
      put "" into tRec
      put pAddress into tRec["address"]
      if pShape is "electrum" then
         put cwJsonGet(tItem, "tx_hash") into tRec["txid"]
         put cwJsonGet(tItem, "height") into tHeight
      else
         put cwJsonGet(tItem, "txid") into tRec["txid"]
         put cwJsonGet(tItem, "status/block_height") into tHeight
         -- Esplora says what a transaction paid and weighed; Electrum's
         -- history does not, and a child-pays-for-parent bump (waCpfpBuild)
         -- needs both, so they are kept where they are offered (2026-09-04)
         put cwJsonGet(tItem, "fee") into tRec["fee"]
         if cwJsonGet(tItem, "weight") is an integer then
            put cwCeilDiv(cwJsonGet(tItem, "weight"), 4) into tRec["vsize"]
         end if
      end if
      if tHeight is not "" and tHeight + 0 > 0 and sWaTipHeight is not "" then
         put sWaTipHeight - tHeight + 1 into tConf
      else
         put 0 into tConf
      end if
      put tConf into tRec["confirmations"]
      put tHeight into tRec["height"]
      put cwListAdd(tList, tRec) into tList
   end repeat
   put tList into sWaHistory
end waMergeHistory

command waBroadcast
   if sWaLastRaw is empty then
      throw "there is nothing signed to broadcast. Build and sign on this " & \
            "screen first, or finalize a PSBT on Tools."
   end if
   if sWaBackend is "offline" then
      throw "this wallet is offline, which is a choice and not a failure. " & \
            "Copy the raw transaction and push it from a machine that is on " & \
            "a network - the signature is already valid."
   end if
   waNetQueue "broadcast", sWaLastRaw
   -- RESERVED AT QUEUE TIME, not at acceptance. The 2026-09-03 evening run
   -- queued a fee bump, then built a silent payment and a commit funding on
   -- the ORIGINAL's change while the bump was still behind Tor - and the
   -- bump's acceptance voided that change, so both were refused by every
   -- node. A transaction this wallet has handed to the network is its own
   -- word about its coins from that moment; if the backend refuses it,
   -- waNetFail hands the coins back (waUnnoteBroadcast).
   waNoteBroadcast sWaLastRaw, ""
   waEnsurePolling
   uiStatus "Queued the broadcast to " & sWaHost & ".", ""
end waBroadcast

-- ---- the engine's socket messages --------------------------------------------
--
-- socketError, socketClosed and socketTimeout are the ENGINE's names, and a
-- script may define each of them exactly once. This stack carries OnionXT,
-- which needs all three, so the stack defines them and hands each event to
-- OnionXT's named function first; tools/sync-demo-embeds.py drops OnionXT's
-- own thin wrappers from the embed and asserts that both halves of that
-- arrangement are present.
--
-- The trailing `pass` is mandatory. Swallowing a socket message that belongs
-- to something else is a silent HANG, not an error, and no gate can see it.

on socketError pSocketID, pError
   -- OURS FIRST, then OnionXT's, then pass. The wallet now owns a socket of
   -- its own (the clearnet Electrum transport), and a socket nobody claims
   -- must still reach whatever else is listening.
   local tError
   if pSocketID is sWaSock then
      set the defaultStack to the short name of this stack
      put empty into sWaSock
      waNetFail "the connection to " & pSocketID & " failed: " & pError
      exit socketError
   end if
   try
      if oxSocketError(pSocketID, pError) is true then
         exit socketError
      end if
   catch tError
   end try
   pass socketError
end socketError

on socketClosed pSocketID
   local tError
   if pSocketID is sWaSock then
      set the defaultStack to the short name of this stack
      put empty into sWaSock
      if sWaInFlight is not empty then
         waNetFail "the Electrum server closed the connection before answering."
      end if
      exit socketClosed
   end if
   try
      if oxSocketClosed(pSocketID) is true then
         exit socketClosed
      end if
   catch tError
   end try
   pass socketClosed
end socketClosed

on socketTimeout pSocketID
   local tError
   if pSocketID is sWaSock then
      set the defaultStack to the short name of this stack
      put empty into sWaSock
      waNetFail "the connection to " & pSocketID & " timed out."
      exit socketTimeout
   end if
   try
      if oxSocketTimeout(pSocketID) is true then
         exit socketTimeout
      end if
   catch tError
   end try
   pass socketTimeout
end socketTimeout

