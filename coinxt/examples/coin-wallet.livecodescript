command waPaintAddresses
   local tChain, tI, tCount, tRec, tRows, tUsed, tBal, tLabel, tTab
   set the defaultStack to the short name of this stack
   put waChainShown() into tChain
   set the hilite of button "ad_receive" to (tChain is 0)
   set the hilite of button "ad_change" to (tChain is 1)
   put waUsedAddresses() into tUsed
   put waBalanceByAddress() into tBal
   put numToChar(9) into tTab
   put "index" & tTab & "address" & tTab & "state" & tTab & "balance" & tTab & \
         "label" & return into tRows
   put cwListCount(sWaAddresses) into tCount
   repeat with tI = 1 to tCount
      put sWaAddresses[tI] into tRec
      if tRec["change"] is not tChain then
         next repeat
      end if
      put sWaLabels[tRec["address"]] into tLabel
      put tRows & tRec["index"] & tTab & tRec["address"] & tTab into tRows
      if tUsed[tRec["address"]] is "true" then
         put "used" after tRows
      else if sWaBackend is "offline" then
         put "unknown" after tRows
      else
         put "unused" after tRows
      end if
      put tTab & waAmount(tBal[tRec["address"]] + 0) & tTab & tLabel & return after tRows
   end repeat
   put tRows into field "ad_table"
   put waAddressesHint(tChain) into field "ad_detail"
end waPaintAddresses

private function waAddressesHint pChain
   if pChain is 1 then
      return "The CHANGE chain. Every transaction that does not spend a coin " & \
            "exactly pays its remainder back to the next unused address here. " & \
            "You never hand these out; they are why a wallet's balance is not " & \
            "the balance of the address somebody paid." & return & \
            "Gap limit " & kWaGapLimit & ": another wallet restoring your seed " & \
            "stops looking after that many unused addresses in a row, which " & \
            "is why skipping past it can hide coins from your own backup."
   end if
   return "The RECEIVE chain: the addresses you hand out. Using a fresh one " & \
         "each time is the single cheapest privacy measure there is - reusing " & \
         "one publishes every payment you have ever received to everybody you " & \
         "give it to." & return & "Select a row and type a label to remember " & \
         "who you gave it to. Labels are kept locally and go in the wallet file."
end waAddressesHint

function waChainShown
   if the uChainShown of this stack is 1 then
      return 1
   end if
   return 0
end waChainShown

private function waBalanceByAddress
   local tI, tCount, tRec, tOut
   put empty into tOut
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      add tRec["value"] to tOut[tRec["address"]]
   end repeat
   return tOut
end waBalanceByAddress

command waAddressesClick pRole
   local tRow, tAddr, tTab, tNode, tI, tRec, tList, tCount
   put numToChar(9) into tTab
   if pRole is "receive" then
      set the uChainShown of this stack to 0
   else if pRole is "change" then
      set the uChainShown of this stack to 1
   else if pRole is "more" then
      waDeriveMore
   else if pRole is "scan" then
      if sWaBackend is "offline" then
         throw "a scan needs a backend. Choose one on the Network screen."
      end if
      waSyncIfIdle
   else if pRole is "setLabel" then
      put waSelectedAddress() into tAddr
      if tAddr is "" then
         throw "select a row first."
      end if
      put waSafeText(field "ad_label") into sWaLabels[tAddr]
      uiStatus "Labelled " & tAddr & ".", "ok"
   end if
   waRefreshScreen
end waAddressesClick

function waSelectedAddress
   -- SAVE, SET, USE, RESTORE. `the itemDelimiter` is global mutable state in
   -- this engine and everything else in this stack assumes the default; a
   -- handler that sets it to tab and walks away leaves every later `item`
   -- expression parsing something else. Restoring it to comma would be a
   -- guess about what the caller had.
   local tLine, tTab, tText, tSaved
   set the defaultStack to the short name of this stack
   put the hilitedLine of field "ad_table" into tLine
   if tLine is empty or tLine < 2 then
      return ""
   end if
   put line tLine of field "ad_table" into tText
   put numToChar(9) into tTab
   put the itemDelimiter into tSaved
   set the itemDelimiter to tTab
   put item 2 of tText into tText
   set the itemDelimiter to tSaved
   return cwTrim(tText)
end waSelectedAddress

command waDeriveMore
   -- Extend both chains by another window. Deliberately explicit rather than
   -- automatic: past the gap limit, an address this wallet derives is one a
   -- wallet restored from the same seed elsewhere will NOT find, and that is
   -- a decision a person should make on purpose.
   local tNode, tI, tCount, tRec, tList, tStart, tJ
   if sWaKind is "key" then
      -- One key is one address per script type. There is no chain to extend,
      -- and waAccountNode would throw about a missing account key, which is
      -- true and says nothing about why the button did not work.
      throw "an imported key has a single address, so there is no chain to " & \
            "extend. Open a seed wallet to derive more."
   end if
   put sWaAddresses into tList
   put cwListCount(tList) into tCount
   put waAccountNode() into tNode
   put waHighestIndex(0) + 1 into tStart
   repeat with tJ = 0 to 1
      put waHighestIndex(tJ) + 1 into tStart
      repeat with tI = tStart to (tStart + kWaPrefill - 1)
         if sWaKind is "multisig" then
            put waMultisigRecord(tJ, tI) into tRec
         else
            put cwAddressAt(tNode, sWaScriptType, sWaNetwork, tJ, tI) into tRec
         end if
         put cwListAdd(tList, tRec) into tList
      end repeat
   end repeat
   put empty into tNode
   put tList into sWaAddresses
   uiStatus "Derived to index " & (tStart + kWaPrefill - 1) & " on both chains. " & \
         "Past the gap limit of " & kWaGapLimit & ", another wallet restoring " & \
         "your seed will not look this far.", "warn"
end waDeriveMore

private function waHighestIndex pChain
   local tI, tCount, tRec, tBest
   put -1 into tBest
   put cwListCount(sWaAddresses) into tCount
   repeat with tI = 1 to tCount
      put sWaAddresses[tI] into tRec
      if tRec["change"] is pChain and tRec["index"] > tBest then
         put tRec["index"] into tBest
      end if
   end repeat
   return tBest
end waHighestIndex

private function waMultisigRecord pChange, pIndex
   local tCosigners, tJ, tCount
   put waEmptyList() into tCosigners
   put cwListCount(sWaCosigners) into tCount
   repeat with tJ = 1 to tCount
      put cwListAdd(tCosigners, cwXKeyDecode(sWaCosigners[tJ], sWaNetwork, \
               "p2wsh")) into tCosigners
   end repeat
   return cwMultisigAddressAt(tCosigners, sWaM, sWaNetwork, pChange, pIndex, true)
end waMultisigRecord

-- ==============================================================================
-- 4. SEND
--
-- The screen where a mistake costs money, so it is built around ONE rule:
-- nothing is signed until the person has been shown, in words, what they are
-- authorising - every output, the fee, the change, and which coins are being
-- spent. CoinXT's own rule 3 says a blind signer is a footgun; this is what
-- not being one looks like.
-- ==============================================================================

command waPaintSend
   local tRate, tHint
   set the defaultStack to the short name of this stack
   waPaintChoice "sd_strat", "Bnb,Largest,Smallest,Oldest,Manual", waStrategyChoice()
   if field "sd_rate" is empty then
      put waDefaultRate() into field "sd_rate"
   end if
   if field "sd_locktime" is empty then
      put "0" into field "sd_locktime"
   end if
   put field "sd_rate" into tRate
   if tRate is a number then
      put "At " & tRate & " sat/vB: " & cwFeeRateLabel(tRate + 0) into tHint
   else
      put "Type a fee rate in sat/vB." into tHint
   end if
   if sWaFeeRates["1"] is not "" then
      put tHint & return & "The backend suggests " & sWaFeeRates["1"] & \
            " sat/vB for the next block and " & sWaFeeRates["6"] & \
            " for within six." into tHint
   end if
   put tHint into field "sd_ratehint"
   set the hilite of button "sd_rbf" to (sWaRbf is "true")
   put waSendWarning() into field "sd_warn"
end waPaintSend

private function waStrategyChoice
   local tS
   put the uStrategy of this stack into tS
   if tS is "largest" then
      return "Largest"
   end if
   if tS is "smallest" then
      return "Smallest"
   end if
   if tS is "oldest" then
      return "Oldest"
   end if
   if tS is "manual" then
      return "Manual"
   end if
   return "Bnb"
end waStrategyChoice

function waStrategy
   local tS
   put the uStrategy of this stack into tS
   if tS is "" then
      return "bnb"
   end if
   return tS
end waStrategy

private function waDefaultRate
   if sWaFeeRates["6"] is not "" then
      return sWaFeeRates["6"]
   end if
   return "5"
end waDefaultRate

function waPublicSeedWarning
   -- The one place the public-seed sentence is written. Every screen that can
   -- cost somebody money asks for it, so the wording cannot drift between
   -- them and no screen can quietly stop showing it.
   if not waIsPublicTestSeed() then
      return ""
   end if
   if sWaNetwork is "mainnet" then
      return "DANGER: this is BIP-39's PUBLISHED test seed on MAINNET. Those " & \
            "twelve words are printed in the specification, so ANYONE can " & \
            "derive these private keys and spend anything sent here. Do not " & \
            "receive real coins at this wallet. Generate or restore a seed " & \
            "of your own first."
   end if
   return "This is BIP-39's PUBLISHED test seed, so every address it makes " & \
         "is public. Fine for testnet; never fund it on mainnet."
end waPublicSeedWarning

private function waSendWarning
   if waPublicSeedWarning() is not "" and sWaNetwork is "mainnet" then
      return waPublicSeedWarning()
   end if
   if sWaKind is "watch" then
      return "This is a WATCH-ONLY wallet. It can build a transaction and " & \
            "export it as a PSBT for something that holds the keys, but it " & \
            "cannot sign. Sign is disabled."
   end if
   if cwListCount(sWaUtxos) < 1 then
      return "There are no coins to spend. Either this wallet is empty, or it " & \
            "is offline and has never been told what it owns - the Coins " & \
            "screen can take a UTXO by hand if you know one."
   end if
   if sWaNetwork is "mainnet" then
      return "MAINNET. Read every line of the review panel before pressing " & \
            "Sign, and read the destination address in full: the first and " & \
            "last few characters matching is exactly what address-swapping " & \
            "malware relies on."
   end if
   return "On " & sWaNetwork & ". Nothing here is worth anything, which makes " & \
         "it the right place to press every button once."
end waSendWarning

command waSendClick pRole
   if pRole is "stratBnb" then
      set the uStrategy of this stack to "bnb"
   else if pRole is "stratLargest" then
      set the uStrategy of this stack to "largest"
   else if pRole is "stratSmallest" then
      set the uStrategy of this stack to "smallest"
   else if pRole is "stratOldest" then
      set the uStrategy of this stack to "oldest"
   else if pRole is "stratManual" then
      set the uStrategy of this stack to "manual"
   else if pRole is "paste" then
      waReadUri
   else if pRole is "addSelf" then
      waAddSelfPayment
   else if pRole is "addNote" then
      waAddNoteLine
   else if pRole is "preview" then
      waBuildSpend false, false
   else if pRole is "sign" then
      waBuildSpend true, false
   else if pRole is "toPsbt" then
      waBuildSpend false, true
   else if pRole is "broadcast" then
      waBroadcast
   else if pRole is "copyRaw" then
      set the clipboardData["text"] to sWaLastRaw
      uiCopyFlash "sd_copyRaw"
   else if pRole is "rbf" then
      if sWaRbf is "true" then
         put "false" into sWaRbf
      else
         put "true" into sWaRbf
      end if
   else if pRole is "clear" then
      put empty into field "sd_to"
      put empty into field "sd_out"
      put empty into sWaLastRaw
   end if
   waRefreshScreen
end waSendClick

command waReadUri
   -- BIP-21 in, one payment line out. A req- parameter this wallet does not
   -- understand is a REFUSAL, not a warning: the sender attached a condition
   -- to the payment and paying without honouring it is not the same payment.
   local tUri, tRec, tReq, tCount, tLine
   put cwTrim(field "sd_to") into tUri
   if tUri is "" then
      throw "paste a bitcoin: URI into the Pay to box first."
   end if
   put cwUriParse(line 1 of tUri) into tRec
   put cwListCount(tRec["required"]) into tCount
   if tCount > 0 then
      put tRec["required"] into tReq
      throw "that URI carries " & tReq[1] & ", a req- parameter this wallet " & \
            "does not understand. BIP-21 says a wallet must refuse rather " & \
            "than pay and ignore the condition."
   end if
   if cwAddressIsValid(sWaNetwork, tRec["address"]) is not true then
      throw "that URI's address is not valid on " & sWaNetwork & ": " & \
            cwAddressProblem(sWaNetwork, tRec["address"])
   end if
   put tRec["address"] into tLine
   if tRec["amountsat"] > 0 then
      -- IN THE DISPLAY UNIT, because that is what reads this box back.
      put tLine & ", " & waAmountBare(tRec["amountsat"]) into tLine
   end if
   put tLine & return into field "sd_to"
   if tRec["label"] is not "" then
      -- THE URI'S LABEL IS A STRANGER'S TEXT. See waSafeText.
      put waSafeText(tRec["label"]) into sWaLabels[tRec["address"]]
   end if
   uiStatus "Read a BIP-21 URI" & waUriExtra(tRec) & ".", "ok"
end waReadUri

private function waUriExtra pRec
   local tOut
   put "" into tOut
   if pRec["amountsat"] > 0 then
      put " for " & cwSatToBtc(pRec["amountsat"]) & " BTC" into tOut
   end if
   if pRec["label"] is not "" then
      put tOut & " from " & pRec["label"] into tOut
   end if
   return tOut
end waUriExtra

command waAddSelfPayment
   local tRec
   put waNextUnused(0) into tRec
   if tRec is "" then
      -- Reported from the 2026-09-03 engine log mid-sync of the public test
      -- seed, whose every address everybody has used: the sentence that
      -- stood here said what was missing and nothing about why or what to
      -- press.
      if waIsPublicTestSeed() then
         throw "this wallet has no unused receive address to pay itself: " & \
               "every address the public test seed derives has been used " & \
               "by somebody, because everybody has that seed. Derive more " & \
               "on the Addresses screen (More), or pay a wallet of your own."
      end if
      throw "this wallet has no unused receive address to pay itself. " & \
            "Derive more on the Addresses screen (More)."
   end if
   -- 10000 sat, written in whatever unit this wallet is displaying. The
   -- literal "0.0001" that stood here was BTC, so on mBTC it proposed 10 sat
   -- (refused as dust) and on satoshi it proposed a fraction of one.
   put tRec["address"] & ", " & waAmountBare(10000) & return after field "sd_to"
end waAddSelfPayment

function waParsePayments
   -- One payment per line: "<address>, <amount>" or "<address>, MAX". The
   -- comma is split by hand rather than with `item` so this does not depend
   -- on the engine's current itemDelimiter, which anything in the process may
   -- have changed.
   local tText, tI, tCount, tLine, tPos, tAddr, tAmountText, tRec, tList, tMax
   local tHaveData
   put field "sd_to" into tText
   put waEmptyList() into tList
   put false into tMax
   put false into tHaveData
   put the number of lines of tText into tCount
   repeat with tI = 1 to tCount
      put cwTrim(line tI of tText) into tLine
      if tLine is "" then
         next repeat
      end if
      -- A NOTE TO THE CHAIN is a line, not a screen (2026-09-04): "note:"
      -- writes the text as UTF-8, "data:" writes hex, either as one
      -- OP_RETURN output of value 0. One per transaction, because a second
      -- OP_RETURN output is what most nodes refuse to relay. As a payment
      -- record it rides everything downstream unchanged - sizing, selection,
      -- review, signing, the fee bump - with its size in its kind.
      if cwLower(char 1 to 5 of tLine) is "note:" \
            or cwLower(char 1 to 5 of tLine) is "data:" then
         if tHaveData is true then
            throw "line " & tI & ": only one OP_RETURN output per " & \
                  "transaction will relay. Put everything in one note."
         end if
         put true into tHaveData
         put cwListAdd(tList, waDataPayment(tLine, tI)) into tList
         next repeat
      end if
      put offset(",", tLine) into tPos
      if tPos is 0 then
         put tLine into tAddr
         put "" into tAmountText
      else
         put cwTrim(char 1 to (tPos - 1) of tLine) into tAddr
         put cwTrim(char (tPos + 1) to -1 of tLine) into tAmountText
      end if
      put "" into tRec
      if cwSpIsAddress(tAddr) then
         -- A SILENT PAYMENT ADDRESS HAS NO SCRIPT YET (2026-09-04): the
         -- output is derived from the coins chosen to fund it, so the
         -- record carries the two keys and waSpResolve fills the script in
         -- after selection. Its KIND is taproot now, which is all the sizer
         -- and the dust rule need.
         put waSpRecipient(tAddr, tI) into tRec
      else
         if cwAddressIsValid(sWaNetwork, tAddr) is not true then
            throw "line " & tI & ": " & cwAddressProblem(sWaNetwork, tAddr)
         end if
         put tAddr into tRec["address"]
         put cwScriptForAddress(sWaNetwork, tAddr) into tRec["script"]
         put cwScriptKind(tRec["script"]) into tRec["kind"]
      end if
      if cwUpper(tAmountText) is "MAX" then
         if tMax is true then
            throw "only one output can be MAX: two of them have no answer."
         end if
         put true into tMax
         put true into tRec["max"]
         put 0 into tRec["value"]
      else
         if tAmountText is "" then
            throw "line " & tI & ": that address has no amount. Write " & \
                  quote & "address, 0.001" & quote & " or " & quote & \
                  "address, MAX" & quote & "."
         end if
         put false into tRec["max"]
         put cwParseAmount(tAmountText, sWaUnit) into tRec["value"]
         if tRec["value"] <= 0 then
            throw "line " & tI & ": an amount must be positive."
         end if
         if tRec["value"] < cwDustThreshold(tRec["kind"]) then
            throw "line " & tI & ": " & tRec["value"] & \
                  " sat is below the dust threshold for a " & tRec["kind"] & \
                  " output (" & cwDustThreshold(tRec["kind"]) & \
                  " sat). The network will not relay it."
         end if
      end if
      put cwListAdd(tList, tRec) into tList
   end repeat
   if cwListCount(tList) < 1 then
      throw "there is nothing to pay. Put an address and an amount in the Pay " & \
            "to box."
   end if
   return tList
end waParsePayments

function waDataPayment pLine, pLineNo
   -- The payment record for a "note:" or "data:" line: an OP_RETURN script
   -- of value 0 whose kind carries its byte count for the sizer.
   local tRec, tText, tHex, tBytes, tLen
   put cwTrim(char 6 to -1 of pLine) into tText
   if cwLower(char 1 to 5 of pLine) is "note:" then
      if tText is "" then
         throw "line " & pLineNo & ": the note is empty."
      end if
      put cxHexEncode(textEncode(tText, "utf-8")) into tHex
   else
      put cwLower(cwStripWhitespace(tText)) into tHex
      put the number of chars of tHex into tLen
      if tHex is "" or cwHexIsClean(tHex) is not true or tLen mod 2 is not 0 then
         throw "line " & pLineNo & ": data: takes hex, an even number of 0-9 a-f."
      end if
   end if
   put the number of chars of tHex into tLen
   put tLen div 2 into tBytes
   if tBytes > kWaDataMaxBytes then
      throw "line " & pLineNo & ": " & tBytes & " bytes is more than an OP_RETURN " & \
            "output can carry from here (" & kWaDataMaxBytes & ")."
   end if
   put "" into tRec
   put "OP_RETURN" into tRec["address"]
   put cwOpReturnScript(tHex) into tRec["script"]
   put "nulldata:" & tBytes into tRec["kind"]
   put false into tRec["max"]
   put 0 into tRec["value"]
   put tHex into tRec["data"]
   return tRec
end waDataPayment

private function waSpRecipient pAddr, pLineNo
   -- The payment record for a BIP-352 silent payment address: the two keys
   -- it decodes to, the taproot kind, and no script (see waParsePayments).
   local tRec, tKeys, tError, tWhy
   put "" into tWhy
   try
      put cwSpDecode(sWaNetwork, pAddr) into tKeys
   catch tError
      put tError into tWhy
   end try
   if tWhy is not "" then
      throw "line " & pLineNo & ": " & tWhy
   end if
   put pAddr into tRec["address"]
   put true into tRec["sp"]
   put tKeys["scan"] into tRec["scan"]
   put tKeys["spend"] into tRec["spend"]
   put "p2tr" into tRec["kind"]
   put "" into tRec["script"]
   return tRec
end waSpRecipient

private function waPaysNeedSp pPays
   local tI, tCount, tRec
   put cwListCount(pPays) into tCount
   repeat with tI = 1 to tCount
      put pPays[tI] into tRec
      if tRec["sp"] is true then
         return true
      end if
   end repeat
   return false
end waPaysNeedSp

private function waSpResolve pPays, pSel, pAsPsbt
   -- Derive the taproot output for every silent payment line from the coins
   -- just chosen (BIP-352, the sending side; the derivation is wallet-core's
   -- cwSpSend). This needs the private key of every eligible input, which is
   -- why it is refused for a PSBT and for a watch-only wallet - there is no
   -- script to hand a signer, only a derivation the signer would have to
   -- repeat - and a multisig wallet's P2WSH inputs take no part at all.
   -- The taproot case passes the TWEAKED key, because that is the key that
   -- spends the output and the one the BIP's negation rule is about.
   local tI, tCount, tRec, tAddrRec, tType, tKey, tIn, tInputs, tOutpoints
   local tRecipients, tKeys, tMap, tN, tPays, tScript
   if pAsPsbt is true then
      throw "a silent payment cannot go into a PSBT: its output is derived " & \
            "from the private keys of the coins that fund it, so only the " & \
            "signer can compute it. Sign it here instead."
   end if
   if sWaKind is "watch" then
      throw "a silent payment needs the private keys of the coins it spends, " & \
            "and this watch-only wallet holds none."
   end if
   if sWaKind is "multisig" then
      throw "a silent payment cannot be made from a multisig wallet: BIP-352 " & \
            "derives the output from single-key inputs, and P2WSH inputs " & \
            "take no part."
   end if
   put waEmptyList() into tInputs
   put waEmptyList() into tOutpoints
   put cwListCount(pSel) into tCount
   repeat with tI = 1 to tCount
      put pSel[tI] into tRec
      put "" into tIn
      put tRec["txid"] into tIn["txid"]
      put tRec["vout"] into tIn["vout"]
      put cwListAdd(tOutpoints, tIn) into tOutpoints
      put waRecordFor(tRec["address"]) into tAddrRec
      if tAddrRec is "" then
         throw "coin " & tI & " is at " & tRec["address"] & ", which is not " & \
               "an address this wallet derives, so its key is not here to " & \
               "derive a silent payment from."
      end if
      put waRecordType(tAddrRec) into tType
      if cwSpEligible(tType, tAddrRec["pubkey"]) is not true then
         next repeat
      end if
      put waSeckeyFor(tAddrRec) into tKey
      put "" into tIn
      if tType is "p2tr" then
         -- the key that spends the output: tweaked by an empty root, or by
         -- the leaf hash for an inscription commit
         put cxHexEncode(cxTaprootTweakSeckey(cxHexDecode(tKey), \
               cxHexDecode(tAddrRec["leafhash"]))) into tIn["seckey"]
         put true into tIn["xonly"]
      else
         put tKey into tIn["seckey"]
         put false into tIn["xonly"]
      end if
      put "" into tKey
      put cwListAdd(tInputs, tIn) into tInputs
   end repeat
   -- the recipients in pay order, remembering which pay each one is
   put waEmptyList() into tRecipients
   put waEmptyList() into tMap
   put cwListCount(pPays) into tCount
   repeat with tI = 1 to tCount
      put pPays[tI] into tRec
      if tRec["sp"] is not true then
         next repeat
      end if
      put "" into tIn
      put tRec["scan"] into tIn["scan"]
      put tRec["spend"] into tIn["spend"]
      put cwListAdd(tRecipients, tIn) into tRecipients
      put cwListAdd(tMap, tI) into tMap
   end repeat
   put cwSpSend(tInputs, tOutpoints, tRecipients) into tKeys
   put "" into tInputs
   put pPays into tPays
   put cwListCount(tMap) into tCount
   repeat with tI = 1 to tCount
      put tMap[tI] into tN
      put tPays[tN] into tRec
      put cwScriptP2tr(tKeys[tI]) into tScript
      put tScript into tRec["script"]
      put cwAddressForScript(sWaNetwork, tScript) into tRec["derived"]
      put tRec into tPays[tN]
   end repeat
   waLog "derived " & tCount & " silent payment output(s) from " & \
         cwListCount(tOutpoints) & " input(s) (BIP-352)"
   return tPays
end waSpResolve

function waDataPreview pHex
   -- Data as a person would read it: the text in quotes when every byte is
   -- printable UTF-8, otherwise the byte count and the hex, cut short.
   local tBytes, tText, tI, tCount, tCode, tPrintable, tLen
   if pHex is "" then
      return "(no data)"
   end if
   put the number of chars of pHex into tLen
   put tLen div 2 into tBytes
   put textDecode(cxHexDecode(pHex), "utf-8") into tText
   put true into tPrintable
   put the number of chars of tText into tCount
   repeat with tI = 1 to tCount
      put charToNum(char tI of tText) into tCode
      if tCode is 65533 or (tCode < 32 and tCode is not 9 and tCode is not 10 \
            and tCode is not 13) then
         put false into tPrintable
         exit repeat
      end if
   end repeat
   if tPrintable is true then
      return "text " & quote & tText & quote & " (" & tBytes & " bytes)"
   end if
   if tLen > 64 then
      return tBytes & " bytes: " & char 1 to 64 of pHex & "..."
   end if
   return tBytes & " bytes: " & pHex
end waDataPreview

function waInscriptionIn pWitness
   -- An Ordinals inscription in a witness, if there is one: the envelope is
   -- OP_FALSE OP_IF "ord" ... OP_ENDIF inside the tapscript, with the
   -- content type after a push of 0x01 and the body after OP_0, in as many
   -- pushes as it takes. Answers "<type>, <N> bytes: <preview>" or empty.
   local tI, tCount, tItem, tItems, tJ, tLines, tLine, tData, tPhase, tType
   local tBody, tBytes, tIn, tLen
   put cwListCount(pWitness) into tCount
   repeat with tI = 1 to tCount
      put pWitness[tI] into tItem
      if not (cwLower(tItem) contains "0063036f7264") then
         next repeat
      end if
      put cwScriptItems(tItem) into tItems
      put "" into tPhase
      put "" into tType
      put "" into tBody
      put false into tIn
      put the number of lines of tItems into tLines
      repeat with tJ = 1 to tLines
         put line tJ of tItems into tLine
         if char 1 to 5 of tLine is "push " then
            put char 6 to -1 of tLine into tData
         else
            put "" into tData
         end if
         if tIn is false then
            if tLine is "push 6f7264" then
               put true into tIn
            end if
            next repeat
         end if
         if tLine is "op 104" then
            exit repeat
         end if
         if tPhase is "body" then
            if char 1 to 4 of tLine is "push" then
               put tData after tBody
            end if
         else if tPhase is "type" then
            put textDecode(cxHexDecode(tData), "utf-8") into tType
            put "" into tPhase
         else if tLine is "push 01" then
            put "type" into tPhase
         else if tLine is "op 0" then
            put "body" into tPhase
         end if
      end repeat
      if tIn is true then
         put the number of chars of tBody into tLen
         put tLen div 2 into tBytes
         if tType is "" then
            put "(no content type)" into tType
         end if
         return tType & ", " & tBytes & " bytes: " & waDataPreview(tBody)
      end if
   end repeat
   return ""
end waInscriptionIn

function waSpendableCoins
   -- The UTXO set as the selector wants it, carrying the freeze and tick
   -- flags the Coins screen sets.
   local tI, tCount, tRec, tKey, tOut, tCoin, tAddrRec
   put waEmptyList() into tOut
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      -- A LOCKED COIN THE CHAIN CANNOT YET RELEASE IS NOT SPENDABLE, and
      -- offering it would build a transaction every node rejects. Once the
      -- tip reaches its height (or while the tip is unknown, offline) it is
      -- offered, and waBuildSpend raises the locktime to match.
      put waRecordFor(tRec["address"]) into tAddrRec
      if tAddrRec is not "" and tAddrRec["lockheight"] is not "" \
            and sWaTipHeight is not empty and tAddrRec["lockheight"] > sWaTipHeight then
         next repeat
      end if
      put tRec["txid"] & ":" & tRec["vout"] into tKey
      -- A COIN A TRANSACTION THIS WALLET BROADCAST HAS SPENT is not spendable
      -- either, however unspent the last sync's coin list still says it is:
      -- the second spend would be a replacement of the first paying nothing
      -- extra, which every node refuses (waNoteBroadcast has the record).
      if sWaSpentBy[tKey] is not "" then
         next repeat
      end if
      put tRec into tCoin
      put (sWaFrozen[tKey] is "true") into tCoin["frozen"]
      put (sWaSelected[tKey] is "true") into tCoin["selected"]
      put cwListAdd(tOut, tCoin) into tOut
   end repeat
   return tOut
end waSpendableCoins

command waBuildSpend pSign, pAsPsbt
   -- The whole spend path in one place: parse, select, build, review, and
   -- only then sign. Every early return leaves the review panel saying what
   -- stopped it.
   local tPays, tCoins, tTarget, tRate, tSel, tOutTypes, tI, tCount, tRec
   local tInputs, tOutputs, tChangeRec, tLock, tSeq, tResult, tOut, tMaxIndex
   local tChangeType, tFee, tChange, tVsize, tError, tNode, tSigs, tWits
   local tDigest, tSig, tRaw, tTxid, tPsbt, tMeta, tKey, tAmounts, tScripts
   set the defaultStack to the short name of this stack
   put waParsePayments() into tPays
   put field "sd_rate" into tRate
   if tRate is not a number or tRate <= 0 then
      throw "the fee rate must be a positive number of sat/vB."
   end if
   put field "sd_locktime" into tLock
   if tLock is not an integer or tLock < 0 then
      put 0 into tLock
   end if
   put waSequenceNumber() into tSeq
   put waSpendableCoins() into tCoins
   if cwListCount(tCoins) < 1 then
      throw "this wallet holds no coins to spend."
   end if
   -- the target and the output types the estimator needs
   put 0 into tTarget
   put -1 into tMaxIndex
   put waEmptyList() into tOutTypes
   put cwListCount(tPays) into tCount
   repeat with tI = 1 to tCount
      put tPays[tI] into tRec
      if tRec["max"] is true then
         put tI into tMaxIndex
      else
         add tRec["value"] to tTarget
      end if
      put cwListAdd(tOutTypes, tRec["kind"]) into tOutTypes
   end repeat
   put waChangeType() into tChangeType
   if tMaxIndex > 0 then
      put waMaxSpend(tCoins, tOutTypes, tRate, tTarget) into tResult
   else
      put cwSelectCoins(tCoins, tTarget, tRate, waInputType(), tOutTypes, \
            tChangeType, waStrategy(), sWaM, cwListCount(sWaCosigners)) into tResult
   end if
   if tResult["ok"] is not true then
      put "Cannot build this spend: " & tResult["why"] & return & return & \
            waCoinAdvice(tResult, tTarget) into field "sd_out"
      uiStatus tResult["why"], "bad"
      exit waBuildSpend
   end if
   put tResult["selected"] into tSel
   put tResult["fee"] into tFee
   put tResult["change"] into tChange
   put tResult["vsize"] into tVsize
   -- a silent payment's output exists only once the inputs are known
   if waPaysNeedSp(tPays) then
      put waSpResolve(tPays, tSel, pAsPsbt) into tPays
   end if
   -- a locked coin needs the transaction's locktime at or past its height
   put waLockedHeight(tSel, tLock) into tLock
   -- inputs
   put waEmptyList() into tInputs
   put cwListCount(tSel) into tCount
   repeat with tI = 1 to tCount
      put tSel[tI] into tRec
      put cwListAdd(tInputs, cwTxInput(tRec["txid"], tRec["vout"], tSeq)) into tInputs
   end repeat
   -- outputs, with MAX taking whatever is left
   put waEmptyList() into tOutputs
   repeat with tI = 1 to cwListCount(tPays)
      put tPays[tI] into tRec
      if tRec["max"] is true then
         put tResult["totalin"] - tTarget - tFee into tRec["value"]
         if tRec["value"] < cwDustThreshold(tRec["kind"]) then
            throw "after the fee, the MAX output would be " & tRec["value"] & \
                  " sat, which is dust."
         end if
         put tRec into tPays[tI]
      end if
      put cwListAdd(tOutputs, cwTxOutput(tRec["value"], tRec["script"])) into tOutputs
   end repeat
   put "" into tChangeRec
   if tChange > 0 then
      put waNextChangeOrMore() into tChangeRec
      put cwListAdd(tOutputs, cwTxOutput(tChange, tChangeRec["script"])) into tOutputs
   end if
   put waReviewText(tPays, tSel, tFee, tChange, tChangeRec, tVsize, tRate, \
         tSeq, tLock, tResult) into tOut
   if pAsPsbt is true then
      put waMakePsbt(tInputs, tOutputs, tSel, tLock) into tPsbt
      put tPsbt into sWaLastPsbt
      put tOut & return & "PSBT (unsigned, ready for a cosigner or a signer):" & \
            return & tPsbt & return into field "sd_out"
      uiStatus "Built a PSBT. It is on the Tools screen too.", "ok"
      exit waBuildSpend
   end if
   if pSign is not true then
      put tOut & return & "Nothing has been signed. Press Sign when every " & \
            "line above is what you meant." into field "sd_out"
      uiStatus "Built, unsigned: " & tVsize & " vB, fee " & waAmount(tFee) & ".", ""
      exit waBuildSpend
   end if
   if sWaKind is "watch" then
      throw "this is a watch-only wallet and holds no keys. Build a PSBT " & \
            "instead and sign it where the keys are."
   end if
   put waSignSpend(tInputs, tOutputs, tSel, tLock) into tRaw
   put cwTxDecode(tRaw) into tRec
   waRecordSpend tRec["txid"], tSel, tPays, tChange, tChangeRec, tLock, tSeq, \
         tFee, tVsize
   put tOut & return & "SIGNED." & return & \
         "txid    " & tRec["txid"] & return & \
         "size    " & tRec["size"] & " bytes, " & tRec["vsize"] & " vB" & return & \
         "raw     " & tRaw & return & return & \
         "Nothing has been broadcast. Press Broadcast to send it, or copy the " & \
         "raw transaction and push it from somewhere else." into field "sd_out"
   uiStatus "Signed " & tRec["txid"] & ".", "ok"
end waBuildSpend

command waRecordSpend pTxid, pSel, pPays, pChange, pChangeRec, pLock, pSeq, pFee, pVsize
   -- KEPT SO IT CAN BE BUMPED. A replacement transaction spends the same
   -- inputs, and signing an input under BIP-143 commits to that input's
   -- VALUE - a number the raw transaction does not carry and which lives only
   -- in the coin that funded it. The moment this spend is signed, those coins
   -- leave sWaUtxos: the wallet is looking at a transaction it can price a
   -- replacement for and cannot build one.
   --
   -- THIS IS MEMORY ONLY, deliberately, and waBumpFee says so on screen when
   -- it is missing. The wallet file is one field per line with a tab between
   -- name and value, and a per-transaction coin list is a nested structure
   -- that format has no spelling for. Inventing one to keep bump records
   -- across a reopen would be a change to the format every existing wallet
   -- file is written in, for a case - bumping a transaction made in an
   -- earlier session - that the advice text already covers.
   local tRec
   put pSel into tRec["selected"]
   put pPays into tRec["pays"]
   put pChange into tRec["change"]
   put pChangeRec into tRec["changerec"]
   put pLock into tRec["locktime"]
   put pSeq into tRec["sequence"]
   put pFee into tRec["fee"]
   put pVsize into tRec["vsize"]
   put tRec into sWaSpends[pTxid]
   waLog "recorded the makeup of " & pTxid & " so its fee can be bumped"
end waRecordSpend

command waNoteBroadcast pRaw, pTxid
   -- WHAT THE WALLET JUST DID, before the backend says so. The 2026-09-03
   -- engine log built two spends a minute apart with no sync between them,
   -- and the second reused the first one's input: the server took the first,
   -- refused the second as a replacement paying nothing extra ("insufficient
   -- fee, rejecting replacement"), and the wallet had been choosing from a
   -- coin list that was true when the sync answered and not since. A
   -- broadcast the backend ACCEPTED is the wallet's own word that those
   -- coins are gone, so they are marked here - waSpendableCoins, waCpfpCoins
   -- and the balance skip a marked coin and the Coins screen shows SPT - and
   -- every output that comes back to this wallet, the change usually, is
   -- added as a coin at 0 confirmations, which is also what lets a
   -- child-pays-for-parent bump find it without a sync.
   --
   -- THE BACKEND OUTRANKS THIS MEMORY: waMergeUtxos drops the mark from any
   -- coin the backend still lists (the spend never reached it) and replaces
   -- the added coins with what it says the moment the address is asked. And
   -- A REPLACEMENT VOIDS WHAT IT REPLACES: an input already marked as spent
   -- by a DIFFERENT transaction means that one has just been replaced, and
   -- the coins this wallet added from its outputs will never exist, so they
   -- go with it. Nothing here can be read on a raw transaction this wallet
   -- cannot decode; that case is logged and the next sync puts it right.
   local tTx, tError, tIns, tOuts, tI, tCount, tIn, tOut, tKey, tOld
   local tAddr, tRec, tSpent, tBack, tVoided, tTxid, tNew
   try
      put cwTxDecode(pRaw) into tTx
   catch tError
      waLog "could not read back the transaction just broadcast (" & tError & \
            "); its coins will be right after the next sync"
      exit waNoteBroadcast
   end try
   put pTxid into tTxid
   if tTxid is "" then
      put tTx["txid"] into tTxid
   end if
   put tTx["inputs"] into tIns
   put cwListCount(tIns) into tCount
   put 0 into tSpent
   put 0 into tNew
   put "" into tVoided
   repeat with tI = 1 to tCount
      put tIns[tI] into tIn
      put tIn["txid"] & ":" & tIn["vout"] into tKey
      put sWaSpentBy[tKey] into tOld
      if tOld is not "" and tOld is not tTxid then
         if not (tVoided contains tOld) then
            put waCoinsNotFrom(tOld) into sWaUtxos
            put tOld & return after tVoided
            waLog tTxid & " replaces " & tOld & "; the coins this wallet had " & \
                  "added from it are void"
         end if
      end if
      if tOld is not tTxid then
         add 1 to tNew
      end if
      put tTxid into sWaSpentBy[tKey]
      add 1 to tSpent
   end repeat
   put tTx["outputs"] into tOuts
   put cwListCount(tOuts) into tCount
   put 0 into tBack
   repeat with tI = 1 to tCount
      put tOuts[tI] into tOut
      put "" into tAddr
      try
         put cwAddressForScript(sWaNetwork, tOut["script"]) into tAddr
      catch tError
         -- an OP_RETURN, or a script with no address: not a coin of anyone's
         put "" into tAddr
      end try
      if tAddr is "" then
         next repeat
      end if
      if waIsMine(tAddr) is not true then
         next repeat
      end if
      put tTxid & ":" & (tI - 1) into tKey
      if waHoldsCoin(tKey) is true then
         next repeat
      end if
      put "" into tRec
      put tTxid into tRec["txid"]
      put tI - 1 into tRec["vout"]
      put tOut["value"] into tRec["value"]
      put tAddr into tRec["address"]
      put 0 into tRec["confirmations"]
      put "" into tRec["height"]
      put cwListAdd(sWaUtxos, tRec) into sWaUtxos
      add 1 to tBack
   end repeat
   if tNew is 0 and tBack is 0 then
      -- the acceptance of a transaction reserved when it was queued
      waLog tTxid & " accepted; its " & tSpent & " coin(s) were reserved when it was queued"
   else
      waLog tTxid & " spent " & tSpent & " coin(s) this wallet will not offer " & \
            "again, and " & tBack & " output(s) came back to it as unconfirmed coin(s)"
   end if
   waRecomputeBalance
   waPaintNav
end waNoteBroadcast

command waUnnoteBroadcast pRaw
   -- The backend refused the transaction for good (after the one retry):
   -- the coins it reserved are offered again, and the coins added from its
   -- outputs go, because they will never exist. A mark that another
   -- transaction has since taken over is left to that one.
   local tTx, tError, tIns, tI, tCount, tIn, tKey, tFreed
   try
      put cwTxDecode(pRaw) into tTx
   catch tError
      exit waUnnoteBroadcast
   end try
   put tTx["inputs"] into tIns
   put cwListCount(tIns) into tCount
   put 0 into tFreed
   repeat with tI = 1 to tCount
      put tIns[tI] into tIn
      put tIn["txid"] & ":" & tIn["vout"] into tKey
      if sWaSpentBy[tKey] is tTx["txid"] then
         put "" into sWaSpentBy[tKey]
         add 1 to tFreed
      end if
   end repeat
   put waCoinsNotFrom(tTx["txid"]) into sWaUtxos
   waLog "the broadcast of " & tTx["txid"] & " failed; " & tFreed & \
         " coin(s) it had reserved are offered again"
   waRecomputeBalance
   waPaintNav
end waUnnoteBroadcast

function waPendingSpenderOf pTxid
   -- The txid of a transaction this wallet has queued or broadcast that
   -- spends an output of pTxid, or empty. Memory only, like the marks.
   local tKey, tLen
   put the number of chars of pTxid into tLen
   repeat for each key tKey in sWaSpentBy
      if char 1 to tLen of tKey is pTxid and char (tLen + 1) of tKey is ":" \
            and sWaSpentBy[tKey] is not "" then
         return sWaSpentBy[tKey]
      end if
   end repeat
   return ""
end waPendingSpenderOf

private function waHoldsCoin pKey
   -- Whether a coin with that outpoint is already in the list.
   local tI, tCount, tRec
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      if tRec["txid"] & ":" & tRec["vout"] is pKey then
         return true
      end if
   end repeat
   return false
end waHoldsCoin

private function waCoinsNotFrom pTxid
   -- The coin list without the outputs of one transaction.
   local tI, tCount, tRec, tOut
   put waEmptyList() into tOut
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      if tRec["txid"] is not pTxid then
         put cwListAdd(tOut, tRec) into tOut
      end if
   end repeat
   return tOut
end waCoinsNotFrom

function waLockedHeight pSel, pLock
   -- The locktime a spend of these coins needs: the given one, raised to
   -- the highest lock height among them (a CLTV leaf is satisfied only by
   -- a locktime at or past its number).
   local tI, tCount, tRec, tAddrRec, tLock
   put pLock into tLock
   put cwListCount(pSel) into tCount
   repeat with tI = 1 to tCount
      put pSel[tI] into tRec
      put waRecordFor(tRec["address"]) into tAddrRec
      if tAddrRec is not "" and tAddrRec["lockheight"] is not "" \
            and tAddrRec["lockheight"] > tLock then
         put tAddrRec["lockheight"] + 0 into tLock
      end if
   end repeat
   return tLock
end waLockedHeight

function waSequenceNumber
   -- BIP-125 opt-in replaceability is a SEQUENCE NUMBER, not a flag in the
   -- transaction: anything below 0xFFFFFFFE says "this may be replaced", and
   -- a wallet that cannot bump a stuck transaction is a wallet whose only
   -- answer to a fee that turned out too low is to wait.
   -- READ FROM THE APP'S OWN STATE, not from the control. The kit builds a
   -- checkbox with autoHilite FALSE on purpose - "the hilite is set
   -- explicitly by the adopter's state machine" - so a box no handler drives
   -- can never be ticked, and reading it would have meant every transaction
   -- this wallet ever built was non-replaceable while the screen offered the
   -- option and waBumpAdvice told the user to bump it.
   if sWaRbf is "true" then
      return kCwSeqRbf
   end if
   return kCwSeqNoRbf
end waSequenceNumber

function waInputType
   -- The wallet's OWN type: what a NEW address gets, and what change goes to.
   -- It is not necessarily the type of a coin being spent - see
   -- waRecordType, and read its note before using this one in a signing path.
   if sWaKind is "multisig" then
      return "p2wsh"
   end if
   return sWaScriptType
end waInputType

function waRecordType pAddrRec
   -- THE TYPE OF ONE ADDRESS, which is not the same question as the type of
   -- the wallet, and the difference is what a signing path must ask.
   -- Every record carries its own "scripttype" (cwAddressAt writes it, the
   -- multisig builder writes p2wsh, and the imported-key path writes the type
   -- of the address it actually chose - which for an uncompressed key is
   -- legacy however the Wallet screen is set). Signing by the WALLET's type
   -- signed a P2PKH output with the BIP-143 sighash and gave it a witness,
   -- which no node accepts.
   --
   -- The fallback is the wallet's type rather than a throw because a record
   -- from an older saved file predates the field, and for those every address
   -- really was the wallet's type - that is exactly the case this replaces.
   if pAddrRec["scripttype"] is not "" then
      return pAddrRec["scripttype"]
   end if
   return waInputType()
end waRecordType

function waSelectedInputSpecs pSel
   -- The cwEstimateVsize input list built from the ACTUAL coins, so a mixed
   -- selection is priced by what it really costs rather than by the wallet's
   -- nominal type. cwSimpleInputs (count x one type) is still right wherever
   -- the caller genuinely has one type, and wrong here.
   local tI, tCount, tRec, tAddrRec, tSpec, tOut
   put waEmptyList() into tOut
   put cwListCount(pSel) into tCount
   repeat with tI = 1 to tCount
      put pSel[tI] into tRec
      put waRecordFor(tRec["address"]) into tAddrRec
      put "" into tSpec
      if tAddrRec is "" then
         put waInputType() into tSpec["type"]
      else
         put waRecordType(tAddrRec) into tSpec["type"]
      end if
      put sWaM into tSpec["m"]
      put cwListCount(sWaCosigners) into tSpec["cosigners"]
      put cwListAdd(tOut, tSpec) into tOut
   end repeat
   return tOut
end waSelectedInputSpecs

function waChangeType
   -- Change goes to the same script type as the wallet, which is what keeps
   -- it from standing out: a transaction whose change output is a different
   -- type than its other outputs tells a chain analyst which one it is.
   return waInputType()
end waChangeType

private function waMaxSpend pCoins, pOutTypes, pRate, pFixedSat
   -- MAX: spend every unfrozen coin, pay the fee AND any fixed-amount outputs
   -- on the same transaction, and hand the rest to the one MAX output. There
   -- is no change, by construction.
   --
   -- pFixedSat is the sum of the OTHER outputs, and it is a parameter rather
   -- than an assumption: without it the sufficiency test compares the total
   -- against the fee alone, passes, and the MAX output comes out NEGATIVE -
   -- refused a step later by the dust check, but with a message about dust
   -- rather than about not having enough money.
   local tI, tCount, tRec, tSel, tTotal, tVsize, tFee, tOut, tIns
   put waEmptyList() into tSel
   put 0 into tTotal
   put cwListCount(pCoins) into tCount
   repeat with tI = 1 to tCount
      put pCoins[tI] into tRec
      if tRec["frozen"] is true then
         next repeat
      end if
      if waStrategy() is "manual" and tRec["selected"] is not true then
         next repeat
      end if
      put cwListAdd(tSel, tRec) into tSel
      add tRec["value"] to tTotal
   end repeat
   put waSelectedInputSpecs(tSel) into tIns
   put cwEstimateVsize(tIns, pOutTypes) into tVsize
   put cwFeeFor(tVsize, pRate) into tFee
   put "" into tOut
   put tSel into tOut["selected"]
   put tFee into tOut["fee"]
   put 0 into tOut["change"]
   put tTotal into tOut["totalin"]
   put tVsize into tOut["vsize"]
   put "max" into tOut["strategy"]
   if cwListCount(tSel) < 1 then
      put false into tOut["ok"]
      put "no spendable coins" into tOut["why"]
      return tOut
   end if
   if tTotal <= (tFee + pFixedSat) then
      put false into tOut["ok"]
      if pFixedSat > 0 then
         put "the fee (" & tFee & " sat) plus the fixed-amount outputs (" & \
               pFixedSat & " sat) is more than everything this wallet has (" & \
               tTotal & " sat)" into tOut["why"]
      else
         put "the fee (" & tFee & " sat) is more than everything this wallet " & \
               "has (" & tTotal & " sat)" into tOut["why"]
      end if
      return tOut
   end if
   put true into tOut["ok"]
   put "MAX: every unfrozen coin, less the fee" into tOut["why"]
   return tOut
end waMaxSpend

private function waCoinAdvice pResult, pTarget
   local tOut
   put "You asked to pay " & waAmount(pTarget) & "." & return into tOut
   put "This wallet holds " & waAmount(sWaBalance["confirmed"]) & " confirmed" after tOut
   if sWaBalance["unconfirmed"] > 0 then
      put ", " & waAmount(sWaBalance["unconfirmed"]) & " unconfirmed" after tOut
   end if
   if sWaBalance["frozen"] > 0 then
      put ", " & waAmount(sWaBalance["frozen"]) & " frozen (thaw it on the " & \
            "Coins screen if you meant to spend it)" after tOut
   end if
   put "." & return after tOut
   if waStrategy() is "manual" then
      put "You are on 'Ticked coins', so only the coins you ticked were " & \
            "considered." & return after tOut
   end if
   return tOut
end waCoinAdvice

function waReviewText pPays, pSel, pFee, pChange, pChangeRec, pVsize, pRate, pSeq, pLock, pResult
   -- WHAT YOU ARE ABOUT TO AUTHORISE. Every output in full, every coin being
   -- spent, the fee both as an amount and as a rate, and where the change
   -- goes. Nothing is abbreviated: an address shown as "bc1q...8z3" is an
   -- address the reader cannot check, and checking it is the entire point of
   -- this panel.
   local tOut, tI, tCount, tRec, tTotalOut, tKey
   put "YOU ARE ABOUT TO AUTHORISE" & return & return into tOut
   put 0 into tTotalOut
   put cwListCount(pPays) into tCount
   repeat with tI = 1 to tCount
      put pPays[tI] into tRec
      add tRec["value"] to tTotalOut
      if char 1 to 9 of tRec["kind"] is "nulldata:" then
         put "  data   " & char 10 to -1 of tRec["kind"] & " bytes in an " & \
               "OP_RETURN output (value 0; it pays nobody)" & return after tOut
         put "         " & waDataPreview(tRec["data"]) & return after tOut
         if char 10 to -1 of tRec["kind"] > kWaDataWarnBytes then
            put "         OVER " & kWaDataWarnBytes & " BYTES: many nodes " & \
                  "will not relay this; whether it reaches a miner depends " & \
                  "on whose node it meets." & return after tOut
         end if
         put return after tOut
         next repeat
      end if
      put "  pay    " & waAmount(tRec["value"]) & return after tOut
      put "  to     " & tRec["address"] & return after tOut
      if tRec["sp"] is true then
         put "         a SILENT PAYMENT (BIP-352). The coin lands on" & return after tOut
         put "         " & tRec["derived"] & return after tOut
         put "         a taproot output derived from the coins below, which" & return after tOut
         put "         only the payee's scan key can find." & return after tOut
      end if
      if waIsMine(tRec["address"]) then
         put "         (an address of THIS wallet - a self-send)" & return after tOut
      end if
      if sWaLabels[tRec["address"]] is not "" then
         put "         labelled: " & sWaLabels[tRec["address"]] & return after tOut
      end if
      put return after tOut
   end repeat
   if pChange > 0 then
      put "  change " & waAmount(pChange) & return after tOut
      put "  back to " & pChangeRec["address"] & \
            "  (your own change chain, index " & pChangeRec["index"] & ")" & \
            return & return after tOut
   else
      put "  change none: " & pResult["why"] & return & return after tOut
   end if
   put "  fee    " & waAmount(pFee) & "  (" & pVsize & " vB at " & pRate & \
         " sat/vB)" & return after tOut
   put "         " & cwFeeRateLabel(pRate + 0) & return & return after tOut
   put "  spending " & cwListCount(pSel) & " coin(s), " & \
         waAmount(pResult["totalin"]) & " in total, chosen by " & \
         pResult["strategy"] & ":" & return after tOut
   put cwListCount(pSel) into tCount
   repeat with tI = 1 to tCount
      put pSel[tI] into tRec
      put "    " & waAmount(tRec["value"]) & "  " & char 1 to 16 of tRec["txid"] & \
            "..:" & tRec["vout"] & "  " & tRec["address"] & return after tOut
   end repeat
   put return & "  replaceable  " after tOut
   if pSeq < kCwSeqNoRbf then
      put "yes (BIP-125 opt-in RBF; the fee can be bumped later)" & return after tOut
   else
      put "NO. If the fee turns out too low this cannot be bumped." & return after tOut
   end if
   put "  locktime     " & pLock after tOut
   if waLockedHeight(pSel, 0) > 0 then
      put "  (raised to release a coin locked until block " & \
            waLockedHeight(pSel, 0) & ")" after tOut
   end if
   put return after tOut
   put "  network      " & sWaNetwork after tOut
   if sWaNetwork is "mainnet" then
      put "  - THIS IS REAL MONEY" after tOut
   end if
   put return after tOut
   return tOut
end waReviewText

function waSignSpend pInputs, pOutputs, pSel, pLock
   -- Sign every input. The key for each one is re-derived from the account
   -- node at the moment it is needed and dropped immediately after, so no
   -- private key outlives the loop iteration that used it.
   local tNode, tI, tCount, tRec, tAddrRec, tDigest, tSig, tSigs, tWits
   local tScripts, tAmounts, tType, tRaw, tVersion, tWs, tKeys, tInType
   put 2 into tVersion
   put waEmptyList() into tSigs
   put waEmptyList() into tWits
   put waInputType() into tType
   if tType is "p2pkh" then
      put 1 into tVersion
   end if
   -- AN IMPORTED KEY HAS NO ACCOUNT NODE, and asking for one threw before the
   -- check below could excuse it - so a WIF wallet could not sign anything at
   -- all, refused with "this wallet has no account key yet. Open one on the
   -- Wallet screen", about a wallet that was open and holding the only key it
   -- needs. The condition already named this case; the call ordering defeated
   -- it. The key path gets its key from waSeckeyFor, which reads the WIF.
   if sWaKind is not "key" then
      put waAccountNode() into tNode
      if tNode["kind"] is not "private" then
         throw "this wallet has no private key loaded, so it cannot sign."
      end if
   end if
   -- taproot commits to every input's scriptPubKey and amount, so those are
   -- gathered before the loop rather than per input
   put waEmptyList() into tScripts
   put waEmptyList() into tAmounts
   put cwListCount(pSel) into tCount
   repeat with tI = 1 to tCount
      put pSel[tI] into tRec
      put waRecordFor(tRec["address"]) into tAddrRec
      if tAddrRec is "" then
         throw "coin " & tI & " is at " & tRec["address"] & \
               ", which is not an address this wallet derives. It cannot be signed here."
      end if
      put cwListAdd(tScripts, tAddrRec["script"]) into tScripts
      put cwListAdd(tAmounts, tRec["value"]) into tAmounts
   end repeat
   repeat with tI = 1 to tCount
      put pSel[tI] into tRec
      put waRecordFor(tRec["address"]) into tAddrRec
      if sWaKind is "multisig" then
         put tAddrRec["witnessscript"] into tWs
         put waCosignerKeys(tAddrRec) into tKeys
         put cwSighash("p2wsh", tVersion, pInputs, pOutputs, tI, pLock, "", \
               tRec["value"], tWs, waEmptyList(), waEmptyList()) into tDigest
         put cwSignMultisig(tKeys, tDigest, tWs) into tSig
         -- A PARTIAL WITNESS IS NOT A SIGNED TRANSACTION. cwSignMultisig
         -- makes a signature for every script key it holds, which for one
         -- cosigner of three is one - a correct partial result whose right
         -- home is a PSBT, not a raw transaction. Presenting it as SIGNED
         -- handed a person a transaction the network refuses, with nothing
         -- on screen to say why.
         if tSig["complete"] is not true then
            throw "this input needs " & tSig["required"] & " signatures " & \
                  "and this wallet holds " & tSig["signed"] & " of them. " & \
                  "Export it as a PSBT instead (the button beside Sign), " & \
                  "send it to your cosigners, and combine what comes back " & \
                  "on the Tools screen."
         end if
      else if tAddrRec["leafscript"] is not "" then
         -- an inscription commit: spent through its leaf, signed by the
         -- INTERNAL key the leaf script names (waLeafRecord)
         put cwTapscriptSighash(tVersion, pInputs, pOutputs, tI, pLock, \
               tScripts, tAmounts, tAddrRec["leafhash"]) into tDigest
         put cwSignTapscript(waSeckeyFor(tAddrRec), tDigest, \
               tAddrRec["leafscript"], tAddrRec["controlblock"]) into tSig
      else if waRecordType(tAddrRec) is "p2tr" then
         put cwSighash("p2tr", tVersion, pInputs, pOutputs, tI, pLock, "", 0, "", \
               tScripts, tAmounts) into tDigest
         put cwSignTaproot(waSeckeyFor(tAddrRec), tDigest, "") into tSig
      else
         -- PER INPUT, not per wallet. See waRecordType.
         put waRecordType(tAddrRec) into tInType
         put cwSighash(tInType, tVersion, pInputs, pOutputs, tI, pLock, \
               tAddrRec["pubkey"], tRec["value"], "", waEmptyList(), \
               waEmptyList()) into tDigest
         put cwSignInput(tInType, waSeckeyFor(tAddrRec), tDigest, \
               tAddrRec["pubkey"]) into tSig
      end if
      put cwListAdd(tSigs, tSig["scriptsig"]) into tSigs
      put cwListAdd(tWits, tSig["witness"]) into tWits
   end repeat
   put empty into tNode
   put cwTxSerialize(tVersion, pInputs, pOutputs, pLock, tSigs, tWits) into tRaw
   put tRaw into sWaLastRaw
   return tRaw
end waSignSpend

private function waSeckeyFor pAddrRec
   -- The private key for one derived address, re-derived on demand. The
   -- record carries it when the account node held the private half; a
   -- watch-only wallet's records do not, and this is where that becomes a
   -- clean refusal rather than a signature over nothing.
   local tInfo
   if pAddrRec["seckey"] is not "" then
      return pAddrRec["seckey"]
   end if
   if sWaKind is "key" and sWaImportedWif is not empty then
      -- a function result cannot be subscripted in this dialect, so the
      -- record lands in a local first
      put cxWifDecode(sWaImportedWif) into tInfo
      return tInfo["seckey"]
   end if
   throw "no private key for " & pAddrRec["address"] & \
         ". This wallet is watch-only for that address."
end waSeckeyFor

private function waCosignerKeys pAddrRec
   -- The cosigner keys THIS wallet holds for a multisig input. Normally one:
   -- the other signatures come from the other cosigners, through a PSBT.
   local tKeys, tNode, tRec
   put waEmptyList() into tKeys
   if sWaAccountXprv is empty then
      return tKeys
   end if
   put cwXKeyDecode(sWaAccountXprv, sWaNetwork, sWaScriptType) into tNode
   put cwChainNode(tNode, pAddrRec["change"], pAddrRec["index"]) into tRec
   put empty into tNode
   return cwListAdd(tKeys, cxHexEncode(tRec["seckey"]))
end waCosignerKeys

function waMakePsbt pInputs, pOutputs, pSel, pLock
   -- A PSBT carrying everything a signer needs and nothing it does not: the
   -- witness UTXO (so BIP-143 has the amount it commits to), the redeem or
   -- witness script where the type needs one, the taproot internal key where
   -- it does, and the BIP-32 derivation so a signer can find the key without
   -- being told which one.
   local tMeta, tI, tCount, tRec, tAddrRec, tType, tKeys, tVersion, tOutMeta
   local tOurPub
   put waInputType() into tType
   put 2 into tVersion
   if tType is "p2pkh" then
      put 1 into tVersion
   end if
   put empty into tMeta
   put cwListCount(pSel) into tCount
   repeat with tI = 1 to tCount
      put pSel[tI] into tRec
      put waRecordFor(tRec["address"]) into tAddrRec
      put "" into tMeta[tI]
      -- A WITNESS UTXO for every input, including a legacy one. BIP-174
      -- wants NON_WITNESS_UTXO (the whole previous transaction) for a legacy
      -- input, and a strict external signer is entitled to refuse this PSBT
      -- for that reason. It is not supplied because this wallet may be
      -- OFFLINE and has no way to fetch a previous transaction it was never
      -- given - and a witness UTXO is exactly what a legacy sighash needs
      -- from it anyway. Own signer, own PSBTs: fine. Handing one to a
      -- hardware wallet for a legacy input: expect a refusal, and use a
      -- SegWit or taproot wallet for that.
      put tAddrRec["script"] into tMeta[tI]["witnessutxoscript"]
      put tRec["value"] into tMeta[tI]["witnessutxovalue"]
      if tAddrRec["redeem"] is not "" then
         put tAddrRec["redeem"] into tMeta[tI]["redeemscript"]
      end if
      if tAddrRec["witnessscript"] is not "" then
         put tAddrRec["witnessscript"] into tMeta[tI]["witnessscript"]
      end if
      if tAddrRec["internalkey"] is not "" then
         put tAddrRec["internalkey"] into tMeta[tI]["tapinternalkey"]
      end if
      -- THE DERIVATION FIELD DEPENDS ON THE INPUT TYPE, and writing one
      -- shape for all three was wrong twice. BIP-371 gives taproot its own
      -- key type (PSBT_IN_TAP_BIP32_DERIVATION, keyed by the X-ONLY key with
      -- a leaf-hash count in front); a taproot input carrying the ordinary
      -- type-6 entry keyed by a 33-byte key tells a strict signer nothing it
      -- can use. And a multisig record has no "pubkey" at all - it carries
      -- "pubkeys", one per cosigner - so the test below simply failed and
      -- the input went out with NO derivation of any kind, which is the one
      -- thing a cosigner's wallet needs to find its own key.
      if sWaFingerprint is not "" then
         if tAddrRec["internalkey"] is not "" then
            put waEmptyList() into tKeys
            put cwListAdd(tKeys, waBip32Record(tAddrRec, \
                  tAddrRec["internalkey"])) into tKeys
            put tKeys into tMeta[tI]["tapbip32"]
         else if tAddrRec["witnessscript"] is not "" then
            -- one entry for OUR cosigner key: the others' derivations are
            -- theirs to know, and claiming them would be a guess
            put waOurPubkeyAt(tAddrRec) into tOurPub
            if tOurPub is not "" then
               put waEmptyList() into tKeys
               put cwListAdd(tKeys, waBip32Record(tAddrRec, tOurPub)) into tKeys
               put tKeys into tMeta[tI]["bip32"]
            end if
         else if tAddrRec["pubkey"] is not "" then
            put waEmptyList() into tKeys
            put cwListAdd(tKeys, waBip32Record(tAddrRec, \
                  tAddrRec["pubkey"])) into tKeys
            put tKeys into tMeta[tI]["bip32"]
         end if
      end if
   end repeat
   put empty into tOutMeta
   return cwPsbtCreate(tVersion, pInputs, pOutputs, pLock, tMeta, tOutMeta)
end waMakePsbt

private function waOurPubkeyAt pAddrRec
   -- THIS wallet's cosigner public key at a multisig address's chain
   -- position. Derived from the account XPUB, never from the private half:
   -- a watch-only multisig wallet must be able to say which of the n keys is
   -- its own, and materialising a secret to answer a public question is how
   -- key material ends up somewhere nobody expected it.
   local tNode, tError
   if sWaAccountXpub is empty then
      return ""
   end if
   try
      put cwChainNode(cwXKeyDecode(sWaAccountXpub, sWaNetwork, sWaScriptType), \
            pAddrRec["change"], pAddrRec["index"]) into tNode
   catch tError
      return ""
   end try
   return cxHexEncode(tNode["pubkey"])
end waOurPubkeyAt

private function waBip32Record pAddrRec, pPubkeyHex
   local tRec
   put pPubkeyHex into tRec["pubkey"]
   put sWaFingerprint into tRec["fingerprint"]
   put waAccountPath() & \
         pAddrRec["suffix"] into tRec["path"]
   return tRec
end waBip32Record

