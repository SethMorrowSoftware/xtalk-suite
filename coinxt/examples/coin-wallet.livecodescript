-- ==============================================================================
-- THE CLICK ROUTER
--
-- One mouseUp, a "<screen>_<role>" naming scheme, and a dispatch by role. A
-- disabled control never reaches here, which is how the wallet gates a flow:
-- a button that cannot yet do anything is disabled and says so, rather than
-- being clickable and then complaining.
-- ==============================================================================

command waEnsureBooted
   -- WHY THIS EXISTS: waBoot runs from openStack, and openStack fires when a
   -- stack is OPENED. Paste this script into a stack that is already open -
   -- which is how somebody tries it the first time - and openStack has
   -- already fired, so waBoot never runs at all: no capability probe, no
   -- wallet, no state. Every symptom of that is misleading rather than
   -- absent. sWaHaveOnion is empty, so `is not "true"`, so a transport
   -- reports that OnionXT did not answer when OnionXT is embedded three
   -- thousand lines above and fine. sWaScriptType is empty, so wallet-core
   -- refuses "unknown script type """ about a variable nobody assigned.
   -- Both were reported from a real engine as two separate defects; they are
   -- one, and neither is what it looks like.
   --
   -- So the wallet boots itself the first time anybody touches it. Reopening
   -- the stack is still the documented way and still the better one - this is
   -- the safety net, not the mechanism.
   if sWaBooted is "true" then
      exit waEnsureBooted
   end if
   put "true" into sWaBooted
   waBoot
end waEnsureBooted

on mouseDown pWhich
   -- THE RIGHT-CLICK MENU, and it must never cost the ordinary click.
   --
   -- Button 3 is the contextual click. Everything else passes straight
   -- through, so mouseUp's router below is untouched - and even for button 3
   -- the popup goes through uiPopupMenu, which ANSWERS rather than throwing.
   -- On an engine without popup menus the right-click does nothing and the
   -- wallet is otherwise exactly as it was.
   --
   -- NONE OF THIS HAS RUN ON AN ENGINE. `popup`, `menuMode` and `menuPick`
   -- are documented LiveCode and OpenXTalk is a fork of it, but this suite
   -- has never opened a menu and the headless runners model no mouse button,
   -- so what the gate can settle is the menu's CONTENT and its ROUTING - what
   -- each screen offers, and that picking an item does the same thing the
   -- button does. That the menu APPEARS needs an OXT pass.
   local tError, tName, tLine
   if pWhich is not 3 then
      pass mouseDown
   end if
   waEnsureBooted
   -- THE ROW UNDER THE CURSOR IS THE ROW THE MENU ACTS ON. A list field
   -- moves its selection on button 1 only, so a right-click on a table popped
   -- a menu whose Inspect, Copy and Freeze acted on whatever had been clicked
   -- BEFORE - the "needs a second look for usability" of the 2026-09-02
   -- engine report, the first time the menu was seen to open. Selecting first
   -- is the whole of the fix: every item reads the hilitedLine at the moment
   -- it acts. Contained, so an engine that answers the clickLine oddly still
   -- gets its menu, on the old selection.
   try
      put the short name of the target into tName
      if word 1 of the name of the target is "field" and tName ends with "_table" then
         put word 2 of the clickLine into tLine
         if tLine is an integer then
            set the hilitedLine of the target to tLine
         end if
      end if
   catch tError
   end try
   try
      if uiPopupMenu(waMenuFor(sWaScreen)) is false then
         pass mouseDown
      end if
   catch tError
      pass mouseDown
   end try
end mouseDown

on menuPick pItem
   -- The item's LABEL is all the engine sends, so the menu it came from is
   -- read back from the kit rather than guessed from the label: two screens
   -- may both offer "Copy" and mean different things by it.
   local tError
   set the defaultStack to the short name of this stack
   try
      waMenuPick uiMenuSource(), pItem
   catch tError
      uiStatus tError, "bad"
   end try
end menuPick

on mouseUp
   local tName, tPrefix, tRole, tError, tI
   waEnsureBooted
   -- BUTTONS ONLY. Fields carry the same "<screen>_<role>" names, and routing
   -- a click on one would run that screen's repaint - which writes the stored
   -- value back over whatever the person had just typed into the field they
   -- clicked. Table selections are read at the moment a button acts on them,
   -- so nothing needs a field click to be routed.
   if word 1 of the name of the target is not "button" then
      pass mouseUp
   end if
   put the short name of the target into tName
   if char 3 of tName is not "_" then
      pass mouseUp
   end if
   put char 1 to 2 of tName into tPrefix
   put char 4 to -1 of tName into tRole
   if waRouteKnows(tPrefix) is not true then
      pass mouseUp
   end if
   try
      waRouteClick tPrefix, tRole
   catch tError
      -- EVERY failure reaches the person, on the status line and in the log.
      -- A wallet that swallows an error has decided on the user's behalf that
      -- they did not need to know why nothing happened.
      uiStatus line 1 of tError, "bad"
      waLog "error: " & tError
   end try
end mouseUp

function waRouteKnows pPrefix
   -- Is this two-letter prefix one of the eleven screens' routers? Asked
   -- before dispatching so an unknown prefix can `pass mouseUp` from the
   -- handler that owns the message, rather than from inside a helper that
   -- cannot pass on its caller's behalf.
   return "nv,wl,rc,ad,sd,cn,hs,od,vt,tl,nw,lg,st" contains pPrefix
end waRouteKnows

command waRouteClick pPrefix, pRole
   -- THE ONE DISPATCH, shared by the buttons and the context menu. It used to
   -- live inside mouseUp, which is why a menu item had no way to mean "the
   -- same thing that button means" except by copying the call - and a copy is
   -- what drifts.
   if pPrefix is "nv" then
      waNavClick pRole
   else if pPrefix is "wl" then
      waWalletClick pRole
   else if pPrefix is "rc" then
      waReceiveClick pRole
   else if pPrefix is "ad" then
      waAddressesClick pRole
   else if pPrefix is "sd" then
      waSendClick pRole
   else if pPrefix is "cn" then
      waCoinsClick pRole
   else if pPrefix is "hs" then
      waHistoryClick pRole
   else if pPrefix is "od" then
      waOrdinalsClick pRole
   else if pPrefix is "vt" then
      waVaultClick pRole
   else if pPrefix is "tl" then
      waToolsClick pRole
   else if pPrefix is "nw" then
      waNetworkClick pRole
   else if pPrefix is "lg" then
      waLogClick pRole
   else if pPrefix is "st" then
      waSettingsClick pRole
   else
      throw "no screen owns the prefix " & quote & pPrefix & quote & "."
   end if
end waRouteClick

function waMenuRoute pItem
   -- THE CLICK THIS MENU ITEM STANDS FOR, as the same "<prefix> <role>" pair
   -- mouseUp builds out of a button's name - so an item means exactly what
   -- the button means, by construction rather than by agreement.
   --
   -- Items this router performs itself answer "self". Anything else answers
   -- EMPTY, and waMenuPick throws on empty, so a menu that grows an item
   -- nobody wired is a failed check rather than a click that quietly does
   -- nothing. tools/check-wallet-boot.py walks every item of every screen's
   -- menu through here for exactly that reason.
   if pItem is "-" then
      return "self"
   end if
   if pItem is "Refresh" or pItem is "About this wallet" \
         or pItem is "Copy seed phrase" then
      return "self"
   end if
   if pItem is "Update from main" then
      return "st update"
   end if
   if pItem is "Copy account key" then
      return "wl copyXpub"
   end if
   if pItem is "Copy descriptor" then
      return "wl copyDesc"
   end if
   if pItem is "Copy address" then
      return "rc copy"
   end if
   if pItem is "Copy payment URI" then
      return "rc copyUri"
   end if
   if pItem is "Next unused address" then
      return "rc next"
   end if
   -- THREE ITEMS ROUTED TO THE WRONG BUTTON until 2026-09-03, and the gate
   -- could not see it: it proves every route names a control the registry
   -- carries, and "ad receive" IS a control - the receive-chain toggle. So
   -- "Copy selected address" switched the chain view, "Prove this address"
   -- ran a sync (ad scan), and "Copy selected outpoint" named the coins
   -- DETAIL FIELD, which no click handler answers. Reported from the engine
   -- as the menu failing to copy the selected address. The Addresses and
   -- Coins screens have no copy button, so these are the router's own.
   if pItem is "Copy selected address" or pItem is "Sign a message with it" \
         or pItem is "Copy selected outpoint" then
      return "self"
   end if
   if pItem is "Derive twenty more" then
      return "ad more"
   end if
   if pItem is "Paste a payment URI" then
      return "sd paste"
   end if
   if pItem is "Pay myself" then
      return "sd addSelf"
   end if
   if pItem is "Clear the form" then
      return "sd clear"
   end if
   if pItem is "Freeze or thaw" then
      return "cn freeze"
   end if
   if pItem is "Tick all" then
      return "cn tickAll"
   end if
   if pItem is "Tick none" then
      return "cn tickNone"
   end if
   if pItem is "Copy txid" then
      return "hs copyTxid"
   end if
   if pItem is "Inspect this transaction" then
      return "hs inspect"
   end if
   if pItem is "Bump the fee" then
      return "hs bump"
   end if
   if pItem is "Prepare the commit" then
      return "od prepare"
   end if
   if pItem is "Sign the reveal" then
      return "od reveal"
   end if
   if pItem is "Read what is in the box" then
      return "od read"
   end if
   if pItem is "Copy the commit address" then
      return "od copyAddr"
   end if
   if pItem is "Prepare the locked address" then
      return "vt prepare"
   end if
   if pItem is "Copy the locked address" then
      return "vt copyAddr"
   end if
   if pItem is "Copy the result" then
      return "tl copyOut"
   end if
   if pItem is "Inspect what is in the box" then
      return "tl inspect"
   end if
   if pItem is "Validate it" then
      return "tl validate"
   end if
   if pItem is "Decode it as a script" then
      return "tl decode"
   end if
   if pItem is "Words to entropy" then
      return "tl toEntropy"
   end if
   if pItem is "Copy the log" then
      return "lg copy"
   end if
   if pItem is "Clear the log" then
      return "lg clear"
   end if
   return ""
end waMenuRoute

function waMenuFor pScreen
   -- ONE MENU PER SCREEN, built on demand so it describes the screen a person
   -- is actually looking at. The items are the things they reach for and the
   -- buttons make awkward: copying what is in front of them, and the actions
   -- that belong to the row they just clicked.
   --
   -- Every screen's menu ends with the same two items, because a menu that
   -- differs everywhere is a menu nobody learns.
   local tItems, tName
   put "menu_" & pScreen into tName
   put "" into tItems
   if pScreen is "wallet" then
      put "Copy account key" & return & "Copy descriptor" & return & \
            "Copy seed phrase" & return & "-" & return into tItems
   else if pScreen is "receive" then
      put "Copy address" & return & "Copy payment URI" & return & \
            "Next unused address" & return & "-" & return into tItems
   else if pScreen is "addresses" then
      put "Copy selected address" & return & "Sign a message with it" & return & \
            "Derive twenty more" & return & "-" & return into tItems
   else if pScreen is "send" then
      put "Paste a payment URI" & return & "Pay myself" & return & \
            "Clear the form" & return & "-" & return into tItems
   else if pScreen is "coins" then
      put "Copy selected outpoint" & return & "Freeze or thaw" & return & \
            "Tick all" & return & "Tick none" & return & "-" & return into tItems
   else if pScreen is "history" then
      put "Copy txid" & return & "Inspect this transaction" & return & \
            "Bump the fee" & return & "-" & return into tItems
   else if pScreen is "tools" then
      put "Copy the result" & return & "Inspect what is in the box" & return & \
            "Validate it" & return & "Decode it as a script" & return & \
            "Words to entropy" & return & "-" & return into tItems
   else if pScreen is "ordinals" then
      put "Prepare the commit" & return & "Sign the reveal" & return & \
            "Read what is in the box" & return & "Copy the commit address" & \
            return & "-" & return into tItems
   else if pScreen is "vault" then
      put "Prepare the locked address" & return & "Copy the locked address" & \
            return & "-" & return into tItems
   else if pScreen is "log" then
      put "Copy the log" & return & "Clear the log" & return & "-" & return into tItems
   end if
   put tItems & "Refresh" & return & "About this wallet" & return & \
         "Update from main" into tItems
   uiContextMenu tName, tItems
   return tName
end waMenuFor

command waMenuPick pMenu, pItem
   -- EVERY ITEM IS A ROUTE TO A HANDLER THAT ALREADY EXISTS. A menu that
   -- grows its own copies of what the buttons do is a menu that drifts out of
   -- agreement with them, which is this member's own recorded failure shape,
   -- so this resolves the item to a (prefix, role) pair and hands it to the
   -- SAME dispatcher the buttons use.
   local tRoute, tAddr, tKey
   set the defaultStack to the short name of this stack
   put waMenuRoute(pItem) into tRoute
   if tRoute is "" then
      throw "the menu offered " & quote & pItem & quote & \
            " and nothing routes it."
   end if
   if tRoute is "self" then
      if pItem is "Refresh" then
         waRefreshAll
      else if pItem is "About this wallet" then
         waShow "settings"
      else if pItem is "Copy selected address" then
         put waSelectedAddress() into tAddr
         if tAddr is "" then
            throw "select an address row first."
         end if
         set the clipboardData["text"] to tAddr
         uiStatus tAddr & " is on the clipboard.", "ok"
      else if pItem is "Sign a message with it" then
         put waSelectedAddress() into tAddr
         if tAddr is "" then
            throw "select an address row first."
         end if
         -- shown first, then filled: the screen's paint owns its fields
         waShow "tools"
         put tAddr into field "tl_msgAddr"
         uiStatus "Type the message and press Sign; " & tAddr & \
               " is filled in.", ""
      else if pItem is "Copy selected outpoint" then
         put waSelectedCoinKey() into tKey
         if tKey is "" then
            throw "select a coin row first."
         end if
         set the clipboardData["text"] to tKey
         uiStatus tKey & " is on the clipboard.", "ok"
      else if pItem is "Copy seed phrase" then
         if sWaMnemonic is empty then
            throw "this wallet has no seed phrase to copy."
         end if
         set the clipboardData["text"] to sWaMnemonic
         uiStatus "The seed phrase is on the clipboard. Clear it when you " & \
               "are done - anything that reads the clipboard can spend it.", "warn"
      end if
      exit waMenuPick
   end if
   waRouteClick word 1 of tRoute, word 2 of tRoute
end waMenuPick

command waNavClick pRole
   local tI
   repeat with tI = 1 to kWaScreenCount
      if waScreenCode(tI) is pRole then
         waShow waScreenName(tI)
         exit waNavClick
      end if
   end repeat
   if pRole is "refresh" then
      waRefreshAll
      if sWaBackend is not "offline" then
         waSyncIfIdle
      end if
   end if
end waNavClick

command waSyncIfIdle
   -- A refresh is a REPAINT that would also like fresh data, and the two must
   -- not be confused: the Tor log of 2026-09-02 has "a sync is already
   -- running" seven times, each one the nav rail's Refresh pressed while a
   -- slow Tor sync was still walking its queue - which, before the
   -- one-sync-at-a-time guard, had been appending a whole second batch each
   -- time, and after it was an error line about the very thing the person
   -- was waiting for. Refresh now starts a sync only when none is running,
   -- and otherwise says where the running one is, as information. The Sync
   -- button on the Network screen keeps the refusal, because pressing SYNC
   -- during a sync is the one case where a person meant to start another.
   if cwListCount(sWaQueue) > 0 then
      uiStatus "A sync is already running, " & cwListCount(sWaQueue) & \
            " request(s) to go. This repainted what has arrived so far.", ""
      exit waSyncIfIdle
   end if
   waSync
end waSyncIfIdle

-- ==============================================================================
-- THE WALLET MODEL
--
-- CoinXT holds a key for the microseconds of one operation and this stack
-- holds it for the lifetime of a window, which is the whole difference
-- between a calculator and a wallet, and the whole of what makes custody the
-- app's problem. So: the seed lives in one script local, the account private
-- key is derived from it and kept only while a seed wallet is open, and every
-- signing path re-derives the one key it needs and clears it on the way out.
-- ==============================================================================

constant kWaElectrumSalt = "electrum"

function waSeedFormatOf pText
   -- WHAT KIND OF PHRASE THIS IS, by asking the phrase rather than the person:
   -- "bip39", "electrum-standard", "electrum-segwit", "electrum-2fa", or
   -- empty for a phrase that is none of them.
   --
   -- An Electrum seed is twelve words from the SAME English list as BIP-39,
   -- and it fails BIP-39's checksum BY DESIGN - Electrum's generator rejects
   -- any phrase that would also validate as BIP-39, so the two formats never
   -- collide and BIP-39 can be asked first. Its own check is the hex prefix of
   -- HMAC-SHA512 keyed "Seed version" over the normalised phrase: "01" for the
   -- original (legacy p2pkh, receive m/0/i and change m/1/i straight off the
   -- master), "100" for segwit (p2wpkh under m/0'), "101" and "102" for the
   -- two-factor kinds that need TrustedCoin's third key and which this wallet
   -- cannot open. What made this worth having is the engine log that arrived
   -- 2026-09-01: twenty-seven identical "does not pass its BIP-39 checksum"
   -- lines from a person whose phrase almost certainly was not BIP-39 at all,
   -- and nothing on screen that could have told them so.
   local tWords, tHex
   put cxMnemonicNormalize(cwTrim(pText)) into tWords
   if tWords is "" then
      return ""
   end if
   if cxMnemonicValidate(tWords) is true then
      return "bip39"
   end if
   put cxHexEncode(cxHmacSha512("Seed version", tWords)) into tHex
   if char 1 to 2 of tHex is "01" then
      return "electrum-standard"
   end if
   if char 1 to 3 of tHex is "100" then
      return "electrum-segwit"
   end if
   if char 1 to 3 of tHex is "101" or char 1 to 3 of tHex is "102" then
      return "electrum-2fa"
   end if
   return ""
end waSeedFormatOf

function waMnemonicProblem pText
   -- EMPTY when the phrase can open a wallet here, otherwise WHY NOT - and
   -- the why is the specific one. The sentence this replaced said only that
   -- the checksum failed, and a checksum failure is the LEAST useful thing to
   -- know about a phrase: it does not say whether a word is misspelt, which
   -- word, whether there are eleven words instead of twelve, or whether the
   -- phrase is a perfectly good seed from another wallet. cxMnemonicToEntropy
   -- already throws every one of those distinctions by name and this app was
   -- discarding them.
   local tWords, tFormat, tError, tWhy, tCount, tSavedDelim
   put cxMnemonicNormalize(cwTrim(pText)) into tWords
   if tWords is "" then
      return "the seed box is empty."
   end if
   put waSeedFormatOf(tWords) into tFormat
   if tFormat is "bip39" or tFormat is "electrum-standard" \
         or tFormat is "electrum-segwit" then
      return ""
   end if
   if tFormat is "electrum-2fa" then
      return "that is an Electrum TWO-FACTOR seed. Those wallets are 2-of-3 " & \
            "with a key held by TrustedCoin, and this wallet cannot open one. " & \
            "Electrum itself can, and can export the keys from there."
   end if
   put "" into tWhy
   try
      get cxMnemonicToEntropy(tWords)
   catch tError
      put line 1 of tError into tWhy
   end try
   -- the library prefixes its throws with its own name; a person does not
   -- need to know which function said it
   if tWhy begins with "CoinXT: cxMnemonicToEntropy: " then
      put char 30 to -1 of tWhy into tWhy
   end if
   if tWhy is "" then
      put "it is not a BIP-39 phrase and not an Electrum seed." into tWhy
   end if
   put the itemDelimiter into tSavedDelim
   set the itemDelimiter to space
   put the number of items of tWords into tCount
   set the itemDelimiter to tSavedDelim
   return tWhy & " (" & tCount & " word(s) given.)"
end waMnemonicProblem

command waDeriveAccount
   -- Turn whatever the user gave us into the account-level key material every
   -- other screen works from. Four wallet kinds arrive here and each one ends
   -- with the same two facts: an account extended PUBLIC key (always) and an
   -- account extended private key (only when we actually hold the secret).
   local tSeed, tMaster, tNode, tPath, tError, tRec, tWhy, tFormat
   local tFp, tXprv, tXpub
   -- THE TWO NON-SEED KINDS EXIT BEFORE ANYTHING IS CLEARED. Their account
   -- key did not come from a mnemonic and cannot be re-derived from one, so
   -- clearing it first and then reading it back - which is what this handler
   -- used to do, decoding an sWaAccountXpub it had emptied three lines
   -- earlier - destroyed the only copy of a watch-only wallet's account key
   -- on any path that re-derives, waSetNetwork's among them.
   if sWaKind is "watch" then
      -- Nothing to re-derive, but the network may just have changed under a
      -- key that belongs to the other chain. Refuse that the same way
      -- waOpenWallet does rather than showing one chain's addresses.
      if sWaAccountXpub is not empty then
         put cwXKeyDecode(sWaAccountXpub, sWaNetwork, sWaScriptType) into tNode
         if tNode["network"] is not sWaNetwork then
            throw "the account key this wallet is watching belongs to " & \
                  tNode["network"] & ", and the wallet is now on " & \
                  sWaNetwork & ". Switch back, or paste a key for this chain."
         end if
         -- and the addresses are RE-ENCODED for the chain that passed the
         -- check: testnet and signet spell them the same, regtest does not
         waDeriveAddresses
      end if
      exit waDeriveAccount
   end if
   if sWaKind is "key" then
      -- a single imported key has no account and no chain; the Addresses
      -- screen shows exactly one address per script type and says so
      exit waDeriveAccount
   end if
   if sWaMnemonic is empty then
      put empty into sWaAccountXpub
      put empty into sWaAccountXprv
      put empty into sWaFingerprint
      exit waDeriveAccount
   end if
   -- VALIDATED BEFORE ANYTHING IS CLEARED. This handler used to empty the
   -- account key, the private key and the fingerprint and THEN test the
   -- phrase, so a phrase that failed took the open wallet down with it: no
   -- account, no addresses, and every screen reading an empty key. The engine
   -- log of 2026-09-01 is what that looks like from the outside - the same
   -- error twenty-seven times, from a wallet that had nothing left to show.
   -- Now the new key material is built in locals and the three fields are
   -- written together at the end, so a throw anywhere above leaves whatever
   -- was open still open.
   -- THE FORMAT IS ASKED ONCE. waSeedFormatOf and waMnemonicProblem each walk
   -- the phrase against the 2048-word list, and asking both on the path that
   -- succeeds doubled the cost of every derive for no answer the first had
   -- not already given. The problem is asked only when the format says there
   -- is one.
   put waSeedFormatOf(sWaMnemonic) into tFormat
   if tFormat is "" or tFormat is "electrum-2fa" then
      put waMnemonicProblem(sWaMnemonic) into tWhy
      throw "that seed phrase cannot open a wallet: " & tWhy & \
            " Nothing has been derived, and whatever was open is still open."
   end if
   -- THE SEED BYTES DEPEND ON THE FORMAT, and only the seed bytes do: from
   -- the master key down, an Electrum wallet is ordinary BIP-32 at a path
   -- this app already lets a person type (m/0' for segwit, the master itself
   -- for the original kind), so everything below this line is shared.
   -- Electrum salts its PBKDF2 with "electrum" where BIP-39 uses "mnemonic";
   -- same rounds, same length, same passphrase rule.
   if tFormat begins with "electrum" then
      put cxPbkdf2HmacSha512(cxMnemonicNormalize(sWaMnemonic), \
            kWaElectrumSalt & sWaPassphrase, kCxBip39Rounds, 64) into tSeed
   else
      put cxMnemonicToSeed(cxMnemonicNormalize(sWaMnemonic), sWaPassphrase) into tSeed
   end if
   put cxHdFromSeed(tSeed) into tMaster
   put empty into tSeed
   put cwFingerprint(cxHexEncode(tMaster["pubkey"])) into tFp
   put waAccountPath() into tPath
   put cxHdDerivePath(tMaster, tPath) into tNode
   put cwXKeyEncode(tNode, cwXKeyVersion(sWaNetwork, sWaScriptType, false), true) \
         into tXprv
   put cwXKeyEncode(cxHdNeuter(tNode), \
         cwXKeyVersion(sWaNetwork, sWaScriptType, true), false) into tXpub
   put empty into tMaster
   put empty into tNode
   put tFp into sWaFingerprint
   put tXprv into sWaAccountXprv
   put tXpub into sWaAccountXpub
   put empty into tXprv
   waDeriveAddresses
end waDeriveAccount

function waAccountPath
   -- THE ACCOUNT PATH THIS WALLET ACTUALLY DERIVES FROM.
   --
   -- cwAccountPath answers the STANDARD path for a script type - BIP-44's
   -- purpose 44, BIP-84's 84, BIP-48's extra level - and until now that was
   -- the only answer this app could give. It is not the only path in
   -- circulation: Electrum's legacy wallets sit at m/0', early Bitcoin Core
   -- at m/0'/0', and plenty of hardware wallets have shipped their own. A
   -- person recovering one of those has correct words and no way to say where
   -- to look, and a wallet that can only find the addresses it would itself
   -- have made is a wallet that cannot recover.
   --
   -- ONE ACCESSOR, because the path is not a display string: it is in the
   -- descriptor this wallet exports and in the BIP32_DERIVATION a cosigner
   -- uses to find its own key in a PSBT. Eight readers each had their own
   -- copy of the call, and a ninth that missed the override would hand
   -- somebody a descriptor for a wallet that is not this one.
   --
   -- The override is validated where it is SET, so every reader here gets a
   -- path that has already parsed.
   if sWaCustomPath is not empty then
      return sWaCustomPath
   end if
   return cwAccountPath(sWaScriptType, sWaNetwork, sWaAccount)
end waAccountPath

private function waCheckedPath pText
   -- A PATH TYPED BY HAND, OR READ OUT OF A WALLET FILE. cwParsePath is the
   -- authority and is vector-tested: it refuses a trailing separator (the
   -- engine's ignore-one-delimiter rule made "m/84'/" parse as a good
   -- one-level path once already), an empty level, a non-numeric level, and a
   -- level at or above 2^31.
   --
   -- The depth cap is this handler's own. BIP-32 serializes depth in ONE
   -- byte, and this path gets two more levels below it before an address, so
   -- a path deeper than 253 could not round-trip through an extended key. 32
   -- is far below that and far above anything in circulation; the point is
   -- that the refusal is a sentence rather than a truncated byte.
   local tLevels, tTrimmed
   put cwTrim(pText) into tTrimmed
   if tTrimmed is "" then
      return ""
   end if
   put cwParsePath(tTrimmed) into tLevels
   if cwListCount(tLevels) > 32 then
      throw "that path is " & cwListCount(tLevels) & " levels deep. This " & \
            "wallet derives two more below it for the chain and the index, " & \
            "and BIP-32 has one byte for the depth."
   end if
   return tTrimmed
end waCheckedPath

function waAccountNode
   -- The account node, rebuilt on demand from whichever half we hold. A
   -- watch-only wallet answers with a neutered node and everything that only
   -- needs public keys keeps working; anything that needs to sign asks for
   -- the private half separately and gets a clean refusal.
   if sWaAccountXprv is not empty then
      return cwXKeyDecode(sWaAccountXprv, sWaNetwork, sWaScriptType)
   end if
   if sWaAccountXpub is not empty then
      return cwXKeyDecode(sWaAccountXpub, sWaNetwork, sWaScriptType)
   end if
   throw "this wallet has no account key yet. Open one on the Wallet screen."
end waAccountNode

command waDeriveAddresses
   -- Derive both chains to the prefill window. Non-hardened both steps, which
   -- is exactly why a watch-only wallet holding only the account xpub can
   -- follow them - and the reason the account level sits where it does.
   local tNode, tI, tRec, tList, tCosigners, tJ, tCount
   put waEmptyList() into tList
   if sWaKind is "key" then
      put waImportedRecords() into sWaAddresses
      exit waDeriveAddresses
   end if
   if sWaKind is "multisig" then
      put cwListCount(sWaCosigners) into tCount
      if tCount < 1 then
         put tList into sWaAddresses
         exit waDeriveAddresses
      end if
      put waEmptyList() into tCosigners
      repeat with tJ = 1 to tCount
         put cwListAdd(tCosigners, cwXKeyDecode(sWaCosigners[tJ], sWaNetwork, \
               "p2wsh")) into tCosigners
      end repeat
      repeat with tJ = 0 to 1
         repeat with tI = 0 to (kWaPrefill - 1)
            put cwMultisigAddressAt(tCosigners, sWaM, sWaNetwork, tJ, tI, true) into tRec
            put cwListAdd(tList, tRec) into tList
         end repeat
      end repeat
      put tList into sWaAddresses
      exit waDeriveAddresses
   end if
   put waAccountNode() into tNode
   repeat with tJ = 0 to 1
      repeat with tI = 0 to (kWaPrefill - 1)
         put cwAddressAt(tNode, sWaScriptType, sWaNetwork, tJ, tI) into tRec
         put cwListAdd(tList, tRec) into tList
      end repeat
   end repeat
   put empty into tNode
   put tList into sWaAddresses
   waLeavesAttach
end waDeriveAddresses

private function waImportedRecords
   local tInfo, tList, tRec, tAddr, tType
   put waEmptyList() into tList
   if sWaImportedWif is empty then
      return tList
   end if
   put cwWifInfo(sWaImportedWif, sWaNetwork) into tInfo
   put sWaScriptType into tType
   put tInfo[tType] into tAddr
   if tAddr is "" then
      -- AN UNCOMPRESSED KEY HAS NO SEGWIT ADDRESS - BIP-143 forbids one, so
      -- cwWifInfo leaves both SegWit slots empty and the only address this
      -- key has is legacy. Falling back is right; recording the fallback as
      -- the type the SCREEN says was not. The record said p2wpkh over a
      -- P2PKH scriptPubKey, and waSignSpend signs by type - so this key's
      -- coins were signed with the BIP-143 sighash and given a witness with
      -- an empty scriptSig, which every node rejects. The wallet could not
      -- spend from an address it was showing as its own.
      put tInfo["p2pkh"] into tAddr
      put "p2pkh" into tType
   end if
   put tAddr into tRec["address"]
   put tInfo["pubkey"] into tRec["pubkey"]
   put tInfo["seckey"] into tRec["seckey"]
   put 0 into tRec["change"]
   put 0 into tRec["index"]
   put tType into tRec["scripttype"]
   put cwScriptForAddress(sWaNetwork, tAddr) into tRec["script"]
   put "(imported)" into tRec["suffix"]
   return cwListAdd(tList, tRec)
end waImportedRecords

function waAddressCount
   return cwListCount(sWaAddresses)
end waAddressCount

function waRecordFor pAddress
   local tI, tCount, tRec
   put cwListCount(sWaAddresses) into tCount
   repeat with tI = 1 to tCount
      put sWaAddresses[tI] into tRec
      if tRec["address"] is pAddress then
         return tRec
      end if
   end repeat
   return ""
end waRecordFor

function waIsMine pAddress
   return waRecordFor(pAddress) is not ""
end waIsMine

function waNextUnused pChange
   -- The first address on this chain that nothing has ever been sent to. With
   -- no backend the wallet does not KNOW what is used, so it says so on the
   -- Receive screen rather than pretending index 0 is unused forever.
   local tI, tCount, tRec, tSeen
   put waUsedAddresses() into tSeen
   put cwListCount(sWaAddresses) into tCount
   repeat with tI = 1 to tCount
      put sWaAddresses[tI] into tRec
      if tRec["change"] is pChange then
         if tSeen[tRec["address"]] is not "true" then
            return tRec
         end if
      end if
   end repeat
   return ""
end waNextUnused

private function waNextUnusedOrMore
   -- The next unused receive address, deriving a further window first when
   -- the derived one is spent. A leaf (an inscription commit, a timelock)
   -- and the reveal's destination each take a fresh receive key, and a
   -- wallet that has prepared a few of them runs out of the window it
   -- derived at open - which used to be a refusal that sent the person to
   -- the Addresses screen and back. The window is extended here instead,
   -- with the gap-limit warning that extending it always carries. A key
   -- wallet has one address and no chain to extend, and says so.
   local tRec
   put waNextUnused(0) into tRec
   if tRec is not "" then
      return tRec
   end if
   if sWaKind is "key" then
      throw "this wallet's one address is already used, and an imported key " & \
            "has no chain to derive a fresh one from."
   end if
   waDeriveMore
   waLog "derived a further window: every receive address was used"
   put waNextUnused(0) into tRec
   if tRec is "" then
      throw "there is no unused receive address left, even after deriving " & \
            "a further window."
   end if
   return tRec
end waNextUnusedOrMore

private function waNextChangeOrMore
   -- The next unused change address, deriving a further window first when
   -- the derived one is spent: the same rule as waNextUnusedOrMore, for the
   -- change chain. A key wallet's one address is its change address too.
   local tRec
   put waNextUnused(1) into tRec
   if tRec is not "" then
      return tRec
   end if
   if sWaKind is "key" then
      put waNextUnused(0) into tRec
      if tRec is not "" then
         return tRec
      end if
      throw "this wallet's one address is already used, and an imported key " & \
            "has no chain to derive a fresh change address from."
   end if
   waDeriveMore
   waLog "derived a further window: every change address was used"
   put waNextUnused(1) into tRec
   if tRec is "" then
      throw "there is no change address left, even after deriving a further window."
   end if
   return tRec
end waNextChangeOrMore

private function waUsedAddresses
   local tSeen, tI, tCount, tRec
   put empty into tSeen
   put cwListCount(sWaHistory) into tCount
   repeat with tI = 1 to tCount
      put sWaHistory[tI] into tRec
      if tRec["address"] is not "" then
         put "true" into tSeen[tRec["address"]]
      end if
   end repeat
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      put "true" into tSeen[tRec["address"]]
   end repeat
   return tSeen
end waUsedAddresses

-- ---- balances ----------------------------------------------------------------

command waRecomputeBalance
   local tI, tCount, tRec, tKey, tConfirmed, tPending, tFrozen
   put 0 into tConfirmed
   put 0 into tPending
   put 0 into tFrozen
   put cwListCount(sWaUtxos) into tCount
   repeat with tI = 1 to tCount
      put sWaUtxos[tI] into tRec
      put tRec["txid"] & ":" & tRec["vout"] into tKey
      if sWaSpentBy[tKey] is not "" then
         -- gone, by this wallet's own hand; its change is counted as pending
         next repeat
      end if
      if sWaFrozen[tKey] is "true" then
         add tRec["value"] to tFrozen
      else if tRec["confirmations"] + 0 > 0 then
         add tRec["value"] to tConfirmed
      else
         add tRec["value"] to tPending
      end if
   end repeat
   put tConfirmed into sWaBalance["confirmed"]
   put tPending into sWaBalance["unconfirmed"]
   put tFrozen into sWaBalance["frozen"]
end waRecomputeBalance

function waAmount pSat
   return cwFormatAmount(pSat, sWaUnit)
end waAmount

private function waSafeText pText
   -- NOTHING A STRANGER CHOSE MAY CARRY THIS FILE FORMAT'S SEPARATORS.
   --
   -- waSerializeWallet writes one record per LINE, name and value split by a
   -- TAB, and waDeserializeWallet dispatches each line last-wins. A label is
   -- the one field a person does not type: a BIP-21 URI carries one, and
   -- cwPercentDecode turns %0A into a real newline and %09 into a real tab.
   -- So a payer could put
   --     Refund%0Akind%09watch%0Amnemonic%09%0Axpub%09<their key>
   -- in the label of an invoice, and the next Save-then-Open replaced the
   -- wallet's OWN account key with theirs - after which every address the
   -- Receive screen offered was an address they could spend from. That is
   -- the whole wallet, taken by a payment request.
   --
   -- Stripped rather than escaped, and stripped at every door rather than at
   -- the file: an escape needs an unescape and the two drift, while a label
   -- has no legitimate use for a tab or a newline in the first place.
   local tOut, tI, tCount, tCh
   put "" into tOut
   put the number of chars of pText into tCount
   repeat with tI = 1 to tCount
      put char tI of pText into tCh
      if tCh is not numToChar(9) and tCh is not numToChar(10) \
            and tCh is not numToChar(13) then
         put tCh after tOut
      end if
   end repeat
   return tOut
end waSafeText

private function waAmountBare pSat
   -- THE AMOUNT AS waParsePayments WILL READ IT BACK: a bare number in the
   -- unit the Send box is parsed in, with no unit name after it.
   --
   -- There are three ways to render an amount here and they are not
   -- interchangeable. cwFormatAmount appends the unit NAME, which is right
   -- for a label and wrong for an input field. cwSatToBtc is always BTC.
   -- And field "sd_to" is read by cwParseAmount(text, sWaUnit), so the ONLY
   -- correct thing to write into it is a bare number in sWaUnit.
   --
   -- waReadUri wrote cwSatToBtc, which is BTC whatever the display unit says.
   -- With mBTC selected, a BIP-21 request for 1.5 BTC was written as "1.5"
   -- and read back as 1.5 mBTC: the person paid a THOUSANDTH of what they
   -- were asked for, and nothing on screen disagreed, because both numbers
   -- read "1.5". On satoshi it threw instead, which is why only one of the
   -- three units was silently wrong - the most dangerous arrangement there
   -- is, because two units looked fine.
   if sWaUnit is "sat" then
      return pSat
   end if
   if sWaUnit is "mBTC" then
      return cwSatToBtc(pSat * 1000)
   end if
   return cwSatToBtc(pSat)
end waAmountBare

-- ==============================================================================
-- REPAINTING
--
-- One handler per screen, all of them idempotent, and one that calls them
-- all. Repainting is cheap and being wrong is not, so anything that changes
-- state repaints rather than trying to work out what moved.
-- ==============================================================================

command waRefreshAll
   waRecomputeBalance
   waPaintNav
   waRefreshScreen
end waRefreshAll

command waRefreshScreen
   local tError
   try
      if sWaScreen is "wallet" then
         waPaintWallet
      else if sWaScreen is "receive" then
         waPaintReceive
      else if sWaScreen is "addresses" then
         waPaintAddresses
      else if sWaScreen is "send" then
         waPaintSend
      else if sWaScreen is "coins" then
         waPaintCoins
      else if sWaScreen is "history" then
         waPaintHistory
      else if sWaScreen is "ordinals" then
         waPaintOrdinals
      else if sWaScreen is "vault" then
         waPaintVault
      else if sWaScreen is "tools" then
         waPaintTools
      else if sWaScreen is "network" then
         waPaintNetwork
      else if sWaScreen is "log" then
         waPaintLog
      else if sWaScreen is "settings" then
         waPaintSettings
      end if
   catch tError
      uiStatus line 1 of tError, "bad"
   end try
end waRefreshScreen

command waPaintNav
   local tKind
   set the defaultStack to the short name of this stack
   put waAmount(sWaBalance["confirmed"]) into field "nv_confirmed"
   if sWaBalance["unconfirmed"] is 0 then
      put "no pending" into field "nv_pending"
   else
      put waAmount(sWaBalance["unconfirmed"]) && "pending" into field "nv_pending"
   end if
   if sWaBalance["frozen"] is 0 then
      put "nothing frozen" into field "nv_frozenamt"
   else
      put waAmount(sWaBalance["frozen"]) && "frozen" into field "nv_frozenamt"
   end if
   put "wait" into tKind
   if sWaBackend is "offline" then
      put "wait" into tKind
   else if sWaNetState is "ok" then
      put "ok" into tKind
   else if sWaNetState is "failed" then
      put "bad" into tKind
   else if sWaNetState is "partial" then
      -- the rail pill is the one a person sees while reading a balance
      put "warn" into tKind
   end if
   uiPill "nv_net", waBackendLabel(), "20,458,168,478", tKind
   put sWaNetwork && "/" && sWaScriptType into field "nv_chain"
   if sWaTipHeight is empty then
      put "tip unknown" into field "nv_tip"
   else
      put "tip" && sWaTipHeight into field "nv_tip"
   end if
   put sWaLabel & return & sWaKind && "wallet" into field "nv_wallet"
end waPaintNav

function waBackendLabel
   if sWaBackend is "offline" then
      return "offline"
   end if
   if sWaBackend is "esplora-tor" then
      return "Esplora / Tor"
   end if
   if sWaBackend is "electrum-tor" then
      return "Electrum / Tor"
   end if
   return "Esplora / clear"
end waBackendLabel

command waLog pText
   -- Append one line, bounded. A log that grows without limit is a memory
   -- leak with a nice name, and a wallet left open for a week is exactly the
   -- thing that would find it.
   set the defaultStack to the short name of this stack
   put pText & return after sWaLog
   if the number of chars of sWaLog > 200000 then
      put char -120000 to -1 of sWaLog into sWaLog
   end if
   if there is a field "lg_text" then
      put sWaLog into field "lg_text"
      set the scroll of field "lg_text" to the formattedHeight of field "lg_text"
   end if
end waLog

