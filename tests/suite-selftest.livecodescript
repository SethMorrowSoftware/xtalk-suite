      cx1stAssert "an all-lowercase address is NOT reported as checksummed", cxEthAddressIsChecksummed(cx1stToLowerText(cx1kEip55A)) is false
      cx1stAssert "a wrong-length address is refused", cx1stThrows("cxEthAddressChecksum", "0xdeadbeef")
   catch cx1tError
      cx1stSectionFailed "EIP-55", cx1tError
   end try
end cx1stRunEip55

command cx1stRunRlp
   local cx1tError -- a REFERENCED catch variable must be declared: undeclared, strict OXT throws a second error that masks the real one (checker check 15)
   local cx1tCatDog, cx1tDecoded
   cx1stSection "RLP"
   try
      cx1stAssert "encodes the string dog", cxHexEncode(cxRlpEncodeBytes(cx1stText("dog"))) is "83646f67"
      cx1stAssert "encodes the empty string", cxHexEncode(cxRlpEncodeBytes("")) is "80"
      cx1stAssert "encodes a single byte below 0x80 as itself", cxHexEncode(cxRlpEncodeBytes(numToByte(15))) is "0f"
      cx1stAssert "encodes the empty list", cxHexEncode(cxRlpEncodeList("")) is "c0"
      put cxRlpEncodeBytes(cx1stText("cat")) & cxRlpEncodeBytes(cx1stText("dog")) into cx1tCatDog
      cx1stAssert "encodes the list of cat and dog", cxHexEncode(cxRlpEncodeList(cx1tCatDog)) is "c88363617483646f67"
      put cxRlpDecode(cxHexDecode("83646f67")) into cx1tDecoded
      cx1stAssert "decodes a string item", cx1tDecoded["kind"] is "bytes"
      cx1stAssert "and its payload", cxHexEncode(cx1tDecoded["payload"]) is "646f67"
      put cxRlpDecode(cxHexDecode("c88363617483646f67")) into cx1tDecoded
      cx1stAssert "decodes a list item", cx1tDecoded["kind"] is "list"
      -- RLP's guarantee is one value, one encoding. A decoder that accepts a
      -- second spelling breaks every hash computed over the result.
      cx1stAssert "a single byte wrapped in a length prefix is refused", cx1stThrows("cxRlpDecode", cxHexDecode("8100"))
   catch cx1tError
      cx1stSectionFailed "RLP", cx1tError
   end try
end cx1stRunRlp

command cx1stRunWif
   local cx1tError -- a REFERENCED catch variable must be declared: undeclared, strict OXT throws a second error that masks the real one (checker check 15)
   local cx1tDecoded, cx1tThrew
   cx1stSection "WIF (wallet import format)"
   try
      -- The mainnet/uncompressed answer IS the Bitcoin wiki's published worked
      -- example; the other forms are oracle-derived (see the constants block).
      cx1stAssert "encodes the wiki worked example (mainnet, uncompressed)", cxWifEncode(cx1kWifSeckey, "mainnet", false) is cx1kWifUncompressed
      cx1stAssert "the compressed form is the same key with the 0x01 marker", cxWifEncode(cx1kWifSeckey, "mainnet", true) is cx1kWifCompressed
      cx1stAssert "the testnet form differs only in its version byte", cxWifEncode(cx1kWifSeckey, "testnet", true) is cx1kWifTestnet
      -- The three encodings must be three different strings, or the network
      -- and the flag are not reaching the payload at all.
      cx1stAssert "compressed and uncompressed forms are distinct", cx1kWifCompressed is not cx1kWifUncompressed
      cx1stAssert "mainnet and testnet forms are distinct", cx1kWifTestnet is not cx1kWifCompressed
      put cxWifDecode(cx1kWifCompressed) into cx1tDecoded
      cx1stAssert "decodes back to the same key", cx1tDecoded["seckey"] is cx1kWifSeckey
      cx1stAssert "and reports mainnet", cx1tDecoded["network"] is "mainnet"
      cx1stAssert "and reports the compressed flag", cx1tDecoded["compressed"] is true
      put cxWifDecode(cx1kWifUncompressed) into cx1tDecoded
      cx1stAssert "the uncompressed form reports compressed false", cx1tDecoded["compressed"] is false
      put cxWifDecode(cx1kWifTestnet) into cx1tDecoded
      cx1stAssert "the testnet form reports testnet", cx1tDecoded["network"] is "testnet"
      -- The refusals. A typo in a pasted key must never decode to a plausible
      -- neighbouring wallet, so "it threw" is the assertion.
      cx1stAssert "a corrupt checksum is refused", cx1stThrows("cxWifDecode", cx1kWifBadChecksum)
      cx1stAssert "an xprv is refused (wrong payload length)", cx1stThrows("cxWifDecode", cx1kBip32V1Xprv)
      put "false" into cx1tThrew
      try
         get cxWifEncode(cx1kWifSeckey, "regtest", true)
      catch tInner
         put "true" into cx1tThrew
      end try
      cx1stAssert "an unknown network is refused", cx1tThrew is "true"
      put "false" into cx1tThrew
      try
         get cxWifEncode("deadbeef", "mainnet", true)
      catch tInner2
         put "true" into cx1tThrew
      end try
      cx1stAssert "a short key is refused", cx1tThrew is "true"
   catch cx1tError
      cx1stSectionFailed "WIF", cx1tError
   end try
end cx1stRunWif

command cx1stRunSchnorr
   local cx1tError -- a REFERENCED catch variable must be declared: undeclared, strict OXT throws a second error that masks the real one (checker check 15)
   local cx1tSk, cx1tPub, cx1tMsg, cx1tAux, cx1tSig, cx1tFreshA, cx1tFreshB
   cx1stSection "BIP-340 Schnorr (published vectors, positive and negative)"
   try
      put cxHexDecode(cx1kSchnorrSk1) into cx1tSk
      put cxHexDecode(cx1kSchnorrMsg1) into cx1tMsg
      put cxHexDecode(cx1kSchnorrAux1) into cx1tAux
      put cxXOnlyPubkey(cx1tSk) into cx1tPub
      cx1stAssert "cxXOnlyPubkey reproduces BIP-340 vector 1's x-only key", cx1stSameHex(cxHexEncode(cx1tPub), cx1kSchnorrPub1)
      put cxSchnorrSign(cx1tSk, cx1tMsg, cx1tAux) into cx1tSig
      cx1stAssert "cxSchnorrSign reproduces vector 1 byte for byte", cx1stSameHex(cxHexEncode(cx1tSig), cx1kSchnorrSig1)
      cx1stAssert "cxSchnorrVerify accepts it", cxSchnorrVerify(cx1tPub, cx1tMsg, cx1tSig) is true
      -- The negatives. A Schnorr verifier that only ever meets good signatures
      -- passes every positive case above while accepting a forgery.
      cx1stAssert "cxSchnorrVerify rejects a tampered signature", cxSchnorrVerify(cx1tPub, cx1tMsg, cx1stFlipByte(cx1tSig, 40)) is false
      cx1stAssert "cxSchnorrVerify rejects the wrong message", cxSchnorrVerify(cx1tPub, cx1tSk, cx1tSig) is false
      cx1stAssert "cxSchnorrVerify rejects the wrong key", cxSchnorrVerify(cxHexDecode(cx1kTapInternal0), cx1tMsg, cx1tSig) is false
      -- BIP-340 case 5. The expected result is FALSE, not an error: a verifier
      -- that threw here would be unusable on a third party's signature.
      cx1stAssert "a public key that is not on the curve answers false, not an error", cxSchnorrVerify(cxHexDecode(cx1kSchnorrPubOffCurve), cx1tMsg, cx1tSig) is false
      -- BIP-340 case 6: has_even_y(R) is false.
      cx1stAssert "a signature whose R has an odd Y is rejected", cxSchnorrVerify(cx1tPub, cx1tMsg, cxHexDecode(cx1kSchnorrSigOddR)) is false
      -- An ABSENT aux means FRESH randomness, never an all-zero aux. Two calls
      -- must differ, both must verify, and neither may be the pinned vector -
      -- which is what would come back if empty were passed through as a null
      -- and upstream read it as zeros.
      put cxSchnorrSign(cx1tSk, cx1tMsg, empty) into cx1tFreshA
      put cxSchnorrSign(cx1tSk, cx1tMsg, empty) into cx1tFreshB
      cx1stAssert "an absent aux gives two DIFFERENT signatures", not cx1stSameHex(cxHexEncode(cx1tFreshA), cxHexEncode(cx1tFreshB))
      cx1stAssert "and neither one is the zero-aux signature", not cx1stSameHex(cxHexEncode(cx1tFreshA), cx1kSchnorrSig1)
      cx1stAssert "both signatures still verify", cxSchnorrVerify(cx1tPub, cx1tMsg, cx1tFreshA) is true and cxSchnorrVerify(cx1tPub, cx1tMsg, cx1tFreshB) is true
      -- The three new length accessors, called by name.
      cx1stAssert "cxSchnorrSignatureLen is 64", cxSchnorrSignatureLen() is 64
      cx1stAssert "cxXOnlyPubkeyLen is 32", cxXOnlyPubkeyLen() is 32
      cx1stAssert "cxTaprootOutputLen is 33 (key plus a parity byte)", cxTaprootOutputLen() is 33
      -- Fail closed.
      cx1stAssert "cxXOnlyPubkey refuses a 33-byte public key", cx1stThrows("cxXOnlyPubkey", cxHexDecode(cx1kPubOneCompressed))
      cx1stAssert "cxSchnorrVerify refuses a 33-byte key (a length is a caller bug, not a verdict)", cx1stThrows3("cxSchnorrVerify", cxHexDecode(cx1kPubOneCompressed), cx1tMsg, cx1tSig)
   catch cx1tError
      cx1stSectionFailed "BIP-340 Schnorr", cx1tError
   end try
end cx1stRunSchnorr

command cx1stRunTaproot
   local cx1tError -- a REFERENCED catch variable must be declared: undeclared, strict OXT throws a second error that masks the real one (checker check 15)
   local cx1tInternal, cx1tTweak, cx1tZeroTweak, cx1tSeckey, cx1tTweaked, cx1tOutKey, cx1tSig, cx1tMsg, cx1tRecord
   cx1stSection "BIP-341 Taproot (published wallet vectors)"
   try
      put cxHexDecode(cx1kTapInternal0) into cx1tInternal
      put cxTaprootTweak(cx1tInternal, empty) into cx1tTweak
      put cx1tTweak["outputKey"] into cx1tOutKey
      cx1stAssert "the key-path-only output key matches BIP-341 vector 0", cx1stSameHex(cxHexEncode(cx1tOutKey), cx1kTapOutput0)
      cx1stAssert "the parity byte is 0 or 1", cx1tTweak["parity"] is 0 or cx1tTweak["parity"] is 1
      -- cxTaprootTweakPubkey is the .lcb handler cxTaprootTweak is a thin
      -- slicer over, and it is public API in its own right. Pin it to the
      -- PUBLISHED key first and only then assert the two agree - the
      -- cxHdDeriveChild lesson: testing only the wrapper cannot separate "the
      -- record is right" from "the record and the slicing are wrong in the
      -- same direction". This also pins the 33-byte layout: 32 bytes of key
      -- then one parity byte, in that order.
      put cxTaprootTweakPubkey(cx1tInternal, empty) into cx1tRecord
      cx1stAssert "cxTaprootTweakPubkey returns a 33-byte record", the number of bytes of cx1tRecord is cxTaprootOutputLen()
      cx1stAssert "its first 32 bytes are the published output key", cx1stSameHex(cxHexEncode(byte 1 to 32 of cx1tRecord), cx1kTapOutput0)
      cx1stAssert "and its last byte is the parity cxTaprootTweak reports", byteToNum(byte 33 of cx1tRecord) is cx1tTweak["parity"]
      cx1stAssert "and the address is BIP-341's published bc1p string", cxBtcAddressP2TRFromInternal(cx1tInternal, empty) is cx1kTapAddress0
      -- The same operation WITH a script tree, so both lengths of tagged-hash
      -- input (32 bytes and 64) have a published answer behind them.
      put cxTaprootTweak(cxHexDecode(cx1kTapInternal1), cxHexDecode(cx1kTapRoot1)) into cx1tTweak
      cx1stAssert "a script-tree root gives vector 1's output key", cx1stSameHex(cxHexEncode(cx1tTweak["outputKey"]), cx1kTapOutput1)
      cx1stAssert "and vector 1's published address", cxBtcAddressP2TRFromInternal(cxHexDecode(cx1kTapInternal1), cxHexDecode(cx1kTapRoot1)) is cx1kTapAddress1
      -- THE CONSENSUS DISTINCTION. An EMPTY merkle root is the specification's
      -- empty byte string; 32 ZERO BYTES is a script commitment to a zero root.
      -- They hash different lengths and must give different output keys. If
      -- these ever agreed, every key-path-only address this library produced
      -- would be wrong, and it would still look like an address.
      put cxTaprootTweak(cx1tInternal, cx1stRepeatByte(0, 32)) into cx1tZeroTweak
      cx1stAssert "an EMPTY merkle root is not a 32-zero root", not cx1stSameHex(cxHexEncode(cx1tZeroTweak["outputKey"]), cx1kTapOutput0)
      -- The private half, and then the loop closed: the tweaked PRIVATE key
      -- must sign for the output key the PUBLIC path derived on its own.
      put cxHexDecode(cx1kTapSeckey0) into cx1tSeckey
      cx1stAssert "the internal key is the x-only key of its private key", cx1stSameHex(cxHexEncode(cxXOnlyPubkey(cx1tSeckey)), cx1kTapInternal0)
      put cxTaprootTweakSeckey(cx1tSeckey, empty) into cx1tTweaked
      cx1stAssert "the tweaked private key matches BIP-341's published value", cx1stSameHex(cxHexEncode(cx1tTweaked), cx1kTapTweaked0)
      put cxHexDecode(cx1kSchnorrMsg1) into cx1tMsg
      put cxSchnorrSign(cx1tTweaked, cx1tMsg, cxHexDecode(cx1kSchnorrAux1)) into cx1tSig
      cx1stAssert "the tweaked private key signs for the tweaked public key", cxSchnorrVerify(cx1tOutKey, cx1tMsg, cx1tSig) is true
      -- cxBtcAddressP2TR is UNCHANGED and must stay so: it encodes the output
      -- key it is given and never tweaks. If a future edit made it tweak, every
      -- existing correct call would silently become a DOUBLE tweak - a
      -- valid-looking address nobody can spend from - so the two handlers
      -- disagreeing on the same 32 bytes is the assertion.
      cx1stAssert "cxBtcAddressP2TR still does NOT tweak", cxBtcAddressP2TR(cx1tInternal) is not cx1kTapAddress0
      -- Fail closed.
      cx1stAssert "a 33-byte internal key is refused", cx1stThrows2("cxTaprootTweak", cxHexDecode(cx1kPubOneCompressed), empty)
      cx1stAssert "an internal key that is not on the curve is refused", cx1stThrows2("cxTaprootTweak", cxHexDecode(cx1kSchnorrPubOffCurve), empty)
      cx1stAssert "a 31-byte merkle root is refused", cx1stThrows2("cxTaprootTweak", cx1tInternal, cx1stRepeatByte(0, 31))
      cx1stAssert "cxBtcAddressP2TRFromInternal refuses a 33-byte key", cx1stThrows2("cxBtcAddressP2TRFromInternal", cxHexDecode(cx1kPubOneCompressed), empty)
      cx1stAssert "cxTaprootTweakSeckey refuses a 31-byte key", cx1stThrows2("cxTaprootTweakSeckey", cx1stRepeatByte(0, 31), empty)
   catch cx1tError
      cx1stSectionFailed "BIP-341 Taproot", cx1tError
   end try
end cx1stRunTaproot

function cx1stThrows pHandler, pArg
   local cx1tThrew
   put "false" into cx1tThrew
   try
      do "get" && pHandler & "(pArg)"
   catch cx1tError
      put "true" into cx1tThrew
   end try
   return cx1tThrew is "true"
end cx1stThrows

function cx1stThrows2 pHandler, pArgA, pArgB
   local cx1tThrew
   put "false" into cx1tThrew
   try
      do "get" && pHandler & "(pArgA, pArgB)"
   catch cx1tError
      put "true" into cx1tThrew
   end try
   return cx1tThrew is "true"
end cx1stThrows2

function cx1stThrows3 pHandler, pArgA, pArgB, pArgC
   local cx1tThrew
   put "false" into cx1tThrew
   try
      do "get" && pHandler & "(pArgA, pArgB, pArgC)"
   catch cx1tError
      put "true" into cx1tThrew
   end try
   return cx1tThrew is "true"
end cx1stThrows3

function cx1stSameHex pA, pB
   return ("h" & pA) is ("h" & pB)
end cx1stSameHex

function cx1stToLowerText pText
   local cx1tI, cx1tCount, cx1tCode, cx1tOut
   put "" into cx1tOut
   put the number of chars of pText into cx1tCount
   repeat with cx1tI = 1 to cx1tCount
      put byteToNum(char cx1tI of pText) into cx1tCode
      if cx1tCode >= 65 and cx1tCode <= 90 then
         add 32 to cx1tCode
      end if
      put numToChar(cx1tCode) after cx1tOut
   end repeat
   return cx1tOut
end cx1stToLowerText

function cx1stText pString
   return textEncode(pString, "utf-8")
end cx1stText

function cx1stHex pData
   local cx1tOut, cx1tI, cx1tByte, cx1tDigits
   put "0123456789abcdef" into cx1tDigits
   put empty into cx1tOut
   repeat with cx1tI = 1 to the number of bytes of pData
      put byteToNum(byte cx1tI of pData) into cx1tByte
      put char (cx1tByte div 16 + 1) of cx1tDigits after cx1tOut
      put char (cx1tByte mod 16 + 1) of cx1tDigits after cx1tOut
   end repeat
   return cx1tOut
end cx1stHex

function cx1stSeckeyOne
   return cx1stRepeatByte(0, 31) & numToByte(1)
end cx1stSeckeyOne

function cx1stSeckeyTwo
   return cx1stRepeatByte(0, 31) & numToByte(2)
end cx1stSeckeyTwo

function cx1stFlipByte pData, pIndex
   local cx1tByte
   put (byteToNum(byte pIndex of pData) + 1) mod 256 into cx1tByte
   return byte 1 to (pIndex - 1) of pData & numToByte(cx1tByte) & \
      byte (pIndex + 1) to (the number of bytes of pData) of pData
end cx1stFlipByte

function cx1stRepeatByte pCode, pCount
   local cx1tOne, cx1tOut
   put numToByte(pCode) into cx1tOne
   put cx1tOne into cx1tOut
   -- double up to size, then trim: O(log n) concatenations
   repeat while the number of bytes in cx1tOut < pCount
      put cx1tOut & cx1tOut into cx1tOut
   end repeat
   return byte 1 to pCount of cx1tOut
end cx1stRepeatByte

command cx1stRunBip39
   local cx1tError -- a REFERENCED catch variable must be declared: undeclared, strict OXT throws a second error that masks the real one (checker check 15)
   local cx1tEnt, cx1tMnemonic
   cx1stSection "BIP-39 mnemonics"
   try
      put cxHexDecode(cx1kBip39Entropy12) into cx1tEnt
      cx1stAssert "12 words from all-zero entropy", cxMnemonicFromEntropy(cx1tEnt) is cx1kBip39Mnemonic
      cx1stAssert "and back to the entropy", cxHexEncode(cxMnemonicToEntropy(cx1kBip39Mnemonic)) is cx1kBip39Entropy12
      put cxHexDecode(cx1kBip39Entropy24) into cx1tEnt
      cx1stAssert "24 words from all-ones entropy", cxMnemonicFromEntropy(cx1tEnt) is cx1kBip39Mnemonic24
      cx1stAssert "and back to the entropy", cxHexEncode(cxMnemonicToEntropy(cx1kBip39Mnemonic24)) is cx1kBip39Entropy24
      cx1stAssert "cxMnemonicValidate accepts it", cxMnemonicValidate(cx1kBip39Mnemonic) is true
      -- The checksum is the whole reason a mnemonic is 12 words and not 11: it
      -- is what catches a single mistyped word before it becomes a lost wallet.
      cx1stAssert "one wrong word fails the checksum", cxMnemonicValidate(cx1kBip39Mnemonic12Bad) is false
      cx1stAssert "a word outside the list is refused", cxMnemonicValidate("zzzz" && cx1kBip39Mnemonic) is false
      -- Whitespace is normalized because BIP-39 derives the seed from the
      -- STRING; a pasted trailing newline must not change the wallet.
      put "  " & cx1kBip39Mnemonic & "  " into cx1tMnemonic
      cx1stAssert "surrounding whitespace is normalized away", cxMnemonicValidate(cx1tMnemonic) is true
      -- cxMnemonicNormalize on its own, because it is public API and because
      -- every other BIP-39 handler runs it first: if it were wrong, validate
      -- and to-seed would be wrong together and agree with each other.
      cx1stAssert "cxMnemonicNormalize strips the padding", cxMnemonicNormalize(cx1tMnemonic) is cx1kBip39Mnemonic
      cx1stAssert "an already-clean mnemonic is returned unchanged", cxMnemonicNormalize(cx1kBip39Mnemonic) is cx1kBip39Mnemonic
      cx1stAssert "it is idempotent", cxMnemonicNormalize(cxMnemonicNormalize(cx1tMnemonic)) is cx1kBip39Mnemonic
      -- Tabs, newlines and runs of spaces are what a pasted backup actually
      -- contains, and BIP-39 derives the seed from the STRING, so collapsing
      -- them is the difference between restoring a wallet and missing it.
      cx1stAssert "tabs and newlines collapse to single spaces", cxMnemonicNormalize("abandon" & tab & "abandon" & return & "  abandon ") is "abandon abandon abandon"
      cx1stAssert "an empty string normalizes to empty", cxMnemonicNormalize("   ") is ""
      cx1stAssert "the seed with no passphrase", cxHexEncode(cxMnemonicToSeed(cx1kBip39Mnemonic, "")) is cx1kBip39SeedNoPass
      cx1stAssert "the seed with the TREZOR passphrase", cxHexEncode(cxMnemonicToSeed(cx1kBip39Mnemonic, "TREZOR")) is cx1kBip39Seed
      cx1stAssert "a normalized mnemonic gives the same seed", cxHexEncode(cxMnemonicToSeed(cx1tMnemonic, "")) is cx1kBip39SeedNoPass
      cx1stAssert "an entropy length BIP-39 does not define is refused", cx1stThrows("cxMnemonicFromEntropy", cx1stRepeatByte(0, 17))
      -- The wordlist crosses from the shim; if it were the wrong list or in the
      -- wrong order, everything above would still be self-consistent.
      cx1stAssert "the wordlist is 2048 slots of 8 bytes", the number of bytes of cxBip39Wordlist() is 16384
      cx1stAssert "cxBip39WordlistLen agrees", cxBip39WordlistLen() is 16384
      cx1stAssert "the first word is abandon", byte 1 to 7 of cxBip39Wordlist() is "abandon"
   catch cx1tError
      cx1stSectionFailed "BIP-39", cx1tError
   end try
end cx1stRunBip39

command cx1stRunBip32
   local cx1tError -- a REFERENCED catch variable must be declared: undeclared, strict OXT throws a second error that masks the real one (checker check 15)
   local cx1tNode, cx1tDeep, cx1tWatch, cx1tChild, cx1tStep
   cx1stSection "BIP-32 derivation"
   try
      put cxHdFromSeed(cxHexDecode(cx1kBip32Seed1)) into cx1tNode
      cx1stAssert "vector 1 master xprv", cxXprv(cx1tNode) is cx1kBip32V1Xprv
      cx1stAssert "vector 1 master xpub", cxXpub(cx1tNode) is cx1kBip32V1Xpub
      cx1stAssert "the master node is at depth 0", cx1tNode["depth"] is 0
      put cxHdDerivePath(cx1tNode, "m/0'") into cx1tChild
      cx1stAssert "vector 1 m/0' xprv", cxXprv(cx1tChild) is cx1kBip32V1H0Xprv
      cx1stAssert "vector 1 m/0' xpub", cxXpub(cx1tChild) is cx1kBip32V1H0Xpub
      cx1stAssert "h is accepted as a hardened marker", cxXprv(cxHdDerivePath(cx1tNode, "m/0h")) is cx1kBip32V1H0Xprv
      -- cxHdDeriveChild is the single CKD step cxHdDerivePath is a loop over,
      -- and it is public API in its own right. Pin it to the SAME published
      -- vector rather than only to the path walker: a shared defect in the
      -- step would make the two agree while both were wrong, so the first
      -- assertion here is against BIP-32's own number and the second is the
      -- agreement check on top of it.
      cx1stAssert "cxHdDeriveChild reaches m/0' as one hardened step", cxXprv(cxHdDeriveChild(cx1tNode, 2147483648)) is cx1kBip32V1H0Xprv
      cx1stAssert "and a normal step agrees with the path walker", cxXprv(cxHdDeriveChild(cx1tChild, 1)) is cxXprv(cxHdDerivePath(cx1tNode, "m/0'/1"))
      cx1stAssert "index 0 is not treated as hardened", cxXprv(cxHdDeriveChild(cx1tNode, 0)) is cxXprv(cxHdDerivePath(cx1tNode, "m/0"))
      put cxHdDeriveChild(cx1tChild, 1) into cx1tStep
      cx1stAssert "each step advances the depth by one", cx1tStep["depth"] is 2
      cx1stAssert "a child index at or above 2^32 is refused", cx1stThrows2("cxHdDeriveChild", cx1tNode, 4294967296)
      cx1stAssert "a negative child index is refused", cx1stThrows2("cxHdDeriveChild", cx1tNode, -1)
      put cxHdDerivePath(cx1tNode, cx1kBip32V1DeepPath) into cx1tDeep
      cx1stAssert "vector 1 five levels deep", cxXprv(cx1tDeep) is cx1kBip32V1DeepXprv
      cx1stAssert "and it is at depth 5", cx1tDeep["depth"] is 5
      -- Vector 3 is in the BIP for one reason: a leading zero in the master key.
      cx1stAssert "vector 3 (leading-zero master key)", cxXprv(cxHdFromSeed(cxHexDecode(cx1kBip32Seed3))) is cx1kBip32V3Xprv
      -- A watch-only node is the whole point of an xpub, and its limits are the
      -- whole point of hardened derivation.
      put cxHdNeuter(cx1tChild) into cx1tWatch
      cx1stAssert "neuter leaves the source node's key alone", cx1tChild["seckey"] is not ""
      cx1stAssert "a watch-only node has no private key", cx1tWatch["seckey"] is ""
      cx1stAssert "and still derives the same normal child", cxXpub(cxHdDerivePath(cx1tWatch, "m/1")) is cxXpub(cxHdDerivePath(cx1tChild, "m/1"))
      cx1stAssert "but cannot make an xprv", cx1stThrows("cxXprv", cx1tWatch)
      cx1stAssert "and cannot derive a hardened child", cx1stThrows2("cxHdDerivePath", cx1tWatch, "m/0'")
      -- A path that parses loosely is a path that silently derives the wrong
      -- wallet, so each of these must throw rather than be interpreted.
      cx1stAssert "a path without a leading m is refused", cx1stThrows2("cxHdDerivePath", cx1tNode, "0/1")
      cx1stAssert "an empty level is refused", cx1stThrows2("cxHdDerivePath", cx1tNode, "m/")
      -- "m/" and "m/0'/" are the trailing-separator cases the 2026-08-10
      -- engine pass caught failing OPEN: a trailing delimiter is invisible
      -- to `the number of items`, so the walker returned the node unchanged
      -- instead of throwing. The second spelling pins the fix at depth too.
      cx1stAssert "a trailing separator is refused", cx1stThrows2("cxHdDerivePath", cx1tNode, "m/0'/")
      cx1stAssert "a non-digit level is refused", cx1stThrows2("cxHdDerivePath", cx1tNode, "m/1e3")
      cx1stAssert "a level at or above 2^31 is refused", cx1stThrows2("cxHdDerivePath", cx1tNode, "m/2147483648")
      cx1stAssert "a too-short seed is refused", cx1stThrows("cxHdFromSeed", cx1stRepeatByte(0, 15))
   catch cx1tError
      cx1stSectionFailed "BIP-32", cx1tError
   end try
end cx1stRunBip32

