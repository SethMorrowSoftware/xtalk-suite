private command rs1rstSectionKeyFile
   local rs1tSeed, rs1tSealed, rs1tOpened, rs1tGenA, rs1tGenB
   rs1rstSection "the RIPTKEY1 sealed key file"
   put rsGenerateMasterSeed() into rs1tGenA
   put rsGenerateMasterSeed() into rs1tGenB
   rs1rstCheck (the number of bytes in rs1tGenA is 32), \
         "a generated master seed is 32 bytes"
   rs1rstCheck (rs1rstHex(rs1tGenA) is not rs1rstHex(rs1tGenB)), \
         "two generated seeds differ (the CSPRNG is live)"
   put rs1rstBin(rs1kRsGoldMasterHex) into rs1tSeed
   put rsSealMasterSeed(rs1tSeed, "correct horse") into rs1tSealed
   rs1rstCheck (rs1tSealed is not empty), "sealing succeeds"
   rs1rstCheck (textDecode(byte 1 to 9 of rs1tSealed, "ASCII") is "RIPTKEY1E"), \
         "the file leads with the magic and mode"
   rs1rstCheck (the number of bytes in rs1tSealed is 97), \
         "the sealed file is exactly 97 bytes"
   put rsOpenMasterSeed(rs1tSealed, "correct horse") into rs1tOpened
   rs1rstCheck (rs1rstHex(rs1tOpened) is rs1kRsGoldMasterHex), \
         "the right passphrase recovers the seed"
   put rsOpenMasterSeed(rs1tSealed, "wrong horse") into rs1tOpened
   rs1rstCheck (rs1tOpened is empty), "a wrong passphrase is refused"
   rs1rstCheck (rsLastError() contains "passphrase"), \
         "and the refusal says why"
   put rsOpenMasterSeed(rs1rstFlipByte(rs1tSealed, 40), "correct horse") \
         into rs1tOpened
   rs1rstCheck (rs1tOpened is empty), "a tampered file is refused"
   put rsOpenMasterSeed(byte 1 to 60 of rs1tSealed, "correct horse") \
         into rs1tOpened
   rs1rstCheck (rs1tOpened is empty), "a truncated file is refused"
   rs1rstCheck (rsSealMasterSeed(rs1tSeed, empty) is empty), \
         "an empty passphrase is refused at seal time"
   rs1rstCheck (rsSealMasterSeed(byte 1 to 16 of rs1tSeed, "x") is empty), \
         "a 16-byte seed is refused at seal time"
   rs1rstCheck (rsSealMasterSeed(rs1tSeed, "a") is not rsSealMasterSeed(rs1tSeed, \
         "a")), "two seals of one seed differ (fresh salt and nonce)"
end rs1rstSectionKeyFile

private command rs1rstSectionHead
   local rs1tHead, rs1tParsed, rs1tRebuilt, rs1tUpper
   rs1rstSection "RSH1 - the feed head"
   put rsBuildHead(rs1kRsGoldHeadSeq, rs1kRsGoldHeadName, rs1kRsGoldPost2Target, \
         rs1kRsGoldPrekeyTarget, rs1kRsGoldOnion, rs1kRsGoldProfileTarget) into rs1tHead
   rs1rstCheck (rs1rstHex(rs1tHead) is rs1kRsGoldHeadHex), "head bytes match golden"
   put rsParseHead(rs1tHead) into rs1tParsed
   rs1rstCheck (rs1tParsed is not empty), "the golden head parses"
   rs1rstCheck (rs1tParsed["seq"] is 7), "seq round-trips"
   rs1rstCheck (rs1tParsed["displayName"] is rs1kRsGoldHeadName), \
         "display name round-trips"
   rs1rstCheck (rs1tParsed["latestPostTarget"] is rs1kRsGoldPost2Target), \
         "latest-post target round-trips"
   rs1rstCheck (rs1tParsed["prekeyTarget"] is rs1kRsGoldPrekeyTarget), \
         "prekey target round-trips"
   rs1rstCheck (rs1tParsed["onionAddr"] is rs1kRsGoldOnion), \
         "onion address round-trips"
   rs1rstCheck (rs1tParsed["profileMetaTarget"] is rs1kRsGoldProfileTarget), \
         "profile-meta target round-trips"
   put rsBuildHead(0, "n", empty, empty, empty, empty) into rs1tRebuilt
   put rsParseHead(rs1tRebuilt) into rs1tParsed
   rs1rstCheck (rs1tParsed["latestPostTarget"] is rsZeroTarget()), \
         "an empty target normalizes to the zero target"
   rs1rstCheck (rs1tParsed["onionAddr"] is empty), \
         "an empty onion address round-trips as empty"
   rs1rstCheck (rsParseHead(rs1rstFlipByte(rs1tHead, 2)) is empty), \
         "a wrong magic is refused"
   rs1rstCheck (rsParseHead(byte 1 to 30 of rs1tHead) is empty), \
         "a truncated head is refused"
   rs1rstCheck (rsParseHead(rs1tHead & numToByte(0)) is empty), \
         "trailing bytes are refused"
   -- A non-canonical (uppercase) hex target must be refused, not silently
   -- accepted: byte 61 is the first char of the prekey target ("ab"*20), so
   -- turning that 'a' (97) into 'A' (65) is a valid-length but non-lowercase
   -- target. `is in` would accept it (caseSensitive default false); the
   -- byte-value check refuses it.
   put rs1tHead into rs1tUpper
   put numToByte(65) into byte 61 of rs1tUpper
   rs1rstCheck (rsParseHead(rs1tUpper) is empty), \
         "an uppercase (non-canonical) hex target is refused"
   rs1rstCheck (rsBuildHead(1, \
         "0123456789012345678901234567890123456789012345678901234567890123x", \
         empty, empty, empty, empty) is empty), \
         "a 65-byte display name is refused"
   rs1rstCheck (rsBuildHead(1, "n", "zz", empty, empty, empty) is empty), \
         "a malformed target is refused"
   rs1rstCheck (rsBuildHead(1, "n", empty, empty, "short.onion", empty) is \
         empty), "a short onion address is refused"
   rs1rstCheck (rsBuildHead(-1, "n", empty, empty, empty, empty) is empty), \
         "a negative seq is refused"
end rs1rstSectionHead

private command rs1rstSectionPosts
   local rs1tSeed, rs1tPost1, rs1tPost2, rs1tParsed, rs1tChunked, rs1tMangled
   rs1rstSection "RSP1 - posts and the chain"
   put rs1rstBin(rs1kRsGoldIdSeedHex) into rs1tSeed
   put rsBuildPost(rs1kRsGoldTs1, empty, rs1kRsGoldPost1Text, empty, rs1tSeed) \
         into rs1tPost1
   rs1rstCheck (rs1rstHex(rs1tPost1) is rs1kRsGoldPost1Hex), \
         "post 1 bytes match golden (deterministic signature)"
   rs1rstCheck (rs1rstHex(sha1Digest(rsBencodeBytes(rs1tPost1))) is \
         rs1kRsGoldPost1Target), "post 1's DHT target re-derives via SHA-1"
   put rsBuildPost(rs1kRsGoldTs2, rs1kRsGoldPost1Target, rs1kRsGoldPost2Text, \
         rs1kRsGoldMediaTarget, rs1tSeed) into rs1tPost2
   rs1rstCheck (rs1rstHex(rs1tPost2) is rs1kRsGoldPost2Hex), "post 2 bytes match golden"
   rs1rstCheck (rs1rstHex(sha1Digest(rsBencodeBytes(rs1tPost2))) is \
         rs1kRsGoldPost2Target), "post 2's DHT target re-derives via SHA-1"
   put rsParsePost(rs1tPost2) into rs1tParsed
   rs1rstCheck (rs1tParsed is not empty), "post 2 parses"
   rs1rstCheck (rs1tParsed["timestamp"] is 1754870460), "timestamp round-trips"
   rs1rstCheck (rs1tParsed["prevPostTarget"] is rs1kRsGoldPost1Target), \
         "the chain link names post 1"
   rs1rstCheck (rs1tParsed["kind"] is "D"), "kind round-trips"
   rs1rstCheck (rs1tParsed["text"] is rs1kRsGoldPost2Text), "text round-trips"
   rs1rstCheck (rs1tParsed["mediaTargets"] is rs1kRsGoldMediaTarget), \
         "media info-hash round-trips"
   rs1rstCheck (rsVerifyPost(rs1tPost1, rs1kRsGoldHandle) is true), \
         "post 1 verifies under the golden handle"
   rs1rstCheck (rsVerifyPost(rs1tPost2, rs1kRsGoldHandle) is true), \
         "post 2 verifies under the golden handle"
   rs1rstCheck (rsVerifyPost(rs1tPost2, rs1kRsGoldConfPub) is false), \
         "post 2 refuses a different author"
   put rs1rstFlipByte(rs1tPost2, 60) into rs1tMangled
   rs1rstCheck (rsVerifyPost(rs1tMangled, rs1kRsGoldHandle) is false), \
         "one flipped text byte breaks the signature"
   put rs1rstFlipByte(rs1tPost2, 1) into rs1tMangled
   rs1rstCheck (rsVerifyPost(rs1tMangled, rs1kRsGoldHandle) is false), \
         "a wrong magic is refused before any crypto"
   rs1rstCheck (rsVerifyPost(byte 1 to 100 of rs1tPost2, rs1kRsGoldHandle) is \
         false), "a truncated post is refused"
   put rsBuildPostChunked(rs1kRsGoldTs2, rs1kRsGoldPost2Target, \
         rs1kRsGoldPrekeyTarget & comma & rs1kRsGoldProfileTarget, empty, rs1tSeed) \
         into rs1tChunked
   rs1rstCheck (rs1tChunked is not empty), "a chunked post builds"
   put rsParsePost(rs1tChunked) into rs1tParsed
   rs1rstCheck (rs1tParsed["kind"] is "C"), "chunked kind round-trips"
   rs1rstCheck (rs1tParsed["chunkTargets"] is \
         (rs1kRsGoldPrekeyTarget & comma & rs1kRsGoldProfileTarget)), \
         "the chunk list round-trips in order"
   rs1rstCheck (rsVerifyPost(rs1tChunked, rs1kRsGoldHandle) is true), \
         "the chunked post verifies"
   rs1rstCheck (rsBuildPostChunked(1, empty, empty, empty, rs1tSeed) is empty), \
         "an empty chunk list is refused"
   rs1rstCheck (rsBuildPost(1, empty, "x", \
         rs1kRsGoldMediaTarget & comma & rs1kRsGoldMediaTarget & comma & \
         rs1kRsGoldMediaTarget & comma & rs1kRsGoldMediaTarget & comma & \
         rs1kRsGoldMediaTarget & comma & rs1kRsGoldMediaTarget & comma & \
         rs1kRsGoldMediaTarget & comma & rs1kRsGoldMediaTarget & comma & \
         rs1kRsGoldMediaTarget, rs1tSeed) is empty), \
         "nine media attachments are refused"
   rs1rstCheck (rsBuildPost(-5, empty, "x", empty, rs1tSeed) is empty), \
         "a negative timestamp is refused"
end rs1rstSectionPosts

private command rs1rstSectionHelpers
   local rs1tValue
   rs1rstSection "helpers"
   rs1rstCheck (textDecode(rsBencodeBytes(empty), "ASCII") is "0:"), \
         "bencode of empty is 0:"
   rs1rstCheck (textDecode(rsBencodeBytes(textEncode("hi", "ASCII")), \
         "ASCII") is "2:hi"), "bencode of a short string"
   put rsBencodeBytes(rs1rstBin(rs1kRsGoldHeadHex)) into rs1tValue
   rs1rstCheck (textDecode(byte 1 to 4 of rs1tValue, "ASCII") is "203:"), \
         "the golden head bencodes at 203 bytes"
   rs1rstCheck (rsHeadSalt() is "riptide-head"), "the head salt is published"
   rs1rstCheck (the number of chars in rsZeroTarget() is 40), \
         "the zero target is 40 chars"
end rs1rstSectionHelpers

private command rs1rstSectionBep44
   local rs1tValue, rs1tBuf, rs1tSalt
   rs1rstSection "phase 2 - the canonical BEP44 buffer + content addresses"
   -- the exact bytes the golden head's BEP44 signature covers, from the
   -- pure-script assembly (byte-identical to btDhtBep44SignBuf; the folded
   -- suite harness cross-checks the two implementations directly)
   put rsBencodeBytes(rs1rstBin(rs1kRsGoldHeadHex)) into rs1tValue
   put rsBep44SignBuf(rsHeadSalt(), 7, rs1tValue) into rs1tBuf
   rs1rstCheck (rs1rstHex(rs1tBuf) is rs1kRsGoldHeadBufHex), \
         "the golden head's signing buffer matches golden"
   -- the cross-project anchor torrentxt/tests/bep44_golden_test.py pins
   put rsBep44SignBuf("rp-prekeys", 1, textEncode("2:hi", "ASCII")) into rs1tBuf
   rs1rstCheck (textDecode(rs1tBuf, "ASCII") is \
         "4:salt10:rp-prekeys3:seqi1e1:v2:hi"), \
         "the salted anchor vector matches bep44_golden_test.py"
   put rsBep44SignBuf(empty, 7, textEncode("2:hi", "ASCII")) into rs1tBuf
   rs1rstCheck (textDecode(rs1tBuf, "ASCII") is "3:seqi7e1:v2:hi"), \
         "an empty salt omits the salt segment"
   rs1rstCheck (rsBep44SignBuf(rsHeadSalt(), -1, \
         textEncode("2:hi", "ASCII")) is empty), "a negative seq is refused"
   rs1rstCheck (rsBep44SignBuf(rsHeadSalt(), 9007199254740992, \
         textEncode("2:hi", "ASCII")) is empty), \
         "a seq at 2^53 is refused (it would not round-trip)"
   rs1rstCheck (rsBep44SignBuf(rsHeadSalt(), 7, \
         textEncode("hi", "ASCII")) is empty), \
         "a non-bencoded value is refused"
   rs1rstCheck (rsBep44SignBuf(rsHeadSalt(), 7, \
         textEncode("3:hi", "ASCII")) is empty), \
         "a value whose length prefix lies is refused"
   put empty into rs1tSalt
   repeat 65 times
      put "x" after rs1tSalt
   end repeat
   rs1rstCheck (rsBep44SignBuf(rs1tSalt, 1, textEncode("2:hi", "ASCII")) is \
         empty), "a 65-byte salt is refused (the BEP44 cap)"
   -- the content address, through the library this time (the sha1Digest
   -- re-derivations in the posts section prove the same bytes engine-side)
   rs1rstCheck (rsImmutableTarget(rs1rstBin(rs1kRsGoldPost1Hex)) is \
         rs1kRsGoldPost1Target), "rsImmutableTarget re-derives post 1's target"
   rs1rstCheck (rsImmutableTarget(rs1rstBin(rs1kRsGoldPost2Hex)) is \
         rs1kRsGoldPost2Target), "rsImmutableTarget re-derives post 2's target"
   rs1rstCheck (rsImmutableTarget(empty) is empty), \
         "an empty immutable value is refused"
end rs1rstSectionBep44

private command rs1rstSectionIngest
   local rs1tEvent, rs1tBad, rs1tPostEvent, rs1tHead, rs1tPost, rs1tSig
   rs1rstSection "phase 2 - ingest verifiers (synthetic drained events)"
   -- a synthetic dhtMutableItem event, key-for-key what btPoll drains for
   -- the golden head. The oracle pre-derived the BEP44 signature, so this
   -- is fully deterministic - nothing is signed at run time.
   put rs1kRsGoldHandle into rs1tEvent["publicKey"]
   put rsHeadSalt() into rs1tEvent["salt"]
   put 7 into rs1tEvent["seq"]
   put rs1rstBin(rs1kRsGoldHeadHex) into rs1tEvent["value"]
   put rs1kRsGoldHeadSigHex into rs1tEvent["signature"]
   put rsIngestHead(rs1tEvent, rs1kRsGoldHandle) into rs1tHead
   rs1rstCheck (rs1tHead is not empty), "the golden head event ingests"
   rs1rstCheck (rs1tHead["displayName"] is rs1kRsGoldHeadName), \
         "and hands back the parsed head"
   rs1rstCheck (rs1tHead["latestPostTarget"] is rs1kRsGoldPost2Target), \
         "naming post 2 as latest"
   rs1rstCheck (rsIngestHead(rs1tEvent, rs1kRsGoldConfPub) is empty), \
         "an event for another handle is refused"
   put rs1tEvent into rs1tBad
   put "riptide-lies" into rs1tBad["salt"]
   rs1rstCheck (rsIngestHead(rs1tBad, rs1kRsGoldHandle) is empty), \
         "a wrong salt is refused"
   put rs1tEvent into rs1tBad
   put 8 into rs1tBad["seq"]
   rs1rstCheck (rsIngestHead(rs1tBad, rs1kRsGoldHandle) is empty), \
         "a seq disagreeing with the head's embedded seq is refused"
   put rs1tEvent into rs1tBad
   put rs1rstFlipByte(rs1tBad["value"], 2) into rs1tBad["value"]
   rs1rstCheck (rsIngestHead(rs1tBad, rs1kRsGoldHandle) is empty), \
         "a value that is not an RSH1 record is refused"
   put rs1tEvent into rs1tBad
   -- byte 20 is the last display-name char: the record still PARSES, so
   -- this refusal is the signature's, not the parser's
   put rs1rstFlipByte(rs1tBad["value"], 20) into rs1tBad["value"]
   rs1rstCheck (rsIngestHead(rs1tBad, rs1kRsGoldHandle) is empty), \
         "a tampered-but-parseable value fails the BEP44 signature"
   put rs1tEvent into rs1tBad
   put rs1tBad["signature"] into rs1tSig
   if char 1 of rs1tSig is "6" then
      put "7" into char 1 of rs1tSig
   else
      put "6" into char 1 of rs1tSig
   end if
   put rs1tSig into rs1tBad["signature"]
   rs1rstCheck (rsIngestHead(rs1tBad, rs1kRsGoldHandle) is empty), \
         "a forged signature is refused"
   put rs1tEvent into rs1tBad
   put char 1 to 127 of rs1tBad["signature"] into rs1tBad["signature"]
   rs1rstCheck (rsIngestHead(rs1tBad, rs1kRsGoldHandle) is empty), \
         "a truncated signature is refused"
   -- the post walk, on synthetic dhtImmutableItem events: head names post 2,
   -- post 2's prev names post 1, post 1's prev is the zero target - the end
   put rs1kRsGoldPost2Target into rs1tPostEvent["target"]
   put rs1rstBin(rs1kRsGoldPost2Hex) into rs1tPostEvent["value"]
   put rsIngestPost(rs1tPostEvent, rs1tHead["latestPostTarget"], rs1kRsGoldHandle) \
         into rs1tPost
   rs1rstCheck (rs1tPost is not empty), "the head's latest target ingests post 2"
   rs1rstCheck (rs1tPost["text"] is rs1kRsGoldPost2Text), "with its text intact"
   put rs1kRsGoldPost1Target into rs1tPostEvent["target"]
   put rs1rstBin(rs1kRsGoldPost1Hex) into rs1tPostEvent["value"]
   put rsIngestPost(rs1tPostEvent, rs1tPost["prevPostTarget"], rs1kRsGoldHandle) \
         into rs1tPost
   rs1rstCheck (rs1tPost is not empty), "walking the chain link ingests post 1"
   rs1rstCheck (rs1tPost["prevPostTarget"] is rsZeroTarget()), \
         "whose prev is the zero target - the chain ends"
   rs1rstCheck (rsIngestPost(rs1tPostEvent, rs1kRsGoldPost2Target, rs1kRsGoldHandle) \
         is empty), "an event answering a different target is refused"
   put rs1rstFlipByte(rs1rstBin(rs1kRsGoldPost1Hex), 60) into rs1tPostEvent["value"]
   rs1rstCheck (rsIngestPost(rs1tPostEvent, rs1kRsGoldPost1Target, rs1kRsGoldHandle) \
         is empty), "a value that does not hash to its target is refused"
   put rs1rstBin(rs1kRsGoldPost1Hex) into rs1tPostEvent["value"]
   rs1rstCheck (rsIngestPost(rs1tPostEvent, rs1kRsGoldPost1Target, rs1kRsGoldConfPub) \
         is empty), "a different claimed author is refused"
   rs1rstCheck (rsIngestPost(rs1tPostEvent, rsZeroTarget(), rs1kRsGoldHandle) is \
         empty), "ingesting against the zero target is refused"
end rs1rstSectionIngest

private command rs1rstSectionAnon pCaps
   local rs1tHeader, rs1tFrame, rs1tParsed, rs1tHandle, rs1tPage, rs1tPageText, rs1tPkBody, rs1tHex
   rs1rstSection "phase 7 - the anon persona, the guard, and BTXO framing"
   -- derivations: the anon persona is a real, distinct identity
   rs1rstCheck (rsAnonHandle(rs1rstBin(rs1kRsGoldMasterHex), 0) is rs1kRsGoldAnon0Handle), \
         "anon persona 0's handle matches golden"
   rs1rstCheck (rsAnonHandle(rs1rstBin(rs1kRsGoldMasterHex), 0) is not \
         rsAnonHandle(rs1rstBin(rs1kRsGoldMasterHex), 1)), \
         "distinct personas are distinct identities"
   rs1rstCheck (rsAnonHandle(rs1rstBin(rs1kRsGoldMasterHex), 0) is not rs1kRsGoldHandle), \
         "and an anon persona is not the public identity"
   if pCaps["hasSha3"] is true then
      rs1rstCheck (rsAnonOnion(rs1rstBin(rs1kRsGoldMasterHex), 0) is \
            rs1kRsGoldAnon0Onion), "anon persona 0's onion matches golden"
      rs1rstCheck (rsVerifyOnionClaim(rs1kRsGoldAnon0Onion, rs1kRsGoldAnon0Handle) is \
            true or pCaps["hasOnion"] is not true), \
            "the anon onion self-authenticates to the anon handle"
   else
      rs1rstCheck (rsAnonOnion(rs1rstBin(rs1kRsGoldMasterHex), 0) is empty), \
            "without a SHA3 provider the anon onion refuses"
      rs1rstSkip "anon onion self-computation: no SHA3 provider installed"
   end if
   -- THE GUARD (spec 9.3): the full truth table, because a hole here is a
   -- deanonymization bug. An anon persona may use ONLY the onion.
   rs1rstCheck (rsPersonaAllows(true, "onion") is true), \
         "anon persona: onion is allowed"
   rs1rstCheck (rsPersonaAllows(true, "dht") is false), \
         "anon persona: the DHT is REFUSED"
   rs1rstCheck (rsPersonaAllows(true, "torrent") is false), \
         "anon persona: torrents are REFUSED"
   rs1rstCheck (rsPersonaAllows(true, "rp1") is false), \
         "anon persona: rp1 is REFUSED"
   rs1rstCheck (rsPersonaAllows(true, "enet") is false), \
         "anon persona: enet is REFUSED"
   rs1rstCheck (rsPersonaAllows(true, "dc") is false), \
         "anon persona: dataChannel is REFUSED"
   -- a public persona may use anything EXCEPT the anon onion route
   rs1rstCheck (rsPersonaAllows(false, "dht") is true), \
         "public persona: the DHT is allowed"
   rs1rstCheck (rsPersonaAllows(false, "torrent") is true), \
         "public persona: torrents are allowed"
   rs1rstCheck (rsPersonaAllows(false, "rp1") is true), \
         "public persona: rp1 is allowed"
   rs1rstCheck (rsPersonaAllows(false, "enet") is true), \
         "public persona: enet is allowed"
   rs1rstCheck (rsPersonaAllows(false, "dc") is true), \
         "public persona: dataChannel is allowed"
   rs1rstCheck (rsPersonaAllows(false, "onion") is false), \
         "public persona: the anon onion route is REFUSED"
   -- feed and media are in the guard's own known-transport list, so the
   -- "full truth table" must assert them too - an anon persona reaching
   -- either is the exact DHT/torrent-under-the-anon-key leak the guard
   -- exists to prevent, and a hole here would be a silent deanonymization
   rs1rstCheck (rsPersonaAllows(true, "feed") is false), \
         "anon persona: the public feed is REFUSED"
   rs1rstCheck (rsPersonaAllows(true, "media") is false), \
         "anon persona: torrent media is REFUSED"
   rs1rstCheck (rsPersonaAllows(false, "feed") is true), \
         "public persona: the feed is allowed"
   rs1rstCheck (rsPersonaAllows(false, "media") is true), \
         "public persona: media is allowed"
   -- fail-closed: an unknown transport is refused for BOTH personas
   rs1rstCheck (rsPersonaAllows(true, "smoke-signal") is false), \
         "an unknown transport is refused for an anon persona"
   rs1rstCheck (rsPersonaAllows(false, "smoke-signal") is false), \
         "and refused for a public persona (fail-closed)"
   -- BTXO framing
   put rsBtxoHeader("secret.txt", 11, 0) into rs1tHeader
   rs1rstCheck (rs1rstHex(rs1tHeader) is rs1kRsGoldBtxoHeaderHex), \
         "the BTXO header bytes match golden"
   put rsBtxoParseHeader(rs1tHeader) into rs1tParsed
   rs1rstCheck (rs1tParsed["name"] is "secret.txt"), "the header name round-trips"
   rs1rstCheck (rs1tParsed["total"] is 11), "the header total round-trips"
   rs1rstCheck (rs1tParsed["flags"] is 0), "the header flags round-trip"
   put rsBtxoDataFrame(textEncode("hello world", "ASCII")) into rs1tFrame
   rs1rstCheck (rs1rstHex(rs1tFrame) is rs1kRsGoldBtxoFrameHex), \
         "a BTXO data frame matches golden"
   rs1rstCheck (the number of bytes in rsBtxoTerminator() is 4), \
         "the terminator is a 4-byte zero length"
   rs1rstCheck (rsBtxoDataFrame(empty) is empty), \
         "an empty data frame is refused (use the terminator)"
   rs1rstCheck (rsBtxoParseHeader(byte 1 to 5 of rs1tHeader) is empty), \
         "a truncated BTXO header is refused"
   rs1rstCheck (rsBtxoHeader("x", -1, 0) is empty), \
         "a negative total size is refused"
   -- a header whose name field is invalid UTF-8 (0xFF) passes the exact
   -- length gate but must be REFUSED, not thrown (the never-throw contract)
   rs1rstCheck (rsBtxoParseHeader(rs1rstBin("4254584f0100" & "0001" & "ff" & \
         "000000000000000b")) is empty), \
         "a non-UTF-8 file name in a BTXO header is refused, not thrown"
   -- the onion-service wrapper: refusals run offline
   -- 8.3: sealed DMs TO the anon persona - the phase-4 machinery composed
   -- with the anon subkeys, end to end: the persona's prekey (signed by
   -- its ANON identity), an intro from the PUBLIC identity addressed to
   -- the anon handle, sealed to the anon prekey, opened with the anon DM
   -- seed. The sender proves itself; only the persona can read it.
   put rsDmKeys(rsAnonDmSeed(rs1rstBin(rs1kRsGoldMasterHex), 0)) into rs1tParsed
   rs1rstCheck (rs1tParsed["publicKeyHex"] is rs1kRsGoldAnonDmKxPub), \
         "the anon DM subkey (200+n) yields the golden kx public"
   rs1rstCheck (rsAnonDmSeed(rs1rstBin(rs1kRsGoldMasterHex), 0) is not \
         rsAnonSeed(rs1rstBin(rs1kRsGoldMasterHex), 0)), \
         "and it is a DIFFERENT subkey from the persona identity"
   rs1rstCheck (rsAnonDmSeed(rs1rstBin(rs1kRsGoldMasterHex), -1) is empty), \
         "a negative persona index is refused"
   put rsBuildPrekey(rs1kRsGoldAnonDmKxPub, \
         rsAnonSeed(rs1rstBin(rs1kRsGoldMasterHex), 0)) into rs1tHeader
   rs1rstCheck (rsVerifyPrekey(rs1tHeader, rs1kRsGoldAnon0Handle) is not empty), \
         "the persona's prekey verifies under its ANON handle"
   rs1rstCheck (rsVerifyPrekey(rs1tHeader, rs1kRsGoldHandle) is empty), \
         "and refuses the PUBLIC handle (the personas stay unlinked)"
   put rsBuildIntro(rs1kRsGoldMsgTs, rs1kRsGoldAnon0Handle, rs1kRsGoldDmKxPub, \
         rs1rstBin(rs1kRsGoldIdSeedHex)) into rs1tFrame
   put rsDmSealIntro(rs1tFrame, rs1kRsGoldAnonDmKxPub) into rs1tFrame
   rs1rstCheck (rs1tFrame is not empty), "an intro seals to the anon prekey"
   put rsDmOpenIntro(rs1tFrame, rs1kRsGoldAnon0Handle, \
         rsAnonDmSeed(rs1rstBin(rs1kRsGoldMasterHex), 0)) into rs1tParsed
   rs1rstCheck (rs1tParsed is not empty), \
         "the persona opens it with its anon DM seed"
   rs1rstCheck (rs1tParsed["senderHandle"] is rs1kRsGoldHandle), \
         "learning the (proven) sender"
   rs1rstCheck (rsDmOpenIntro(rs1tFrame, rs1kRsGoldHandle, \
         rs1rstBin(rs1kRsGoldDmSeedHex)) is empty), \
         "the PUBLIC identity cannot open the persona's mail"
   -- 8.2/8.3 SERVING SEAMS: the payloads the persona's onion serves and
   -- the POST /dm acceptance. All pure, so they run right here; only the
   -- oxh* wiring and the live onion need tor (the skips below).
   put rsAnonFeedPage(rs1kRsGoldHeadName, rs1kRsGoldPost1Text & return & \
         rs1kRsGoldPost2Text) into rs1tPage
   rs1rstCheck (rs1rstHex(rs1tPage) is rs1kRsGoldAnonPageHex), \
         "the anon feed page bytes match golden"
   put textDecode(rsAnonFeedPage(rs1kRsGoldHeadName, \
         "an <i>entry</i> & " & quote & "q" & quote), "UTF-8") into rs1tPageText
   rs1rstCheck (offset("<i>", rs1tPageText) is 0 and \
         offset("&lt;i&gt;entry&lt;/i&gt; &amp; &quot;q&quot;", \
         rs1tPageText) > 0), \
         "entries are HTML-escaped (no markup injection into the page)"
   rs1rstCheck (rsAnonFeedPage("", "x") is empty), \
         "an empty page title is refused"
   rs1rstCheck (rsAnonFeedPage(rs1kRsGoldHeadName, empty) is not empty), \
         "an empty feed still serves a (bare) page"
   put rsAnonPrekeyBody(rs1rstBin(rs1kRsGoldMasterHex), 0) into rs1tPkBody
   rs1rstCheck (rs1tPkBody is rs1kRsGoldAnonPrekeyBody), \
         "the GET /prekey body matches golden"
   rs1rstCheck (rsVerifyPrekey(rs1rstBin(rs1tPkBody), rs1kRsGoldAnon0Handle) is not \
         empty), "and decodes to a prekey verifying under the ANON handle"
   rs1rstCheck (rsAnonPrekeyBody(rs1rstBin(rs1kRsGoldMasterHex), -1) is empty), \
         "a negative persona index refuses a prekey body"
   -- the POST /dm ACCEPTANCE, against a sealed blob built with the
   -- existing 8.3 crypto (rs1tFrame still holds the sealed intro from the
   -- open checks above) - accept the good body, refuse before decode
   -- everything else
   put rs1rstHex(rs1tFrame) into rs1tHex
   put rsAnonAcceptDm(rs1tHex, rs1rstBin(rs1kRsGoldMasterHex), 0) into rs1tParsed
   rs1rstCheck (rs1tParsed is not empty), \
         "rsAnonAcceptDm accepts the hex-posted sealed intro"
   rs1rstCheck (rs1tParsed["senderHandle"] is rs1kRsGoldHandle), \
         "and reports the proven sender"
   rs1rstCheck (rsAnonAcceptDm(char 1 to 630 of rs1tHex, \
         rs1rstBin(rs1kRsGoldMasterHex), 0) is empty), \
         "a short body is refused before any decode"
   rs1rstCheck (rsAnonAcceptDm(rs1tHex & "00", rs1rstBin(rs1kRsGoldMasterHex), 0) \
         is empty), "a long body is refused before any decode"
   rs1rstCheck (rsAnonAcceptDm(toUpper(rs1tHex), rs1rstBin(rs1kRsGoldMasterHex), 0) \
         is empty), "a non-canonical (uppercase) body is refused"
   rs1rstCheck (rsAnonAcceptDm("zz" & char 3 to -1 of rs1tHex, \
         rs1rstBin(rs1kRsGoldMasterHex), 0) is empty), \
         "a non-hex body of the right length is refused before decode"
   rs1rstCheck (rsAnonAcceptDm(rs1rstHex(rs1rstFlipByte(rs1tFrame, 20)), \
         rs1rstBin(rs1kRsGoldMasterHex), 0) is empty), \
         "a tampered sealed blob is refused by the seal itself"
   rs1rstCheck (rsAnonCreateService(rs1rstBin(rs1kRsGoldMasterHex), 0, 0, 8080) is \
         empty), "rsAnonCreateService refuses a bad virtual port"
   rs1rstCheck (rsAnonCreateService(rs1rstBin(rs1kRsGoldMasterHex), 0, 80, 70000) is \
         empty), "rsAnonCreateService refuses a bad local port"
   if pCaps["hasOnion"] is not true then
      rs1rstSkip "anon onion service create: onionxt is not installed"
   else
      rs1rstSkip "anon onion service create: needs a live tor daemon"
   end if
   rs1rstSkip "anon onion SERVING (the / page, /prekey, POST /dm as routes):" && \
         "needs onion-httpd + a live tor daemon"
end rs1rstSectionAnon

private command rs1rstSectionLan
   local rs1tKeys, rs1tChallenge, rs1tResponse, rs1tNonce2, rs1tChallenge2, rs1tName, rs1tBadName
   local rs1tBadUtf, rs1tWelcome
   rs1rstSection "phase 6 - LAN mesh admission"
   put rsLanKeys(rs1rstBin(rs1kRsGoldMasterHex)) into rs1tKeys
   rs1rstCheck (rs1rstHex(rs1tKeys["publicKey"]) is rs1kRsGoldLanPub), \
         "the LAN subkey yields the golden mesh public"
   rs1rstCheck (the number of bytes in rs1tKeys["secretKey"] is 64), \
         "and a 64-byte signing secret"
   put rsLanBuildChallenge(rs1kRsGoldLanHostName, rs1rstBin(rs1kRsGoldLanNonce)) \
         into rs1tChallenge
   rs1rstCheck (rs1rstHex(rs1tChallenge) is rs1kRsGoldLanChallengeHex), \
         "the challenge bytes match golden"
   put rsLanParseChallenge(rs1tChallenge) into rs1tName
   rs1rstCheck (rs1tName["name"] is rs1kRsGoldLanHostName), \
         "the host name round-trips out of the challenge"
   rs1rstCheck (rs1rstHex(rs1tName["nonce"]) is rs1kRsGoldLanNonce), \
         "the nonce round-trips out of the challenge"
   put rsLanBuildResponse(rs1tChallenge, rs1kRsGoldLanJoinName, \
         rs1rstBin(rs1kRsGoldMasterHex)) into rs1tResponse
   rs1rstCheck (rs1rstHex(rs1tResponse) is rs1kRsGoldLanResponseHex), \
         "the response bytes match golden"
   put rsLanParseResponse(rs1tResponse) into rs1tName
   rs1rstCheck (rs1tName["name"] is rs1kRsGoldLanJoinName), \
         "the joiner name round-trips out of the response"
   -- the host's verdict: this response proves the shared master
   put rsLanVerifyResponse(rs1tResponse, rs1tChallenge, rs1rstBin(rs1kRsGoldMasterHex)) \
         into rs1tName
   rs1rstCheck (rs1tName is rs1kRsGoldLanJoinName), \
         "the host admits a joiner who shares the master, learning its name"
   -- a STRANGER: a response built under a different master must be refused
   -- by a host holding the golden master
   put rsLanBuildResponse(rs1tChallenge, rs1kRsGoldLanJoinName, \
         rs1rstBin(rs1kRsGoldConfSeedHex)) into rs1tBadName
   rs1rstCheck (rsLanVerifyResponse(rs1tBadName, rs1tChallenge, \
         rs1rstBin(rs1kRsGoldMasterHex)) is empty), \
         "a joiner who does NOT share the master is refused"
   -- freshness: the same response against a DIFFERENT challenge nonce fails
   -- (this is why the nonce must never be reused)
   put rs1rstBin(rs1kRsGoldMasterHex) into rs1tNonce2
   put rsLanBuildChallenge(rs1kRsGoldLanHostName, \
         byte 1 to 32 of (rs1tNonce2 & rs1tNonce2)) into rs1tChallenge2
   rs1rstCheck (rsLanVerifyResponse(rs1tResponse, rs1tChallenge2, \
         rs1rstBin(rs1kRsGoldMasterHex)) is empty), \
         "a response replayed against a fresh nonce is refused"
   -- tamper and cap refusals
   rs1rstCheck (rsLanVerifyResponse(rs1rstFlipByte(rs1tResponse, 60), rs1tChallenge, \
         rs1rstBin(rs1kRsGoldMasterHex)) is empty), \
         "a tampered response is refused"
   rs1rstCheck (rsLanParseChallenge(byte 1 to 20 of rs1tChallenge) is empty), \
         "a truncated challenge is refused"
   rs1rstCheck (rsLanBuildChallenge("laptop", byte 1 to 31 of \
         rs1rstBin(rs1kRsGoldLanNonce)) is empty), \
         "a 31-byte nonce is refused"
   rs1rstCheck (rsLanBuildChallenge("", rs1rstBin(rs1kRsGoldLanNonce)) is empty), \
         "an empty device name is refused"
   -- a name field of INVALID UTF-8 (0xFF 0xFE) passes the exact-length gate
   -- but must be REFUSED, not thrown, out of the parser (the never-throw
   -- contract; a LAN peer could otherwise crash the admission drain)
   put rs1rstBin("52534c314302fffe") & rs1rstBin(rs1kRsGoldLanNonce) into rs1tBadUtf
   rs1rstCheck (rsLanParseChallenge(rs1tBadUtf) is empty), \
         "a non-UTF-8 device name in a challenge is refused, not thrown"
   put rs1rstBin("52534c31520180") & (byte -64 to -1 of rs1tResponse) into rs1tBadUtf
   rs1rstCheck (rsLanParseResponse(rs1tBadUtf) is empty), \
         "a non-UTF-8 device name in a response is refused, not thrown"
   -- the W welcome: mutual auth back to the joiner, bound to THIS handshake
   put rsLanBuildWelcome(rs1tResponse, rs1kRsGoldLanHostName, \
         rs1rstBin(rs1kRsGoldMasterHex)) into rs1tWelcome
   rs1rstCheck (rs1rstHex(rs1tWelcome) is rs1kRsGoldLanWelcomeHex), \
         "the welcome bytes match golden"
   put rsLanParseWelcome(rs1tWelcome) into rs1tName
   rs1rstCheck (rs1tName["name"] is rs1kRsGoldLanHostName), \
         "the host name round-trips out of the welcome"
   put rsLanVerifyWelcome(rs1tWelcome, rs1tResponse, rs1rstBin(rs1kRsGoldMasterHex)) \
         into rs1tName
   rs1rstCheck (rs1tName is rs1kRsGoldLanHostName), \
         "the joiner verifies the host shares the master, learning ITS name"
   -- a rogue host: a welcome built under a different master is refused
   put rsLanBuildWelcome(rs1tResponse, rs1kRsGoldLanHostName, \
         rs1rstBin(rs1kRsGoldConfSeedHex)) into rs1tBadName
   rs1rstCheck (rsLanVerifyWelcome(rs1tBadName, rs1tResponse, \
         rs1rstBin(rs1kRsGoldMasterHex)) is empty), \
         "a welcome from a host that does NOT share the master is refused"
   -- handshake binding: the welcome must not verify against a DIFFERENT
   -- response (a captured welcome cannot admit a later session)
   put rsLanBuildResponse(rs1tChallenge2, rs1kRsGoldLanJoinName, \
         rs1rstBin(rs1kRsGoldMasterHex)) into rs1tBadName
   rs1rstCheck (rsLanVerifyWelcome(rs1tWelcome, rs1tBadName, \
         rs1rstBin(rs1kRsGoldMasterHex)) is empty), \
         "a welcome replayed against another handshake is refused"
   rs1rstCheck (rsLanVerifyWelcome(rs1rstFlipByte(rs1tWelcome, 70), rs1tResponse, \
         rs1rstBin(rs1kRsGoldMasterHex)) is empty), \
         "a tampered welcome is refused"
   rs1rstCheck (rsLanParseWelcome(byte 1 to 30 of rs1tWelcome) is empty), \
         "a truncated welcome is refused"
   put rs1rstBin("52534c31570180") & (byte -64 to -1 of rs1tWelcome) into rs1tBadUtf
   rs1rstCheck (rsLanParseWelcome(rs1tBadUtf) is empty), \
         "a non-UTF-8 host name in a welcome is refused, not thrown"
end rs1rstSectionLan

private command rs1rstSectionLanSync
   local rs1tMaster, rs1tKeys, rs1tRec, rs1tOut, rs1tBytes, rs1tBody
   rs1rstSection "phase 6 - LAN sync records (drafts, feed state, presence)"
   put rs1rstBin(rs1kRsGoldMasterHex) into rs1tMaster
   put rsLanKeys(rs1tMaster) into rs1tKeys
   -- the draft record (channel 0, reliable)
   put rsLanBuildDraft(rs1kRsGoldLanJoinName, rs1kRsGoldLanSeq, \
         rs1kRsGoldLanDraftText, rs1tMaster) into rs1tRec
   rs1rstCheck (rs1rstHex(rs1tRec) is rs1kRsGoldLanDraftHex), \
         "the draft record bytes match golden"
   put rsLanVerifyDraft(rs1tRec, rs1tMaster) into rs1tOut
   rs1rstCheck (rs1tOut["name"] is rs1kRsGoldLanJoinName), \
         "the draft's device name verifies and round-trips"
   rs1rstCheck (rs1tOut["seq"] is rs1kRsGoldLanSeq + 0), \
         "the draft's per-device seq round-trips"
   rs1rstCheck (rs1tOut["draft"] is rs1kRsGoldLanDraftText), \
         "the draft text round-trips"
   -- absolute state: an EMPTY draft is legal and means cleared
   put rsLanBuildDraft(rs1kRsGoldLanJoinName, 6, empty, rs1tMaster) into rs1tBytes
   put rsLanVerifyDraft(rs1tBytes, rs1tMaster) into rs1tOut
   rs1rstCheck (rs1tOut is not empty and rs1tOut["draft"] is empty), \
         "an empty draft builds and verifies (cleared state)"
   -- the stranger: a record signed under a DIFFERENT master is refused
   put rsLanBuildDraft(rs1kRsGoldLanJoinName, rs1kRsGoldLanSeq, \
         rs1kRsGoldLanDraftText, rs1rstBin(rs1kRsGoldConfSeedHex)) into rs1tBytes
   rs1rstCheck (rsLanVerifyDraft(rs1tBytes, rs1tMaster) is empty), \
         "a stranger's draft record is refused"
   rs1rstCheck (rsLanVerifyDraft(rs1rstFlipByte(rs1tRec, 30), rs1tMaster) is empty), \
         "a tampered draft record is refused"
   rs1rstCheck (rsLanVerifyDraft(byte 1 to 40 of rs1tRec, rs1tMaster) is empty), \
         "a truncated draft record is refused"
   rs1rstCheck (rsLanBuildDraft(rs1kRsGoldLanJoinName, -1, "x", rs1tMaster) \
         is empty), "a negative draft seq is refused"
   -- a hand-signed record with a non-UTF-8 name: the signature is VALID
   -- (only a master-holder could make it), so this exercises the
   -- refusal AFTER the proof - refused clean, never thrown, never mangled
   put rs1rstBin("52534c3144") & numToByte(2) & rs1rstBin("fffe") & \
         rs1rstBin("0000000000000001") & rs1rstBin("0000") into rs1tBody
   put rs1tBody & sxSignDetached(textEncode("riptide-lan-s", "ASCII") & \
         rs1tBody, rs1tKeys["secretKey"]) into rs1tBytes
   rs1rstCheck (rsLanVerifyDraft(rs1tBytes, rs1tMaster) is empty), \
         "a validly signed draft with a non-UTF-8 name is refused, not thrown"
   -- the feed-state record (channel 0): feedSeq + an optional read receipt
   put rsLanBuildFeedState(rs1kRsGoldLanJoinName, rs1kRsGoldLanFeedSeq, \
         rs1kRsGoldHandle, rs1kRsGoldLanReadTs, rs1tMaster) into rs1tRec
   rs1rstCheck (rs1rstHex(rs1tRec) is rs1kRsGoldLanFeedStateHex), \
         "the feed-state record bytes match golden"
   put rsLanVerifyFeedState(rs1tRec, rs1tMaster) into rs1tOut
   rs1rstCheck (rs1tOut["feedSeq"] is rs1kRsGoldLanFeedSeq + 0), \
         "the feed seq verifies and round-trips"
   rs1rstCheck (rs1tOut["readPeer"] is rs1kRsGoldHandle), \
         "the read-receipt peer round-trips"
   rs1rstCheck (rs1tOut["readUpTo"] is rs1kRsGoldLanReadTs + 0), \
         "the read-up-to timestamp round-trips"
   -- an empty peer travels as the all-zeros handle and parses back EMPTY
   put rsLanBuildFeedState(rs1kRsGoldLanJoinName, 1, empty, 0, rs1tMaster) \
         into rs1tBytes
   put rsLanVerifyFeedState(rs1tBytes, rs1tMaster) into rs1tOut
   rs1rstCheck (rs1tOut is not empty and rs1tOut["readPeer"] is empty), \
         "a pure feed-seq claim (no receipt) round-trips the none spelling"
   put rsLanBuildFeedState(rs1kRsGoldLanJoinName, 1, empty, 0, \
         rs1rstBin(rs1kRsGoldConfSeedHex)) into rs1tBytes
   rs1rstCheck (rsLanVerifyFeedState(rs1tBytes, rs1tMaster) is empty), \
         "a stranger's feed-state record is refused"
   rs1rstCheck (rsLanBuildFeedState(rs1kRsGoldLanJoinName, 1, "zz", 0, rs1tMaster) \
         is empty), "a malformed read-receipt peer is refused at build"
   -- the presence record (channel 1, unreliable-unsequenced)
   put rsLanBuildPresence(rs1kRsGoldLanJoinName, true, rs1kRsGoldLanTick, \
         rs1tMaster) into rs1tRec
   rs1rstCheck (rs1rstHex(rs1tRec) is rs1kRsGoldLanPresenceHex), \
         "the presence record bytes match golden"
   put rsLanVerifyPresence(rs1tRec, rs1tMaster) into rs1tOut
   rs1rstCheck (rs1tOut["typing"] is true and rs1tOut["tick"] is rs1kRsGoldLanTick + 0), \
         "typing state and tick verify and round-trip"
   put rsLanBuildPresence(rs1kRsGoldLanJoinName, false, 4, rs1tMaster) into rs1tBytes
   put rsLanVerifyPresence(rs1tBytes, rs1tMaster) into rs1tOut
   rs1rstCheck (rs1tOut is not empty and rs1tOut["typing"] is false), \
         "the not-typing absolute state round-trips"
   put rsLanBuildPresence(rs1kRsGoldLanJoinName, true, 1, \
         rs1rstBin(rs1kRsGoldConfSeedHex)) into rs1tBytes
   rs1rstCheck (rsLanVerifyPresence(rs1tBytes, rs1tMaster) is empty), \
         "a stranger's presence record is refused"
   -- a hand-signed record with UNKNOWN flag bits (2): a valid signature,
   -- refused fail-closed - a newer format must never half-parse
   put rs1rstBin("52534c3150") & numToByte(5) & \
         textEncode(rs1kRsGoldLanJoinName, "UTF-8") & numToByte(2) & \
         rs1rstBin("0000000000000001") into rs1tBody
   put rs1tBody & sxSignDetached(textEncode("riptide-lan-s", "ASCII") & \
         rs1tBody, rs1tKeys["secretKey"]) into rs1tBytes
   rs1rstCheck (rsLanVerifyPresence(rs1tBytes, rs1tMaster) is empty), \
         "a validly signed presence record with unknown flags is refused"
   -- no cross-kind reads: one record kind can never verify as another
   rs1rstCheck (rsLanVerifyDraft(rs1tRec, rs1tMaster) is empty), \
         "a presence record fed to the draft verifier is refused"
   -- the media-handoff record (channel 0: the channel-2 decision - a
   -- signed POINTER at the phase-3 torrent path; the pointed-at hash is
   -- the same placeholder info-hash the golden post-2 media list names)
   put rsLanBuildHandoff(rs1kRsGoldLanJoinName, rs1kRsGoldLanMediaSeq, \
         rs1kRsGoldMediaTarget, rs1kRsGoldLanFileName, rs1kRsGoldLanFileSize, \
         rs1tMaster) into rs1tRec
   rs1rstCheck (rs1rstHex(rs1tRec) is rs1kRsGoldLanHandoffHex), \
         "the media-handoff record bytes match golden"
   put rsLanVerifyHandoff(rs1tRec, rs1tMaster) into rs1tOut
   rs1rstCheck (rs1tOut["name"] is rs1kRsGoldLanJoinName), \
         "the handoff's device name verifies and round-trips"
   rs1rstCheck (rs1tOut["seq"] is rs1kRsGoldLanMediaSeq + 0), \
         "the handoff's per-device seq round-trips"
   rs1rstCheck (rs1tOut["infoHash"] is rs1kRsGoldMediaTarget), \
         "the handoff's info-hash round-trips"
   rs1rstCheck (rs1tOut["fileName"] is rs1kRsGoldLanFileName), \
         "the handoff's file name round-trips"
   rs1rstCheck (rs1tOut["fileSize"] is rs1kRsGoldLanFileSize + 0), \
         "the handoff's file size round-trips"
   -- the build normalizes hash case; the WIRE stays strict lowercase.
   -- Compared as HEX against the golden, not with `is` on the Data -
   -- `is` folds case, so a non-normalizing build could pass a bytes
   -- compare (the vacuous-check trap)
   put rsLanBuildHandoff(rs1kRsGoldLanJoinName, rs1kRsGoldLanMediaSeq, \
         toUpper(rs1kRsGoldMediaTarget), rs1kRsGoldLanFileName, \
         rs1kRsGoldLanFileSize, rs1tMaster) into rs1tBytes
   rs1rstCheck (rs1rstHex(rs1tBytes) is rs1kRsGoldLanHandoffHex), \
         "an uppercase info-hash normalizes to the same handoff bytes"
   rs1rstCheck (rsLanBuildHandoff(rs1kRsGoldLanJoinName, 1, \
         rsZeroTarget(), "f", 1, rs1tMaster) is empty), \
         "the all-zeros info-hash is refused at build (no empty handoff)"
   rs1rstCheck (rsLanBuildHandoff(rs1kRsGoldLanJoinName, 1, "zz", "f", 1, \
         rs1tMaster) is empty), "a malformed info-hash is refused at build"
   rs1rstCheck (rsLanBuildHandoff(rs1kRsGoldLanJoinName, 1, \
         rs1kRsGoldMediaTarget, empty, 1, rs1tMaster) is empty), \
         "an empty file name is refused at build"
   put rsLanBuildHandoff(rs1kRsGoldLanJoinName, rs1kRsGoldLanMediaSeq, \
         rs1kRsGoldMediaTarget, rs1kRsGoldLanFileName, rs1kRsGoldLanFileSize, \
         rs1rstBin(rs1kRsGoldConfSeedHex)) into rs1tBytes
   rs1rstCheck (rsLanVerifyHandoff(rs1tBytes, rs1tMaster) is empty), \
         "a stranger's handoff record is refused"
   rs1rstCheck (rsLanVerifyHandoff(rs1rstFlipByte(rs1tRec, 25), rs1tMaster) is empty), \
         "a tampered handoff record is refused"
   rs1rstCheck (rsLanVerifyHandoff(byte 1 to 60 of rs1tRec, rs1tMaster) is empty), \
         "a truncated handoff record is refused"
   -- a hand-signed record with a non-UTF-8 FILE name: the signature is
   -- VALID, so this exercises the refusal AFTER the proof (the draft
   -- forgery's discipline, on the handoff's second text field)
   put rs1rstBin("52534c314d") & numToByte(5) & \
         textEncode(rs1kRsGoldLanJoinName, "UTF-8") & \
         rs1rstBin("0000000000000001") & \
         textEncode(rs1kRsGoldMediaTarget, "ASCII") & numToByte(2) & \
         rs1rstBin("fffe") & rs1rstBin("0000000000000001") into rs1tBody
   put rs1tBody & sxSignDetached(textEncode("riptide-lan-s", "ASCII") & \
         rs1tBody, rs1tKeys["secretKey"]) into rs1tBytes
   rs1rstCheck (rsLanVerifyHandoff(rs1tBytes, rs1tMaster) is empty), \
         "a validly signed handoff with a non-UTF-8 file name is refused"
   -- a hand-signed record with an UPPERCASE hash on the wire: valid
   -- signature, non-canonical spelling - refused (the coinxt lesson)
   put rs1rstBin("52534c314d") & numToByte(5) & \
         textEncode(rs1kRsGoldLanJoinName, "UTF-8") & \
         rs1rstBin("0000000000000001") & \
         textEncode(toUpper(rs1kRsGoldMediaTarget), "ASCII") & \
         numToByte(1) & textEncode("f", "UTF-8") & \
         rs1rstBin("0000000000000001") into rs1tBody
   put rs1tBody & sxSignDetached(textEncode("riptide-lan-s", "ASCII") & \
         rs1tBody, rs1tKeys["secretKey"]) into rs1tBytes
   rs1rstCheck (rsLanVerifyHandoff(rs1tBytes, rs1tMaster) is empty), \
         "a validly signed handoff with an uppercase hash is refused"
   -- cross-kind, both directions for the new kind
   rs1rstCheck (rsLanVerifyDraft(rs1tRec, rs1tMaster) is empty), \
         "a handoff record fed to the draft verifier is refused"
   put rsLanBuildDraft(rs1kRsGoldLanJoinName, rs1kRsGoldLanSeq, \
         rs1kRsGoldLanDraftText, rs1tMaster) into rs1tBytes
   rs1rstCheck (rsLanVerifyHandoff(rs1tBytes, rs1tMaster) is empty), \
         "a draft record fed to the handoff verifier is refused"
end rs1rstSectionLanSync

private command rs1rstSectionDm pCaps
   local rs1tSeed, rs1tMyKeys, rs1tConfKeys, rs1tSess, rs1tSessB, rs1tPrekey, rs1tIntro
   local rs1tSealed, rs1tOpened, rs1tFrame, rs1tParsed, rs1tMsg, rs1tBig, rs1tDir, rs1tErr
   local rs1tHeader, rs1tPush, rs1tPull, rs1tCipher, rs1tCipher2, rs1tPlain, rs1tTag, rs1tSession, rs1tH
   rs1rstSection "phase 4 - DM keys, records, and the sealed first contact"
   put rs1rstBin(rs1kRsGoldIdSeedHex) into rs1tSeed
   -- keys: the kx pair from the DM subkey, pinned against real libsodium
   put rsDmKeys(rs1rstBin(rs1kRsGoldDmSeedHex)) into rs1tMyKeys
   rs1rstCheck (rs1tMyKeys["publicKeyHex"] is rs1kRsGoldDmKxPub), \
         "the DM subkey yields the golden kx public"
   rs1rstCheck (the number of bytes in rs1tMyKeys["secretKey"] is 32), \
         "and a 32-byte kx secret"
   put rsDmKeys(rs1rstBin(rs1kRsGoldConfSeedHex)) into rs1tConfKeys
   rs1rstCheck (rs1tConfKeys["publicKeyHex"] is rs1kRsGoldConfKxPub), \
         "the conformance seed yields its golden kx public"
   rs1rstCheck (rsDmKeys(byte 1 to 31 of rs1tSeed) is empty), \
         "a 31-byte DM seed is refused"
   -- one session, two roles, derived from BOTH ends: the golden handle
   -- sorts below the conformance pub, so the golden side is the client
   put rsDmSessionKeys(rs1kRsGoldHandle, rs1tMyKeys, rs1kRsGoldConfPub, \
         rs1kRsGoldConfKxPub) into rs1tSess
   rs1rstCheck (rs1tSess["role"] is "client"), \
         "the lexically smaller handle takes the client role"
   rs1rstCheck (rs1rstHex(rs1tSess["rx"]) is rs1kRsGoldSessionRx), \
         "client rx matches the libsodium-anchored golden"
   rs1rstCheck (rs1rstHex(rs1tSess["tx"]) is rs1kRsGoldSessionTx), \
         "client tx matches the libsodium-anchored golden"
   put rsDmSessionKeys(rs1kRsGoldConfPub, rs1tConfKeys, rs1kRsGoldHandle, \
         rs1kRsGoldDmKxPub) into rs1tSessB
   rs1rstCheck (rs1tSessB["role"] is "server"), "the peer takes the server role"
   rs1rstCheck (rs1rstHex(rs1tSessB["rx"]) is rs1kRsGoldSessionTx), \
         "my tx is the peer's rx"
   rs1rstCheck (rs1rstHex(rs1tSessB["tx"]) is rs1kRsGoldSessionRx), \
         "and my rx is the peer's tx"
   rs1rstCheck (rsDmSessionKeys(rs1kRsGoldHandle, rs1tMyKeys, rs1kRsGoldHandle, \
         rs1kRsGoldConfKxPub) is empty), \
         "a session with myself is refused"
   rs1rstCheck (rsDmSessionKeys("zz", rs1tMyKeys, rs1kRsGoldConfPub, \
         rs1kRsGoldConfKxPub) is empty), "a malformed handle is refused"
   -- RSK1: the signed prekey record
   put rsBuildPrekey(rs1kRsGoldDmKxPub, rs1tSeed) into rs1tPrekey
   rs1rstCheck (rs1rstHex(rs1tPrekey) is rs1kRsGoldPrekeyRecHex), \
         "prekey record bytes match golden"
   rs1rstCheck (rsImmutableTarget(rs1tPrekey) is rs1kRsGoldPrekeyRecTarget), \
         "and its DHT target re-derives"
   put rsParsePrekey(rs1tPrekey) into rs1tParsed
   rs1rstCheck (rs1tParsed["kxPub"] is rs1kRsGoldDmKxPub), "prekey kx round-trips"
   put rsVerifyPrekey(rs1tPrekey, rs1kRsGoldHandle) into rs1tParsed
   rs1rstCheck (rs1tParsed is not empty), "the prekey verifies under its author"
   rs1rstCheck (rsVerifyPrekey(rs1tPrekey, rs1kRsGoldConfPub) is empty), \
         "and refuses a different author"
   rs1rstCheck (rsVerifyPrekey(rs1rstFlipByte(rs1tPrekey, 10), rs1kRsGoldHandle) is \
         empty), "a tampered prekey is refused"
   rs1rstCheck (rsParsePrekey(byte 1 to 131 of rs1tPrekey) is empty), \
         "a truncated prekey is refused"
   rs1rstCheck (rsBuildPrekey("zz", rs1tSeed) is empty), \
         "a malformed kx public is refused at build"
   -- RSI1: the intro, built by the golden identity FOR the conformance
   -- identity; the sender handle comes from the signing seed, never an arg
   put rsBuildIntro(rs1kRsGoldDmTs, rs1kRsGoldConfPub, rs1kRsGoldDmKxPub, rs1tSeed) \
         into rs1tIntro
   rs1rstCheck (rs1rstHex(rs1tIntro) is rs1kRsGoldIntroHex), \
         "intro record bytes match golden"
   put rsParseIntro(rs1tIntro) into rs1tParsed
   rs1rstCheck (rs1tParsed["senderHandle"] is rs1kRsGoldHandle), \
         "the sender handle round-trips"
   rs1rstCheck (rs1tParsed["senderKxPub"] is rs1kRsGoldDmKxPub), \
         "the sender kx public round-trips"
   rs1rstCheck (rs1tParsed["recipientHandle"] is rs1kRsGoldConfPub), \
         "the recipient handle round-trips"
   rs1rstCheck (rs1tParsed["timestamp"] is 1754870520), "the timestamp round-trips"
   put rsVerifyIntro(rs1tIntro, rs1kRsGoldConfPub) into rs1tParsed
   rs1rstCheck (rs1tParsed is not empty), "the intro verifies for its recipient"
   rs1rstCheck (rsVerifyIntro(rs1tIntro, rs1kRsGoldHandle) is empty), \
         "and refuses a recipient it is not addressed to"
   rs1rstCheck (rsVerifyIntro(rs1rstFlipByte(rs1tIntro, 200), rs1kRsGoldConfPub) is \
         empty), "a tampered intro fails its signature"
   rs1rstCheck (rsParseIntro(rs1tIntro & numToByte(0)) is empty), \
         "trailing bytes are refused"
   -- the seal: to the recipient's kx prekey; only the recipient opens it
   put rsDmSealIntro(rs1tIntro, rs1kRsGoldConfKxPub) into rs1tSealed
   rs1rstCheck (rs1tSealed is not empty), "the intro seals to the recipient prekey"
   rs1rstCheck (the number of bytes in rs1tSealed is 268 + 48), \
         "the sealed intro carries the 48-byte seal overhead"
   put rsDmOpenIntro(rs1tSealed, rs1kRsGoldConfPub, rs1rstBin(rs1kRsGoldConfSeedHex)) \
         into rs1tOpened
   rs1rstCheck (rs1tOpened is not empty), "the recipient opens and verifies it"
   rs1rstCheck (rs1tOpened["senderHandle"] is rs1kRsGoldHandle), \
         "learning who is calling"
   rs1rstCheck (rs1tOpened["senderKxPub"] is rs1kRsGoldDmKxPub), \
         "and the key to answer on"
   rs1rstCheck (rsDmOpenIntro(rs1tSealed, rs1kRsGoldHandle, \
         rs1rstBin(rs1kRsGoldDmSeedHex)) is empty), \
         "a NON-recipient cannot open the seal"
   rs1rstCheck (rsDmOpenIntro(rs1rstFlipByte(rs1tSealed, 40), rs1kRsGoldConfPub, \
         rs1rstBin(rs1kRsGoldConfSeedHex)) is empty), \
         "a tampered seal is refused"
   -- RSM1 frames: canonical kinds by byte value, strict parse
   put rsDmFrame("I", rs1tSealed) into rs1tFrame
   rs1rstCheck (rs1tFrame is not empty), "an intro frame builds"
   put rsDmParseFrame(rs1tFrame) into rs1tParsed
   rs1rstCheck (rs1tParsed["kind"] is "I"), "the frame kind round-trips"
   rs1rstCheck (rs1tParsed["payload"] is rs1tSealed), "the frame payload round-trips"
   rs1rstCheck (rsDmFrame("X", rs1tSealed) is empty), \
         "an unknown frame kind is refused"
   rs1rstCheck (rsDmFrame("i", rs1tSealed) is empty), \
         "a lowercase kind is refused (canonical bytes, not folded case)"
   rs1rstCheck (rsDmFrame("M", empty) is empty), \
         "an empty frame payload is refused"
   put "x" into rs1tBig
   repeat 16 times
      put rs1tBig & rs1tBig into rs1tBig
   end repeat
   rs1rstCheck (rsDmFrame("M", textEncode(rs1tBig, "ASCII")) is empty), \
         "a frame over the rp1 cap is refused"
   rs1rstCheck (rsDmParseFrame(byte 1 to 5 of rs1tFrame) is empty), \
         "a payload-less frame is refused"
   -- the message record, and the whole DM message path through a REAL
   -- secretstream: build -> push (my tx) -> pull (peer rx = same key)
   -- -> parse. The stream handles are freed even though the section is
   -- pure - sodiumxt has no unload hook (its own rule).
   put rsDmMessageBody("T", rs1kRsGoldMsgTs, rs1kRsGoldDmMsgText) into rs1tMsg
   rs1rstCheck (rs1rstHex(rs1tMsg) is rs1kRsGoldDmMsgHex), \
         "message record bytes match golden"
   put rsDmParseMessage(rs1tMsg) into rs1tParsed
   rs1rstCheck (rs1tParsed["kind"] is "T"), "message kind round-trips"
   rs1rstCheck (rs1tParsed["timestamp"] is 1754870580), \
         "message timestamp round-trips"
   rs1rstCheck (rs1tParsed["text"] is rs1kRsGoldDmMsgText), "message text round-trips"
   rs1rstCheck (rsDmMessageBody("X", 1, "hi") is empty), \
         "an unknown message kind is refused"
   rs1rstCheck (rsDmMessageBody("T", 1, empty) is empty), \
         "an empty message body is refused"
   rs1rstCheck (rsDmParseMessage(byte 1 to 9 of rs1tMsg) is empty), \
         "a truncated message record is refused"
   put sxSecretStreamInitPush(rs1tSess["tx"], rs1tHeader) into rs1tPush
   put sxSecretStreamPush(rs1tPush, rs1tMsg, empty, false) into rs1tCipher
   rs1rstCheck (the number of bytes in rs1tCipher > the number of bytes in rs1tMsg), \
         "the stream ciphertext carries its auth overhead"
   put sxSecretStreamInitPull(rs1tSessB["rx"], rs1tHeader) into rs1tPull
   put sxSecretStreamPull(rs1tPull, rs1tCipher, empty, rs1tTag) into rs1tPlain
   rs1rstCheck (rs1tPlain is rs1tMsg), \
         "the peer's rx key decrypts what my tx key sent"
   rs1rstCheck (sxIsFinalTag(rs1tTag) is false), "mid-stream is not final"
   put sxSecretStreamPush(rs1tPush, rs1tMsg, empty, true) into rs1tCipher2
   put sxSecretStreamPull(rs1tPull, rs1tCipher2, empty, rs1tTag) into rs1tPlain
   rs1rstCheck (sxIsFinalTag(rs1tTag) is true), \
         "the final tag survives the stream"
