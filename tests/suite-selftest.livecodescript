   b21stNewWorld "player: ladder climb in a zone, hang, jump-exit"
   b21stSlab "st_ground", 50, 500, 800, 560
   b2kPlayerAddLadder 280, 280, 320, 500   -- x 280..320, floor up to y 280
   b2kPlayerMake 300, 470, 32, 48
