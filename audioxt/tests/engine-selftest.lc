      get auDecodeData(empty, empty, 0, 0)
      put "auWAVEncode" into tName
      get auWAVEncode(empty, empty, 0, 0)
      put "auShutDown" into tName
      auShutDown
   catch tError
      check "sweep: " & tName, false, oneLine(tError)
      exit sweepEveryHandler
   end try
   check "sweep: all 112 public handlers called with zeros, none threw", true
end sweepEveryHandler
-- <<< END SWEEP <<<

-- ---------------------------------------------------------------------
put 0 into sPassed
put 0 into sFailed
put "INFO engine " & the version && the platform && the processor & return
try
   set the revLibraryMapping["audioxt"] to $1
   load extension from file $0
   check "the extension loads", the result is empty and "org.openxtalk.library.audioxt" is among the lines of the loadedExtensions, \
         "result '" & oneLine(the result) & "'"
   if sFailed is 0 then
      put "INFO " & auLibraryVersion() & return
      put "INFO backend '" & auBackendName() & "'" & return
      testLibrary
      testOfflineTone
      testBytesAndFiles
      testEndsGroupsAndPlace
      testSilentDevice
      testTypedBoundary
      sweepEveryHandler
   end if
catch tError
   check "the run finished", false, oneLine(tError)
end try
put "SUMMARY " & sPassed && sFailed & return
quit sFailed
?>
